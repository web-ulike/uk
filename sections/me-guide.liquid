{% style %}
  .me-guide {
        padding: 90px 0;
        overflow: hidden;
        background: #fff;
        color: #3F3636;
      }

      .me-guide,
      .me-guide * {
        box-sizing: border-box;
      }

      .me-guide__container {
        width: calc(100% - 64px);
        max-width: 1520px;
        margin: 0 auto;
      }

      .me-guide__title {
        margin: 0;
        color: #190A0A;
        text-align: center;
        font-size: 44px;
        font-weight: 400;
        line-height: 1.2;
      }

      .me-guide__tabs {
        --tab-index: 0;
        position: relative;
        display: flex;
        width: 364px;
        max-width: 100%;
        margin: 48px auto 64px;
        border-bottom: 1px solid #999;
      }

      .me-guide__tabs::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -1px;
        width: 50%;
        height: 2px;
        background: #3F3636;
        transform: translateX(calc(var(--tab-index) * 100%));
        transition: transform .5s cubic-bezier(.22, 1, .36, 1);
        pointer-events: none;
      }

      .me-guide__tab {
        flex: 1;
        padding: 10px 0 12px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #858585;
        font-family: inherit;
        font-size: 20px;
        font-weight: 400;
        line-height: 1.2;
        cursor: pointer;
        transition: color .3s;
        -webkit-tap-highlight-color: transparent;
        text-align: center;
      }

      .me-guide__tab[aria-selected="true"] {
        color: #3F3636;
        font-weight: 500;
      }

      .me-guide__panel[hidden] {
        display: none !important;
      }

      .me-guide custom-swiper-me {
        display: block;
        min-width: 0;
      }

      .me-guide__slider {
        width: 100%;
        min-width: 0;
        overflow: visible;
      }

      .me-guide__grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        height: auto;
      }

      .me-guide__panel--tips .me-guide__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .me-guide__slide {
        min-width: 0;
        height: auto;
      }

      .me-guide__slide:nth-child(1) {
        --card-delay: 0ms;
      }

      .me-guide__slide:nth-child(2) {
        --card-delay: 80ms;
      }

      .me-guide__slide:nth-child(3) {
        --card-delay: 160ms;
      }

      .me-guide__slide:nth-child(4) {
        --card-delay: 240ms;
      }

      .me-guide__picture {
        position: relative;
        overflow: hidden;
        aspect-ratio: 365 / 280;
        border-radius: 6px;
        background: #F7F7F7;
        isolation: isolate;
      }

      .me-guide__panel--tips .me-guide__picture {
        aspect-ratio: 493 / 280;
      }

      .me-guide__picture img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .9s cubic-bezier(.22, 1, .36, 1);
      }

      .me-guide__card h3 {
        margin: 24px 0 0;
        font-size: 22px;
        font-weight: 500;
        line-height: 1.25;
      }

      .me-guide__description {
        margin: 10px 0 0;
        color: #190A0A;
        font-size: 16px;
        line-height: 1.3;
      }

      .me-guide__note {
        margin: 22px 0 0;
        color: #999;
        font-size: 10px;
        line-height: 1.5;
      }

      .me-guide__arrows {
        display: none;
      }

      .me-guide__tab:focus-visible,
      .me-guide__arrow:focus-visible {
        outline: 2px solid #E0004D;
        outline-offset: 4px;
      }

      /* 动画只作用于卡片内部，不影响 Swiper 的位移 */
      .me-guide.appear .me-guide__title {
        animation: me-guide-title .9s cubic-bezier(.22, 1, .36, 1) both;
      }

      .me-guide.appear .me-guide__panel.is-active .me-guide__card {
        animation:
          me-guide-card .8s cubic-bezier(.22, 1, .36, 1) var(--card-delay, 0ms) both;
      }

      @keyframes me-guide-title {
        from {
          opacity: 0;
          transform: translateY(24px);
          filter: blur(5px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @keyframes me-guide-card {
        from {
          opacity: 0;
          transform: perspective(1000px) translateY(36px) rotateX(5deg);
        }

        to {
          opacity: 1;
          transform: perspective(1000px) translateY(0) rotateX(0);
        }
      }

      @media (hover: hover) and (pointer: fine) {
        .me-guide__card:hover .me-guide__picture img {
          transform: scale(1.045);
        }

        .me-guide__tab:hover {
          color: #190A0A;
        }
      }

      /* 768–1450：主要尺寸 × 0.8，四舍五入 */
      @media (min-width: 768px) and (max-width: 1450px) {
        .me-guide {
          padding: 72px 0;
        }

        .me-guide__container {
          width: calc(100% - 52px);
          max-width: 1216px;
        }

        .me-guide__title {
          font-size: 35px;
        }

        .me-guide__tabs {
          width: 291px;
          margin: 38px auto 51px;
        }

        .me-guide__tab {
          padding: 8px 0 10px;
          font-size: 16px;
        }

        .me-guide__grid {
          gap: 16px;
        }

        .me-guide__picture {
          border-radius: 5px;
        }

        .me-guide__card h3 {
          margin-top: 19px;
          font-size: 18px;
        }

        .me-guide__description {
          margin-top: 8px;
          font-size: 13px;
        }

        .me-guide__note {
          margin-top: 18px;
          font-size: 8px;
        }
      }

      @media (max-width: 767px) {
        .me-guide {
          padding: 60px 0 40px;
        }

        .me-guide__container {
          width: calc(100% - 32px);
        }

        .me-guide__title {
          max-width: 280px;
          margin: 0 auto;
          font-size: 24px;
          line-height: 1.2;
        }

        .me-guide__tabs {
          width: 264px;
          margin: 24px auto;
        }

        .me-guide__tab {
          padding: 8px 0 10px;
          font-size: 14px;
        }

        .me-guide__grid,
        .me-guide__panel--tips .me-guide__grid {
          display: flex;
          gap: 0;
        }

        .me-guide__slide {
          flex-shrink: 0;
          /* 初始化之前也保留下一张卡片的预览 */
          width: calc((100% - 2px) / 1.125);
        }

        .me-guide__picture,
        .me-guide__panel--tips .me-guide__picture {
          aspect-ratio: 1;
          border-radius: 4px;
        }

        .me-guide__card h3 {
          margin-top: 18px;
          font-size: 18px;
          line-height: 1.25;
        }

        .me-guide__description {
          margin-top: 8px;
          font-size: 12px;
          line-height: 1.2;
        }

        .me-guide__arrows {
          display: flex;
          justify-content: flex-end;
          align-items: center;
          gap: 16px;
          margin-top: 28px;
          padding-right: 34px;
        }

        .me-guide__arrow {
          display: grid;
          place-items: center;
          width: 34px;
          height: 40px;
          padding: 0;
          border: 0;
          background: transparent;
          color: #190A0A;
          cursor: pointer;
          transition: opacity .3s, transform .3s;
          -webkit-tap-highlight-color: transparent;
        }

        .me-guide__arrow svg {
          display: block;
          width: 26px;
          height: 22px;
        }

        .me-guide__arrow:active {
          transform: scale(.88);
        }

        .me-guide__arrow.swiper-button-disabled {
          opacity: .25;
          cursor: default;
        }

        .me-guide__arrow.swiper-button-lock {
          display: none;
        }

        .me-guide__note {
          margin: 24px 6px 0;
          color: #757575;
          font-size: 10px;
          line-height: 1.5;
        }
      }

      @media (prefers-reduced-motion: reduce) {

        .me-guide *,
        .me-guide *::after {
          animation: none !important;
          transition: none !important;
        }
      }
{% endstyle %}

