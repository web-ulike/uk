{% style %}
  .me-guide {
        padding: 90px 0;
        overflow: hidden;
        background: #fff;
        color: #3F3636;
      }

      .me-guide,
      .me-guide * {
        box-sizing: border-box;
      }

      .me-guide__container {
        width: calc(100% - 64px);
        max-width: 1520px;
        margin: 0 auto;
      }

      .me-guide__title {
        margin: 0;
        color: #190A0A;
        text-align: center;
        font-size: 44px;
        font-weight: 400;
        line-height: 1.2;
      }

      .me-guide__tabs {
        --tab-index: 0;
        position: relative;
        display: flex;
        width: 364px;
        max-width: 100%;
        margin: 48px auto 64px;
        border-bottom: 1px solid #999;
      }

      .me-guide__tabs::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -1px;
        width: 50%;
        height: 2px;
        background: #3F3636;
        transform: translateX(calc(var(--tab-index) * 100%));
        transition: transform .5s cubic-bezier(.22, 1, .36, 1);
        pointer-events: none;
      }

      .me-guide__tab {
        flex: 1;
        padding: 10px 0 12px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #858585;
        font-family: inherit;
        font-size: 20px;
        font-weight: 400;
        line-height: 1.2;
        cursor: pointer;
        transition: color .3s;
        -webkit-tap-highlight-color: transparent;
        text-align: center;
      }

      .me-guide__tab[aria-selected="true"] {
        color: #3F3636;
        font-weight: 500;
            font-family: var(--heading-font-family);
      }

      .me-guide__panel[hidden] {
        display: none !important;
      }

      .me-guide custom-swiper-me {
        display: block;
        min-width: 0;
      }

      .me-guide__slider {
        width: 100%;
        min-width: 0;
        overflow: visible;
      }

      .me-guide__grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        height: auto;
      }

      .me-guide__panel--tips .me-guide__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .me-guide__slide {
        min-width: 0;
        height: auto;
      }




      .me-guide__picture {
        position: relative;
        overflow: hidden;
        aspect-ratio: 365 / 280;
        border-radius: 6px;
        background: #F7F7F7;
        isolation: isolate;
      }

      .me-guide__panel--tips .me-guide__picture {
        aspect-ratio: 493 / 280;
      }

      .me-guide__picture img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .9s cubic-bezier(.22, 1, .36, 1);
      }

      .me-guide__card h3 {
        margin: 24px 0 0;
        font-size: 22px;
        font-weight: 500;
        line-height: 1.25;
      }

      .me-guide__description {
        margin: 10px 0 0;
        color: #190A0A;
        font-size: 16px;
        line-height: 1.3;
      }

      .me-guide__note {
        margin: 22px 0 0;
        color: #999;
        font-size: 10px;
        line-height: 1.5;
      }

      .me-guide__arrows {
        display: none;
      }

      .me-guide__tab:focus-visible,
      .me-guide__arrow:focus-visible {
        outline: 2px solid #E0004D;
        outline-offset: 4px;
      }

      /* 动画只作用于卡片内部，不影响 Swiper 的位移 */
      .me-guide.appear .me-guide__title {
        animation: me-guide-title .9s cubic-bezier(.22, 1, .36, 1) both;
      }

      .me-guide.appear .me-guide__panel.is-active .me-guide__card {
        animation:
          me-guide-card .8s cubic-bezier(.22, 1, .36, 1) var(--card-delay, 0ms) both;
      }

      @keyframes me-guide-title {
        from {
          opacity: 0;
          transform: translateY(24px);
          filter: blur(5px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @keyframes me-guide-card {
        from {
          opacity: 0;
          transform: perspective(1000px) translateY(36px) rotateX(5deg);
        }

        to {
          opacity: 1;
          transform: perspective(1000px) translateY(0) rotateX(0);
        }
      }

      @media (hover: hover) and (pointer: fine) {
        .me-guide__card:hover .me-guide__picture img {
          transform: scale(1.045);
        }

        .me-guide__tab:hover {
          color: #190A0A;
        }
      }

      /* 768–1450：主要尺寸 × 0.8，四舍五入 */
      @media (min-width: 768px) and (max-width: 1450px) {
        .me-guide {
          padding: 72px 0;
        }

        .me-guide__container {
          width: calc(100% - 52px);
          max-width: 1216px;
        }

        .me-guide__title {
          font-size: 35px;
        }

        .me-guide__tabs {
          width: 291px;
          margin: 38px auto 51px;
        }

        .me-guide__tab {
          padding: 8px 0 10px;
          font-size: 16px;
        }

        .me-guide__grid {
          gap: 16px;
        }

        .me-guide__picture {
          border-radius: 5px;
        }

        .me-guide__card h3 {
          margin-top: 19px;
          font-size: 18px;
        }

        .me-guide__description {
          margin-top: 8px;
          font-size: 13px;
        }

        .me-guide__note {
          margin-top: 18px;
          font-size: 8px;
        }
      }

      @media (max-width: 767px) {
        .me-guide {
          padding: 60px 0 40px;
        }

        .me-guide__container {
          width: calc(100% - 32px);
        }

        .me-guide__title {
          max-width: 280px;
          margin: 0 auto;
          font-size: 24px;
          line-height: 1.2;
        }

        .me-guide__tabs {
          width: 264px;
          margin: 24px auto;
        }

        .me-guide__tab {
          padding: 8px 0 10px;
          font-size: 14px;
        }

        .me-guide__grid,
        .me-guide__panel--tips .me-guide__grid {
          display: flex;
          gap: 0;
        }

        .me-guide__slide {
          flex-shrink: 0;
          /* 初始化之前也保留下一张卡片的预览 */
          width: calc((100% - 2px) / 1.125);
        }

        .me-guide__picture,
        .me-guide__panel--tips .me-guide__picture {
          aspect-ratio: 1;
          border-radius: 4px;
        }

        .me-guide__card h3 {
          margin-top: 18px;
          font-size: 18px;
          line-height: 1.25;
        }

        .me-guide__description {
          margin-top: 8px;
          font-size: 12px;
          line-height: 1.2;
        }

        .me-guide__arrows {
          display: flex;
          justify-content: flex-end;
          align-items: center;
          gap: 16px;
          margin-top: 28px;
          padding-right: 34px;
        }

        .me-guide__arrow {
          display: grid;
          place-items: center;
          width: 34px;
          height: 40px;
          padding: 0;
          border: 0;
          background: transparent;
          color: #190A0A;
          cursor: pointer;
          transition: opacity .3s, transform .3s;
          -webkit-tap-highlight-color: transparent;
        }

        .me-guide__arrow svg {
          display: block;
          width: 26px;
          height: 22px;
        }

        .me-guide__arrow:active {
          transform: scale(.88);
        }

        .me-guide__arrow.swiper-button-disabled {
          opacity: .25;
          cursor: default;
        }

        .me-guide__arrow.swiper-button-lock {
          display: none;
        }

        .me-guide__note {
          margin: 24px 6px 0;
          color: #757575;
          font-size: 10px;
          line-height: 1.5;
        }
      }

      @media (prefers-reduced-motion: reduce) {

        .me-guide *,
        .me-guide *::after {
          animation: none !important;
          transition: none !important;
        }
      }
{% endstyle %}

<section class="me-guide js-me-top">
  <div class="me-guide__container">
    <h2 class="me-guide__title">{{ section.settings.heading | escape }}</h2>

    <div class="me-guide__tabs" role="tablist" aria-label="Product instructions">
      <button class="me-guide__tab" type="button" role="tab" aria-selected="true" tabindex="0">{{ section.settings.steps_tab | escape }}</button>
      <button class="me-guide__tab" type="button" role="tab" aria-selected="false" tabindex="-1">{{ section.settings.tips_tab | escape }}</button>
    </div>

    <div class="me-guide__panel is-active" role="tabpanel">
      <custom-swiper-me disable-on="desktop" mobile-breakpoint="767" slides-per-view="1.125" slides-per-group="1" space-between="16" speed="550" loop="false" centered-slides="false" watch-overflow="true" navigation="true" pagination="false">
        <div class="me-guide__slider swiper-container">
          <div class="me-guide__grid swiper-wrapper">
            {% for block in section.blocks %}
              {% if block.settings.group == 'steps' %}
                <article class="me-guide__slide swiper-slide" style="--card-delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
                  <div class="me-guide__card">
                    <div class="me-guide__picture">
                      {% if block.settings.image != blank %}
                        <img src="{{ block.settings.image | image_url: width: 1800 }}" loading="lazy" alt="{{ block.settings.image.alt | escape }}">
                      {% endif %}
                    </div>
                    {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
                    {% if block.settings.description != blank %}<p class="me-guide__description">{{ block.settings.description | escape | newline_to_br }}</p>{% endif %}
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="me-guide__arrows">
          <button class="me-guide__arrow" data-swiper-prev type="button" aria-label="Previous slide">
            <svg viewBox="0 0 28 24" fill="none" aria-hidden="true">
              <path d="M26 12H3M11 3l-9 9 9 9" stroke="currentColor" stroke-width="1" />
            </svg>
          </button>
          <button class="me-guide__arrow" data-swiper-next type="button" aria-label="Next slide">
            <svg viewBox="0 0 28 24" fill="none" aria-hidden="true">
              <path d="M2 12h23M17 3l9 9-9 9" stroke="currentColor" stroke-width="1" />
            </svg>
          </button>
        </div>
      </custom-swiper-me>
      {% if section.settings.steps_note != blank %}<p class="me-guide__note">{{ section.settings.steps_note | escape }}</p>{% endif %}
    </div>

    <div class="me-guide__panel me-guide__panel--tips" role="tabpanel" hidden>
      <custom-swiper-me disable-on="desktop" mobile-breakpoint="767" slides-per-view="1.125" slides-per-group="1" space-between="16" speed="550" loop="false" centered-slides="false" watch-overflow="true" navigation="true" pagination="false">
        <div class="me-guide__slider swiper-container">
          <div class="me-guide__grid swiper-wrapper">
            {% for block in section.blocks %}
              {% if block.settings.group == 'tips' %}
                <article class="me-guide__slide swiper-slide" style="--card-delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
                  <div class="me-guide__card">
                    <div class="me-guide__picture">
                      {% if block.settings.image != blank %}
                        <img src="{{ block.settings.image | image_url: width: 1800 }}" loading="lazy" alt="{{ block.settings.image.alt | escape }}">
                      {% endif %}
                    </div>
                    {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
                    {% if block.settings.description != blank %}<p class="me-guide__description">{{ block.settings.description | escape | newline_to_br }}</p>{% endif %}
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="me-guide__arrows">
          <button class="me-guide__arrow" data-swiper-prev type="button" aria-label="Previous slide">
            <svg viewBox="0 0 28 24" fill="none" aria-hidden="true">
              <path d="M26 12H3M11 3l-9 9 9 9" stroke="currentColor" stroke-width="1" />
            </svg>
          </button>
          <button class="me-guide__arrow" data-swiper-next type="button" aria-label="Next slide">
            <svg viewBox="0 0 28 24" fill="none" aria-hidden="true">
              <path d="M2 12h23M17 3l9 9-9 9" stroke="currentColor" stroke-width="1" />
            </svg>
          </button>
        </div>
      </custom-swiper-me>
    </div>
  </div>
</section>
<script>
  (() => {
    function initMeGuide() {
      document.querySelectorAll('.me-guide').forEach((root, rootIndex) => {
        if (root.dataset.guideInitialized) return;
        root.dataset.guideInitialized = 'true';

        const tablist = root.querySelector('.me-guide__tabs');
        const tabs = [...root.querySelectorAll('.me-guide__tab')];
        const panels = [...root.querySelectorAll('.me-guide__panel')];
        const prefix = `me-guide-${Date.now()}-${rootIndex}`;
        let activeIndex = 0;

        tabs.forEach((tab, index) => {
          tab.id = `${prefix}-tab-${index}`;
          tab.setAttribute('aria-controls', `${prefix}-panel-${index}`);

          panels[index].id = `${prefix}-panel-${index}`;
          panels[index].setAttribute('aria-labelledby', tab.id);
        });

        function refreshPanel(panel) {
          const carousel = panel.querySelector('custom-swiper-me');
          if (!carousel) return;

          customElements.whenDefined('custom-swiper-me').then(() => {
            requestAnimationFrame(() => {
              if (!root.isConnected || panel.hidden) return;
              carousel.refresh();
            });
          });
        }

        function activate(index, moveFocus = false) {
          if (index === activeIndex) {
            if (moveFocus) tabs[index].focus();
            return;
          }

          activeIndex = index;
          tablist.style.setProperty('--tab-index', index);

          tabs.forEach((tab, i) => {
            const selected = i === index;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;

            panels[i].hidden = !selected;
            panels[i].classList.toggle('is-active', selected);
          });

          if (moveFocus) tabs[index].focus();
          refreshPanel(panels[index]);
        }

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => activate(index));
        });

        tablist.addEventListener('keydown', (event) => {
          let nextIndex = activeIndex;

          switch (event.key) {
            case 'ArrowRight':
              nextIndex = (activeIndex + 1) % tabs.length;
              break;
            case 'ArrowLeft':
              nextIndex = (activeIndex - 1 + tabs.length) % tabs.length;
              break;
            case 'Home':
              nextIndex = 0;
              break;
            case 'End':
              nextIndex = tabs.length - 1;
              break;
            default:
              return;
          }

          event.preventDefault();
          activate(nextIndex, true);
        });

        refreshPanel(panels[0]);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMeGuide, { once: true });
    } else {
      initMeGuide();
    }
  })();
</script>
{% schema %}
{
  "name": "Me Product Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Easy to Use Easy to Use Easy to Use"
    },
    {
      "type": "text",
      "id": "steps_tab",
      "label": "Steps tab label",
      "default": "Easy to Use"
    },
    {
      "type": "text",
      "id": "tips_tab",
      "label": "Tips tab label",
      "default": "Usage Tips"
    },
    {
      "type": "textarea",
      "id": "steps_note",
      "label": "Steps note",
      "default": "These steps are simplified usage guidance. Some operational details are not included. Please refer to the user manual for full operating instructions."
    }
  ],
  "max_blocks": 30,
  "blocks": [
    {
      "type": "guide_slide",
      "name": "Guide slide",
      "settings": [
        {
          "type": "select",
          "id": "group",
          "label": "Panel",
          "options": [
            {
              "value": "steps",
              "label": "Easy to Use"
            },
            {
              "value": "tips",
              "label": "Usage Tips"
            }
          ],
          "default": "steps"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Guide title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Me Product Guide",
      "blocks": [
        {
          "type": "guide_slide",
          "settings": {
            "group": "steps",
            "title": "1. Prepare",
            "description": "Shave the treatment area."
          }
        },
        {
          "type": "guide_slide",
          "settings": {
            "group": "steps",
            "title": "2. Plug In",
            "description": "Connect the device to power."
          }
        },
        {
          "type": "guide_slide",
          "settings": {
            "group": "steps",
            "title": "3. Power On & Select Mode",
            "description": "Turn on the device and choose a mode."
          }
        },
        {
          "type": "guide_slide",
          "settings": {
            "group": "steps",
            "title": "4. Start",
            "description": "Place it on your skin and press the flash button."
          }
        },
        {
          "type": "guide_slide",
          "settings": {
