<script>
  (() => {
    function initMeGuide() {
      document.querySelectorAll('.me-guide').forEach((root, rootIndex) => {
        if (root.dataset.guideInitialized) return;
        root.dataset.guideInitialized = 'true';

        const tablist = root.querySelector('.me-guide__tabs');
        const tabs = [...root.querySelectorAll('.me-guide__tab')];
        const panels = [...root.querySelectorAll('.me-guide__panel')];
        const prefix = `me-guide-${Date.now()}-${rootIndex}`;
        let activeIndex = 0;

        tabs.forEach((tab, index) => {
          tab.id = `${prefix}-tab-${index}`;
          tab.setAttribute('aria-controls', `${prefix}-panel-${index}`);

          panels[index].id = `${prefix}-panel-${index}`;
          panels[index].setAttribute('aria-labelledby', tab.id);
        });

        function refreshPanel(panel) {
          const carousel = panel.querySelector('custom-swiper-me');
          if (!carousel) return;

          customElements.whenDefined('custom-swiper-me').then(() => {
            requestAnimationFrame(() => {
              if (!root.isConnected || panel.hidden) return;
              carousel.refresh();
            });
          });
        }

        function activate(index, moveFocus = false) {
          if (index === activeIndex) {
            if (moveFocus) tabs[index].focus();
            return;
          }

          activeIndex = index;
          tablist.style.setProperty('--tab-index', index);

          tabs.forEach((tab, i) => {
            const selected = i === index;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;

            panels[i].hidden = !selected;
            panels[i].classList.toggle('is-active', selected);
          });

          if (moveFocus) tabs[index].focus();
          refreshPanel(panels[index]);
        }

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => activate(index));
        });

        tablist.addEventListener('keydown', (event) => {
          let nextIndex = activeIndex;

          switch (event.key) {
            case 'ArrowRight':
              nextIndex = (activeIndex + 1) % tabs.length;
              break;
            case 'ArrowLeft':
              nextIndex = (activeIndex - 1 + tabs.length) % tabs.length;
              break;
            case 'Home':
              nextIndex = 0;
              break;
            case 'End':
              nextIndex = tabs.length - 1;
              break;
            default:
              return;
          }

          event.preventDefault();
          activate(nextIndex, true);
        });

        refreshPanel(panels[0]);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMeGuide, { once: true });
    } else {
      initMeGuide();
    }
  })();
</script>
