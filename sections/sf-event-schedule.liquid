<script>
  window.addEventListener('load', function () {
    var root = document.getElementById('sf-es-{{ sid }}');
    if (!root) return;

    // Real-time progress for the 2-point timeline (no refresh needed)
    (function () {
      var firstTs = Number(root.getAttribute('data-first-ts') || 0);
      var lastTs = Number(root.getAttribute('data-last-ts') || 0);
      if (!firstTs || !lastTs || lastTs <= firstTs) return;

      var line = root.querySelector('.sf-es__line');

      function setProgress(pct) {
        pct = Math.max(0, Math.min(100, pct));
        root.style.setProperty('--sf-es-progress', pct + '%');
        if (line) line.setAttribute('data-zero', pct === 0 ? '1' : '0');
      }

      function tick() {
        var now = Date.now() / 1000;
        var pct;
        if (now <= firstTs) pct = 0;
        else if (now >= lastTs) pct = 100;
        else pct = ((now - firstTs) / (lastTs - firstTs)) * 100;
        setProgress(pct);
      }

      tick();
      setInterval(tick, 1000);
    })();

    var successText = root.getAttribute('data-success-text') || 'Subscription successful!';

    function validateEmail(v) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v || '').trim());
    }

    function show(msg, type, text) {
      if (!msg) return;
      msg.hidden = false;
      msg.className = 'sf-es-msg ' + (type === 'success' ? 'is-success' : 'is-error');
      msg.textContent = text;
    }

    function clear(msg) {
      if (!msg) return;
      msg.hidden = true;
      msg.textContent = '';
      msg.className = 'sf-es-msg';
    }

    var MSG = window.ULIKE_MESSAGES || {};

    root.querySelectorAll('[data-sf-es-subscribe]').forEach(function (subRoot) {
      var form = subRoot.querySelector('form');
      var email = subRoot.querySelector('[data-sf-es-email]');
      var consent = subRoot.querySelector('[data-sf-es-consent]');
      var msg = subRoot.querySelector('[data-sf-es-msg]');
      var submitBtn = subRoot.querySelector('[data-sf-es-submit]');
      if (!form) return;

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        clear(msg);

        var v = ((email && email.value) || '').trim();

        if (!v) {
          email && email.focus();
          return show(msg, 'error', MSG.email_empty || '{{ st.error_empty | escape }}');
        }
        if (!validateEmail(v)) {
          email && email.focus();
          return show(msg, 'error', MSG.email_invalid || '{{ st.error_email | escape }}');
        }
        if (consent && !consent.checked) {
          return show(msg, 'error', MSG.consent_required || '{{ st.error_consent | escape }}');
        }

        // Call the same subscribe API used by sf-banner
        if (typeof window.subscriptionApiNew !== 'function') {
          return show(msg, 'error', MSG.default_error || 'Subscription service is unavailable.');
        }

        // loading state
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.classList.add('is-loading');
        }

        window
          .subscriptionApiNew(v, 'spring_festival', 'USER_SUBSCRIBE')
          .then(function (res) {
            // Compatible with your sf-banner return shape
            if (res && res.code === 0) {
              show(msg, 'success', successText);
              // keep value by default (same as banner). If you want clear, uncomment:
              // form.reset();
            } else {
              var key = res && res.message ? res.message : '';
              var errText = key && MSG[key] ? MSG[key] : MSG.default_error || '{{ st.error_email | escape }}';
              show(msg, 'error', errText);
            }
          })
          .catch(function (err) {
            console.error(err);
            show(msg, 'error', MSG.default_error || 'Something went wrong. Please try again.');
          })
          .finally(function () {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.classList.remove('is-loading');
            }
          });
      });
    });
  });
</script>

