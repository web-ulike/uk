
{%- liquid
  assign sid = section.id
  assign st = section.settings
  assign blocks = section.blocks
  assign n = blocks.size

  assign now_s = 'now' | date: '%s' | plus: 0
  assign active_index = 0

  if st.auto_by_time and n > 0
    for b in blocks
      assign ts = b.settings.start_at | date: '%s' | plus: 0
      if ts != 0 and now_s >= ts
        assign active_index = forloop.index0
      endif
    endfor
  else
    assign active_index = st.current_step | default: 0 | times: 1
  endif

  if active_index < 0
    assign active_index = 0
  endif

  assign max_index = 0
  if n > 0
    assign max_index = n | minus: 1
  endif
  if n > 0 and active_index > max_index
    assign active_index = n | minus: 1
  endif

  assign progress = 0
  assign first_ts = 0
  assign last_ts = 0

  if n > 1
    assign first_ts = blocks[0].settings.start_at | date: '%s' | plus: 0
    assign last_ts  = blocks[1].settings.start_at | date: '%s' | plus: 0

    if first_ts != 0 and last_ts != 0 and last_ts > first_ts
      if now_s <= first_ts
        assign progress = 0
      elsif now_s >= last_ts
        assign progress = 100
      else
        assign elapsed = now_s | minus: first_ts
        assign total   = last_ts | minus: first_ts
        assign progress = elapsed | times: 100 | divided_by: total
      endif
    endif
  endif

  if progress < 0
    assign progress = 0
  endif
  if progress > 100
    assign progress = 100
  endif
-%}

<section
  id="sf-es-{{ sid }}"
  class="sf-es"
  data-first-ts="{{ first_ts }}"
  data-last-ts="{{ last_ts }}"
  {% if st.bg_image_pc != blank or st.bg_image_mobile != blank %}data-has-bg-image="1"{% endif %}
  style="
    --sf-es-accent: {{ st.accent }};
    --sf-es-text: {{ st.text_color }};
    --sf-es-muted: {{ st.muted_color }};
    --sf-es-bg: {{ st.background }};
    --sf-es-card: {{ st.card_bg }};
    --sf-es-bg-image-pc: url('{{ st.bg_image_pc | image_url: width: 2400 }}');
    --sf-es-bg-image-mobile: url('{{ st.bg_image_mobile | image_url: width: 1600 }}');
    --sf-es-radius: {{ st.radius }}px;
    --sf-es-progress: {{ progress }}%;
  "
  data-success-text="{{ st.success_text | escape }}"
>
  <div class="sf-es__inner container">
    <!-- Top schedule -->
    <div class="sf-es__schedule">
      <div class="sf-es__schedule-title">
        {%- if st.schedule_title_img_mobile != blank or st.schedule_title_img_pc != blank -%}
          <picture class="sf-es__title-img" aria-hidden="true">
            {%- if st.schedule_title_img_mobile != blank -%}
              <source
                media="(max-width: 768px)"
                srcset="
                  {{ st.schedule_title_img_mobile | image_url: width: 480 }} 480w,
                  {{ st.schedule_title_img_mobile | image_url: width: 720 }} 720w,
                  {{ st.schedule_title_img_mobile | image_url: width: 960 }} 960w
                "
                sizes="(max-width: 768px) 60vw, 1px"
              >
            {%- endif -%}

            {%- if st.schedule_title_img_pc != blank -%}
              <source
                media="(min-width: 769px)"
                srcset="
                  {{ st.schedule_title_img_pc | image_url: width: 520 }} 520w,
                  {{ st.schedule_title_img_pc | image_url: width: 780 }} 780w,
                  {{ st.schedule_title_img_pc | image_url: width: 1040 }} 1040w
                "
                sizes="240px"
              >
            {%- endif -%}

            {%- assign fallback_img = st.schedule_title_img_pc | default: st.schedule_title_img_mobile -%}
            <img
              class="sf-es__title-img-el"
              src="{{ fallback_img | image_url: width: 1040 }}"
              alt=""
              loading="lazy"
              width="1040"
              height="{{ 1040 | divided_by: fallback_img.aspect_ratio | round }}"
            >
          </picture>
        {%- endif -%}
      </div>

      {%- if n > 0 -%}
        {%- assign first = blocks.first -%}
        {%- assign last = blocks.last -%}

        <div class="sf-es__timeline-wrap">
          {%- if st.timeline_star_top_left != blank -%}
            <img
              class="sf-es__timeline-star sf-es__timeline-star--top-left"
              src="{{ st.timeline_star_top_left | image_url: width: 120 }}"
              alt=""
              loading="lazy"
              width="120"
              height="{{ 120 | divided_by: st.timeline_star_top_left.aspect_ratio | round }}"
            >
          {%- endif -%}

          <div class="sf-es__timeline" aria-label="Event timeline">
          <div class="sf-es__time-col sf-es__time-col--left">
            <div class="sf-es__date">{{ first.settings.date_top }}</div>
            {%- assign first_bottom = first.settings.date_bottom | replace: '/', '' | strip -%}
            <div class="sf-es__date-sub">
              <span class="sf-es__slash" aria-hidden="true">/</span>
              <span class="sf-es__bottom">{{ first_bottom }}</span>
            </div>
            <div class="sf-es__label">{{ first.settings.label }}</div>
          </div>

          <div class="sf-es__line" aria-hidden="true" data-zero="{% if progress == 0 %}1{% else %}0{% endif %}">
            <span class="sf-es__line-base"></span>
            <span class="sf-es__line-fill"></span>
          </div>

          <div class="sf-es__time-col sf-es__time-col--right">
            <div class="sf-es__date">{{ last.settings.date_top }}</div>
            {%- assign last_bottom = last.settings.date_bottom | replace: '/', '' | strip -%}
            <div class="sf-es__date-sub">
              <span class="sf-es__slash" aria-hidden="true">/</span>
              <span class="sf-es__bottom">{{ last_bottom }}</span>
            </div>
            <div class="sf-es__label">{{ last.settings.label }}</div>
          </div>
          </div>

          {%- if st.timeline_star_bottom_right != blank -%}
            <img
              class="sf-es__timeline-star sf-es__timeline-star--bottom-right"
              src="{{ st.timeline_star_bottom_right | image_url: width: 120 }}"
              alt=""
              loading="lazy"
              width="120"
              height="{{ 120 | divided_by: st.timeline_star_bottom_right.aspect_ratio | round }}"
            >
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Cards -->
    <div class="sf-es__cards">
      <!-- Card 1 -->
      <div class="sf-es-card sf-es-card--gift">
        <div class="sf-es-card__media" aria-hidden="true">
          {%- if st.card1_image != blank -%}
            <img
              src="{{ st.card1_image | image_url: width: 900 }}"
              alt=""
              loading="lazy"
              width="900"
              height="{{ 900 | divided_by: st.card1_image.aspect_ratio | round }}"
            >
          {%- endif -%}
        </div>

        <div class="sf-es-card__body">
          {%- if st.card1_title != blank -%}
            <div class="sf-es-card__title">{{ st.card1_title }}</div>
          {%- endif -%}

          {%- if st.card1_text != blank -%}
            <div class="sf-es-card__text">{{ st.card1_text }}</div>
          {%- endif -%}

          {%- if st.card1_note != blank -%}
            <div class="sf-es-card__note">{{ st.card1_note }}</div>
          {%- endif -%}

          {%- if st.card1_link != blank and st.card1_link_text != blank -%}
            <a
              class="sf-es-card__link"
              href="{{ st.card1_link }}"
              {% if st.open_new %}
                target="_blank" rel="noopener"
              {% endif %}
            >
              {{ st.card1_link_text }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Card 2 -->
      <div class="sf-es-card sf-es-card--sub" data-sf-es-subscribe>
        <div class="sf-es-card__body">
          {%- if st.card2_title != blank -%}
            <div class="sf-es-card__title">{{ st.card2_title }}</div>
          {%- endif -%}

          {%- if st.card2_text != blank -%}
            <div class="sf-es-card__text sf-es-card__text--desktop">{{ st.card2_text }}</div>
          {%- endif -%}

          {%- if st.card2_note != blank -%}
            <div class="sf-es-card__note sf-es-card__note--desktop">{{ st.card2_note }}</div>
          {%- endif -%}

          <form class="sf-es-form" novalidate>
            <div class="sf-es-form__row">
              <input
                class="sf-es-input"
                type="email"
                name="email"
                placeholder="{{ st.email_placeholder }}"
                autocomplete="email"
                data-sf-es-email
              >
            </div>

            <label class="sf-es-consent">
              <input type="checkbox" data-sf-es-consent>
              <span>{{ st.consent_html }}</span>
            </label>

            <button class="sf-es-btn" type="submit" data-sf-es-submit>
              {{ st.button_text }}
            </button>

            <div class="sf-es-msg" hidden data-sf-es-msg></div>
          </form>
        </div>

        <div class="sf-es-card__media" aria-hidden="true">
          {%- if st.card2_image != blank or st.card2_image_mobile != blank -%}
            {%- assign card2_fallback_image = st.card2_image | default: st.card2_image_mobile -%}
            <picture class="sf-es-card__picture">
              {%- if st.card2_image_mobile != blank -%}
                <source
                  media="(max-width: 768px)"
                  srcset="{{ st.card2_image_mobile | image_url: width: 700 }}"
                >
              {%- endif -%}
              {%- if st.card2_image != blank -%}
                <source
                  media="(min-width: 769px)"
                  srcset="{{ st.card2_image | image_url: width: 900 }}"
                >
              {%- endif -%}
              <img
                src="{{ card2_fallback_image | image_url: width: 900 }}"
                alt=""
                loading="lazy"
                width="900"
                height="{{ 900 | divided_by: card2_fallback_image.aspect_ratio | round }}"
              >
            </picture>
          {%- endif -%}
        </div>
      </div>

      <div class="sf-es-signup" data-sf-es-subscribe>
        {%- if st.card1_title != blank -%}
          <h3 class="sf-es-signup__title">{{ st.card1_title }}</h3>
        {%- endif -%}

        {%- if st.card1_text != blank -%}
          <div class="sf-es-signup__desc">{{ st.card1_text }}</div>
        {%- endif -%}

        <form class="sf-es-form" novalidate>
          <div class="sf-es-form__row">
            <input
              class="sf-es-input"
              type="email"
              name="email"
              placeholder="{{ st.email_placeholder }}"
              autocomplete="email"
              data-sf-es-email
            >
          </div>

          <label class="sf-es-consent">
            <input type="checkbox" data-sf-es-consent>
            <span>{{ st.consent_html }}</span>
          </label>

          <button class="sf-es-btn" type="submit" data-sf-es-submit>
            {{ st.button_text }}
          </button>

          <div class="sf-es-msg" hidden data-sf-es-msg></div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  #sf-es-{{ sid }}{
    background: var(--sf-es-bg);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    color: var(--sf-es-text);
    padding: {{ st.padding_top }}px 0 {{ st.padding_bottom }}px;
  }

  #sf-es-{{ sid }}[data-has-bg-image="1"]{
    background-image: var(--sf-es-bg-image-pc);
  }

  /* schedule */
  #sf-es-{{ sid }} .sf-es__schedule{
    display: grid;
    grid-template-columns: 35% 1fr;
    align-items: start;
    column-gap: 20px;
    margin-bottom: 80px;
  }

  #sf-es-{{ sid }} .sf-es__schedule-title{
    line-height: 1.05;
  }

  /* legacy text title (fallback) */
  #sf-es-{{ sid }} .sf-es__title-pc{
    font-style: italic;
    letter-spacing: 0.2px;
    font-size: 44px;
  }
  #sf-es-{{ sid }} .sf-es__title-m{
    display: none;
    font-style: italic;
    letter-spacing: 0.2px;
    font-size: 36px;
  }

  /* image title */
  #sf-es-{{ sid }} .sf-es__title-img{
    display: block;
    width: 240px;
    max-width: 100%;
  }
  #sf-es-{{ sid }} .sf-es__title-img-el{
    display: block;
    width: 100%;
    height: auto;
  }

  #sf-es-{{ sid }} .sf-es__timeline-wrap{
    position: relative;
    width: 70%;
  }

  #sf-es-{{ sid }} .sf-es__timeline-star{
    position: absolute;
    display: block;
    width: 28px;
    height: auto;
    pointer-events: none;
  }

  #sf-es-{{ sid }} .sf-es__timeline-star--top-left{
    top: -10px;
    left: -40px;
  }

  #sf-es-{{ sid }} .sf-es__timeline-star--bottom-right{
    right: 30px;
    bottom: 38px;
  }

  #sf-es-{{ sid }} .sf-es__timeline{
    display: grid;
    grid-template-columns: 1fr 280px 1fr;
    align-items: start;
    gap: 0px;
    width: 100%;
  }

  #sf-es-{{ sid }} .sf-es__time-col{
    display: flex;
    flex-direction: column;
    align-items: center;
    align-items: flex-start;
    text-align: left;
  }

  /* Big date stack like the design: bold top number, slash+bottom number slightly smaller */
  #sf-es-{{ sid }} .sf-es__date{
    font-family: "Bodoni-Book";
    font-size: 60px;
    font-weight: 700;
    color: #1A1A1A;
    line-height: 1;
  }
  #sf-es-{{ sid }} .sf-es__date-sub{
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 6px;
  }
  #sf-es-{{ sid }} .sf-es__slash{
    font-family: "Bodoni-Book";
    font-size: 26px;
    line-height: 42px;
    font-weight: 700;
    text-align: left;
    padding-left: 34px;
    color: #1A1A1A;
  }
  #sf-es-{{ sid }} .sf-es__bottom{
    font-family: "Bodoni-Book";
    font-size: 60px;
    font-weight: 700;
    line-height: 1;
    color: #1A1A1A;
  }

  #sf-es-{{ sid }} .sf-es__label{
    margin-top: 10px;
    font-size: 22px;
    line-height: 1.25;
    color: #1A1A1A;
  }

  #sf-es-{{ sid }} .sf-es__line{
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    top: 34%;
    left: -20px;
    min-height: 2px;
  }
  #sf-es-{{ sid }} .sf-es__line-base{
    position: absolute;
    inset: 0;
    display: block;
    height: 2px;
    background: rgba(0,0,0,0.14);
    border-radius: 999px;
  }
  #sf-es-{{ sid }} .sf-es__line-fill{
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    height: 2px;
    width: var(--sf-es-progress);
    background: var(--sf-es-accent);
    border-radius: 999px;
  }
  #sf-es-{{ sid }} .sf-es__line-fill::after{
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translate(50%, -50%);
    width: 8px;
    height: 8px;
    border-radius: 999px;
    {% comment %} background: var(--sf-es-accent); {% endcomment %}
  }

  #sf-es-{{ sid }} .sf-es__line[data-zero="1"] .sf-es__line-fill::after{
    transform: translate(0, -50%);
  }

  /* heading */
  #sf-es-{{ sid }} .sf-es__heading{
    text-align: center;
    margin-bottom: 60px;
  }
  #sf-es-{{ sid }} .sf-es__h2{
    margin: 0;
    font-size: 56px;
    font-family: "Bodoni-Book";
    font-weight: 500;
    color: var(--sf-es-accent);
  }
  #sf-es-{{ sid }} .sf-es__desc{
    font-size: 18px;
    color: #3F3636;
  }

  /* cards */
  #sf-es-{{ sid }} .sf-es__cards{
    display: grid;
    grid-template-columns: minmax(260px, 32%) repeat(2, minmax(0, 1fr));
    gap: 20px 24px;
    align-items: end;
  }

  #sf-es-{{ sid }} .sf-es-signup{
    order: -1;
    grid-column: 1;
    align-self: end;
    max-width: 340px;
    padding-bottom: 66px;
  }
  #sf-es-{{ sid }} .sf-es-signup__title{
    margin: 0;
    font-family: "Bodoni-Book";
    font-size: 28px;
    font-weight: 500;
    line-height: 1.08;
    color: #1A1A1A;
  }
  #sf-es-{{ sid }} .sf-es-signup__desc{
    margin-top: 8px;
    color: #1A1A1A;
    font-size: 12px;
    line-height: 1.35;
  }

  #sf-es-{{ sid }} .sf-es-card{
    grid-column: auto;
    min-width: 0;
    display: flex;
    flex-direction: column-reverse;
    gap: 12px;
    background: transparent;
    border-radius: 0;
    padding: 0;
    overflow: visible;
  }
  #sf-es-{{ sid }} .sf-es-card--gift{
    flex-direction: column;
    gap: 14px;
  }
  #sf-es-{{ sid }} .sf-es-card--sub .sf-es-form{
    display: none;
  }

  #sf-es-{{ sid }} .sf-es-card__title{
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 7px;
    color: #1A1A1A;
  }
  #sf-es-{{ sid }} .sf-es-card__text{
    color: #1A1A1A;
    font-size: 10px;
    line-height: 1.38;
  }
  #sf-es-{{ sid }} .sf-es-card__note{
    margin-top: 0;
    font-size: 10px;
    line-height: 1.38;
    color: #1A1A1A;
  }

  #sf-es-{{ sid }} .sf-es-card__link{
    display: inline-flex;
    margin-top: 10px;
    font-size: 12px;
    color: var(--sf-es-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #sf-es-{{ sid }} .sf-es-card__media{
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    aspect-ratio: 1.24 / 1;
    border-radius: var(--sf-es-radius);
    background: var(--sf-es-card);
    overflow: hidden;
  }
  #sf-es-{{ sid }} .sf-es-card--gift .sf-es-card__media{
    padding: 20px 24px;
  }
  #sf-es-{{ sid }} .sf-es-card__body{
    min-width: 0;
    padding-bottom: 4px;
  }
  #sf-es-{{ sid }} .sf-es-card--gift .sf-es-card__body{
    padding-bottom: 0;
  }
  #sf-es-{{ sid }} .sf-es-card__picture{
    display: block;
    width: 100%;
    line-height: 0;
  }

  #sf-es-{{ sid }} .sf-es-card__media img{
    width: 100%;
    height: auto;
    display: block;
    max-height: 100%;
    object-fit: contain;
  }
  #sf-es-{{ sid }} .sf-es-card--gift .sf-es-card__media img{
    width: 86%;
    max-width: 220px;
  }

  /* form */
  #sf-es-{{ sid }} .sf-es-form{
    margin-top: 16px;
  }
  #sf-es-{{ sid }} .sf-es-input{
    width: 100%;
    height: 28px;
    border-radius: 0;
    border: 1px solid #909090;
    background: #fff;
    color: #3F3636;
    padding: 7px 16px;
    font-size: 11px;
    outline: none;
    margin-top: 0;
  }
  #sf-es-{{ sid }} .sf-es-input:focus{
    border-color: rgba(0,0,0,0.35);
  }

  #sf-es-{{ sid }} .sf-es-consent{
    display: flex;
    gap: 4px;
    align-items: flex-start;
    margin-top: 8px;
    font-size: 7px;
    color: rgba(0,0,0,0.55);
    line-height: 1.35;
    user-select: none;
  }
  #sf-es-{{ sid }} .sf-es-consent span{
    color: inherit;
  }
  #sf-es-{{ sid }} .sf-es-consent a{
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  #sf-es-{{ sid }} .sf-es-consent input{
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    margin: 1px 0 0;
  }

  #sf-es-{{ sid }} .sf-es-btn{
    margin-top: 10px;
    min-width: 110px;
    height: 28px;
    border: 0;
    color: #fff;
    font-size: 10px;
    font-weight: 500;
    cursor: pointer;
    text-align: center;
    border-radius: 0;
    padding: 0 20px;
    background: linear-gradient(180deg, #E0024D -25%, #E0024D -21.4%, #FF7595 125%);
  }

  #sf-es-{{ sid }} .sf-es-msg{
    margin-top: 10px;
    font-size: 12px;
    line-height: 1.35;
  }
  #sf-es-{{ sid }} .sf-es-msg.is-error{ color: #E0024D; }
  #sf-es-{{ sid }} .sf-es-msg.is-success{ color: #1b7f3a; }

  /* responsive */
  @media (max-width: 989px){

  }

  @media (max-width: 768px){
    #sf-es-{{ sid }}[data-has-bg-image="1"]{
      background-image: var(--sf-es-bg-image-mobile);
    }
    #sf-es-{{ sid }}{
      padding: {{ st.mobile_padding_top }}px 0 {{ st.mobile_padding_bottom }}px;
    }
    #sf-es-{{ sid }} .sf-es__schedule{
      grid-template-columns: 1fr;
      row-gap: 24px;
      margin-bottom: 40px;
    }
    #sf-es-{{ sid }} .sf-es__time-col{
      align-items: center;
    }
    #sf-es-{{ sid }} .sf-es__line{
      left: 0px;
    }

    #sf-es-{{ sid }} .sf-es__title-pc{ display:none; }
    #sf-es-{{ sid }} .sf-es__title-m{ display:block; }
    #sf-es-{{ sid }} .sf-es__title-img{
      width: 200px;
      margin: 0 auto;
    }

    #sf-es-{{ sid }} .sf-es__timeline-wrap{
      width: 100%;
    }

    #sf-es-{{ sid }} .sf-es__timeline{
      grid-template-columns: 1fr 140px 1fr;
      width: 100%;
      padding: 0px 10px 0px;
    }

    #sf-es-{{ sid }} .sf-es__timeline-star{
      display: none;
    }
    #sf-es-{{ sid }} .sf-es__date{ font-size: 32px; }
    #sf-es-{{ sid }} .sf-es__date-sub{ margin-top: 4px; }
    #sf-es-{{ sid }} .sf-es__slash{ 
      padding-left: 0px;
      text-align: center;
      line-height: 30px;
      font-size: 18px;
    }
    #sf-es-{{ sid }} .sf-es__bottom{ font-size: 32px; }
    #sf-es-{{ sid }} .sf-es__label{ max-width: 160px; margin-top: 10px; font-size: 12px; }

