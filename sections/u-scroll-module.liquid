{%- liquid
  assign se_stts = section.settings
  assign se_bks = section.blocks
-%}

<style>
  .u-scroll-module {
    font-family: 'Saans', sans-serif;
    position: relative;
    background: #F9F9F9;
    min-height: 120vh; /* 外层负责滚动长度 */
    overflow: clip;
  }

  .u-scroll-module .card-container {
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 15vh 0 0;
  }

  .u-scroll-module .card { position: relative; height: 140%; }

  .u-scroll-module .card-text {
    position: absolute;
    top: 5vh;
    left: 50%;
    transform: translateX(-50%);
    width: min(1200px, 86vw);
    text-align: center;
    font-size: clamp(22px, 3.2vw, 44px);
    line-height: 1.5;
    height: 50vh;
    z-index: 1; /* 低于图片 */
    pointer-events: none;
  }

  .u-scroll-module .card-text .sentence {
    display: inline;
    color: rgba(0, 0, 0, 0.20);
    background-clip: text;
    -webkit-background-clip: text;
    background-size: var(--num-backgroundSize, 0%) 100%;
    background-repeat: no-repeat;
    background-image: linear-gradient(90deg, #E0004D, #E0004D);
  }

  .u-scroll-module .image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
    padding-top: 10vh;
  }

  .u-scroll-module .card-image {
    width: 24%;
    max-width: 420px;
    padding: 10px;
    background: #ac3a42;
    color: #fff;
    border-radius: 10px;
    will-change: transform;
    transform: translate3d(0, 18vh, 0) rotate(0deg) scale(1);
  }

  .u-scroll-module .card-image:nth-child(even) {
    background-color: #ffe0e9;
    color: #000;
  }

  .u-scroll-module .card-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .u-scroll-module .card-image .name {
    font-size: 16px;
    font-weight: 500;
    line-height: 150%;
    margin-top: 10px;
  }

  .u-scroll-module .card-image__inner {
    width: 100%;
    height: 100%;
    will-change: transform;
  }

  @media (max-width: 768px) {
    .u-scroll-module {
      min-height: 100vh;
      overflow: clip;
    }

    .u-scroll-module .card-container {
      padding-top: 0vh;
      height: 100%;
    }

    .u-scroll-module .card {
      position: relative;
      height: 100vh;
    }

    .u-scroll-module .card-text {
      top: 18vh;
      height: 100%;
      z-index: 1;
    }

    .u-scroll-module .image-wrapper {
      position: absolute;
      inset: 0;
      z-index: 5;
      pointer-events: none;
      display: block;
      padding-top: 0;
    }

    .u-scroll-module .card-image {
      position: absolute;
      width: 180px;
      max-width: none;
      transform: none;
      transform-origin: 50% 50%;
      will-change: transform;
      backface-visibility: hidden;
    }

    .u-scroll-module .card-image__inner {
      width: 100%;
      height: 100%;
      will-change: transform;
    }

    /* 仅支持最多 5 张（schema 里也限制了 max_blocks=5） */
  .u-scroll-module .card-image:nth-child(1) { left: 0vw;  top: 40vh; z-index: 2; }
  .u-scroll-module .card-image:nth-child(2) { left: 28vw; top: 32vh; z-index: 3; }
  .u-scroll-module .card-image:nth-child(3) { left: 65vw; top: 40vh; z-index: 3; }
  .u-scroll-module .card-image:nth-child(4) { left: 10vw; top: 58vh; z-index: 4; }
  .u-scroll-module .card-image:nth-child(5) { left: 46vw; top: 70vh; z-index: 4; }

    .u-scroll-module .card-image .name {
      font-size: 10px;
      line-height: 1.2;
    }
  }
</style>

<div class="u-scroll-module" data-scroll-module>
  <div class="card-container">
    <div class="card">
      <div class="card-text" style="--num-backgroundSize: 0%;">
        <span class="sentence">
          {{ se_stts.title }}
          <br />
          {{ se_stts.desc }}
        </span>
      </div>

      <div class="image-wrapper">
        {%- for block in se_bks -%}
          {%- if block.type == 'item' -%}
            {%- assign img = block.settings.image -%}
            <div class="card-image" {{ block.shopify_attributes }}>
              <div class="card-image__inner">
                {%- if img != blank -%}
                  <picture>
                    <source
                      media="(max-width: 768px)"
                      srcset="{{ img | image_url: width: 400 }}"
                    >
                    <img
                      class="image"
                      loading="lazy"
                      decoding="async"
                      alt="{{ img.alt | escape }}"
                      src="{{ img | image_url: width: 800 }}"
                    >
                  </picture>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <div class="name">{{ block.settings.title }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'u-scroll-module.all.js' | asset_url }}" async></script>

{% schema %}
{
  "name": "u-scroll-module",
  "max_blocks": 5,
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "标题"
    },
    {
      "type": "html",
      "id": "desc",
      "label": "标题2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "标题",
          "default": "1st Prize"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "u-scroll-module",
      "blocks": []
    }
  ]
}
{% endschema %}