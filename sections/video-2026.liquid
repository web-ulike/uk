<style>
  #shopify-section-{{ section.id }} .video-2026 {
    position: relative;
    z-index: 0;
    height: 100vh;
    min-height: 640px;
    overflow: hidden;
    background: #000;
  }

  #shopify-section-{{ section.id }} .video-2026::before {
    position: absolute;
    content: '';
    display: block;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 2;
    background: rgba(0, 0, 0, 0.12);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  #shopify-section-{{ section.id }} .video-2026__poster,
  #shopify-section-{{ section.id }} .video-2026__video {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .video-2026__poster {
    z-index: 1;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  #shopify-section-{{ section.id }} .video-2026__poster--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .video-2026__video {
    z-index: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  #shopify-section-{{ section.id }} .video-2026__video--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .video-2026__top {
    position: absolute;
    width: 100%;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    text-align: center;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  #shopify-section-{{ section.id }} .video-2026__play {
    --video-2026-play-size: 86px;
    --video-2026-play-triangle-top: 16px;
    --video-2026-play-triangle-left: 23px;
    --video-2026-play-triangle-offset: 5px;
    cursor: pointer;
    position: relative;
    display: block;
    width: var(--video-2026-play-size);
    height: var(--video-2026-play-size);
    margin: 0 auto;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: transparent;
    transition: all 0.4s ease;
  }

  #shopify-section-{{ section.id }} .video-2026__play::before,
  #shopify-section-{{ section.id }} .video-2026__play-ring {
    position: absolute;
    content: '';
    display: block;
    width: 160%;
    height: 160%;
    border: 1px solid #fff;
    border-radius: 50%;
    left: -30%;
    top: -30%;
    pointer-events: none;
    animation: video-2026-bounce-circle 1.8s infinite;
  }

  #shopify-section-{{ section.id }} .video-2026__play-ring {
    animation-delay: 400ms;
  }

  #shopify-section-{{ section.id }} .video-2026__play::after {
    position: absolute;
    content: '';
    display: block;
    width: 0;
    height: 0;
    border-top: var(--video-2026-play-triangle-top) solid transparent;
    border-bottom: var(--video-2026-play-triangle-top) solid transparent;
    border-left: var(--video-2026-play-triangle-left) solid #fff;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin-left: var(--video-2026-play-triangle-offset);
    transition: all 0.4s ease;
  }

  #shopify-section-{{ section.id }} .video-2026__play:hover {
    background: #fff;
  }

  #shopify-section-{{ section.id }} .video-2026__play:hover::after {
    border-left-color: #000;
  }

  #shopify-section-{{ section.id }} .video-2026__text {
    max-width: 420px;
    margin: 40px auto 0;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .video-2026__content {
    font-size: 16px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .video-2026__content p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .video-2026__title {
    margin: 0;
    color: #fff;
    font-size: 40px;
    font-family: var(--heading-font-family);
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .video-2026__close {
    position: absolute;
    top: 34px;
    right: 34px;
    z-index: 4;
    width: 45px;
    height: 45px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #fff;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: transform 0.45s ease, opacity 0.3s ease, visibility 0.3s ease;
  }

  #shopify-section-{{ section.id }} .video-2026__close:hover {
    transform: rotate(180deg);
  }

  #shopify-section-{{ section.id }} .video-2026__close::before,
  #shopify-section-{{ section.id }} .video-2026__close::after {
    position: absolute;
    content: '';
    display: block;
    width: 2px;
    height: 22px;
    background: #000;
    top: 50%;
    left: 50%;
  }

  #shopify-section-{{ section.id }} .video-2026__close::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  #shopify-section-{{ section.id }} .video-2026__close::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  #shopify-section-{{ section.id }} .video-2026.is-playing::before,
  #shopify-section-{{ section.id }} .video-2026.is-playing .video-2026__poster,
  #shopify-section-{{ section.id }} .video-2026.is-playing .video-2026__top {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .video-2026.is-playing .video-2026__video,
  #shopify-section-{{ section.id }} .video-2026.is-playing .video-2026__close {
    opacity: 1;
    visibility: visible;
  }

  @keyframes video-2026-bounce-circle {
    0% {
      opacity: 0;
      transform: scale(0.8);
    }

    20% {
      opacity: 1;
    }

    80%,
    100% {
      opacity: 0;
      transform: scale(1.3);
    }
  }

  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} .video-2026 {
      min-height: 560px;
    }

    #shopify-section-{{ section.id }} .video-2026__poster--desktop,
    #shopify-section-{{ section.id }} .video-2026__video--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .video-2026__poster--mobile,
    #shopify-section-{{ section.id }} .video-2026__video--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .video-2026__title {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .video-2026__play {
      --video-2026-play-size: 60px;
      --video-2026-play-triangle-top: 10px;
      --video-2026-play-triangle-left: 18px;
      --video-2026-play-triangle-offset: 3px;
    }

    #shopify-section-{{ section.id }} .video-2026__text {
      width: calc(100% - 48px);
      margin-top: 28px;
    }

    #shopify-section-{{ section.id }} .video-2026__content {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .video-2026__close {
      top: 20px;
      right: 20px;
      width: 38px;
      height: 38px;
    }
  }
</style>

<section class="video-2026">
  {%- assign pc_poster = section.settings.image -%}
  {%- assign mobile_poster = section.settings.image_m -%}

  {%- if pc_poster == blank and section.settings.video.preview_image != blank -%}
    {%- assign pc_poster = section.settings.video.preview_image -%}
  {%- endif -%}

  {%- if mobile_poster == blank and section.settings.video_m.preview_image != blank -%}
    {%- assign mobile_poster = section.settings.video_m.preview_image -%}
  {%- endif -%}

  {%- if mobile_poster == blank -%}
    {%- assign mobile_poster = pc_poster -%}
  {%- endif -%}

  {%- if pc_poster != blank -%}
    {{-
      pc_poster
      | image_url: width: 2400
      | image_tag:
        loading: 'lazy',
        widths: '800,1200,1600,1920,2400',
        class: 'video-2026__poster video-2026__poster--desktop'
    -}}
  {%- endif -%}

  {%- if mobile_poster != blank -%}
    {{-
      mobile_poster
      | image_url: width: 900
      | image_tag:
        loading: 'lazy',
        widths: '400,600,750,900',
        class: 'video-2026__poster video-2026__poster--mobile'
    -}}
  {%- endif -%}

  {%- if section.settings.video != blank -%}
    {{-
      section.settings.video
      | video_tag:
        class: 'video-2026__video video-2026__video--desktop',
        image_size: '2400x',
        controls: true,
        autoplay: false,
        muted: false,
        playsinline: true,
        loop: false
    -}}
  {%- endif -%}

  {%- if section.settings.video_m != blank -%}
    {{-
      section.settings.video_m
      | video_tag:
        class: 'video-2026__video video-2026__video--mobile',
        image_size: '900x',
        controls: true,
        autoplay: false,
        muted: false,
        playsinline: true,
        loop: false
    -}}
  {%- elsif section.settings.video != blank -%}
    {{-
      section.settings.video
      | video_tag:
        class: 'video-2026__video video-2026__video--mobile',
        image_size: '900x',
        controls: true,
        autoplay: false,
        muted: false,
        playsinline: true,
        loop: false
    -}}
  {%- endif -%}

  <div class="video-2026__top">
    <button type="button" class="video-2026__play" aria-label="{{ 'general.accessibility.play_video' | t | escape }}">
      <span class="video-2026__play-ring"></span>
    </button>

    <div class="video-2026__text">
      {%- if section.settings.content != blank -%}
        <div class="video-2026__content">{{ section.settings.content }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="video-2026__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
  </div>

  <button type="button" class="video-2026__close" aria-label="Close video"></button>
</section>

<script>
  window.addEventListener('DOMContentLoaded', function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var root = section.querySelector('.video-2026');
    var playButton = section.querySelector('.video-2026__play');
    var closeButton = section.querySelector('.video-2026__close');

    function getCurrentVideo() {
      var mobileVideo = section.querySelector('.video-2026__video--mobile');
      var desktopVideo = section.querySelector('.video-2026__video--desktop');

      if (window.matchMedia('(max-width: 991px)').matches && mobileVideo) {
        return mobileVideo;
      }

      return desktopVideo || mobileVideo;
    }

    function pauseAllVideos() {
      section.querySelectorAll('.video-2026__video').forEach(function (video) {
        video.pause();
        video.currentTime = 0;
      });
    }

    if (playButton) {
      playButton.addEventListener('click', function () {
        var video = getCurrentVideo();
        if (!video) return;

        root.classList.add('is-playing');
        video.currentTime = 0;
        video.play();
      });
    }

    if (closeButton) {
      closeButton.addEventListener('click', function () {
        root.classList.remove('is-playing');
        pauseAllVideos();
      });
    }
  });
</script>

{% schema %}
{
  "name": "video-2026",
  "class": "video-2026-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC image"
    },
    {
      "type": "image_picker",
      "id": "image_m",
      "label": "Mobile image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "PC video"
    },
    {
      "type": "video",
      "id": "video_m",
      "label": "Mobile video"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ],
  "presets": [
    {
      "name": "video-2026"
    }
  ]
}
{% endschema %}