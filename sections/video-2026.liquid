<style>
  #shopify-section-{{ section.id }} {
    --video-2026-overlay-color: {{ section.settings.overlay_color.red }}, {{ section.settings.overlay_color.green }}, {{ section.settings.overlay_color.blue }};
    --video-2026-overlay-opacity: {{ section.settings.overlay_opacity | default: 10 | divided_by: 100.0 }};
  }

  #shopify-section-{{ section.id }} .video-2026 {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .video-2026__media {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 520px;
    background: #000;
  }

  #shopify-section-{{ section.id }} .video-2026__video,
  #shopify-section-{{ section.id }} .video-2026__poster-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .video-2026__poster {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  #shopify-section-{{ section.id }} .video-2026__poster::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(var(--video-2026-overlay-color), var(--video-2026-overlay-opacity));
  }

  #shopify-section-{{ section.id }} .video-2026__poster-img {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .video-2026__content {
    position: relative;
    z-index: 2;
    color: #fff;
    text-align: center;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  #shopify-section-{{ section.id }} .video-2026__play {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    margin: 0 auto;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    cursor: pointer;
    backdrop-filter: blur(2px);
  }

  #shopify-section-{{ section.id }} .video-2026__play::before,
  #shopify-section-{{ section.id }} .video-2026__play::after {
    content: '';
    position: absolute;
    inset: -12px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    animation: video-2026-ripple 1.8s infinite;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .video-2026__play::after {
    animation-delay: 0.45s;
  }

  #shopify-section-{{ section.id }} .video-2026__play svg {
    width: 28px;
    height: 28px;
  }

  #shopify-section-{{ section.id }} .video-2026__text {
    margin-top: 18px;
  }

  #shopify-section-{{ section.id }} .video-2026__title {
    margin: 0;
    color: inherit;
    font-size: 20px;
    line-height: 1.2;
    font-family: var(--heading-font-family);
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .video-2026__desc {
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .video-2026__desc p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .video-2026__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 140px;
    min-height: 42px;
    margin-top: 16px;
    padding: 10px 24px;
    border-radius: 999px;
    color: #000;
    background: #fff;
    font-size: 14px;
    line-height: 1;
    text-decoration: none;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  #shopify-section-{{ section.id }} .video-2026__button:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .video-2026.is-playing .video-2026__poster {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .video-2026__note {
    position: absolute;
    left: 0;
    bottom: 40px;
    z-index: 3;
    width: 100%;
    color: #b2b2b2;
    font-size: 12px;
    line-height: normal;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .video-2026__note p {
    margin: 0;
  }

  @keyframes video-2026-ripple {
    0% {
      opacity: 0;
      transform: scale(0.85);
    }

    20% {
      opacity: 1;
    }

    80%,
    100% {
      opacity: 0;
      transform: scale(1.25);
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .video-2026__media {
      height: 75vh;
      min-height: 460px;
    }

    #shopify-section-{{ section.id }} .video-2026__play {
      width: 58px;
      height: 58px;
    }

    #shopify-section-{{ section.id }} .video-2026__play svg {
      width: 22px;
      height: 22px;
    }

    #shopify-section-{{ section.id }} .video-2026__text {
      margin-top: 14px;
    }

    #shopify-section-{{ section.id }} .video-2026__title {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .video-2026__desc {
      margin-top: 4px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .video-2026__button {
      min-width: 120px;
      min-height: 38px;
      margin-top: 12px;
      padding: 9px 20px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .video-2026__note {
      bottom: 20px;
      font-size: 10px;
    }
  }
</style>

<section class="video-2026{% if section.settings.autoplay %} is-playing{% endif %}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}">
  <div class="video-2026__media">
    {%- if section.settings.video != blank -%}
      {{-
        section.settings.video
        | video_tag:
          class: 'video-2026__video video-2026__video--desktop',
          image_size: '2000x',
          controls: section.settings.show_video_controls,
          autoplay: section.settings.autoplay,
          muted: section.settings.autoplay,
          playsinline: true,
          loop: section.settings.autoplay
      -}}
    {%- endif -%}

    {%- if section.settings.mobile_video != blank -%}
      {{-
        section.settings.mobile_video
        | video_tag:
          class: 'video-2026__video video-2026__video--mobile',
          image_size: '1200x',
          controls: section.settings.show_video_controls,
          autoplay: section.settings.autoplay,
          muted: section.settings.autoplay,
          playsinline: true,
          loop: section.settings.autoplay
      -}}
    {%- endif -%}

    {%- unless section.settings.autoplay -%}
      <div class="video-2026__poster">
        {%- if section.settings.image != blank -%}
          {{-
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              widths: '400,600,800,1000,1200,1400,1600,1800,2000',
              class: 'video-2026__poster-img'
          -}}
        {%- elsif section.settings.video.preview_image != blank -%}
          {{-
            section.settings.video.preview_image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              widths: '400,600,800,1000,1200,1400,1600,1800,2000',
              class: 'video-2026__poster-img'
          -}}
        {%- endif -%}

        <div class="video-2026__content">
          <button type="button" class="video-2026__play" aria-label="{{ 'general.accessibility.play_video' | t | escape }}">
            {%- render 'icon' with 'play', width: 72, height: 72 -%}
          </button>

          {%- if section.settings.title != blank or section.settings.content != blank or section.settings.button_text != blank -%}
            <div class="video-2026__text">
              {%- if section.settings.title != blank -%}
                <h3 class="video-2026__title">{{ section.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if section.settings.content != blank -%}
                <div class="video-2026__desc">{{ section.settings.content }}</div>
              {%- endif -%}

              {%- if section.settings.button_text != blank -%}
                {%- if section.settings.button_link != blank -%}
                  <a class="video-2026__button" href="{{ section.settings.button_link }}">{{ section.settings.button_text | escape }}</a>
                {%- else -%}
                  <span class="video-2026__button">{{ section.settings.button_text | escape }}</span>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}

    {%- if section.settings.note != blank -%}
      <div class="video-2026__note">
        <div class="container">{{ section.settings.note }}</div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  window.addEventListener('DOMContentLoaded', function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var root = section.querySelector('.video-2026');
    if (!root || root.classList.contains('is-playing')) return;

    var playButton = root.querySelector('.video-2026__play');
    var poster = root.querySelector('.video-2026__poster');

    function getCurrentVideo() {
      var mobileVideo = root.querySelector('.video-2026__video--mobile');
      var desktopVideo = root.querySelector('.video-2026__video--desktop');

      if (window.matchMedia('(max-width: 768px)').matches && mobileVideo) {
        return mobileVideo;
      }

      return desktopVideo || mobileVideo;
    }

    function playVideo(event) {
      if (event && event.target.closest('.video-2026__button')) return;

      var video = getCurrentVideo();
      if (!video) return;

      root.classList.add('is-playing');
      video.play();
    }

    if (poster) poster.addEventListener('click', playVideo);
    if (playButton) playButton.addEventListener('click', playVideo);
  });
</script>

{% schema %}
{
  "name": "Video-2026",
  "class": "shopify-section--video-2026",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "video",
      "id": "video",
      "label": "PC video"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile video"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Cover image"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "info": "Video will be muted automatically when autoplay is enabled.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_video_controls",
      "label": "Show video controls",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Salon like Results"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Without Salon costs and pain</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Video-2026"
    }
  ]
}
{% endschema %}