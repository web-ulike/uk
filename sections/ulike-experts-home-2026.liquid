{% style %}
  #shopify-section-{{ section.id }} .ulike-experts-home {
    padding: 100px 0 90px;
    overflow: hidden;
    background: linear-gradient(180deg, #fff 0%, #fbfbfd 100%);
    color: #190a0a;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__inner {
    position: relative;
    width: min(1520px, calc(100% - 80px));
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__heading {
    margin: 0 0 39px;
    font-family: var(--heading-font-family);
    font-size: 48px;
    font-weight: 500;
    line-height: 1.2;
    color: #1a1a1a;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__swiper,
  #shopify-section-{{ section.id }} .ulike-experts-home__swiper .swiper-container {
    display: block;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__swiper .swiper-container {
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__swiper .swiper-wrapper {
    align-items: stretch;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__swiper .swiper-slide {
    height: auto;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__card {
    width: 100%;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__media {
    position: relative;
    height: auto;
    aspect-ratio: 493 / 280;
    overflow: hidden;
    border-radius: 10px;
    background: #f2f2fa;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__portrait,
  #shopify-section-{{ section.id }} .ulike-experts-home__uploaded-image,
  #shopify-section-{{ section.id }} .ulike-experts-home__video {
    display: block;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__uploaded-image,
  #shopify-section-{{ section.id }} .ulike-experts-home__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__portrait {
    position: absolute;
    left: 50%;
    max-width: none;
    width: 130%;
    height: auto;
    top: 0;
    transform: translateX(-50%);
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__portrait--adam {
    width: 90%;
    top: 8%;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__portrait--davin {
    width: 90%;
    top: -10%;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__mobile-image {
    display: none;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__video {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__card.is-playing .ulike-experts-home__video {
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__play {
    position: absolute;
    right: 20px;
    bottom: 20px;
    z-index: 3;
    width: 50px;
    height: 50px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__play img {
    display: block;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__card.is-playing .ulike-experts-home__play {
    display: none;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__details {
    margin-top: 30px;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__name {
    margin: 0 0 6px;
    font-family: var(--heading-font-family);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__role {
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 1px solid #cfcacc;
    color: #3f3636;
    font-size: 12px;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__description {
    margin: 15px 0 0;
    font-size: 14px;
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__navigation {
    position: absolute;
    top: 5px;
    right: 0;
    width: 94px;
    height: 24px;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__arrow {
    position: absolute;
    top: 0;
    width: 47px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    background-image: url('{{ 'ulike-experts-arrows.svg' | asset_url }}');
    background-repeat: no-repeat;
    background-size: 94px 24px;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__arrow.swiper-prev {
    left: 0;
    background-position: left center;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__arrow.swiper-next {
    right: 0;
    background-position: right center;
  }
  #shopify-section-{{ section.id }} .ulike-experts-home__arrow.swiper-button-disabled {
    opacity: .3;
    cursor: default;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .ulike-experts-home {
      padding: 59px 0 64px;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__inner {
      width: calc(100% - 32px);
      margin-left: 16px;
      margin-right: 16px;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__heading {
      margin-bottom: 22px;
      font-size: 26px;
      line-height: 1.25;
      color: #3f3636;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__swiper .swiper-container {
      overflow: visible;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__media {
      aspect-ratio: 301 / 260;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__portrait {
      width: 210%;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__portrait--adam {
      width: 146%;
      top: 8%;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__portrait--davin {
      width: 140%;
      top: -5%;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__media--has-mobile .ulike-experts-home__desktop-image,
    #shopify-section-{{ section.id }} .ulike-experts-home__media--has-mobile .ulike-experts-home__portrait {
      display: none;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__mobile-image {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__details {
      margin-top: 20px;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__name {
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__role {
      padding-bottom: 4px;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__navigation {
      position: relative;
      top: auto;
      right: auto;
      width: 63px;
      height: 16px;
      margin-left: min(238px, calc(100% - 63px));
      margin-top: 24px;
    }
    #shopify-section-{{ section.id }} .ulike-experts-home__arrow {
      width: 31.5px;
      height: 16px;
      background-size: 63px 16px;
    }
  }
{% endstyle %}

<section id="UlikeExpertsHome-{{ section.id }}" class="ulike-experts-home">
  <div class="ulike-experts-home__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ulike-experts-home__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ulike-experts-home__swiper">
      <div class="swiper-container">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% liquid
              assign desktop_image = block.settings.image
              assign mobile_image = block.settings.mobile_image
              assign video = block.settings.video
              assign fallback = block.settings.reference_portrait
              assign poster = desktop_image | default: mobile_image | default: video.preview_image
            %}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <article class="ulike-experts-home__card">
                <div class="ulike-experts-home__media{% if mobile_image != blank %} ulike-experts-home__media--has-mobile{% endif %}">
                  {% if poster != blank %}
                    {{ poster | image_url: width: 1100 | image_tag: loading: 'lazy', class: 'ulike-experts-home__uploaded-image ulike-experts-home__desktop-image', widths: '400,600,800,1100', sizes: '(max-width: 767px) 301px, (max-width: 1199px) 50vw, 33vw' }}
                  {% elsif fallback != 'none' %}
                    {% case fallback %}
                      {% when 'cassandra' %}{% assign portrait_file = 'ulike-expert-cassandra.png' %}
                      {% when 'adam' %}{% assign portrait_file = 'ulike-expert-adam.png' %}
                      {% when 'davin' %}{% assign portrait_file = 'ulike-expert-davin.png' %}
                    {% endcase %}
                    <img class="ulike-experts-home__portrait ulike-experts-home__portrait--{{ fallback }}" src="{{ portrait_file | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="1200" height="1200">
                  {% endif %}
                  {% if mobile_image != blank %}
                    {{ mobile_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'ulike-experts-home__uploaded-image ulike-experts-home__mobile-image', widths: '350,500,700', sizes: '301px' }}
                  {% endif %}
                  {% if video != blank %}
                    {{ video | video_tag: class: 'ulike-experts-home__video', controls: false, autoplay: false, loop: false, muted: false, playsinline: true, preload: 'none' }}
                    <button class="ulike-experts-home__play" type="button" aria-label="Play {{ block.settings.name | escape }} video">
                      <img src="{{ 'ulike-experts-play.svg' | asset_url }}" alt="" width="50" height="50">
                    </button>
                  {% endif %}
                </div>
                <div class="ulike-experts-home__details">
                  {% if block.settings.name != blank %}<h3 class="ulike-experts-home__name">{{ block.settings.name | escape }}</h3>{% endif %}
                  {% if block.settings.role != blank %}<p class="ulike-experts-home__role">{{ block.settings.role | escape }}</p>{% endif %}
                  {% if block.settings.description != blank %}<div class="ulike-experts-home__description">{{ block.settings.description }}</div>{% endif %}
                </div>
              </article>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <div class="ulike-experts-home__navigation">
          <button class="ulike-experts-home__arrow swiper-prev" type="button" aria-label="Previous experts">
          </button>
          <button class="ulike-experts-home__arrow swiper-next" type="button" aria-label="Next experts">
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('UlikeExpertsHome-{{ section.id }}');
    if (!section) return;
    const wrapper = section.querySelector('.swiper-wrapper');
    const originalSlides = [...wrapper.children];
    let swiper;

    // Repeat the editable cards so three visible desktop cards can still move.
    if (originalSlides.length > 1) {
      while (wrapper.children.length < Math.max(6, originalSlides.length * 2)) {
        originalSlides.forEach((slide) => {
          const clone = slide.cloneNode(true);
          clone.removeAttribute('data-shopify-editor-block');
          wrapper.appendChild(clone);
        });
      }
    }

    const pause = (card) => {
      const video = card.querySelector('video');
      if (!video) return;
      card.classList.remove('is-playing');
      if (!video.paused) video.pause();
      video.controls = false;
    };
    const pausePlaying = () => {
      section.querySelectorAll('.ulike-experts-home__card.is-playing').forEach(pause);
    };
    const resumeAutoplay = () => {
      if (swiper?.autoplay && originalSlides.length > 1) swiper.autoplay.start();
    };

    section.addEventListener('click', async (event) => {
      const button = event.target.closest('.ulike-experts-home__play');
      if (!button) return;
      const card = button.closest('.ulike-experts-home__card');
      const video = card?.querySelector('video');
      if (!video) return;
      pausePlaying();
      swiper?.autoplay?.stop();
      try {
        video.controls = true;
        await video.play();
        card.classList.add('is-playing');
      } catch (error) {
        video.controls = false;
        resumeAutoplay();
      }
    });

    section.addEventListener('ended', (event) => {
      const card = event.target.closest('.ulike-experts-home__card');
      if (card) pause(card);
      resumeAutoplay();
    }, true);
    section.addEventListener('pause', (event) => {
      const card = event.target.closest('.ulike-experts-home__card');
      if (card?.classList.contains('is-playing')) {
        pause(card);
        resumeAutoplay();
      }
    }, true);

    let retries = 0;
    const init = () => {
      if (section.dataset.swiperReady === 'true') return;
      if (typeof window.Swiper === 'undefined') {
        if (retries++ < 40) window.setTimeout(init, 100);
        return;
      }
      section.dataset.swiperReady = 'true';
      swiper = new window.Swiper(section.querySelector('.swiper-container'), {
        slidesPerView: 3,
        spaceBetween: 20,
        loop: originalSlides.length > 1,
        centeredSlides: false,
        speed: 600,
        autoplay: originalSlides.length > 1 ? {
          delay: 5000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        } : false,
        navigation: {
          prevEl: section.querySelector('.swiper-prev'),
          nextEl: section.querySelector('.swiper-next')
        },
        breakpoints: {
          0: { slidesPerView: 1.14, spaceBetween: 16 },
          768: { slidesPerView: 2, spaceBetween: 20 },
          1200: { slidesPerView: 3, spaceBetween: 20 }
        },
        on: {
          slideChangeTransitionStart: () => {
            pausePlaying();
            resumeAutoplay();
          }
        }
      });
    };
    init();
  })();
</script>

{% schema %}
{
  "name": "Ulike experts home",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Backed by experts." }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Expert",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image / video cover" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
        { "type": "video", "id": "video", "label": "Video (optional)" },
        {
          "type": "select",
          "id": "reference_portrait",
          "label": "Reference portrait if no image is uploaded",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "cassandra", "label": "Cassandra Bankson" },
            { "value": "adam", "label": "Dr. Adam Rubinstein" },
            { "value": "davin", "label": "Dr. Davin Lim" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Expert name" },
        { "type": "text", "id": "role", "label": "Title", "default": "A board-certified dermatologist" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Ulike IPL is backed by over 30+ safety certifications, ensuring your skin is protected from harmful UV light, and delivering you a comfortable and reliable hair removal experience.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ulike experts home",
      "blocks": [
        { "type": "expert", "settings": { "reference_portrait": "cassandra", "name": "Cassandra Bankson" } },
        { "type": "expert", "settings": { "reference_portrait": "adam", "name": "Dr. Adam Rubinstein", "role": "Award-Winning Aesthetic Surgeon" } },
        { "type": "expert", "settings": { "reference_portrait": "davin", "name": "Dr. Davin Lim", "role": "Board-Certified Dermatologist" } }
      ]
    }
  ]
}
{% endschema %}
