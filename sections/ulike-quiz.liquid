            </button>
          </div>
        </section>

        <!-- STEP 4 -->
        <section
          class="quiz-step"
          data-step="4"
          data-type="single"
          data-answer-key="age"
        >
          <div class="quiz-header">
            <h2>What is your age?</h2>
            <p>Single selection</p>
          </div>

          <div class="quiz-list">
            {% assign ages = 'Under 18,18-34,35-54,55+,I don’t want to disclose it.' | split: ',' %}

            {% assign agesTags = 'AGE_[yyyy]_under22,AGE_[yyyy]_22-29,AGE_[yyyy]_30-49,AGE_[yyyy]_over50,AGE_[yyyy]_Secret'
              | split: ','
            %}

            {% for age in ages %}
              <button
                type="button"
                class="quiz-list-option"
                data-value="{{ age | escape }}"
                data-tag="{{ agesTags[forloop.index0] }}"
              >
                <span>{{ age }}</span>
                <span class="quiz-list-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="#E0004D"
                    />
                  </svg>
                </span>
              </button>
            {% endfor %}
          </div>
        </section>

        <!-- STEP 5 -->
        <section
          class="quiz-step"
          data-step="5"
          data-type="single"
          data-answer-key="gender"
        >
          <div class="quiz-header">
            <h2>What is your gender?</h2>
            <p>Single selection</p>
          </div>

          <div class="quiz-list">
            <button
              type="button"
              class="quiz-list-option"
              data-value="Female"
              data-tag="Female"
            >
              Female
              <span class="quiz-list-check">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="#E0004D"
                  />
                </svg>
              </span>
            </button>

            <button
              type="button"
              class="quiz-list-option"
              data-value="Male"
              data-tag="Male"
            >
              Male
              <span class="quiz-list-check">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="#E0004D"
                  />
                </svg>
              </span>
            </button>

            <button
              type="button"
              class="quiz-list-option"
              data-value="I don't want to disclose it."
              data-tag="Secret"
            >
              I don't want to disclose it.
              <span class="quiz-list-check">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
