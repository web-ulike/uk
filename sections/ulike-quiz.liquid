<div
  id="UlikeQuiz-{{ section.id }}"
  class="ulike-quiz"
  data-submit-url="{{ section.settings.submit_url | escape }}"
  data-skin-test-url="{{ section.settings.skin_test_url | escape }}"
>
  {% if section.settings.show_trigger %}
    <button
      type="button"
      class="ulike-quiz-trigger"
      data-ulike-quiz-open
    >
      {{ section.settings.trigger_text }}
    </button>
  {% endif %}

  <div class="ulike-quiz-modal" hidden>
    <div class="ulike-quiz-overlay" data-quiz-close></div>

    <div
      class="ulike-quiz-dialog"
      role="dialog"
      aria-modal="true"
    >
      <button
        type="button"
        class="ulike-quiz-close"
        data-quiz-close
        aria-label="Close"
      >
        <span></span>
        <span></span>
      </button>

      <div class="ulike-quiz-body">
        <!-- STEP 1 -->
        <section
          class="quiz-step active"
          data-step="1"
          data-type="multi"
          data-answer-key="treatmentAreas"
        >
          <div class="quiz-header">
            <h2>Target Treatment Area</h2>
            <p>Multiple/Single selection</p>
          </div>

          <div class="quiz-image-grid">
            <button
              type="button"
              class="quiz-image-option"
              data-value="Bikini / Underarms"
              data-tag="Q01_A01"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.area_bikini != blank %}
                  {{ section.settings.area_bikini | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

                <span class="quiz-option-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="white"
                    />
                  </svg>
                </span>
              </div>

              <div class="quiz-image-option__label">Bikini / Underarms</div>
            </button>

            <button
              type="button"
              class="quiz-image-option"
              data-value="Legs & Arms"
              data-tag="Q01_A02"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.area_legs != blank %}
                  {{ section.settings.area_legs | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

                <span class="quiz-option-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="white"
                    />
                  </svg>
                </span>
              </div>

              <div class="quiz-image-option__label">Legs & Arms</div>
            </button>

            <button
              type="button"
              class="quiz-image-option"
              data-value="Facial & Lip"
              data-tag="Q01_A03"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.area_face != blank %}
                  {{ section.settings.area_face | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

                <span class="quiz-option-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="white"
                    />
                  </svg>
                </span>
              </div>

              <div class="quiz-image-option__label">Facial & Lip</div>
            </button>

            <button
              type="button"
              class="quiz-image-option"
              data-value="Full Body"
              data-tag="Q01_A04"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.area_body != blank %}
                  {{ section.settings.area_body | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

                <span class="quiz-option-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="white"
                    />
                  </svg>
                </span>
              </div>

              <div class="quiz-image-option__label">Full Body</div>
            </button>
          </div>
        </section>

        <!-- STEP 2 -->
        <section
          class="quiz-step"
          data-step="2"
          data-type="multi"
          data-answer-key="occasions"
        >
          <div class="quiz-header">
            <h2>Primary Occasion & Motivation</h2>
            <p>Multiple/Single selection</p>
          </div>

          <div class="quiz-image-grid">
            <button
              type="button"
              class="quiz-image-option"
              data-value="Upcoming Vacation / Beach Trip"
              data-tag="Q02_A01"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.occasion_vacation != blank %}
                  {{ section.settings.occasion_vacation | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

