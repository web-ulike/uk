<script>
  (() => {
    const root = document.querySelector('#UlikeQuiz-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const modal = root.querySelector('.ulike-quiz-modal');
    const dialog = root.querySelector('.ulike-quiz-dialog');
    const steps = [...root.querySelectorAll('.quiz-step')];
    const dots = [...root.querySelectorAll('[data-progress-dot]')];
    const navigation = root.querySelector('[data-quiz-navigation]');
    const prevButton = root.querySelector('[data-quiz-prev]');
    const nextButton = root.querySelector('[data-quiz-next]');
    const SWIPE_DISTANCE = 55;

    let currentStep = '1';
    let transitionLocked = false;
    let history = [];

    const answers = { tags: [] };

    const getStep = (id) => root.querySelector(`.quiz-step[data-step="${id}"]`);
    const getCurrentStep = () => getStep(currentStep);

    const syncTags = () => {
      const currentYear = new Date().getFullYear();

      answers.tags = [
        ...new Set(
          [
            ...root.querySelectorAll(
              '.quiz-image-option.active[data-tag], .quiz-list-option.active[data-tag], .quiz-swatch.active[data-tag]'
            ),
          ]
            .map((item) => item.dataset.tag?.trim().replace('[yyyy]', currentYear))
            .filter(Boolean)
        ),
      ];

      return answers.tags;
    };

    const updateProgress = (step) => {
      let value = Number(step.dataset.progress || step.dataset.step);

      if (['result', 'incompatible', 'exit'].includes(step.dataset.step)) value = 7;
      if (step.dataset.step === 'concern') value = 5;

      dots.forEach((dot) => {
        dot.classList.toggle('active', Number(dot.dataset.progressDot) === value);
      });
    };

    const isDisqualified = () => Boolean(root.querySelector('.quiz-swatch.active[data-disqualify="true"]'));

    const hasAnswer = (step) => {
      if (!step) return false;

      if (step.dataset.type === 'tone') {
        if (isDisqualified()) return true;

        return Boolean(
          step.querySelector('[data-tone-group="skinTone"].active') &&
            step.querySelector('[data-tone-group="hairColor"].active')
        );
      }

      return Boolean(step.querySelector('.quiz-image-option.active, .quiz-list-option.active'));
    };

    const updateNavigation = (step = getCurrentStep()) => {
      if (!navigation || !step) return;

      const isSpecial = ['result', 'incompatible', 'exit'].includes(step.dataset.step);

      navigation.hidden = isSpecial;

      if (isSpecial) return;

      if (prevButton) prevButton.disabled = history.length === 0;
      if (nextButton) nextButton.disabled = !hasAnswer(step);
    };

    const showStep = (target, { pushHistory = true, direction = 'forward' } = {}) => {
      if (transitionLocked || target === currentStep) return;

      const next = getStep(target);
      const current = getCurrentStep();

      if (!next) return;

      transitionLocked = true;

      if (pushHistory) history.push(currentStep);

      current?.classList.remove('active');
      next.classList.toggle('is-backward', direction === 'back');

      requestAnimationFrame(() => {
        next.classList.add('active');
        requestAnimationFrame(() => next.classList.remove('is-backward'));
      });

      currentStep = target;
      updateProgress(next);
      updateNavigation(next);
      next.scrollTop = 0;

      setTimeout(() => {
        transitionLocked = false;
      }, 320);
    };

    const goBack = () => {
      const previous = history.pop();
      if (!previous) return;

      showStep(previous, {
        pushHistory: false,
        direction: 'back',
      });
    };

    const getNextStep = () => {
      switch (currentStep) {
        case '1':
          return '2';
        case '2':
          return '3';
        case '3':
          return '4';
        case '4':
          return '5';
        case '5':
          return 'concern';
        case 'concern':
          return '6';
        case '6':
          return isDisqualified() ? 'incompatible' : 'result';
        case 'incompatible':
          return 'exit';
        default:
          return null;
      }
    };

    const goNext = () => {
      const step = getCurrentStep();
      if (!step || !hasAnswer(step)) return;

      syncTags();

      const next = getNextStep();
      if (next) showStep(next);
    };

    const handleNormalOption = (button) => {
      const step = button.closest('.quiz-step');
      if (!step) return;

      const type = step.dataset.type;

      if (type === 'single') {
        step.querySelectorAll('.quiz-image-option, .quiz-list-option').forEach((item) => {
          item.classList.remove('active');
        });

        button.classList.add('active');
      }

      if (type === 'multi') button.classList.toggle('active');

      syncTags();
      updateNavigation(step);
    };

    const handleToneOption = (button) => {
      const step = button.closest('.quiz-step');
      const group = button.dataset.toneGroup;

      if (!step || !group) return;

      root.querySelectorAll(`[data-tone-group="${group}"]`).forEach((item) => {
        item.classList.remove('active');
      });

      button.classList.add('active');

      syncTags();
      updateNavigation(step);
    };

    const resetQuiz = () => {
      history = [];
      currentStep = '1';
      transitionLocked = false;
      answers.tags = [];

      root
        .querySelectorAll('.quiz-image-option.active, .quiz-list-option.active, .quiz-swatch.active')
        .forEach((item) => item.classList.remove('active'));

      steps.forEach((step) => {
        step.classList.toggle('active', step.dataset.step === '1');
        step.classList.remove('is-backward');
        step.scrollTop = 0;
      });

      updateProgress(getStep('1'));
      updateNavigation(getStep('1'));

      const resultEmail = root.querySelector('[data-result-email]');
      const resultConsent = root.querySelector('[data-result-consent]');
      const incompatibleEmail = root.querySelector('[data-incompatible-email]');
      const incompatibleConsent = root.querySelector('[data-incompatible-consent]');
      const resultError = root.querySelector('[data-form-error]');
      const incompatibleError = root.querySelector('[data-incompatible-error]');

      if (resultEmail) resultEmail.value = '';
      if (resultConsent) resultConsent.checked = false;
      if (incompatibleEmail) incompatibleEmail.value = '';
      if (incompatibleConsent) incompatibleConsent.checked = false;
      if (resultError) resultError.textContent = '';
      if (incompatibleError) incompatibleError.textContent = '';
    };

    const openQuiz = () => {
      modal.hidden = false;
      document.body.classList.add('ulike-quiz-lock');
      updateProgress(getCurrentStep());
      updateNavigation(getCurrentStep());
    };

    const closeQuiz = () => {
      modal.hidden = true;
      document.body.classList.remove('ulike-quiz-lock');
    };

    const isEmail = (email) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    const sendQuizRequest = async (payload) => {
      const submitUrl = 'https://api.ulike.com/user/userSubscribe';

      console.log('------------payload------------------', payload);

      const response = await fetch(submitUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const result = await response.json().catch(() => ({}));

      if (typeof result.code !== 'undefined' && result.code !== 0) {
        throw new Error(result.message || `API code ${result.code}`);
      }

      return result;
    };

    const submitQuiz = async () => {
      const button = root.querySelector('[data-quiz-submit]');
      const emailInput = root.querySelector('[data-result-email]');
      const consent = root.querySelector('[data-result-consent]');
      const error = root.querySelector('[data-form-error]');
      const email = emailInput?.value.trim() || '';

      if (error) error.textContent = '';

      if (!isEmail(email)) {
        if (error) error.textContent = 'Please enter a valid email address.';
        emailInput?.focus();
        return;
      }

      if (!consent?.checked) {
        if (error) error.textContent = 'Please confirm the checkbox first.';
        return;
      }

      syncTags();

      const payload = {
        ...answers,
        userEmail: email,
        since: 'ADD_QUIZ_TAG',
        siteCode: 'UK',
        timestamp: new Date().toISOString(),
      };

      window.dispatchEvent(
        new CustomEvent('ulike:quiz:submit', {
          detail: payload,
        })
      );

      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'ulike_quiz_submit',
          quizData: payload,
        });
      }

      const originalText = button?.textContent.trim() || '';

      try {
        if (button) {
          button.disabled = true;
          button.textContent = 'SUBMITTING...';
        }

        const result = await sendQuizRequest(payload);

        if (result.redirectUrl) {
          window.location.href = result.redirectUrl;
          return;
        }

        window.dispatchEvent(
          new CustomEvent('ulike:quiz:submitted', {
            detail: {
              payload,
              response: result,
            },
          })
        );
        closeQuiz();
        resetQuiz();
      } catch (err) {
        console.error('[Ulike Quiz submit error]', err);

        if (error) {
          error.textContent = 'Something went wrong. Please try again.';
        }
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = originalText || 'Open Email to Claim Reward';
        }
      }
    };

    const submitIncompatibleQuiz = async () => {
      const button = root.querySelector('[data-incompatible-next]');
      const emailInput = root.querySelector('[data-incompatible-email]');
      const consent = root.querySelector('[data-incompatible-consent]');
      const error = root.querySelector('[data-incompatible-error]');
      const email = emailInput?.value.trim() || '';

      if (error) error.textContent = '';

      if (!isEmail(email)) {
        if (error) error.textContent = 'Please enter a valid email address.';
        emailInput?.focus();
        return;
      }

      if (!consent?.checked) {
        if (error) error.textContent = 'Please confirm the checkbox first.';
        return;
      }

      syncTags();

      const payload = {
        ...answers,
        userEmail: email,
        since: 'ADD_QUIZ_TAG',
        siteCode: 'US',
        timestamp: new Date().toISOString(),
      };

      window.dispatchEvent(
        new CustomEvent('ulike:quiz:submit', {
          detail: payload,
        })
      );

      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'ulike_quiz_submit',
          quizData: payload,
        });
      }

      const originalText = button?.textContent.trim() || '';

      try {
        if (button) {
          button.disabled = true;
          button.textContent = 'SUBMITTING...';
        }

        const result = await sendQuizRequest(payload);

        window.dispatchEvent(
          new CustomEvent('ulike:quiz:submitted', {
            detail: {
              payload,
              response: result,
            },
          })
        );

        showStep('exit');
      } catch (err) {
        console.error('[Ulike Quiz incompatible submit error]', err);

        if (error) {
          error.textContent = 'Something went wrong. Please try again.';
        }
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = originalText || 'NEXT';
        }
      }
    };

    root.addEventListener('click', (event) => {
      const normalOption = event.target.closest('.quiz-image-option, .quiz-list-option');

      const toneOption = event.target.closest('.quiz-swatch');

      if (normalOption) {
        handleNormalOption(normalOption);
        return;
      }

      if (toneOption) {
        handleToneOption(toneOption);
        return;
      }

      if (event.target.closest('[data-quiz-prev]')) {
        goBack();
        return;
      }

      if (event.target.closest('[data-quiz-next]')) {
        goNext();
        return;
      }

      if (event.target.closest('[data-quiz-back]')) {
        goBack();
        return;
      }

      if (event.target.closest('[data-incompatible-next]')) {
        submitIncompatibleQuiz();
        return;
      }

      if (event.target.closest('[data-quiz-restart]')) {
        resetQuiz();
        return;
      }

      if (event.target.closest('[data-quiz-submit]')) {
        submitQuiz();
        return;
      }

      if (event.target.closest('[data-quiz-close]')) {
        closeQuiz();
      }
    });

    document.addEventListener('click', (event) => {
      if (!event.target.closest('[data-ulike-quiz-open]')) return;

      event.preventDefault();
      openQuiz();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) closeQuiz();
    });

    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;

    dialog.addEventListener(
      'touchstart',
      (event) => {
        if (window.innerWidth > 767) return;

        const touch = event.touches[0];

        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
        touchEndX = touch.clientX;
        touchEndY = touch.clientY;
      },
      { passive: true }
    );

    dialog.addEventListener(
      'touchmove',
      (event) => {
        if (window.innerWidth > 767) return;

        const touch = event.touches[0];

        touchEndX = touch.clientX;
        touchEndY = touch.clientY;
      },
      { passive: true }
    );

    dialog.addEventListener(
      'touchend',
      () => {
        if (window.innerWidth > 767) return;

        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;

        if (Math.abs(diffY) > Math.abs(diffX)) return;
        if (Math.abs(diffX) < SWIPE_DISTANCE) return;

        if (diffX > 0) {
          goBack();
          return;
        }

        const step = getCurrentStep();

        if (!step) return;
        if (['result', 'exit'].includes(step.dataset.step)) return;

        if (step.dataset.step === 'incompatible') {
          submitIncompatibleQuiz();
          return;
        }

        if (hasAnswer(step)) goNext();
      },
      { passive: true }
    );

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail.sectionId !== '{{ section.id }}') return;

      document.body.classList.remove('ulike-quiz-lock');
    });

    syncTags();
    updateNavigation(getCurrentStep());
  })();
</script>

