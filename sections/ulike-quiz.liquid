                    fill="white"
                    />
                  </svg>
                </span>
              </div>

              <div class="quiz-image-option__label">Upcoming Vacation / Beach Trip</div>
            </button>

            <button
              type="button"
              class="quiz-image-option"
              data-value="Everyday Confidence & Carefree Outfits"
              data-tag="Q02_A02"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.occasion_everyday != blank %}
                  {{ section.settings.occasion_everyday | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

                <span class="quiz-option-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="white"
                    />
                  </svg>
                </span>
              </div>

              <div class="quiz-image-option__label">Everyday Confidence & Carefree Outfits</div>
            </button>

            <button
              type="button"
              class="quiz-image-option"
              data-value="Special Event / Wedding / Date"
              data-tag="Q02_A03"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.occasion_event != blank %}
                  {{ section.settings.occasion_event | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

                <span class="quiz-option-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="white"
                    />
                  </svg>
                </span>
              </div>

              <div class="quiz-image-option__label">Special Event / Wedding / Date</div>
            </button>

            <button
              type="button"
              class="quiz-image-option"
              data-value="Long-term Maintenance"
              data-tag="Q02_A04"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.occasion_longterm != blank %}
                  {{ section.settings.occasion_longterm | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

                <span class="quiz-option-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="white"
                    />
                  </svg>
                </span>
              </div>

              <div class="quiz-image-option__label">Long-term Maintenance</div>
            </button>
          </div>
        </section>

        <!-- STEP 3 -->
        <section
          class="quiz-step"
          data-step="3"
          data-type="single"
          data-answer-key="skinType"
        >
          <div class="quiz-header">
            <h2>Skin Type & Hair Texture</h2>
            <p>Single selection</p>
          </div>

          <div class="quiz-image-grid">
            <button
              type="button"
              class="quiz-image-option"
              data-value="Sensitive Skin / Low Pain Tolerance"
              data-tag="Q03_A01"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.skin_sensitive != blank %}
                  {{ section.settings.skin_sensitive | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

                <span class="quiz-option-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="white"
                    />
                  </svg>
                </span>
              </div>

              <div class="quiz-image-option__label">Sensitive Skin / Low Pain Tolerance</div>
            </button>

            <button
              type="button"
              class="quiz-image-option"
              data-value="Coarse & Stubborn Hair"
              data-tag="Q03_A02"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.skin_coarse != blank %}
                  {{ section.settings.skin_coarse | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

                <span class="quiz-option-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="white"
                    />
                  </svg>
                </span>
              </div>

              <div class="quiz-image-option__label">Coarse & Stubborn Hair</div>
            </button>

            <button
              type="button"
              class="quiz-image-option"
              data-value="Medium / Normal Skin & Hair"
              data-tag="Q03_A03"
            >
              <div class="quiz-image-option__media">
                {% if section.settings.skin_normal != blank %}
                  {{ section.settings.skin_normal | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {% endif %}

                <span class="quiz-option-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none">
                    <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.7136 0.326216C17.2016 0.782524 17.2273 1.54803 16.771 2.036L6.50458 13.0149C6.26262 13.2736 5.91945 13.4131 5.5656 13.397C5.21173 13.3808 4.88278 13.2102 4.66553 12.9304L0.254235 7.24866C-0.15547 6.72096 -0.0598076 5.96103 0.467894 5.55133C0.995595 5.14162 1.75552 5.23727 2.16522 5.76499L5.70648 10.3261L15.0039 0.383574C15.4602 -0.104391 16.2256 -0.130073 16.7136 0.326216Z"
                    fill="white"
