{%- liquid
  assign sid = section.id
  assign sid_js = section.id | replace: 'template--', '' | replace: '__', '' | replace: '-', '_'
  assign st = section.settings

  if st.product != blank
    assign product = st.product
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign shipping_notice_text = st.shipping_notice | default: 'Limitierte Early-Bird-Verfügbarkeit.<br>Voraussichtlicher Versand ab dem 15. Juni 2026 oder früher.'
  assign coupon_left_text = st.coupon_left_text | default: '100€'
  assign coupon_sub_text = st.coupon_sub_text | default: 'Rabatt'
  assign coupon_code_text = st.coupon_code | default: 'AIR10BO'
  assign coupon_copy_text = st.coupon_copy_text | default: 'Kopieren'
  assign coupon_success_text = st.coupon_success_text | default: 'Kopiert'
  assign countdown_label_text = st.countdown_label | default: 'Begrenzte Menge verfügbar. Endet in:'
  assign countdown_end_text = st.countdown_end | default: '2026-06-15 23:59:59'
  assign add_to_cart_text = st.add_to_cart_text | default: 'JETZT VORBESTELLEN'
  assign sold_out_text = st.sold_out_text | default: 'AUSVERKAUFT'
  assign product_form_id = 'UProducts2026Form-' | append: sid
-%}

<section
  id="u-products-2026-{{ sid }}"
  class="u-products-2026 {{ st.custom_class }}"
  style="
    --u-p26-bg: {{ st.bg_color }};
    --u-p26-accent: {{ st.accent_color }};
    --u-p26-button-bg: {{ st.button_bg }};
    --u-p26-button-color: {{ st.button_color }};
    {%- if st.coupon_bg_image != blank -%}
      --u-p26-coupon-bg-image: url({{ st.coupon_bg_image | image_url: width: 1400 }});
    {%- endif -%}
  "
>
  <div class="container u-products-2026__container">
    <div class="u-products-2026__grid">
      <div class="u-products-2026__media">
        <div class="u-products-2026__thumbs-wrap">
          <div class="swiper u-products-2026__thumbs" id="UProducts2026Thumbs-{{ sid }}">
            <div class="swiper-wrapper" data-u-p26-thumbs-wrapper>
              {%- for media in product.media -%}
                <div class="swiper-slide u-products-2026__thumb">
                  {%- if media.media_type == 'image' -%}
                    {{ media | image_url: width: 140 | image_tag: loading: 'lazy', draggable: false }}
                  {%- elsif media.preview_image != blank -%}
                    {{ media.preview_image | image_url: width: 140 | image_tag: loading: 'lazy', draggable: false }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>

        <div class="u-products-2026__gallery-wrap">
          {%- if st.media_badge_image != blank -%}
            <div class="u-products-2026__media-badge">
              {{ st.media_badge_image | image_url: width: 240 | image_tag: loading: 'lazy' }}
            </div>
          {%- endif -%}

          <div class="swiper u-products-2026__gallery" id="UProducts2026Gallery-{{ sid }}">
            <div class="swiper-wrapper" data-u-p26-gallery-wrapper>
              {%- for media in product.media -%}
                <div class="swiper-slide u-products-2026__gallery-slide" data-media-id="{{ media.id }}">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      <picture>
                        <source media="(max-width: 768px)" srcset="{{ media | image_url: width: 900 }}">
                        {%- if forloop.first -%}
                          {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', draggable: false }}
                        {%- else -%}
                          {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', draggable: false }}
                        {%- endif -%}
                      </picture>
                    {%- when 'video' -%}
                      {{ media | video_tag: controls: true, muted: true, loop: true, playsinline: true }}
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag }}
                    {%- when 'model' -%}
                      {{ media | model_viewer_tag }}
                    {%- else -%}
                      {%- if media.preview_image != blank -%}
                        {{ media.preview_image | image_url: width: 1600 | image_tag: loading: 'lazy', draggable: false }}
                      {%- endif -%}
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            </div>

            <div class="u-products-2026__arrow u-products-2026__arrow--prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="33" height="25" viewBox="0 0 33 25" fill="none" aria-hidden="true">
                <g clip-path="url(#u-products-2026-arrow-prev-{{ sid }})">
                  <path d="M0 12.3597C0 12.5548 0.0739021 12.7484 0.215279 12.8963L11.4612 24.6999L12.6356 23.6266L2.65083 13.1466H32.9346C32.9346 12.2778 32.2149 11.5728 31.328 11.5728H0.840233C0.536591 11.5728 0.240986 11.7223 0.0963936 11.9851C0.0305252 12.1031 0 12.2322 0 12.3597Z" fill="currentColor"/>
                  <path d="M1.67679 9.60024C2.30496 10.214 3.32192 10.214 3.94848 9.60024L12.6143 1.11268L11.4785 0L1.6784 9.60024H1.67679Z" fill="currentColor"/>
                </g>
                <defs>
                  <clipPath id="u-products-2026-arrow-prev-{{ sid }}">
                    <rect width="32.9346" height="24.701" fill="white" transform="matrix(-1 0 0 1 32.9346 0)"/>
                  </clipPath>
                </defs>
              </svg>
            </div>

            <div class="u-products-2026__arrow u-products-2026__arrow--next">
              <svg xmlns="http://www.w3.org/2000/svg" width="33" height="25" viewBox="0 0 33 25" fill="none" aria-hidden="true">
                <g clip-path="url(#u-products-2026-arrow-next-{{ sid }})">
                  <path d="M32.9346 12.3597C32.9346 12.5548 32.8607 12.7484 32.7193 12.8963L21.4734 24.6999L20.299 23.6266L30.2838 13.1466H0C0 12.2778 0.719742 11.5728 1.60657 11.5728H32.0944C32.398 11.5728 32.6936 11.7223 32.8382 11.9851C32.9041 12.1031 32.9346 12.2322 32.9346 12.3597Z" fill="currentColor"/>
                  <path d="M31.2539 9.60024C30.6257 10.214 29.6088 10.214 28.9822 9.60024L20.3164 1.11268L21.4522 0L31.2523 9.60024H31.2539Z" fill="currentColor"/>
                </g>
                <defs>
                  <clipPath id="u-products-2026-arrow-next-{{ sid }}">
                    <rect width="32.9346" height="24.701" fill="white"/>
                  </clipPath>
                </defs>
              </svg>
            </div>

            <div class="u-products-2026__pagination"></div>
          </div>

          {%- if st.show_360_text -%}
            {% comment %} <div class="u-products-2026__view360">{{ st.view360_text }}</div> {% endcomment %}
          {%- endif -%}
        </div>
      </div>

      <div class="u-products-2026__info">
        {%- if st.sale_tag != blank -%}
          <div class="u-products-2026__sale-tag">{{ st.sale_tag }}</div>
        {%- endif -%}

        <h1 class="u-products-2026__title" data-u-p26-title>
          {%- if current_variant.metafields.custom.variant_title != blank -%}
            {{ current_variant.metafields.custom.variant_title }}
          {%- elsif st.title != blank -%}
            {{ st.title }}
          {%- else -%}
            {{ product.title }}
          {%- endif -%}
        </h1>

        <div class="u-products-2026__subtitle" data-u-p26-subtitle>
          {%- if current_variant.metafields.custom.variant_description != blank -%}
            {{ current_variant.metafields.custom.variant_description }}
          {%- elsif current_variant.metafields.custom.product_description != blank -%}
            {{ current_variant.metafields.custom.product_description }}
          {%- else -%}
            {{ st.subtitle }}
          {%- endif -%}
        </div>

        {%- assign badge_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            {%- assign badge_count = badge_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if badge_count > 0 -%}
          <div class="u-products-2026__badges">
            {%- for block in section.blocks -%}
              {%- if block.type == 'badge' -%}
                {%- assign b = block.settings -%}
                <div class="u-products-2026__badge" {{ block.shopify_attributes }}>
                  {%- if b.icon != blank -%}
                    {{ b.icon | image_url: width: 32 | image_tag: loading: 'lazy' }}
                  {%- endif -%}

                  {%- if b.is_warranty_popup -%}
                    <span class="u-products-2026__warranty-wrap">
                      <button
                        type="button"
                        class="u-products-2026__badge-text u-products-2026__warranty-trigger"
                        data-u-p26-warranty-trigger
                        aria-expanded="false"
                      >
                        {{ b.text }}
                      </button>
                      <span class="u-products-2026__warranty-popover" data-u-p26-warranty-popover hidden>
                        <button type="button" class="u-products-2026__warranty-popover-close" data-u-p26-warranty-close aria-label="Close">×</button>
                        <span class="u-products-2026__warranty-popover-content">
                          {{ st.warranty_popup_content }}
                        </span>
                      </span>
                    </span>
                  {%- else -%}
                    <span class="u-products-2026__badge-text">{{ b.text }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="u-products-2026__desc-wrap">
          {%- if st.show_auto_tooltip and st.tooltip_text != blank -%}
            <div class="u-products-2026__tooltip" data-u-p26-auto-tooltip>
              <button type="button" class="u-products-2026__tooltip-close" data-u-p26-tooltip-close aria-label="Close">×</button>
              {{ st.tooltip_text }}
            </div>
          {%- endif -%}

          {%- if product.description != blank -%}
            <div class="u-products-2026__desc-list" data-u-p26-product-description>
              {{ product.description }}
            </div>
          {%- endif -%}
        </div>

        {%- form 'product', product, id: product_form_id, class: 'u-products-2026__form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-u-p26-variant-id>
          <input type="hidden" name="quantity" value="1" data-u-p26-quantity-input>

          {%- unless product.has_only_default_variant -%}
            <div class="u-products-2026__variants">
              {%- for option in product.options_with_values -%}
                {%- assign option_name_down = option.name | downcase -%}

                {%- if option_name_down contains 'color' or option_name_down contains 'colour' or option_name_down contains 'farbe' -%}
                  <div class="u-products-2026__option u-products-2026__option--color">
                    <div class="u-products-2026__option-name">
                      {{ option.name }}:
                      <span data-u-p26-option-label="{{ option.position }}">{{ option.selected_value | default: option.values.first }}</span>
                    </div>

                    <div class="u-products-2026__swatches" data-u-p26-option-position="{{ option.position }}">
                      {%- for value in option.values -%}
                      {%- liquid
                          assign option_handle = value | handle
                          assign swatch_color = '#d9d9d9'
                          assign color_swatch_config = settings.color_swatch_config | newline_to_br | split: '<br />'

                          for color_swatch_item in color_swatch_config
                            assign color_swatch_item = color_swatch_item | strip
                            if color_swatch_item == blank
                              continue
                            endif

                            assign color_swatch_parts = color_swatch_item | split: ':'
                            assign color_swatch_name = color_swatch_parts.first | strip | handle
                            assign color_swatch_value = color_swatch_parts.last | strip

                            if color_swatch_name == option_handle and color_swatch_value != blank
                              assign swatch_color = color_swatch_value
                              break
                            endif
                          endfor
                        -%}
                        <button
                          type="button"
                          class="u-products-2026__swatch {% if option.selected_value == value or forloop.first and option.selected_value == blank %}is-active{% endif %}"
                          data-u-p26-option-value="{{ value | escape }}"
                          data-u-p26-option-index="{{ option.position }}"
                          aria-label="{{ value | escape }}"
                          style="--swatch-bg: {{ swatch_color }};"
                        >
                          <span></span>
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="u-products-2026__price-row">
            <div class="u-products-2026__price-box">
              <span class="u-products-2026__price" data-u-p26-price>
                {%- if current_variant.metafields.custom.page_price != blank -%}
                  {{ current_variant.metafields.custom.page_price | times: 100 | money }}
                {%- else -%}
                  {{ current_variant.price | money }}
                {%- endif -%}
              </span>

              {%- if current_variant.metafields.custom.page_price != blank -%}
                <span class="u-products-2026__compare" data-u-p26-compare-price>
                  {{ current_variant.price | money }}
                </span>
              {%- elsif current_variant.compare_at_price > current_variant.price -%}
                <span class="u-products-2026__compare" data-u-p26-compare-price>
                  {{ current_variant.compare_at_price | money }}
                </span>
              {%- else -%}
                <span class="u-products-2026__compare is-hidden" data-u-p26-compare-price></span>
              {%- endif -%}
            </div>

            {%- if st.price_tag != blank -%}
              <span class="u-products-2026__price-tag">{{ st.price_tag }}</span>
            {%- endif -%}
          </div>

          {%- if st.klarna_text != blank -%}
            <div class="u-products-2026__installment">{{ st.klarna_text }}</div>
          {%- endif -%}

         {%- if st.show_coupon_bar -%}
            <div class="u-products-2026__coupon">
              <div class="u-products-2026__coupon-left">
                <strong>{{ coupon_left_text }}</strong>
                <span>{{ coupon_sub_text }}</span>
              </div>

              {%- if countdown_end_text != blank -%}
                <div class="u-products-2026__coupon-countdown" data-u-p26-countdown="{{ countdown_end_text }}">
                  <div>{{ countdown_label_text }}</div>
                  <div class="u-products-2026__time">
                    <span data-u-p26-days>00</span>
                    <span data-u-p26-hours>00</span>
                    <span data-u-p26-minutes>00</span>
                    <span data-u-p26-seconds>00</span>
                  </div>
                  <div class="u-products-2026__time-label">
                    <span>{{ st.countdown_days_label }}</span>
                    <span>{{ st.countdown_hours_label }}</span>
                    <span>{{ st.countdown_minutes_label }}</span>
                    <span>{{ st.countdown_seconds_label }}</span>
                  </div>
                </div>
              {%- endif -%}

              <button
                type="button"
                class="u-products-2026__coupon-copy"
                data-u-p26-copy
                data-u-p26-copy-code="{{ coupon_code_text | escape }}"
                data-u-p26-copy-default="{{ coupon_copy_text | escape }}"
                data-u-p26-copy-success="{{ coupon_success_text | escape }}"
              >
                <span>{{ coupon_copy_text }}</span>
                <strong>{{ coupon_code_text }}</strong>
              </button>
            </div>
          {%- endif -%}

          <div class="u-products-2026__actions">
            <div class="u-products-2026__qty">
              <button type="button" data-u-p26-qty-minus>-</button>
              <input type="number" min="1" value="1" data-u-p26-qty>
              <button type="button" data-u-p26-qty-plus>+</button>
            </div>

            <button
              type="button"
              class="u-products-2026__atc"
              data-u-p26-atc
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span class="loader-button__text" data-u-p26-atc-text>
                {%- if current_variant.available -%}
                  {{ add_to_cart_text }}
                {%- else -%}
                  {{ sold_out_text }}
                {%- endif -%}
              </span>
              <span class="u-products-2026__loader loader-button__loader" hidden></span>
            </button>
          </div>

          {%- if st.show_dynamic_checkout -%}
            <div class="u-products-2026__dynamic-checkout">
              {{ form | payment_button }}
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- if shipping_notice_text != blank -%}
          <div class="u-products-2026__notice">
            {%- if st.shipping_icon != blank -%}
              {{ st.shipping_icon | image_url: width: 48 | image_tag: loading: 'lazy' }}
            {%- else -%}
              <svg class="u-products-2026__notice-icon" width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <path d="M5 10.5H21.5V24H5V10.5Z" stroke="currentColor" stroke-width="1.4"/>
                <path d="M21.5 15H26.5L30 19.5V24H21.5V15Z" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="10.5" cy="25" r="2.4" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="25.5" cy="25" r="2.4" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            {%- endif -%}
            <div>{{ shipping_notice_text }}</div>
          </div>
        {%- endif -%}

        {%- assign service_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'service_item' -%}
            {%- assign service_count = service_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if service_count > 0 -%}
          <div class="u-products-2026__services">
            {%- for block in section.blocks -%}
              {%- if block.type == 'service_item' -%}
                <div class="u-products-2026__service" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon | image_url: width: 36 | image_tag: loading: 'lazy' }}
                  {%- endif -%}
                  <span>{{ block.settings.text }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

</section>

<style>
  #u-products-2026-{{ sid }} {
    background: var(--u-p26-bg, #fff);
    color: #190a0a;
    padding: 60px 0 50px;
  }

  #u-products-2026-{{ sid }} * {
    box-sizing: border-box;
  }

  #u-products-2026-{{ sid }} .u-products-2026__container {
    width: 100%;
    margin: 0 auto;
  }

  #u-products-2026-{{ sid }} .u-products-2026__grid {
    display: grid;
    grid-template-columns: 55% 45%;
    gap: 30px;
    align-items: start;
  }

  #u-products-2026-{{ sid }} .u-products-2026__media {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 30px;
    position: sticky;
    top: 90px;
  }

  #u-products-2026-{{ sid }} .u-products-2026__thumbs-wrap {
    width: 70px;
  }

  #u-products-2026-{{ sid }} .u-products-2026__thumbs {
    height: 650px;
  }

  #u-products-2026-{{ sid }} .u-products-2026__thumb {
    width: 64px;
    height: 64px;
    border: 1px solid transparent;
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    opacity: .65;
  }

  #u-products-2026-{{ sid }} .u-products-2026__thumb.swiper-slide-thumb-active {
    border-color: #190a0a;
    opacity: 1;
  }

  #u-products-2026-{{ sid }} .u-products-2026__thumb img {
    width: 100%;
  }

  #u-products-2026-{{ sid }} .u-products-2026__gallery-wrap {
    position: relative;
    min-width: 0;
  }

  #u-products-2026-{{ sid }} .u-products-2026__gallery {
    background: #f7f6fb;
    overflow: hidden;
  }

  #u-products-2026-{{ sid }} .u-products-2026__gallery-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1.08 / 1;
  }

  #u-products-2026-{{ sid }} .u-products-2026__gallery-slide img,
  #u-products-2026-{{ sid }} .u-products-2026__gallery-slide video,
  #u-products-2026-{{ sid }} .u-products-2026__gallery-slide iframe,
  #u-products-2026-{{ sid }} .u-products-2026__gallery-slide model-viewer {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #u-products-2026-{{ sid }} .u-products-2026__media-badge {
    position: absolute;
    left: 24px;
    top: 24px;
    z-index: 3;
    width: 112px;
  }

  #u-products-2026-{{ sid }} .u-products-2026__media-badge img {
    width: 100%;
    height: auto;
  }

  #u-products-2026-{{ sid }} .u-products-2026__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    color: #190a0a;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 1;
    transition: opacity .2s ease;
  }

  #u-products-2026-{{ sid }} .u-products-2026__arrow.swiper-button-disabled {
    opacity: .3;
    cursor: default;
    pointer-events: none;
  }

  #u-products-2026-{{ sid }} .u-products-2026__arrow svg {
    display: block;
    width: 33px;
    height: auto;
  }

  #u-products-2026-{{ sid }} .u-products-2026__arrow--prev {
    left: 24px;
  }

  #u-products-2026-{{ sid }} .u-products-2026__arrow--next {
    right: 24px;
  }

  #u-products-2026-{{ sid }} .u-products-2026__pagination {
    display: none;
  }

  #u-products-2026-{{ sid }} .u-products-2026__view360 {
    position: absolute;
    right: 24px;
    bottom: 24px;
    z-index: 3;
    font-size: 18px;
    color: #190a0a;
  }

  #u-products-2026-{{ sid }} .u-products-2026__info {
    position: relative;
    max-width: 600px;
  }

  #u-products-2026-{{ sid }} .u-products-2026__sale-tag {
    display: inline-flex;
    border: 1px solid var(--u-p26-accent, #e0004d);
    color: var(--u-p26-accent, #e0004d);
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 12px;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  #u-products-2026-{{ sid }} .u-products-2026__title {
    margin: 0;
    font-family: var(--heading-font-family);
    font-size: 35px;
    line-height: 1.25;
    font-weight: normal;
    color: #190a0a;
  }

  #u-products-2026-{{ sid }} .u-products-2026__subtitle {
    margin-top: 16px;
    font-size: 18px;
    line-height: 1.4;
    color: #190A0A;
  }

  #u-products-2026-{{ sid }} .u-products-2026__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
