</style>

<script>
  (() => {
    const root = document.getElementById('u-products-2026-{{ sid }}');
    if (!root) return;

    const productData = {{ product | json }};
    const moneyFormat = {{ shop.money_format | json }};
    const currencyCode = {{ cart.currency.iso_code | json }};

    const productMediaArr = [];
    {% for media in product.media %}
      productMediaArr.push({
        id: {{ media.id | json }},
        position: {{ media.position | json }},
        media_type: {{ media.media_type | json }},
        src: {% if media.media_type == 'image' %}{{ media | image_url: width: 2200 | json }}{% elsif media.preview_image %}{{ media.preview_image | image_url: width: 2200 | json }}{% else %}''{% endif %},
        preview: {% if media.preview_image %}{{ media.preview_image | image_url: width: 300 | json }}{% elsif media.media_type == 'image' %}{{ media | image_url: width: 300 | json }}{% else %}''{% endif %},
        alt: {{ media.alt | default: product.title | json }}
      });
    {% endfor %}

    let variantExtraArr = [];
    {% for variant in product.variants %}
      variantExtraArr.push({
        id: {{ variant.id | json }},
        available: {{ variant.available | json }},
        price: {{ variant.price | json }},
        compare_at_price: {{ variant.compare_at_price | json }},
        page_price: {% if variant.metafields.custom.page_price != blank %}{{ variant.metafields.custom.page_price | times: 100 | json }}{% else %}null{% endif %},
        discount_code: {{ variant.metafields.custom.discount_code | default: '' | json }},
        discount_percentage: {{ variant.metafields.custom.discount_percentage | default: '' | json }},
        featured_media_id: {{ variant.featured_media.id | json }},
        featured_media_position: {{ variant.featured_media.position | default: 1 | json }},
        title: {{ variant.metafields.custom.variant_title | default: product.title | json }},
        description: {% if variant.metafields.custom.variant_description != blank %}{{ variant.metafields.custom.variant_description | json }}{% elsif variant.metafields.custom.product_description != blank %}{{ variant.metafields.custom.product_description | json }}{% else %}{{ st.subtitle | json }}{% endif %},
        option1: {{ variant.option1 | json }},
        option2: {{ variant.option2 | json }},
        option3: {{ variant.option3 | json }}
      });
    {% endfor %}

    function addMaxProperty(arr) {
      const sorted = arr.slice().sort((a, b) => {
        return Number(a.featured_media_position || 1) - Number(b.featured_media_position || 1);
      });

      for (let i = 0; i < sorted.length; i++) {
        const current = sorted[i];
        const next = sorted[i + 1];

        current.max = next
          ? Number(next.featured_media_position || productMediaArr.length + 1) - 1
          : productMediaArr.length;
      }

      return arr.map((item) => {
        const found = sorted.find((sortedItem) => String(sortedItem.id) === String(item.id));
        return found || item;
      });
    }

    variantExtraArr = addMaxProperty(variantExtraArr);

    const variantInput = root.querySelector('[data-u-p26-variant-id]');
    const qtyHiddenInput = root.querySelector('[data-u-p26-quantity-input]');
    const priceEl = root.querySelector('[data-u-p26-price]');
    const compareEl = root.querySelector('[data-u-p26-compare-price]');
    const atcBtn = root.querySelector('.u-products-2026__atc');
    const atcText = root.querySelector('[data-u-p26-atc-text]');
    const form = root.querySelector('.u-products-2026__form');

    let thumbsSwiper = null;
    let gallerySwiper = null;
    let swiperInitTimer = null;

    let selectedOptions = [];
    if (productData.options && productData.options.length) {
      const currentVariantId = {{ current_variant.id | json }};
      const currentVariantData = productData.variants.find((variant) => String(variant.id) === String(currentVariantId)) || productData.variants[0];

      selectedOptions = productData.options.map((option, index) => {
        return currentVariantData ? currentVariantData['option' + (index + 1)] : '';
      });
    }

    function formatMoney(cents) {
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, moneyFormat);
      }

      return (cents / 100).toLocaleString(undefined, {
        style: 'currency',
        currency: currencyCode
      });
    }

    function getVariantByOptions() {
      return productData.variants.find((variant) => {
        return selectedOptions.every((value, index) => {
          return variant['option' + (index + 1)] === value;
        });
      });
    }

    function getVariantExtraData(variantId) {
      return variantExtraArr.find((item) => String(item.id) === String(variantId)) || variantExtraArr[0];
    }

    function convertShopifyImageUrl(url, size) {
      if (!url) return '';
      if (url.indexOf('_' + size) > -1) return url;
      return url.replace(/(\.[^/.]+)(\?.*)?$/, '_' + size + '$1$2');
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function initProductImages() {
      const thumbsEl = root.querySelector('#UProducts2026Thumbs-{{ sid }}');
      const galleryEl = root.querySelector('#UProducts2026Gallery-{{ sid }}');

      if (!thumbsEl || !galleryEl) return;

      if (typeof window.Swiper === 'undefined') {
        if (swiperInitTimer) window.clearTimeout(swiperInitTimer);
        swiperInitTimer = window.setTimeout(initProductImages, 100);
        return;
      }

      if (swiperInitTimer) {
        window.clearTimeout(swiperInitTimer);
        swiperInitTimer = null;
      }

      if (thumbsSwiper && thumbsSwiper.destroy) {
        thumbsSwiper.destroy(true, true);
        thumbsSwiper = null;
      }

      if (gallerySwiper && gallerySwiper.destroy) {
        gallerySwiper.destroy(true, true);
        gallerySwiper = null;
      }

      thumbsSwiper = new window.Swiper(thumbsEl, {
        slidesPerView: 'auto',
        spaceBetween: 8,
        watchSlidesProgress: true,
        observer: true,
        observeParents: true,
        direction: 'horizontal',
        breakpoints: {
          992: {
            direction: 'vertical',
            spaceBetween: 12
          }
        }
      });

      gallerySwiper = new window.Swiper(galleryEl, {
        slidesPerView: 1,
        spaceBetween: 10,
        loop: false,
        observer: true,
        observeParents: true,
        thumbs: {
          swiper: thumbsSwiper
        },
        pagination: {
          el: '#u-products-2026-{{ sid }} .u-products-2026__pagination',
          clickable: true
        },
        navigation: {
          nextEl: '#u-products-2026-{{ sid }} .u-products-2026__arrow--next',
          prevEl: '#u-products-2026-{{ sid }} .u-products-2026__arrow--prev'
        }
      });

      window.requestAnimationFrame(() => {
        if (thumbsSwiper && thumbsSwiper.update) thumbsSwiper.update();
        if (gallerySwiper && gallerySwiper.update) gallerySwiper.update();
      });
    }

    function generateMediaHtmlForVariant(variantId) {
      const currentVariant = getVariantExtraData(variantId);
      if (!currentVariant) return;

      const start = Math.max((Number(currentVariant.featured_media_position) || 1) - 1, 0);
      const end = Math.max(Number(currentVariant.max) || productMediaArr.length, start + 1);

      let galleryHtml = '';
      let thumbsHtml = '';

      for (let i = start; i < end; i++) {
        const media = productMediaArr[i];
        if (!media) continue;

        const imageUrl = media.src;
        const thumbUrl = media.preview || media.src;
        const alt = escapeHtml(media.alt || 'Product image');

        thumbsHtml += `
          <div class="swiper-slide u-products-2026__thumb">
            <img src="${convertShopifyImageUrl(thumbUrl, '160x')}" alt="${alt}" loading="lazy">
          </div>
        `;

        galleryHtml += `
          <div class="swiper-slide u-products-2026__gallery-slide" data-media-id="${media.id}">
            <picture>
              <source media="(max-width: 768px)" srcset="${convertShopifyImageUrl(imageUrl, '900x')}">
              <img src="${convertShopifyImageUrl(imageUrl, '1600x')}" alt="${alt}" loading="${i === start ? 'eager' : 'lazy'}" ${i === start ? 'fetchpriority="high"' : ''}>
            </picture>
          </div>
        `;
      }

      const thumbsWrapper = root.querySelector('[data-u-p26-thumbs-wrapper]');
      const galleryWrapper = root.querySelector('[data-u-p26-gallery-wrapper]');

      if (thumbsWrapper) thumbsWrapper.innerHTML = thumbsHtml;
      if (galleryWrapper) galleryWrapper.innerHTML = galleryHtml;

      initProductImages();
    }

    function updateVariant(variant) {
      if (!variant) return;

      const variantExtra = getVariantExtraData(variant.id);

      if (variantInput) variantInput.value = variant.id;

      const finalPrice = variantExtra && variantExtra.page_price ? variantExtra.page_price : variant.price;

      if (priceEl) priceEl.innerHTML = formatMoney(finalPrice);

      if (compareEl) {
        if (variant.compare_at_price && variant.compare_at_price > finalPrice) {
          compareEl.innerHTML = formatMoney(variant.compare_at_price);
          compareEl.classList.remove('is-hidden');
        } else {
          compareEl.innerHTML = '';
          compareEl.classList.add('is-hidden');
        }
      }

      updateCouponByVariant(variantExtra);

      const titleEl = root.querySelector('[data-u-p26-title]');
      const subtitleEl = root.querySelector('[data-u-p26-subtitle]');

      if (titleEl && variantExtra && variantExtra.title) {
        titleEl.innerHTML = variantExtra.title;
      }

      if (subtitleEl && variantExtra && variantExtra.description) {
        subtitleEl.innerHTML = variantExtra.description;
      }

      generateMediaHtmlForVariant(variant.id);

      if (atcBtn && atcText) {
        if (variant.available) {
          atcBtn.disabled = false;
          atcText.innerHTML = {{ add_to_cart_text | json }};
        } else {
          atcBtn.disabled = true;
          atcText.innerHTML = {{ sold_out_text | json }};
        }
      }

      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url.toString());
    }

    function initSwatches() {
      root.querySelectorAll('[data-u-p26-option-value]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const optionIndex = Number(btn.dataset.uP26OptionIndex) - 1;
          const value = btn.dataset.uP26OptionValue;

          selectedOptions[optionIndex] = value;

          const group = btn.closest('[data-u-p26-option-position]');
          if (group) {
            group.querySelectorAll('[data-u-p26-option-value]').forEach((item) => item.classList.remove('is-active'));
          }

          btn.classList.add('is-active');

          const label = root.querySelector(`[data-u-p26-option-label="${optionIndex + 1}"]`);
          if (label) label.textContent = value;

          const variant = getVariantByOptions();
          updateVariant(variant);
        });
      });
    }

    function initQty() {
      const qty = root.querySelector('[data-u-p26-qty]');
      const minus = root.querySelector('[data-u-p26-qty-minus]');
      const plus = root.querySelector('[data-u-p26-qty-plus]');

      if (!qty) return;

      function syncQty(value) {
        let num = parseInt(value, 10);
        if (isNaN(num) || num < 1) num = 1;
        qty.value = num;
        if (qtyHiddenInput) qtyHiddenInput.value = num;
      }

      if (minus) minus.addEventListener('click', () => syncQty(Number(qty.value) - 1));
      if (plus) plus.addEventListener('click', () => syncQty(Number(qty.value) + 1));
      qty.addEventListener('change', () => syncQty(qty.value));

      syncQty(qty.value);
    }

    function updateCouponByVariant(variantExtra) {
      const couponLeft = root.querySelector('.u-products-2026__coupon-left strong');
      const couponCopyBtn = root.querySelector('[data-u-p26-copy]');
      if (!variantExtra || !couponCopyBtn) return;

      const defaultCode = {{ coupon_code_text | json }};
      const defaultLeftText = {{ coupon_left_text | json }};
      const finalCode = variantExtra.discount_code ? String(variantExtra.discount_code).trim() : defaultCode;
      const finalLeftText = variantExtra.discount_percentage ? String(variantExtra.discount_percentage).trim() : defaultLeftText;

      if (couponLeft && finalLeftText) couponLeft.textContent = finalLeftText;
      couponCopyBtn.dataset.uP26CopyCode = finalCode || '';

      const defaultText = couponCopyBtn.dataset.uP26CopyDefault || 'Kopieren';
      couponCopyBtn.innerHTML = '<span>' + defaultText + '</span><strong>' + (finalCode || '') + '</strong>';
    }

    function initCopy() {
      root.querySelectorAll('[data-u-p26-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const code = btn.dataset.uP26CopyCode || '';
          const defaultText = btn.dataset.uP26CopyDefault || 'Kopieren';
          const successText = btn.dataset.uP26CopySuccess || 'Kopiert';

          if (!code) return;

          const renderCopyText = (text) => {
            btn.innerHTML = '<span>' + text + '</span><strong>' + code + '</strong>';
          };

          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(code);
            } else {
              const input = document.createElement('input');
              input.value = code;
              input.setAttribute('readonly', 'readonly');
              input.style.position = 'fixed';
              input.style.left = '-9999px';
              document.body.appendChild(input);
              input.select();
              document.execCommand('copy');
              document.body.removeChild(input);
            }

            renderCopyText(successText);
            window.setTimeout(() => renderCopyText(defaultText), 1800);
          } catch (error) {
            console.warn('Copy coupon code failed:', error);
          }
        });
      });
    }

    function initCountdown() {
      const countdown = root.querySelector('[data-u-p26-countdown]');
      if (!countdown) return;

      const endStr = countdown.dataset.uP26Countdown;
      const endTime = new Date(endStr.replace(/-/g, '/')).getTime();

      if (!endTime) return;

      const daysEl = root.querySelector('[data-u-p26-days]');
      const hoursEl = root.querySelector('[data-u-p26-hours]');
      const minutesEl = root.querySelector('[data-u-p26-minutes]');
      const secondsEl = root.querySelector('[data-u-p26-seconds]');

      function pad(num) {
        return String(num).padStart(2, '0');
      }

      function tick() {
        const now = Date.now();
        let diff = Math.max(0, endTime - now);

        const days = Math.floor(diff / 86400000);
        diff %= 86400000;

        const hours = Math.floor(diff / 3600000);
        diff %= 3600000;

        const minutes = Math.floor(diff / 60000);
        diff %= 60000;

        const seconds = Math.floor(diff / 1000);

        if (daysEl) daysEl.textContent = pad(days);
        if (hoursEl) hoursEl.textContent = pad(hours);
        if (minutesEl) minutesEl.textContent = pad(minutes);
        if (secondsEl) secondsEl.textContent = pad(seconds);
      }

      tick();
      setInterval(tick, 1000);
    }

    function initTooltipAutoHide() {
      const tooltip = root.querySelector('[data-u-p26-auto-tooltip]');
      const close = root.querySelector('[data-u-p26-tooltip-close]');
      if (!tooltip) return;

      const hideTooltip = () => {
        tooltip.style.display = 'none';
      };

      if (close) close.addEventListener('click', hideTooltip);

      document.addEventListener('click', (event) => {
        if (!tooltip.contains(event.target)) {
          hideTooltip();
        }
      });

      setTimeout(hideTooltip, 8000);
    }

    function initWarrantyPopover() {
      const trigger = root.querySelector('[data-u-p26-warranty-trigger]');
      const popover = root.querySelector('[data-u-p26-warranty-popover]');
      const close = root.querySelector('[data-u-p26-warranty-close]');
      if (!trigger || !popover) return;

      let timer = null;

      const hidePopover = () => {
        popover.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        if (timer) {
          clearTimeout(timer);
          timer = null;
        }
      };

      const showPopover = () => {
        popover.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        if (timer) clearTimeout(timer);
        timer = setTimeout(hidePopover, 8000);
      };

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        if (popover.hidden) {
          showPopover();
        } else {
          hidePopover();
        }
      });

      popover.addEventListener('click', (event) => {
        event.stopPropagation();
      });

      if (close) close.addEventListener('click', hidePopover);

      document.addEventListener('click', hidePopover);
    }

    function initAjaxSubmit() {
      if (!atcBtn) return;

      atcBtn.addEventListener('click', async () => {
        if (atcBtn.disabled) return;

        const variantId = variantInput ? variantInput.value : '';
        const quantityInput = root.querySelector('[data-u-p26-qty]');
        const quantity = quantityInput ? Math.max(parseInt(quantityInput.value, 10) || 1, 1) : 1;
        const couponBtn = root.querySelector('[data-u-p26-copy]');
        const discountCode = couponBtn ? couponBtn.dataset.uP26CopyCode || '' : '';

        if (!variantId) return;

        try {
          await addToCartPromise(variantId, atcBtn, {}, discountCode, quantity);
        } catch (error) {
          console.warn(error);
        }
      });
    }

    updateCouponByVariant(getVariantExtraData({{ current_variant.id | json }}));
    generateMediaHtmlForVariant({{ current_variant.id | json }});
    initSwatches();
    initQty();
    initCopy();
    initCountdown();
    initTooltipAutoHide();
    initWarrantyPopover();
    initAjaxSubmit();
  })();
</script>

