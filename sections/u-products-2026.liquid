    #u-products-2026-{{ sid }} .u-products-2026__services {
      padding: 10px 14px;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    #u-products-2026-{{ sid }} .u-products-2026__services::before,
    #u-products-2026-{{ sid }} .u-products-2026__services::after {
      display: none;
    }

    #u-products-2026-{{ sid }} .u-products-2026__service:nth-child(1),
    #u-products-2026-{{ sid }} .u-products-2026__service:nth-child(2),
    #u-products-2026-{{ sid }} .u-products-2026__service:nth-child(3),
    #u-products-2026-{{ sid }} .u-products-2026__service:nth-child(4) {
      grid-column: auto;
    }

    #u-products-2026-{{ sid }} .u-products-2026__service {
      gap: 8px;
      font-size: 12px;
    }

    #u-products-2026-{{ sid }} .u-products-2026__service img {
      width: 18px;
      height: 18px;
    }

    #u-products-2026-{{ sid }} .u-products-2026__modal-dialog {
      padding: 24px 18px;
