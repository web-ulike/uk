      --intro-pb: {{ section.settings.intro_padding_bottom | default: 32 }}px;
      --intro-pt-m: {{ section.settings.intro_mobile_padding_top | default: 28 }}px;
      --intro-pb-m: {{ section.settings.intro_mobile_padding_bottom | default: 20 }}px;
