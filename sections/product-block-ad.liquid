      font-size: 18px;
      line-height: 1.4;
      color: #190A0A;
    }

    @media screen and (max-width: 999px) {
      #shopify-section-{{ section.id }} .product-block-intro__inner {
        padding-top: var(--intro-pt-m);
        padding-bottom: var(--intro-pb-m);
      }

      #shopify-section-{{ section.id }} .product-block-intro__content {
        max-width: 100%;
        margin: 0 auto;
        text-align: center;
      }

      #shopify-section-{{ section.id }} .product-block-intro__heading {
        width: 100%;
        margin: 0 auto;
        text-align: center;
        font-size: 28px;
        line-height: 1.1;
      }

      #shopify-section-{{ section.id }} .product-block-intro__decor-img {
        width: 15px;
        margin-left: 2px;
        vertical-align: top;
        transform: translateY(1px);
      }

      #shopify-section-{{ section.id }} .product-block-intro__subheading {
        margin-top: 10px;
      }

      #shopify-section-{{ section.id }} .product-block-intro__subheading p {
        font-size: 12px;
        line-height: 1.2;
      }
    }
</style>

{% assign image_found = false %}
{% for block in se_bks %}
  {% if block.type == 'p_image' %}
    {% assign image_found = true %}
    {% break %}
  {% endif %}
{% endfor %}
{%- if section.settings.intro_heading != blank or section.settings.intro_subheading != blank -%}
  <div class="product-block-intro">
    <div class="product-block-intro__inner container">
      <div class="product-block-intro__content">
        {%- if section.settings.intro_heading != blank -%}
          <h2 class="product-block-intro__heading">
            <span class="product-block-intro__heading-text">{{ section.settings.intro_heading }}</span>
            {%- if section.settings.intro_decor_image != blank -%}
              {{
                section.settings.intro_decor_image
                | image_url: width: 80
                | image_tag:
                  loading: 'lazy',
                  widths: '40,60,80',
                  class: 'product-block-intro__decor-img',
                  alt: ''
              }}
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.intro_subheading != blank -%}
          <div class="product-block-intro__subheading">
            <p>{{ section.settings.intro_subheading }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}
<div
  class="product-cont {{ section.settings.text6 }} {% if section.settings.is_reverse %}is-reverse-box{% endif %} "
  style="background:{{ section.settings.bg_color }}"
>
  <div class="container">
    {% if section.settings.t_title != blank or section.settings.t_sub != blank %}
      <div class="top-text">
        {% if section.settings.t_title != blank %}
          <div class="top-text-title">
            {{ section.settings.t_title }}
          </div>
        {% endif %}
        {% if section.settings.t_sub != blank %}
          <div class="top-text-sub">
            {{ section.settings.t_sub }}
          </div>
        {% endif %}
      </div>
    {% endif %}
    <div class="product-components product-components_{{se_id}}" id="product-components">
      <div class="product-left-panel">
        <div class="product-left-panel-box">
          <!-- 左侧轮播 -->
          <div class="thumbs-swiper">
            <div class="swiper myThumbs" id="myThumbs_{{ section.id }}">
              <div class="swiper-wrapper">
                <!-- 缩略图 -->
                {% if image_found %}
                  {% for block in se_bks %}
                    {% if block.type == 'p_image' %}
                      <div class="swiper-slide">
                        {% if block.settings.image_p != blank %}
                          <img
                            src="{{ block.settings.image_p | image_url }}"
                            width=""
                            height=""
                            alt="{{ block.settings.image_p | escape }}"
                          >
                        {% endif %}
                      </div>
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {% for item in product.images %}
                    <div class="swiper-slide ">
                      {{- item | image_url: width: 70 | image_tag: loading: 'lazy', draggable: false -}}
                    </div>
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          </div>
          <div class="main-image-swiper">
            {%- if section.settings.show_diy -%}
              <div class="icon-img-top-list">
                {% for block in se_bks %}
                  {% if block.type == 'info' %}
                    {% if section.settings.icon_img_top != blank %}
                      <div class="icon-img-top" data-index="{{ block.settings.index_gif }}">
                        <img
                          src="{{ section.settings.icon_img_top | image_url }}"
                          width=""
                          height=""
                          alt="{{ section.settings.icon_img_top | escape }}"
                          class="icon-img-el"
                        >
                        <span>{{ section.settings.icon_txt }}</span>
                      </div>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            {% else %}
              {% if section.settings.icon_img_top != blank %}
                <div class="icon-img-top">
                  <img
                    src="{{ section.settings.icon_img_top | image_url }}"
                    width=""
                    height=""
                    alt="{{ section.settings.icon_img_top | escape }}"
                    class="icon-img-el"
                  >
                  <span>{{ section.settings.icon_txt }}</span>
                </div>
              {% endif %}
            {% endif %}
            <!-- Swiper主图 -->
            <div class="swiper myGallery" id="myGallery_{{ section.id }}">
              <div class="swiper-wrapper">
                <!-- 主图 -->
                {% if image_found %}
                  {% for block in se_bks %}
                    {% if block.type == 'p_image' %}
                      <div class="swiper-slide">
                        {% if block.settings.image_p != blank %}
                          <img
                            src="{{ block.settings.image_p | image_url }}"
                            width=""
                            height=""
                            alt="{{ block.settings.image_p | escape }}"
                          >
                        {% endif %}
                      </div>
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {% for item in product.images %}
                    <div class="swiper-slide">
                      {% if forloop.first %}
                        {{- item | image_url: width: 1200 | image_tag: loading: 'eager', draggable: false -}}
                      {% else %}
                        {{- item | image_url: width: 1200 | image_tag: loading: 'lazy', draggable: false -}}
                      {% endif %}
                    </div>
                  {% endfor %}
                {% endif %}
              </div>
              <div class="swiper-pagination"></div>
              <div class="swiper-button-prev">
                <img src="https://cdn.shopify.com/s/files/1/0740/5882/6015/files/Artwork_1.png?v=1712483416">
              </div>
              <div class="swiper-button-next">
                <img src="https://cdn.shopify.com/s/files/1/0740/5882/6015/files/Artwork.png?v=1712482544">
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="product-right-panel">
        <div class="tags">
          {% if se_stts.new != '' %}
            <div class="new-tag">{{ se_stts.new }}</div>
          {% endif %}
        </div>
        <div class="title">{{ se_stts.title }}</div>
        <div class="sub-title">{{ se_stts.desc }}</div>
        <div class="shipped-text">{{ se_stts['shipped-text'] }}</div>
        <div class="loox-rating">
          {{ product.metafields.judgeme.badge }}
        </div>

        <div class="info-list">
          <ul class="description">
            {% for block in se_bks %}
              {% if block.type == 'product-desc' %}
                <li>{{ block.settings.name }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
        {%- if section.settings.show_diy -%}
          <div class="info-gift-list">
            {% for block in se_bks %}
              {% if block.type == 'info' %}
                {%- if block.settings.image1 != blank -%}
                  <div class="info-gift info-gift-flex" data-index="{{ block.settings.index_gif }}">
                    <img
                      loading="lazy"
                      class="img"
                      width="{{ block.settings.image1.width }}"
                      height="{{ block.settings.image1.height }}"
                      {% render 'image-attributes', image: block.settings.image1 %}
                      alt="{{ block.settings.image1.alt | escape }}"
                    >
                    <div class="info-gift-txt">
                      <div class="info-gift-title">{{ block.settings.text8 }}</div>
                      <div class="info-gift-p">
                        {{ block.settings.text9 }}
                        <div class="info-gift-r">
                          {{ block.settings.text10 }}
                          <span>{{ block.settings.text11 }}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              {% endif %}
            {% endfor %}
          </div>
        {%- else -%}
          {%- if section.settings.image1 != blank -%}
            <div class="info-gift info-gift-flex">
              <img
                loading="lazy"
                class="img"
                width="{{ section.settings.image1.width }}"
                height="{{ section.settings.image1.height }}"
                {% render 'image-attributes', image: section.settings.image1 %}
                alt="{{ section.settings.image1.alt | escape }}"
              >
              <div class="info-gift-txt">
                <div class="info-gift-title">{{ section.settings.text8 }}</div>
                <div class="info-gift-p">
                  {{ section.settings.text9 }}
                  <div class="info-gift-r">
                    {{ section.settings.text10 }}
                    <span>{{ section.settings.text11 }}</span>
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {% endif %}
        <div class="variants-list{% unless section.settings.show_variants_list %} is-hidden{% endunless %}">
          {%- assign color_swatch_config = settings.color_swatch_config | newline_to_br | split: '<br />' -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_name = option.name -%}
            {% if option_name == 'Color' or option_name == 'Colour' %}
              <div class="color-block swatch_{{ option_name}}">
                <div class="name">
                  {{ option_name }}: <lable>{{ option.values | first }}</lable>
                </div>
                <div
                  class="color-swatch-list"
                  data-diy="{{ image_found }}"
                  data-num="{{ section.settings.text12 }}"
                  data-num1="{{ section.settings.text12_1 }}"
                  option-v="{{ option.values | json }}"
                >
                  {%- assign pin = section.settings.pinned_color_value | default: '' | strip -%}

                  {%- if pin != blank and option.values contains pin -%}
                    {% render 'p-color-swatch-item',
                      value: pin,
                      option: option,
                      se_id: se_id,
                      product: product,
                      color_swatch_config: color_swatch_config
                    %}
                  {%- endif -%}

                  {% for value in option.values %}
                    {%- if pin != blank and value == pin -%}
                      {%- continue -%}
                    {%- endif -%}
                    {% render 'p-color-swatch-item',
                      value: value,
                      option: option,
                      se_id: se_id,
                      product: product,
                      color_swatch_config: color_swatch_config
                    %}
                  {% endfor %}
                </div>
              </div>
            {% else %}
              <div class="plug-block swatch_{{ option_name}}">
                <div class="name">
                  {{ option_name }}: <label>{{ option.values | first }}</label>
                </div>
                <div class="plug-list">
                  {% for value in option.values %}
                    {%- assign variant_for_value = product.variants
                      | where: 'option1', product_selected_variant.option1
                    -%}

                    <div
                      class="item {% if forloop.index0 == 0 %} active {% endif %}"
                      id="{{  variant_for_value[forloop.index0].id }}"
                      name="{{ value }}"
                    >
                      <div class="text">{{ value }}</div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
          <div class="product-box-num">
            <div class="product-box-pam-p">Quantity:</div>
            <div class="product-box-num-flex">
              <div class="product-box-num-tap" data-n="-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="23" height="24" viewBox="0 0 23 24" fill="none">
                  <path d="M5.75 11.425H16.1" stroke="#190A0A" stroke-width="2" stroke-linecap="round"></path>
                </svg>
              </div>
              <input type="number" value="1" class="inp">
              <div class="product-box-num-tap" data-n="1">
                <svg xmlns="http://www.w3.org/2000/svg" width="23" height="24" viewBox="0 0 23 24" fill="none">
                  <path d="M5.75 11.1093H16.1" stroke="#190A0A" stroke-width="2" stroke-linecap="round"></path>
                  <path d="M10.9248 5.9342L10.9248 16.2842" stroke="#190A0A" stroke-width="2" stroke-linecap="round"></path>
                </svg>
              </div>
            </div>
          </div>
          <div class="product-tips">Restocking</div>
        </div>

        {% comment %} 增加礼盒框 {% endcomment %}
        {% for block in se_bks %}
          {% if block.type == 'gift-box' %}
            {%- assign gift_variant_id = block.settings.product_gift_variant_id | strip -%}
            {%- assign gift_variant = block.settings.product_gift.selected_or_first_available_variant -%}
            {%- if gift_variant_id != blank -%}
              {%- assign gift_variant_id_number = gift_variant_id | times: 1 -%}
              {%- for variant in block.settings.product_gift.variants -%}
                {%- if variant.id == gift_variant_id_number -%}
                  {%- assign gift_variant = variant -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            <div
              class="gift-product-box"
              data-id="{{ gift_variant.id }}"
              data-title="{{ gift_variant.metafields.custom["variant_title"] | default: block.settings.product_gift.title }}"
              data-price="{% if gift_variant.metafields.custom["page_price"] != blank %}{{ gift_variant.metafields.custom["page_price"] | times: 100 | money }}{% else %}{{ gift_variant.price | money }}{% endif %}"
              data-images="{% for image in block.settings.product_gift.media %}{{ image | img_url: 'master' }}{% if forloop.last == false %},{% endif %}{% endfor %}"
            >
              <div class="gift-box-content">
                <div class="gift-box-image">
                  <img src="{{ block.settings.image | img_url: 'master' }}" alt="Gift Box">
                </div>
                <div class="gift-box-details">
                  <div class="gift-box-title">
                    <input type="checkbox">
                    <span>{{ block.settings.text }}</span>
                  </div>
                  <div class="gift-box-items">
                    {{ block.settings.content }}
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}

        <div class="price-block">
          <div class="price">
            <div class="price-p">
              {%- if section.settings.pricr != blank -%}
                <div class="dis-price">{{ section.settings.pricr }}</div>
              {%- endif -%}
              {%- assign display_original_price = section.settings.original_price -%}
              {%- if display_original_price == blank and product != blank -%}
                {%- assign display_original_price = product.price | money -%}
              {%- endif -%}
              {%- if display_original_price != blank -%}
                <div class="original-price">{{ display_original_price }}</div>
              {%- endif -%}
            </div>
            {%- if section.settings.text != blank -%}
              <div class="text-code">{{ section.settings.text1 }}</div>
              <div class="copy-box">
                <div class="copy-left">{{ section.settings.text }}</div>
                <div
                  class="copy-right"
                  data-code="{{ section.settings.text1 }}"
                >
