    } else {
      generateHtmlForVariant_{{ se_id }}(); // 没有 swatch 就不传值
    }
  
    let diyBol = $root.find('.color-swatch-list').data('diy')
    let numDiy = $root.find('.color-swatch-list').data('num')
    let numDiy1 = $root.find('.color-swatch-list').data('num1')
    const colorSwatchList = $root.find('.color-swatch');
    let colorSwatchPosition=[];
    
    if(diyBol == true){
      colorSwatchPosition=[1,numDiy*1,numDiy1*1]
    }else{
      colorSwatchList.each(function (index) {
        colorSwatchPosition[index] = Number(this.getAttribute('position')) || 0;
      });
    }

    setTimeout(function(){
      galleryTop_{{ se_id }}.on('slideChangeTransitionEnd', function () {
        let index = galleryTop_{{ se_id }}.realIndex
        galleryThumbs_{{ se_id  }}.slideToLoop(index);
        if(colorSwatchPosition.includes((index*1+1))){
          $('#shopify-section-{{ section.id }} .color-swatch[data-p="'+(index*1+1)+'"]').addClass('active').siblings('.color-swatch').removeClass('active')
          $('#shopify-section-{{ section.id }} .color-swatch[data-p="'+(index*1+1)+'"]').find('input').prop('checked', true);
          $('#shopify-section-{{ section.id }} .color-swatch[data-p="'+(index*1+1)+'"]').siblings('.color-swatch').find('input').prop('checked', false);
          $('#shopify-section-{{ section.id }} .color-swatch').eq(colorSwatchPosition.indexOf(index*1+1 )).click()
        }
        {% if section.settings.show_diy %}
          if(colorSwatchPosition.includes((index*1+1))){
            $('#shopify-section-{{ section.id }} .icon-img-top-list .icon-img-top[data-index="'+ (colorSwatchPosition.indexOf(index*1+1)+1)+'"]').show().siblings('.icon-img-top').hide()
