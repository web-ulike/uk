    // 颜色切换
   $('#shopify-section-{{ section.id }}').on('click', '.product-components .color-swatch', function () {
      let bIndex = $(this).index()
      var inventory_quantity = $(this).attr('inventory_quantity');
      let _position =  $(this).attr('position') - 1;
      var thatVariant = $(this).closest('.variants-list');
      var colorBlock =  $(this).closest('.color-block');
      let pIindex = $(this).index()
      let diy = $(this).parents('.color-swatch-list').data('diy')
      let num = $(this).parents('.color-swatch-list').data('num')
      let num1 = $(this).parents('.color-swatch-list').data('num1')
      // 变体 id
      var vid = $(this).attr('id');

      $(this).addClass('active').siblings('.color-swatch').removeClass('active')

      {% if section.settings.show_diy %}
        $(this).closest('.product-cont').find('.info-gift-list .info-gift').hide()
        $(this).closest('.product-cont').find('.info-gift-list .info-gift[data-index="'+(bIndex + 1)+'"]').css({'display':'flex'});
      {% endif %}
      $('.color-swatch-list .color-swatch__radio[name="option_{{ section.id | replace: "template--", ""  }}"]').removeAttr('checked');
      $(this).find('.color-swatch__radio[name="option_{{ section.id | replace: "template--", ""  }}"]').attr('checked', 'checked');
      // 修改标题
      colorBlock.find('.name lable').text($(this).find('.color-swatch__radio').val());
      {% comment %}  图片跳转 {% endcomment %}
      generateHtmlForVariant_{{ se_id  }}(vid)
      pid_{{ se_id }} = vid

      {% comment %}  处理库存问题 {% endcomment %}
      const $panel = $(this).closest('.product-right-panel');
      const $btn = $panel.find('.btn-group-purchase');
      const $text = $btn.find('.loader-button__text');
      const qty = Number(inventory_quantity);
      const outOfStock = inventory_quantity !== null && inventory_quantity !== "" && !Number.isNaN(qty) && qty <= 0;

      $text.html(outOfStock ?'{{ 'product.form.sold_out' | t }}': '{{ se_stts['group-purchase'] }}');

      $btn.prop('disabled', outOfStock);
      // ✅ 视觉/交互兜底（a/div 也能禁用点击）
      $btn.css({ pointerEvents: outOfStock ? 'none' : '' });

    });

    //规格切换
    $('#shopify-section-{{ section.id }}').on('click', '.product-components .plug-list .item', function () {
      var list = $(this).closest('.plug-block');
      list.find('.item').removeClass('active');
      $(this).addClass('active');
      // 修改标题
      list.find('.name label').text($(this).attr('name'));
      pid_{{ section.id | replace: "template--", ""  }} = $(this).attr('id');
    });

    // more payment
    $('#shopify-section-{{ section.id }}').on('click', '.product-components .more-payment', function () {
      // commonGtmEvent('A10_P_PayOpt', 'click', '');
      $(this).find('.payment-methods-list').toggleClass('active');
    });

    fixBottomBar();
    
    // 折叠
    const myCollswiper = new Swiper('.collapsible-swiper', {
      loop: true, // 循环模式选项
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      lazy: {
        loadPrevNext: true, // 预加载前后两张图片
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });

    $('#shopify-section-{{ section.id }}').on('click', '.box-collapsible-bar .item .box-head', function () {
      var item = $(this).closest('.item');
      if($(item).find('.box-detail').is(":hidden")){
        $(this).find('.add').fadeTo( "slow", 0);
        $(this).find('.minus').fadeTo( "slow", 1);
      } else {
        $(this).find('.add').fadeTo( "slow", 1);
        $(this).find('.minus').fadeTo( "slow", 0);
      }
      $(item).find('.box-detail').slideToggle('slow');
    });

    {% if section.settings.show_time %}
      (function () {
        const countdownEl = document.querySelector('#shopify-section-{{ section.id }} .price-block-countdown');
        if (!countdownEl) return;

        const endTimeSetting = {{ section.settings.text5 | json }};
        const storageKey = 'priceBlockCountdown_{{ section.id }}';
        const dayMs = 1000 * 60 * 60 * 24;
        const hourMs = 1000 * 60 * 60;
        const minuteMs = 1000 * 60;
        let endTime = endTimeSetting ? new Date(endTimeSetting).getTime() : Number(localStorage.getItem(storageKey));

        if (!endTime || Number.isNaN(endTime) || endTime <= Date.now()) {
          endTime = Date.now() + 2 * dayMs;
          localStorage.setItem(storageKey, endTime);
        }

        function formatTime(time) {
          return time < 10 ? `0${time}` : time;
        }

        function updateCountdown() {
          let distance = endTime - Date.now();

          if (distance < 0) {
            endTime = Date.now() + 2 * dayMs;
            localStorage.setItem(storageKey, endTime);
            distance = endTime - Date.now();
          }

          const days = Math.floor(distance / dayMs);
          const hours = Math.floor((distance % dayMs) / hourMs);
          const minutes = Math.floor((distance % hourMs) / minuteMs);
          const seconds = Math.floor((distance % minuteMs) / 1000);

          countdownEl.querySelector('.d').innerHTML = formatTime(days);
          countdownEl.querySelector('.h').innerHTML = formatTime(hours);
          countdownEl.querySelector('.m').innerHTML = formatTime(minutes);
          countdownEl.querySelector('.s').innerHTML = formatTime(seconds);
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
      })();
    {% endif %}

     $('#shopify-section-{{ section.id }}').on('change', '.gift-product-box .gift-box-title input[type="checkbox"]', function () {
      const isChecked = $(this).prop('checked'); // 获取选中状态
      $('.product-components_{{ se_id }} .color-swatch-list .color-swatch').eq(0).click();
      // 勾选设置值
      if(isChecked){
        const title = $('.gift-product-box').data('title');
        const images = $('.gift-product-box').data('images').split(',');
        setTimeout(function(){
          $('.product-components_{{ se_id }} .title').html(title);
          let id = $('.gift-product-box').data('id');
          // 设置图片
          pid_{{ se_id }} = id;
          $('.buy-buttons-pid').val(id);
          generateGiftHtml_{{ se_id }}(images);
          initProductImages_{{ se_id }}();
        }, 200)
        $('.product-components_{{ se_id }} .color-block').attr('data-disabled', 'true') // 标记禁用状态
        .css({
          'pointer-events': 'none', // 禁用交互
          'opacity': '0.5',         // 设置透明度
          'cursor': 'not-allowed'  // 鼠标不可用样式
        });
      } else {
        $('.product-components_{{ se_id }} .color-block').attr('data-disabled', 'false') // 移除禁用状态
        .css({
          'pointer-events': '', // 恢复默认值
          'opacity': '',        // 恢复默认值
          'cursor': ''         // 恢复默认值
        });
      }
    })

   // edit 0124 礼品购买切换
   $('#shopify-section-{{ section.id }}').on('click', '.gift-product-box .gift-box-title', function () {
      // 防止点击复选框时重复触发
      if ($(event.target).is('input[type="checkbox"]')) {
        return;
      }
      // 找到当前标题下的复选框
      const $checkbox = $(this).find('input[type="checkbox"]');
      // 切换选中状态
      const isChecked = $checkbox.prop('checked');
      $checkbox.prop('checked', !isChecked).trigger('change'); // 手动触发 change 事件
    });
    
  });

  function generateGiftHtml_{{ section.id | replace: "template--", ""  }}(images){
    let _productHtml = '';
    for (let i = 0; i < images.length; i++) {
      let imageUrl = images[i];
      let itemMainHtml = '';
      let alt = 'Ulike Product Image';
      // 第一个直接加载 eager
      let loadingAttr = 'loading="lazy"';
      itemMainHtml = `<img class="product__image" ${loadingAttr} src="${imageUrl}"  alt="${alt}" >`;
      _productHtml += `<div class="swiper-slide">${itemMainHtml}</div>`;
    }
    setTimeout(function(){
      $('#myThumbs_{{ section.id }} .swiper-wrapper').html(_productHtml);
      $('#myGallery_{{ section.id }} .swiper-wrapper').html(_productHtml);
      initProductImages_{{ section.id | replace: "template--", ""  }}();
    }, 100)
  }

  function initProductImages_{{ se_id }}() {
    // thumbs
    if (galleryThumbs_{{ se_id }} && galleryThumbs_{{ se_id }}.destroy) {
      galleryThumbs_{{ se_id }}.destroy(true, true);
      galleryThumbs_{{ se_id }} = null;
    }

    galleryThumbs_{{ se_id }} = new Swiper('#myThumbs_{{ section.id }}', {
      slidesPerView: 'auto',
      freeMode: true,
      watchSlidesProgress: true,
      lazy: { loadPrevNext: true },

      direction: 'horizontal',
      spaceBetween: 8,

      breakpoints: {
        1024: {
          direction: 'vertical',
          spaceBetween: 15
        }
      }
    });

    // top
    if (galleryTop_{{ se_id }} && galleryTop_{{ se_id }}.destroy) {
      galleryTop_{{ se_id }}.destroy(true, true);
      galleryTop_{{ se_id }} = null;
    }

    galleryTop_{{ se_id }} = new Swiper('#myGallery_{{ section.id }}', {
      lazy: { loadPrevNext: true },
      spaceBetween: 10,
      loop: true,

      // ✅ 作用域到当前 section，避免多 section 冲突
      navigation: {
        nextEl: '#shopify-section-{{ section.id }} .swiper-button-next',
        prevEl: '#shopify-section-{{ section.id }} .swiper-button-prev'
      },

      thumbs: {
        swiper: galleryThumbs_{{ se_id }}
      }
    });
  }

  {% comment %} 置底栏 {% endcomment %}
  function fixBottomBar() {
    var topBar = $("#top-bar");
    let barTop = $('#product-components').offset().top + 150;
    $(window).scroll(function() {
      if ($(this).scrollTop() > barTop) {
          topBar.addClass("toolbar-fixed");
      } else {
          topBar.removeClass("toolbar-fixed");
      }
    });
  }

  function generateHtmlForVariant_{{ se_id }}(vid) {

    let currentVariant = !vid ? variantArr_{{ se_id }}[0] : vid;
    if (vid) {
      currentVariant = variantArr_{{ se_id }}.filter(item => item.vid == vid)[0];
    }
    // ✅ 1) 取主题图（你已经有对象了：variantThemeMap_{{ se_id }}）
    var themeUrl = (variantThemeMap_{{ se_id }} || {})[currentVariant.vid];
    
    const { position, max } = currentVariant;

    let _productHtml = '';
    let _productnavHtml = '';

    // ✅ 2) 如果匹配到主题图，先插入首图
    if (themeUrl) {
      if (themeUrl.indexOf('//') === 0) themeUrl = location.protocol + themeUrl;
      _productHtml += `
        <div class="swiper-slide" data-theme="1">
          <picture>
            <source media="(max-width: 768px)" srcset="${themeUrl}">
            <img class="product__media-image" fetchpriority="high" src="${themeUrl}" alt="Theme image">
          </picture>
        </div>`;
    }

    // ✅ 3) 再输出原本该变体区间的 media
    for (let i = position - 1; i < max; i++) {
      const ths = productMediaArr_{{ se_id }}[i];
      let imageUrl = ths.src;
      let itemMainHtml = '';
      ths.alt = ths.alt ? ths.alt : 'Ulike Product Image';

      // 第一个产品图是否还要高优先级：如果已经有主题图，则这里不再 fetchpriority
      let isFirstProduct = i == position - 1;
      let loadingAttr = (isFirstProduct && !themeUrl) ? 'fetchpriority="high"' : 'loading="lazy"';

      const pictureElement = `
        <picture>
          <source media="(max-width: 768px)" srcset="${convertShopifyImageUrl(imageUrl, '800x')}">
          <img class="product__media-image" ${loadingAttr} src="${convertShopifyImageUrl(imageUrl, '1740x')}" alt="${ths.alt}" media_type="${ths.media_type}">
        </picture>
      `;

      if (ths.media_type == 'video') {
        itemMainHtml = generateVideoHtml(ths.sources);
      } else {
        itemMainHtml = pictureElement;
      }

      _productHtml += `<div class="swiper-slide">${itemMainHtml}</div>`;
    }

    setTimeout(function () {
      $('#myThumbs_{{ section.id }} .swiper-wrapper').html(_productHtml);
      $('#myGallery_{{ section.id }} .swiper-wrapper').html(_productHtml);
      initProductImages_{{ section.id | replace: "template--", "" }}();

      if(currentVariant.variantTitle != ''){
        $('.product-components_{{ se_id }} .title').html(currentVariant.variantTitle);
      }
    }, 10)
  }


  function convertShopifyImageUrl(url, size) {
    return url.replace(/(\.[^/.]+)$/, `_${size}$1`);
  }
</script>

