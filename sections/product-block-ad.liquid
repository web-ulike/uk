        {% endif %}
        buyProduct(pid_{{ section.id | replace: "template--", ""  }}, giftParam, $(this).closest('.product-cont').find('.copy-right').attr('data-code') || '', quantity)
    })

    // 加减数量
      $('#shopify-section-{{ section.id }}').on('click','.product-box-num-tap',function () {
        let inp = $(this).siblings('.inp')
