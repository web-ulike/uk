      var defaultCode = '{{ section.settings.text1 }}';
      var copyCodeText = $(this).attr('data-code') || defaultCode;
      var copyButtonText = $(this).html();
      if (typeof copyCode === 'function') {
        copyCode(copyCodeText, copyButtonText, this);
      } else if (typeof copyCodeFun === 'function') {
        copyCodeFun(copyCodeText);
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(copyCodeText);
