    function addMaxProperty(arr) {
      for (let i = 0; i < arr.length; i++) {
          if (i < arr.length - 1) {
            arr[i].max = arr[i + 1].position - 1;
          } else {
            arr[i].max = Number('{{ product.media  | size }}'); // 最后一个对象的 max 被设置为 最大值
          }
      }
      return arr;
    }
    
    variantArr_{{ se_id }} = addMaxProperty(variantArr_{{ se_id  }});
 
  let galleryThumbs_{{ se_id }} = null;
  let galleryTop_{{ se_id }} = null;

  document.addEventListener('DOMContentLoaded', function () {

    var $root = $('#shopify-section-{{ section.id }}');
    var $firstSwatch = $root.find('.color-swatch-list .color-swatch').first();

    if ($firstSwatch.length) {
