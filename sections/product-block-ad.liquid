    #shopify-section-{{ section.id }} .product-block-intro__decor-img {
      display: inline-block !important;
      width: 30px;
      height: auto;
      margin-left: 4px;
      vertical-align: top;
      transform: translateY(2px);
      float: none !important;
      position: static !important;
    }

    #shopify-section-{{ section.id }} .product-block-intro__subheading {
      margin-top: 20px;
    }

    #shopify-section-{{ section.id }} .product-block-intro__subheading p {
