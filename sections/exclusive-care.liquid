<style>
         #shopify-section-{{ section.id }} {
      --section-background: {{ section.settings.background }};
       background: var(--section-background);
   }
     .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px);
    padding-bottom: calc({{ section.settings.padding_bottom }}px);
  }
@media screen and (max-width: 768px){
  .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.mobile_padding_top }}px);
    padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px );
  }
}
    :root{
     --figma-breakpoint-2xl: 1920;
    }
    .exclusive-care-space{
      /* overflow: hidden; */
    }
    /* exclusive-care-space start */
    .exclusive-care-space-box{
      background-color: #FBFAF4;
    height: 200lvh;
    /* overflow: hidden; */
    position: relative;
    width: 100%;
    }
.exclusive-care-space__image{
      display: block;
    height: auto;
    position: absolute;
}
.exclusive-care-space__image--1{
  left: calc(60 / var(--figma-breakpoint-2xl) * 100svw);
    top: 36%;
    width: calc(326 / var(--figma-breakpoint-2xl) * 100svw);
}
.exclusive-care-space__image--2{
  left: calc(466 / var(--figma-breakpoint-2xl) * 100svw);
    top: 68%;
    width: calc(411 / var(--figma-breakpoint-2xl) * 100svw);
}
.exclusive-care-space__image--3{
  left: calc(1012 / var(--figma-breakpoint-2xl) * 100svw);
    top: 56%;
    width: calc(435 / var(--figma-breakpoint-2xl) * 100svw);
}
.exclusive-care-space__image--4{
  left: calc(1558 / var(--figma-breakpoint-2xl) * 100svw);
    top: 40%;
    width: calc(292 / var(--figma-breakpoint-2xl) * 100svw);
}
.exclusive-care-space-content{
      /* align-items: center; */
    display: flex;
    height: 100lvh;
    left: 0;
    position: sticky;

    top: 0;
    width: 100%;
}
.exclusive-care-space-wrapper{
      display: flex;
    gap: calc(191 / var(--figma-breakpoint-2xl) * 100svw);
    padding-left: calc(456 / var(--figma-breakpoint-2xl) * 100svw);
        padding-top: 17%;
    width: 100%;
}
.exclusive-care-space-wrapper .exclusive-care-space-tle{
  color:  #190A0A;
font-size: calc(44 / var(--figma-breakpoint-2xl) * 100svw);
font-style: normal;
font-weight: 400;
line-height: 120%;
width: calc(323 / var(--figma-breakpoint-2xl) * 100svw);
}
.exclusive-care-space-wrapper .exclusive-care-space-txt{
color:  #3F3636;
font-size: calc(18 / var(--figma-breakpoint-2xl) * 100svw);
font-style: normal;
font-weight: 400;
line-height: 150%;
display: flex;
flex-direction: column;
gap: 20px;
width: calc(509 / var(--figma-breakpoint-2xl) * 100svw);
}
  @media screen and (max-width: 1023px) {
        :root{
     --figma-breakpoint-2xl: 375;
    }
    .exclusive-care-space-box{
          background-color: #FFF;
    }
   .exclusive-care-space__image--1{
  left: calc(175 / var(--figma-breakpoint-2xl) * 100svw);
    top: 65%;
    width: calc(180 / var(--figma-breakpoint-2xl) * 100svw);
}
.exclusive-care-space__image--2{
  left: calc(20 / var(--figma-breakpoint-2xl) * 100svw);
    top: 77%;
    width: calc(178 / var(--figma-breakpoint-2xl) * 100svw);
}
.exclusive-care-space__image--3{
  left: calc(20 / var(--figma-breakpoint-2xl) * 100svw);
    top: 20%;
    width: calc(111 / var(--figma-breakpoint-2xl) * 100svw);
}
.exclusive-care-space__image--4{
  left: calc(156 / var(--figma-breakpoint-2xl) * 100svw);
    top: 5%;
    width: calc(199 / var(--figma-breakpoint-2xl) * 100svw);
}
.exclusive-care-space-content{
  align-items: center;
}
.exclusive-care-space-wrapper{
  gap: calc(10 / var(--figma-breakpoint-2xl) * 100svw);
    padding-left: 0;
    padding-top: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
}
.exclusive-care-space-wrapper .exclusive-care-space-tle{
      font-size: calc(24 / var(--figma-breakpoint-2xl) * 100svw);
    width: calc(291 / var(--figma-breakpoint-2xl) * 100svw);
}
.exclusive-care-space-wrapper .exclusive-care-space-txt {
    font-size: calc(12 / var(--figma-breakpoint-2xl) * 100svw);
    gap: 20px;
    width: calc(311 / var(--figma-breakpoint-2xl) * 100svw);
}
  }
    /* exclusive-care-space end */
</style>

  <section>
  <div class="exclusive-care-space">
    <div class="exclusive-care-space-box">
         {% for block in section.blocks %}
       <picture class="exclusive-care-space__image exclusive-care-space__image--{{ forloop.index }}"   data-speed="{{ block.settings.speed }}" mobile-data-speed="{{ block.settings.mobile_speed }}">
        {%- if block.settings.image_mobile -%}
          <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url }}">
               {%- endif -%}
           {%- if block.settings.image -%}
          <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt }}" decoding="async">
            {%- endif -%}
      </picture>
    {% endfor %}
      <div class="exclusive-care-space-content">
        <div class="exclusive-care-space-wrapper">
            <div class="exclusive-care-space-tle js-bounce" aria-label="{{ section.settings.tle }}" data-repeat="true"></div>
          <div class="exclusive-care-space-txt to-top" data-repeat="true">
          {{ section.settings.txt }}
          </div>
        </div>
      </div>
    </div>
  </div>
  </section>

<script>

{% schema %}
{
  "name": "exclusive-care",
  "settings": [
    {
      "type": "text",
      "id": "tle",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "txt",
      "label": "Text"
    },
       {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
        "type": "item",
        "name": "item",
        "settings": [
                          {
          "type": "image_picker",
          "id": "image",
          "label": "Images"
        },
     {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Images"
        },
        {
  "type": "range",
  "id": "speed",
  "label": "Desktop speed",
  "min": 1,
  "max": 10,
  "step": 1,
  "default": 3
},
{
  "type": "range",
  "id": "mobile_speed",
  "label": "Mobile speed",
  "min": 1,
  "max": 10,
  "step": 1,
  "default": 3
}
        ]
      }
  ],
  "presets": [
    {
      "name": "exclusive-care",
      "settings": {},
      "blocks": [
      ]
    }
  ]
}
{% endschema %}