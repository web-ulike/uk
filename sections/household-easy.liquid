<style>
         #shopify-section-{{ section.id }} {
      --section-background: {{ section.settings.background }};
       background: var(--section-background);
   }
     .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px);
    padding-bottom: calc({{ section.settings.padding_bottom }}px);
  }
@media screen and (max-width: 768px){
  .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.mobile_padding_top }}px);
    padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px );
  }
}
   /* household-easy start */
   .household-easy{
    padding: 120px 0;
    overflow: hidden;
   }
   .household-easy-header{
    display: flex;
    justify-content: space-between;
    margin-bottom: 100px;
   }
   .household-easy-header h3{
    color:  #3F3636;
        font-family: 'Sans';
font-size: 48px;
font-style: normal;
font-weight: 400;
line-height: 120%;
max-width: 624px;
margin: 0;
   }
   .household-easy-header .household-header-txt{
    color:  #3F3636;
        font-family: 'Sans';
        font-size: 18px;
font-style: normal;
font-weight: 400;
line-height: 150%;
max-width: 573px;
   }
.household-easy-ico{
  display: flex;
  justify-content: space-between;
  margin-bottom: 40px;
}
.household-easy-ico img{
  width: 58px;

}
.household-easy-ico .household-ico-txt{
margin-top: 15px;
color:  #3F3636;
font-size: 20px;
font-style: normal;
font-weight: 570;
line-height: 125%;
}
.household-easy-swiper-wrapper{
  display: flex;
  gap: 17px;
}
.household-easy-swiper-wrapper .swiper-slide{
  flex-shrink: 1;
}
  @media screen and (max-width: 1023px) {
    .household-easy-header{
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 30px;
    }
    .household-easy-header h3{
      font-size: 24px;
      margin-bottom: 10px;
    }
    .household-easy-header .household-header-txt{
      font-size: 12px;

    }
    .household-easy-swiper-wrapper .swiper-slide{
      flex-shrink: 0;
    }
    .household-easy-ico{
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 30px 56px;
    }
    .household-easy-ico img{

    }
    .household-ico-item{
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .household-easy-ico .household-ico-txt{
      font-size: 12px;
    }
  }
   /* household-easy end */
</style>

  <section>

  <div class="household-easy">
    <div class="container">
      <div class="household-easy-header">
        <h3 class="js-bounce"  aria-label="{{ section.settings.tle }}" data-repeat="true"></h3>
        <div class="household-header-txt to-top" style="transition-delay: 0.2s;">{{ section.settings.txt }}</div>

      </div>
      <div class="household-easy-ico">
           {% for block in section.blocks %}
        <div class="household-ico-item to-top" style="transition-delay: 0.3s;">
          <img src="./images/uk-brand/doctor1.svg" alt="" loading="lazy">
          <div class="household-ico-txt">NO TIME CONSUMING</div>
        </div>
           {% endfor %}

        <div class="household-ico-item to-top" style="transition-delay: 0.5s;">
          <img src="./images/uk-brand/doctor1.svg" alt="" loading="lazy">
          <div class="household-ico-txt">NO TIME CONSUMING</div>
        </div>
        <div class="household-ico-item to-top" style="transition-delay: 0.7s;">
          <img src="./images/uk-brand/doctor1.svg" alt="" loading="lazy">
          <div class="household-ico-txt">NO TIME CONSUMING</div>
        </div>
        <div class="household-ico-item to-top" style="transition-delay: 0.9s;">
          <img src="./images/uk-brand/doctor1.svg" alt="" loading="lazy">
          <div class="household-ico-txt">NO TIME CONSUMING</div>
        </div>
      </div>


        <custom-swiper-new 
  slides-per-view="1.3" 
  space-between="5" 
  loop="false" 
  centered-slides="false"
  pagination="true"
  navigation="true"
  disable-on="desktop"
  breakpoints='{"768":{"slidesPerView": 2,"spaceBetween": 0}}'
>
      <div class="household-easy-swiper-container swiper-container to-top" style="transition-delay: 0.9s;">
        <div class="household-easy-swiper-wrapper swiper-wrapper">



              {% for block in section.blocks %}
          <div class="household-easy-swiper-slide swiper-slide">
            <picture class="household-easy-swiper-pic">
              <source media="(min-width: 1024px)" srcset="./images/uk-brand/household1.png">
              <img src="./images/uk-brand/household1.png" alt="" loading="lazy">
            </picture>
          </div>

   {% endfor %}




        </div>
      </div>
      </custom-swiper-new>

    </div>
  </div>
  </section>

<script>

{% schema %}
{
  "name": "household-easy",
  "settings": [
    {
      "type": "text",
      "id": "tle",
      "label": "Title"
    },
        {
      "type": "text",
      "id": "txt",
      "label": "Text"
    },
               {
          "type": "image_picker",
          "id": "image",
          "label": "Images"
        },
     {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Images"
        },

  {
      "type": "text",
      "id": "product_name",
      "label": "Product Name"
    },
           {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Images"
        },
          {
          "type": "text",
          "id": "link_txt",
          "label": "Link text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
  ],
  "blocks": [
    {
        "type": "item",
        "name": "item",
        "settings": [
            {
      "type": "text",
      "id": "txt",
      "label": "Text"
    },
        ]
      }
  ],
  "presets": [
    {
      "name": "household-easy",
      "settings": {},
      "blocks": [
      ]
    }
  ]
}
{% endschema %}