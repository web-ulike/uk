{% style %}
  #shopify-section-{{ section.id }} .guide-feature-banner {
    position: relative;
    height: 36.458vw;
    min-height: 500px;
    max-height: 700px;
    overflow: hidden;
    background: #d7d7de;
    color: #190a0a;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__slide {
    position: absolute;
    inset: 0;
    visibility: hidden;
    opacity: 0;
    transition: opacity .45s ease, visibility .45s ease;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__slide.is-active {
    visibility: visible;
    opacity: 1;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__image {
    position: absolute;
    top: -29.5%;
    left: 0;
    display: block;
    width: 100%;
    height: 160.7%;
    max-width: none;
    object-fit: fill;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__slide--ipl {
    background: linear-gradient(193deg, #d5dce4 2%, #faf9f9 74%);
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__slide--ipl .guide-feature-banner__art {
    top: 0;
    height: 104.3%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__mobile-image {
    display: none;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__content {
    position: absolute;
    top: 18.5%;
    left: max(40px, calc((100% - 1520px) / 2));
    z-index: 2;
    width: min(700px, calc(100% - 160px));
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__title {
    margin: 0;
    color: inherit;
    font-family: var(--heading-font-family);
    font-size: 48px;
    font-weight: 500;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__description {
    margin-top: 16px;
    font-size: 20px;
    font-weight: 300;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__description--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__button {
    display: inline-flex;
    min-width: 155px;
    height: 48px;
    align-items: center;
    justify-content: center;
    margin-top: 92px;
    padding: 0 20px;
    border: 1px solid #3f3636;
    border-radius: 4px;
    background: #fff;
    color: #190a0a;
    font-family: var(--heading-font-family);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition: background .2s ease, color .2s ease;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__button:hover {
    background: #190a0a;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__pagination {
    position: absolute;
    top: calc(18.5% + 132px);
    left: max(40px, calc((100% - 1520px) / 2));
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__dot {
    display: block;
    width: 10px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 23px;
    background: #cacaca;
    cursor: pointer;
    transition: width .2s ease, background .2s ease;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__dot[aria-current="true"] {
    width: 24px;
    background: #190a0a;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    padding: 0;
    transform: translateY(-50%);
    border: 1px solid #190a0a;
    border-radius: 4px;
    background: #fff;
    color: #190a0a;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__arrow[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__prev {
    left: 60px;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__next {
    right: 100px;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__arrow svg {
    width: 20px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .guide-feature-banner__prev svg {
    transform: rotate(180deg);
  }

  @media screen and (min-width: 768px) and (max-width: 1200px) {
    #shopify-section-{{ section.id }} .guide-feature-banner__title {
      font-size: 36px;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__description {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__next {
      right: 40px;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__prev {
      left: 20px;
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .guide-feature-banner {
      height: 500px;
      min-height: 0;
      max-height: none;
      background: #f6f6f6;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__image {
      top: auto;
      bottom: -6px;
      left: 50%;
      width: 168%;
      height: auto;
      transform: translateX(-50%);
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__mobile-image {
      top: 0;
      bottom: auto;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: none;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__slide--ipl .guide-feature-banner__art {
      top: 0;
      right: 0;
      bottom: auto;
      left: auto;
      width: 140.53%;
      height: 100%;
      object-fit: cover;
      transform: none;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__slide--custom-mobile .guide-feature-banner__art {
      display: none;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__slide--custom-mobile .guide-feature-banner__mobile-image {
      display: block;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__content {
      top: 40px;
      right: 20px;
      left: 19px;
      width: auto;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__title {
      font-size: 24px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__description {
      max-width: 215px;
      margin-top: 8px;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__description--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__description--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__button {
      min-width: 108px;
      height: 34px;
      margin-top: 24px;
      padding: 0 15px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__pagination {
      top: auto;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
    }

    #shopify-section-{{ section.id }} .guide-feature-banner__arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .guide-feature-banner__slide,
    #shopify-section-{{ section.id }} .guide-feature-banner__dot {
      transition: none;
    }
  }
{% endstyle %}

<section class="guide-feature-banner" data-guide-feature-banner>
  {% for block in section.blocks %}
    {% liquid
      assign desktop_image = block.settings.desktop_image
      assign mobile_image = block.settings.mobile_image
    %}
    <div
      id="guide-feature-slide-{{ section.id }}-{{ block.id }}"
      class="guide-feature-banner__slide{% if forloop.first %} is-active{% endif %}"
      data-guide-feature-slide
      {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
      {{ block.shopify_attributes }}
    >
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: 767px)"
            srcset="{{ mobile_image | image_url: width: 1200 }}"
          >
        {% endif %}
        {% if desktop_image != blank %}
          {{ desktop_image | image_url: width: 2400 | image_tag: class: 'guide-feature-banner__image', loading: 'lazy', sizes: '100vw', widths: '750,1100,1500,1920,2400' }}
        {% else %}
          <img
            class="guide-feature-banner__image"
            src="{{ 'guide-feature-skin-2026.png' | asset_url }}"
            alt=""
            width="1024"
            height="572"
            loading="lazy"
          >
        {% endif %}
      </picture>

      <div class="guide-feature-banner__content">
        {% if block.settings.title != blank %}
          <h2 class="guide-feature-banner__title">{{ block.settings.title | escape }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="guide-feature-banner__description">{{ block.settings.description }}</div>
        {% endif %}
        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <a class="guide-feature-banner__button" href="{{ block.settings.button_link }}">
            {{ block.settings.button_text | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  {% endfor %}

  {% if section.blocks.size > 1 %}
    <div class="guide-feature-banner__pagination" aria-label="Slide navigation">
      {% for block in section.blocks %}
        <button
          class="guide-feature-banner__dot"
          type="button"
          aria-label="Go to slide {{ forloop.index }}"
          aria-controls="guide-feature-slide-{{ section.id }}-{{ block.id }}"
          data-guide-feature-dot="{{ forloop.index0 }}"
          {% if forloop.first %}aria-current="true"{% endif %}
        ></button>
      {% endfor %}
    </div>
    <button class="guide-feature-banner__next" type="button" aria-label="Next slide" data-guide-feature-next>
      <svg viewBox="0 0 20 16" fill="none" aria-hidden="true" focusable="false">
        <path d="M1 8H18M12 2L18 8L12 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  {% endif %}
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const banner = section.querySelector('[data-guide-feature-banner]');
    if (!banner) return;
    const slides = [...banner.querySelectorAll('[data-guide-feature-slide]')];
    const dots = [...banner.querySelectorAll('[data-guide-feature-dot]')];
    const next = banner.querySelector('[data-guide-feature-next]');
    if (slides.length < 2) return;

    let current = 0;
    let touchStartX = null;
    const show = (index) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === current;
        slide.classList.toggle('is-active', active);
        slide.toggleAttribute('inert', !active);
        if (active) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, dotIndex) => {
        if (dotIndex === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));
    next?.addEventListener('click', () => show(current + 1));
    banner.addEventListener('touchstart', (event) => {
      touchStartX = event.touches[0]?.clientX ?? null;
    }, { passive: true });
    banner.addEventListener('touchend', (event) => {
      if (touchStartX === null) return;
      const distance = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(distance) > 40) show(current + (distance < 0 ? 1 : -1));
      touchStartX = null;
    }, { passive: true });
    section.addEventListener('shopify:block:select', (event) => {
      const index = slides.findIndex((slide) => slide === event.target || slide.contains(event.target));
      if (index >= 0) show(index);
    });
  })();
</script>

{% schema %}
{
  "name": "Guide feature banner 2026",
  "tag": "section",
  "class": "section-guide-feature-banner-2026",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Uses desktop image when blank." },
        { "type": "text", "id": "title", "label": "Title", "default": "Which one is suitable for me?" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Recommended based on skin tone, hair color and usage scenarios</p>" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "LEARN MORE" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide feature banner 2026",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "Which one is suitable for me?",
            "description": "<p>Recommended based on skin tone, hair color and usage scenarios</p>",
            "button_text": "LEARN MORE",
            "button_link": "/pages/ipl-quiz"
          }
        }
      ]
    }
  ]
}
{% endschema %}
