<style>
         #shopify-section-{{ section.id }} {
      --section-background: {{ section.settings.background }};
       background: var(--section-background);
   }
     .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px);
    padding-bottom: calc({{ section.settings.padding_bottom }}px);
  }
@media screen and (max-width: 768px){
  .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.mobile_padding_top }}px);
    padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px );
  }
}

</style>

  <section>
  <div class="brand-img-cnt">
     <picture class="brand-img-cnt-pic to-top">
              <source media="(min-width: 1024px)" srcset="./images/uk-brand/3-1.png">
              <img src="./images/uk-brand/mob-3-1.png" alt="" loading="lazy">
            </picture>
    <div class="brand-img-cnt-box">
      <div class="container">
      <div class="brand-img-cnt-box-wrp">
         <h3 class="js-bounce"  aria-label="The Experience" data-repeat="true"></h3>
        <div class="brand-img-cnt-txt to-top" data-repeat="true">Guests move through a calming, thoughtfully designed space, experiencing how effortless smooth skin can be —without the time, pain, or upkeep of traditional methods.</div>
      </div>
      </div>
    </div>
  </div>
  </section>

