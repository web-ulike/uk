{% style %}
.technology-slider-cus {
  width: 100%;
  padding-top: var(--padding-top);
  padding-bottom: var(--padding-bottom);
  overflow: hidden;
  color: var(--text-color);
  background: var(--section-bg);
}

.technology-slider-cus custom-swiper { display: block; width: 100%; }

.technology-slider-cus .technology-slider__header {
  margin-bottom: 61px;
  text-align: center;
}

.technology-slider-cus .technology-slider__title {
  margin: 0;
  color: inherit;
  font-size: 44px;
  font-weight: 400;
  line-height: 1.2;
      font-family: var(--heading-font-family);
}

.technology-slider-cus .technology-slider__subtitle {
  margin-top: 16px;
  color: inherit;
  font-size: 20px;
  line-height: 1.5;
}

.technology-slider-cus .technology-slider__subtitle p { margin: 0; }

.technology-slider-cus .swiper-container { width: 100%; overflow: visible; }
.technology-slider-cus .swiper-wrapper { align-items: stretch; }
.technology-slider-cus .swiper-slide { height: auto; }

.technology-slider-cus .technology-card {
  width: 100%;
  height: 100%;
}

.technology-slider-cus .technology-card__media {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: var(--card-radius);
  background: #f3f3f3;
}

.technology-slider-cus .technology-card__video,
.technology-slider-cus .technology-card__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.technology-slider-cus .technology-card__video--mobile,
.technology-slider-cus .technology-card__image--mobile { display: none; }

.technology-slider-cus .technology-card__content {
  padding: 38px 20px 0;
  text-align: center;
}

.technology-slider-cus .technology-card__title {
  margin: 0;
  color: inherit;
  font-size: 30px;
  font-weight: 400;
  line-height: 1.25;
}

.technology-slider-cus .technology-card__description {
  max-width: 520px;
  margin: 15px auto 0;
  color: inherit;
  font-size: 20px;
  line-height: 1.25;
  opacity: .58;
}

.technology-slider-cus .technology-card__description p { margin: 0; }

.technology-slider-cus .technology-slider__arrows {
  position: absolute;
  top: calc(50% - 45px);
  top:34%;
  right: 0;
  z-index: 10;
  display: flex;
  gap: 8px;
  transform: translateY(-50%);
  pointer-events: none;
      width: 100%;
    justify-content: space-between;
    padding: 0 58px;
}

.technology-slider-cus custom-swiper { position: relative; }

.technology-slider-cus .technology-slider__arrow {
  display: flex;
  width: 40px;
  height: 40px;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 1px solid #190A0A;
  border-radius: 4px;
  color: #190A0A;
  background: #fff;
  cursor: pointer;
  pointer-events: auto;
  transition: opacity .3s ease, transform .3s ease;
}

.technology-slider-cus .technology-slider__arrow svg { width: 14px; height: auto; }
.technology-slider-cus .technology-slider__arrow:hover { transform: scale(1.05); }
.technology-slider-cus .technology-slider__arrow.swiper-button-disabled { opacity: 0; pointer-events: none; }
.technology-slider__btn-wrp{
    text-align: center;
    margin-top: 30px;
}
.technology-slider__btn{
      display: inline-flex;
    min-width: 155px;
    min-height: 48px;
    padding: 12px 25px;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    color: var(--section-bg);
    font-size: 14px;
    font-weight: 400;
    font-family: var(--heading-font-family);
    line-height: 1;
    text-transform: uppercase;
    background: #FFF;
      border: 1px solid var(--section-bg);
    transition: opacity .3s ease, transform .3s ease;
}
.technology-slider__btn:hover {
    background: var(--section-bg);
    border-color: #fff;
    color: #fff;
}
@media screen and (max-width: 767px) {
  .technology-slider-cus {
    padding-top: var(--mobile-padding-top);
    padding-bottom: var(--mobile-padding-bottom);
  }
  .technology-slider__container{
        padding-left: var(--container-gutter);
    padding-right: var(--container-gutter);
  }

  .technology-slider-cus .technology-slider__header { margin-bottom: 40px; }
  .technology-slider-cus .technology-slider__title { font-size: 24px; line-height: 1.25; }
  .technology-slider-cus .technology-slider__subtitle { margin-top: 10px; font-size: 12px; line-height: 1.25; }

  .technology-slider-cus .technology-card__media { aspect-ratio: 1; }

  .technology-slider-cus .technology-card__video--desktop,
  .technology-slider-cus .technology-card__image--desktop { display: none; }

  .technology-slider-cus .technology-card__video--mobile,
  .technology-slider-cus .technology-card__image--mobile { display: block; }

  .technology-slider-cus .technology-card__content { padding: 20px 5px 0; }
  .technology-slider-cus .technology-card__title { font-size: 20px; }
  .technology-slider-cus .technology-card__description { margin-top: 5px; font-size: 12px; }
  .technology-slider-cus .technology-slider__arrows { display: none; }
  .technology-slider__btn-wrp {
    margin-top: 20px;
}
  .technology-slider__btn {
    min-width: 110px;
    min-height: 36px;
    font-size: 12px;
}
}
{% endstyle %}

<section
  class="technology-slider technology-slider-cus"
  style="
    --section-bg:{{ section.settings.background }};
    --text-color:{{ section.settings.text_color }};
    --card-radius:{{ section.settings.card_radius }}px;
    --padding-top:{{ section.settings.padding_top }}px;
    --padding-bottom:{{ section.settings.padding_bottom }}px;
    --mobile-padding-top:{{ section.settings.mobile_padding_top }}px;
    --mobile-padding-bottom:{{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="technology-slider__container">
    <div class="technology-slider__header technology-reveal js-scroll__header">
      {% if section.settings.title != blank %}
        <h2 class="technology-slider__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <div class="technology-slider__subtitle">{{ section.settings.subtitle }}</div>
      {% endif %}
    </div>

    <custom-swiper
      slides-per-view="3.2"
      space-between="20"
      loop="false"
      centered-slides="false"
      navigation="true"
      pagination="false"
      breakpoints='{
        "0":{"slidesPerView":1.15,"spaceBetween":16},
        "480":{"slidesPerView":1.4,"spaceBetween":16},
        "768":{"slidesPerView":2.2,"spaceBetween":16},
        "1024":{"slidesPerView":2.3,"spaceBetween":18},
        "1280":{"slidesPerView":2.8,"spaceBetween":20}
      }'
    >
      <div class="swiper-container js-scroll__group">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% liquid
              assign desktop_video = block.settings.desktop_video
              assign mobile_video = block.settings.mobile_video | default: desktop_video
              assign desktop_image = block.settings.desktop_image
              assign mobile_image = block.settings.mobile_image | default: desktop_image
            %}

            <div class="swiper-slide" style="--reveal-index:{{ forloop.index0 }};" {{ block.shopify_attributes }}>
              <div class="technology-card technology-reveal js-scroll__card">
                <div class="technology-card__media">
                  {% if desktop_video != blank %}
                    {{ desktop_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'technology-card__video technology-card__video--desktop' }}
                  {% elsif desktop_image != blank %}
                    {{ desktop_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'technology-card__image technology-card__image--desktop', widths: '500,700,900,1100,1400' }}
                  {% endif %}

                  {% if mobile_video != blank %}
                    {{ mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'technology-card__video technology-card__video--mobile' }}
                  {% elsif mobile_image != blank %}
                    {{ mobile_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'technology-card__image technology-card__image--mobile', widths: '400,600,800,900' }}
                  {% endif %}
                </div>

                <div class="technology-card__content">
                  {% if block.settings.title != blank %}
                    <h3 class="technology-card__title">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <div class="technology-card__description">{{ block.settings.description }}</div>
                  {% endif %}
                  {% if  block.settings.button_text != blank %}
                    <div class="technology-slider__btn-wrp">
                    <a href="{{ block.settings.button_url }}" class="technology-slider__btn">
                      {{ block.settings.button_text  }}
                    </a>
                  </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <div class="technology-slider__arrows">
          <button type="button" class="technology-slider__arrow swiper-prev" aria-label="Previous">
            <svg viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 1L1 5M1 5L5 9M1 5H13" stroke="currentColor"/>
            </svg>
          </button>
          <button type="button" class="technology-slider__arrow swiper-next" aria-label="Next">
            <svg viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 1L13 5M13 5L9 9M13 5H1" stroke="currentColor"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </custom-swiper>

  </div>
</section>

{% schema %}
{
  "name": "Technology slider",
  "tag": "section",
  "class": "section-technology-slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Advanced Ice Cooling Technology"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Engineered for comfortable IPL hair removal.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#190A0A"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Media radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "🖥 Desktop Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "📱 Mobile Settings"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "technology",
      "name": "Technology",
      "settings": [
        {
          "type": "header",
          "content": "🖥 Desktop Media"
        },
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Desktop video"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop fallback image"
        },
        {
          "type": "header",
          "content": "📱 Mobile Media"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video",
          "info": "If empty, desktop video will be used."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile fallback image",
          "info": "If empty, desktop image will be used."
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ice Cooling Technology"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Engineered for comfortable IPL hair removal.</p>"
        },
         {
          "type": "text",
          "id": "button_text",
          "label": "按钮文字"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "按钮链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Technology slider",
      "blocks": [
        { "type": "technology", "settings": { "title": "Ice Cooling Technology" } },
        { "type": "technology", "settings": { "title": "USHR* Mode" } },
        { "type": "technology", "settings": { "title": "SkinSensor" } },
        { "type": "technology", "settings": { "title": "Dual Lights" } }
      ]
    }
  ]
}
{% endschema %}