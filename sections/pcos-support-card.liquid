<style>
  #shopify-section-{{ section.id }} .pcos-support {
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    text-align: center;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .pcos-support__inner {
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pcos-support__title {
    max-width: 920px;
    margin: 0 auto 14px;
    font-size: 48px;
    line-height: 1.2;
    font-family: var(--text-font-family);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .pcos-support__text {
    max-width: 750px;
    margin: 0 auto 34px;
    color: #525252;
    font-size: clamp(14px, 1.39vw, 20px);
    line-height: 1.32;
  }

  #shopify-section-{{ section.id }} .pcos-support__text a {
    color: inherit;
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .pcos-support__logos {
    margin: 40px 0 40px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pcos-support__logo {
    display: block;
    width: auto;
    max-width: 295px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pcos-support__card {
    max-width: 860px;
    margin: 0 auto;
    padding: 32px 40px 36px;
    border-radius: 10px;
    background: {{ section.settings.card_background }};
    color: #1A1A1A;
    text-align: center;
    font-size: 20px;
    font-weight: 400;
    line-height: 130%; /* 28.6px */
  }

  #shopify-section-{{ section.id }} .pcos-support__contribution {
    margin: 24px 0 0;
    color: #1A1A1A;
    font-size: 14px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .pcos-support__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(350px, 100%);
    min-height: 48px;
    margin-top: 16px;
    padding: 12px 20px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_color }};
    font-size: 15px;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .pcos-support__note {
    max-width: 760px;
    margin: 16px auto 0;
    color: #8B8B8B;
    font-size: 12px;
    line-height: 1.35;
  }
   #shopify-section-{{ section.id }} .pcos-support__note a{
    color: #333;
    text-decoration: underline;
   }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .pcos-support {
      padding: {{ section.settings.mobile_padding_top }}px 0px {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .pcos-support__inner {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .pcos-support__title {
      max-width: 80%;
      margin-bottom: 12px;
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .pcos-support__text {
      max-width: inherit;
      margin-bottom: 24px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .pcos-support__logos {
      margin: 24px 0 26px;
    }

    #shopify-section-{{ section.id }} .pcos-support__logo {
      max-width: 167px;
    }

    #shopify-section-{{ section.id }} .pcos-support__card {
      width: 100%;
      padding: 21px 13px;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .pcos-support__contribution {
      margin-top: 32px;
      font-size: 12px;
      line-height: 1.3;
    }

    #shopify-section-{{ section.id }} .pcos-support__button {
      width: 70%;
      min-height: 32px;
      margin-top: 8px;
      padding: 9px 14px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .pcos-support__note {
      margin-top: 16px;
      font-size: 8px;
    }
  }
</style>

<section class="pcos-support">
  <div class="pcos-support__inner container">
    {%- if section.settings.title != blank -%}
      <h2 class="pcos-support__title to-top">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="pcos-support__text to-top">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.logo != blank -%}
      <div class="pcos-support__logos to-top">
        {{ section.settings.logo | image_url: width: 590 | image_tag: class: 'pcos-support__logo', loading: 'lazy' }}
      </div>
    {%- endif -%}
    <div class="pcos-support__card">
      {%- if section.settings.card_text != blank -%}
        <div class="to-top">{{ section.settings.card_text }}</div>
      {%- endif -%}
      {%- if section.settings.contribution_text != blank -%}
        <div class="pcos-support__contribution to-top">{{ section.settings.contribution_text }}</div>
      {%- endif -%}
      {%- if section.settings.button_text != blank -%}
        <a class="pcos-support__button to-top" href="{{ section.settings.button_link }}">{{ section.settings.button_text }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.note != blank -%}
      <div class="pcos-support__note to-top">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "pcos-support-card",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "PCOS affects millions of women worldwide." },
    { "type": "html", "id": "text", "label": "Intro text HTML", "default": "<a href=\"#\">Polycystic Ovary Syndrome (PCOS)</a> is a common hormonal condition that can affect skin, hair growth, weight, menstrual cycles, fertility, and emotional well-being." },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "textarea", "id": "card_text", "label": "Card text", "default": "For many, it is an invisible experience. Together, we're helping raise awareness, encourage conversation, and support initiatives focused on women's health." },
    { "type": "text", "id": "contribution_text", "label": "Contribution text", "default": "Add a contribution during checkout" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "html", "id": "note", "label": "Footnote HTML" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f6f6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#c8f2f7" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#1A1A1A" },
    { "type": "color", "id": "button_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Mobile padding top", "default": 44 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Mobile padding bottom", "default": 44 }
  ],
  "presets": [
    { "name": "pcos-support-card" }
  ]
}
{% endschema %}
