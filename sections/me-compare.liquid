
{% style %}
.me-compare {
      padding: 110px 0 100px;
      background: #fff;
      color: #242424;
    }

    .me-compare,
    .me-compare * {
      box-sizing: border-box;
    }

    .me-compare__container {
      position: relative;
      width: calc(100% - 64px);
      max-width: 1520px;
      margin: 0 auto;
    }

    .me-compare__head {
      position: absolute;
      top: 28px;
      left: 0;
      z-index: 2;
      width: 340px;
    }

    .me-compare__title {
      margin: 0;
      font-size: 48px;
      font-weight: 400;
      line-height: 1.25;
    }

    .me-compare__note {
      margin: 28px 0 0;
      color: #757575;
      font-size: 12px;
      line-height: 1.4;
    }

    .me-compare__scroll {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .me-compare__scroll::-webkit-scrollbar {
      display: none;
    }

    .me-compare__table {
      width: 100%;
      border-spacing: 0;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .me-compare__table caption {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .me-compare__table thead,
    .me-compare__table tbody {
      display: block;
    }

    .me-compare__table tr {
      display: grid;
      grid-template-columns: 24% 26% 26% 24%;
    }

    .me-compare__cell {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      min-width: 0;
      margin: 0;
      padding: 20px 16px;
      text-align: center;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.4;
      border-bottom: 1px dotted #C6C6C6;
    }

    .me-compare__cell--label {
      grid-column: 1;
      grid-row: 1;
      align-items: flex-start;
      padding-left: 0;
      text-align: left;
      font-size: 20px;
      font-weight: 500;
    }

    .me-compare__cell--air10 {
      grid-column: 2;
      grid-row: 1;
    }

    .me-compare__cell--air4 {
      grid-column: 3;
      grid-row: 1;
    }

    .me-compare__cell--me {
      grid-column: 4;
      grid-row: 1;
      background: #FFF3F7;
    }

    .me-compare__table tbody tr {
      min-height: 80px;
    }

    .me-compare__table tbody tr:last-child {
      min-height: 108px;
    }

    .me-compare__table tbody tr:last-child .me-compare__cell {
      border-bottom: 0;
    }

    .me-compare__table thead .me-compare__cell {
      height: 290px;
      padding-top: 26px;
      padding-bottom: 20px;
      border-bottom: 0;
    }

    .me-compare__table thead .me-compare__cell--label {
      justify-content: flex-end;
      padding-bottom: 24px;
    }

    .me-compare__product {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    .me-compare__product img {
      display: block;
      width: 100px;
      height: 184px;
      object-fit: contain;
      transition: transform .6s cubic-bezier(.22, 1, .36, 1);
    }

    .me-compare__badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 84px;
      padding: 8px 24px;
      border-radius: 100px;
      background: #3F3636;
      color: #fff;
      font-size: 16px;
      font-weight: 500;
      line-height: 1.2;
      white-space: nowrap;
    }

    .me-compare__cell--me .me-compare__badge {
      background: #E0004D;
    }

    .me-compare__check {
      display: block;
      width: 14px;
      height: 8px;
      border-left: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: translateY(-2px) rotate(-45deg);
    }

    .me-compare__dash {
      color: #888;
    }

    .me-compare__arrows {
      display: none;
    }

    .me-compare__scroll:focus-visible,
    .me-compare__arrow:focus-visible {
      outline: 2px solid #E0004D;
      outline-offset: 4px;
    }

    /* 复用现有 js-me-top + appear 入场机制 */
    .me-compare.appear .me-compare__head {
      animation: me-compare-rise .8s cubic-bezier(.22, 1, .36, 1) both;
    }

    .me-compare.appear .me-compare__product {
      animation: me-compare-rise 1s cubic-bezier(.22, 1, .36, 1) both;
    }

    .me-compare.appear .me-compare__cell--air4 .me-compare__product {
      animation-delay: .1s;
    }

    .me-compare.appear .me-compare__cell--me .me-compare__product {
      animation-delay: .2s;
    }

    @keyframes me-compare-rise {
      from {
        opacity: 0;
        transform: translateY(24px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (hover: hover) and (pointer: fine) {
      .me-compare__product:hover img {
        transform: translateY(-8px);
      }
    }

    @media (min-width: 768px) and (max-width: 1450px) {
      .me-compare {
        padding: 88px 0 80px;
      }

      .me-compare__container {
        width: calc(100% - 52px);
        max-width: 1216px;
      }

      .me-compare__head {
        top: 22px;
        width: 24%;
      }

      .me-compare__title {
        font-size: 38px;
      }

      .me-compare__note {
        margin-top: 22px;
        font-size: 10px;
      }

      .me-compare__cell {
        padding: 16px 13px;
        font-size: 13px;
      }

      .me-compare__cell--label {
        padding-left: 0;
        font-size: 16px;
      }

      .me-compare__table tbody tr {
        min-height: 64px;
      }

      .me-compare__table tbody tr:last-child {
        min-height: 86px;
      }

      .me-compare__table thead .me-compare__cell {
        height: 272px;
        padding-top: 21px;
        padding-bottom: 16px;
      }

      .me-compare__table thead .me-compare__cell--label {
        padding-bottom: 19px;
      }

      .me-compare__product {
        gap: 19px;
      }

      .me-compare__product img {
        width: 80px;
        height: 147px;
      }

      .me-compare__badge {
        min-width: 67px;
        padding: 6px 19px;
        font-size: 13px;
      }
    }

    @media (max-width: 767px) {
      .me-compare {
        padding: 36px 0 40px;
        overflow: hidden;
      }

      .me-compare__container {
        width: calc(100% - 32px);
      }

      .me-compare__head {
        position: static;
        width: 100%;
        padding: 0 4px;
      }

      .me-compare__title {
        font-size: 24px;
        line-height: 1.25;
      }

      .me-compare__note {
        margin-top: 14px;
        font-size: 12px;
        line-height: 1.5;
      }

      .me-compare__scroll {
        position: relative;
        margin-top: 28px;
        overscroll-behavior-x: contain;
        -webkit-overflow-scrolling: touch;
      }

      .me-compare__table {
        /* 375px 屏幕下：参数132 + ME88 + Air4 123 + Air10 123 */
        width: calc(100% + 123px);
        min-width: 466px;
      }

      .me-compare__table tr {
        grid-template-columns: 132px 88px repeat(2, minmax(123px, 1fr));
      }

      .me-compare__cell {
        padding: 18px 8px;
        font-size: 12px;
        line-height: 1.25;
        border-bottom: 1px solid #C6C6C6;
      }

      .me-compare__cell--label {
        position: sticky;
        left: 0;
        z-index: 2;
        grid-column: 1;
        padding-left: 4px;
        padding-right: 12px;
        background: #fff;
        font-size: 14px;
        line-height: 1.2;
      }

      .me-compare__cell--me {
        grid-column: 2;
        background: #FFF7FA;
      }

      .me-compare__cell--air4 {
        grid-column: 3;
      }

      .me-compare__cell--air10 {
        grid-column: 4;
      }

      .me-compare__table thead .me-compare__cell {
        height: 118px;
        padding: 14px 8px;
        border-bottom: 1px solid #C6C6C6;
      }

      .me-compare__table thead .me-compare__cell--label {
        justify-content: center;
        padding-left: 8px;
      }

      .me-compare__product {
        gap: 8px;
      }

      .me-compare__product img {
        width: 42px;
        height: 56px;
      }

      .me-compare__badge {
        min-width: 52px;
        padding: 2px 7px;
        font-size: 10px;
        line-height: 1.2;
      }

      .me-compare__table tbody tr {
        min-height: 80px;
      }

      .me-compare__table tbody tr:first-child {
        min-height: 92px;
      }

      .me-compare__table tbody tr:last-child {
        min-height: 100px;
      }

      .me-compare__check {
        width: 10px;
        height: 6px;
      }

      .me-compare__arrows {
        display: flex;
        justify-content: flex-end;
        gap: 16px;
        margin-top: 30px;
        padding-right: 32px;
      }

      .me-compare__arrow {
        display: grid;
        place-items: center;
        width: 36px;
        height: 40px;
        padding: 0;
        border: 0;
        background: transparent;
        color: #190A0A;
        cursor: pointer;
        transition: opacity .25s;
      }

      .me-compare__arrow svg {
        display: block;
        width: 26px;
        height: 22px;
      }

      .me-compare__arrow:disabled {
        opacity: .25;
        cursor: default;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      .me-compare *,
      .me-compare *::before,
      .me-compare *::after {
        animation: none !important;
        transition: none !important;
      }
    }
{% endstyle %}

<section class="me-compare js-me-top">
