<script>
    (() => {
      function initMeCompare() {
        document.querySelectorAll('.me-compare').forEach(root => {
          if (root.dataset.compareInitialized) return;
          root.dataset.compareInitialized = 'true';

          const scroll = root.querySelector('.me-compare__scroll');
          const table = root.querySelector('.me-compare__table');
          const prev = root.querySelector('[data-compare-prev]');
          const next = root.querySelector('[data-compare-next]');
          const reducedMotion = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          );

          function updateArrows() {
            const max = Math.max(0, scroll.scrollWidth - scroll.clientWidth);

            prev.disabled = scroll.scrollLeft <= 1;
            next.disabled = scroll.scrollLeft >= max - 1;
          }

          function move(direction) {
            const product = root.querySelector(
              'thead .me-compare__cell--air4'
            );

            scroll.scrollBy({
              left: direction * product.getBoundingClientRect().width,
              behavior: reducedMotion.matches ? 'auto' : 'smooth'
            });
          }

          prev.addEventListener('click', () => move(-1));
          next.addEventListener('click', () => move(1));
          scroll.addEventListener('scroll', updateArrows, { passive: true });

          const resizeObserver = new ResizeObserver(updateArrows);
          resizeObserver.observe(scroll);
          resizeObserver.observe(table);

          updateArrows();
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMeCompare, {
          once: true
        });
      } else {
        initMeCompare();
      }
    })();
  </script>
