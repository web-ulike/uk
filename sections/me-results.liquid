
{% style %}
.me-result__slider {}

    .me-results {
      padding: 100px 0;
      background: #F9F9F9;
      overflow: hidden;
    }

    .me-result__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 40px;
      color: #000;
    }

    .me-result__head h3 {

      font-size: 40px;
      line-height: 120%;
    }

    .me-result__container {
      display: flex;
    }

    .me-result__head__arrows {
      display: flex;
      align-items: center;
      gap: 36px;
    }

    .me-result__head__arrows svg {
      display: block;
      width: 30px;
      cursor: pointer;
    }

    .me-result__head__arrows svg.swiper-button-disabled {
      opacity: 0.6;
    }

    .me-result__top {
      position: relative;
    }

    .me-result__before-txt {
      position: absolute;
      display: inline-flex;
      background: rgba(0, 0, 0, 0.40);
      border-radius: 555px;
      font-size: 12px;
      line-height: 1.2;
      font-weight: 500;
      padding: 6px 17px;
      top: 16px;
      left: 16px;
      color: #FFF;

    }

    .me-result__after-txt {
      position: absolute;
      display: inline-flex;
      background: #E0004D;
      border-radius: 555px;
      font-size: 12px;
      line-height: 1.2;
      font-weight: 500;
      padding: 6px 17px;
      top: 16px;
      right: 16px;
      color: #FFF;
    }

    .me-result__top__cnt {
      position: absolute;
      width: 50%;
      bottom: 20px;
      right: 0;
      text-align: center;
      color: #fff;
    }

    .me-result__top__cnt .me-result__top__cnt_tle {
      font-size: 40px;
      line-height: 1.2;
      font-weight: 400;
    }

    .me-result__top__cnt .me-result__top__cnt_tle span {
      font-size: 20px;

    }

    .me-result__top__cnt__txt {
      font-size: 12px;
      line-height: 1.2;
      max-width: 123px;
      margin: 0 auto;
    }

    .me-result__top__bottom {
      padding: 35px 20px;
      background: #FFF;
    }

    .me-result__top__bottom h4 {
      color: #3F3636;
      font-size: 22px;
      font-weight: 500;
      line-height: 1.2;
    }

    .me-result__top__bottom__des {
      font-size: 16px;
      line-height: 1.3;
      font-weight: 400;
      margin-top: 15px;
    }

    .me-result__top__bottom__review {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 28px;
    }

    .me-result__top__bottom__review__name {
      color: #757575;
      font-size: 16px;
      line-height: 1.2;
    }

    .me-result__note {
      font-size: 16px;
      line-height: 1.2;
      color: #919191;
      margin-top: 40px;
      max-width: 586px;
    }

    @media (min-width: 768px) and (max-width: 1450px) {
      .me-results {
        padding: 80px 0;
      }

      .me-result__head {
        margin-bottom: 32px;
      }

      .me-result__head h3 {
        font-size: 32px;
      }

      .me-result__head__arrows {
        gap: 29px;
      }

      .me-result__head__arrows svg {
        width: 24px;
      }

      .me-result__before-txt {
        border-radius: 444px;
        font-size: 10px;
        padding: 5px 14px;
        top: 13px;
        left: 13px;
      }

      .me-result__after-txt {
        border-radius: 444px;
        font-size: 10px;
        padding: 5px 14px;
        top: 13px;
        right: 13px;
      }

      .me-result__top__cnt {
        bottom: 16px;
      }

      .me-result__top__cnt .me-result__top__cnt_tle {
        font-size: 32px;
      }

      .me-result__top__cnt .me-result__top__cnt_tle span {
        font-size: 16px;
      }

      .me-result__top__cnt__txt {
        font-size: 10px;
        max-width: 98px;
      }

      .me-result__top__bottom {
        padding: 28px 16px;
      }

      .me-result__top__bottom h4 {
        font-size: 18px;
      }

      .me-result__top__bottom__des {
        font-size: 13px;
        margin-top: 12px;
      }

      .me-result__top__bottom__review {
        margin-top: 22px;
      }

      .me-result__top__bottom__review__name {
        font-size: 13px;
      }

      .me-result__note {
        font-size: 13px;
        margin-top: 32px;
        max-width: 469px;
      }
    }

    @media (max-width: 767px) {
      .me-results {
        padding: 60px 0;
      }

      .me-result__head {
        display: contents;
      }

      .me-result__head__arrows {
        gap: 27px;
        order: 4;
        margin-top: 38px;
        justify-content: flex-end;
        padding-right: 20px;
      }

      .me-result__head__arrows svg {
        width: 23px;
      }

      .me-results .container {
        display: flex;
        flex-direction: column;
      }

      .me-result__head h3 {
        order: 1;
        font-size: 26px;
        text-align: center;
      }

      .me-result__content {
        order: 3;
      }

      .me-result__note {
        order: 2;
        font-size: 10px;
        margin: 8px auto 30px;
        max-width: 300px;
        text-align: center;
      }

      .me-result__before-txt {
        border-radius: 392px;
        font-size: 9px;
        padding: 4px 12px;
        top: 11px;
        left: 11px;
      }

      .me-result__after-txt {

        border-radius: 392px;
        font-size: 9px;

        padding: 4px 12px;
        top: 11px;
        right: 11px;
      }

      .me-result__top__cnt {
        bottom: 14px;
      }

      .me-result__top__cnt .me-result__top__cnt_tle {
        font-size: 28px;
      }

      .me-result__top__cnt .me-result__top__cnt_tle span {
        font-size: 14px;
      }

      .me-result__top__cnt__txt {
        font-size: 10px;
        max-width: 105px;
      }

      .me-result__top__bottom {
        padding: 25px 14px;
      }

      .me-result__top__bottom h4 {
        font-size: 14px;
        font-size: 500;
      }

      .me-result__top__bottom__des {
        font-size: 12px;
        margin-top: 5px;
      }

      .me-result__top__bottom__review {
        margin-top: 20px;
      }

      .me-result__top__bottom__review__name {
        font-size: 12px;

      }

      .me-result__top__bottom__review__img {
        text-align: right;
      }

      .me-result__top__bottom__review__img img {
        width: 70%;
      }
    }
{% endstyle %}

