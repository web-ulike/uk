{% style %}
.me-result__slider {}

    .me-results {
      padding: 100px 0;
      background: #F9F9F9;
      overflow: hidden;
    }

    .me-result__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 40px;
      color: #000;
    }

    .me-result__head h3 {

      font-size: 40px;
      line-height: 120%;
    }

    .me-result__container {
      display: flex;
    }

    .me-result__head__arrows {
      display: flex;
      align-items: center;
      gap: 36px;
    }

    .me-result__head__arrows svg {
      display: block;
      width: 30px;
      cursor: pointer;
    }

    .me-result__head__arrows svg.swiper-button-disabled {
      opacity: 0.6;
    }

    .me-result__top {
      position: relative;
    }

    .me-result__before-txt {
      position: absolute;
      display: inline-flex;
      background: rgba(0, 0, 0, 0.40);
      border-radius: 555px;
      font-size: 12px;
      line-height: 1.2;
      font-weight: 500;
      padding: 6px 17px;
      top: 16px;
      left: 16px;
      color: #FFF;

    }

    .me-result__after-txt {
      position: absolute;
      display: inline-flex;
      background: #E0004D;
      border-radius: 555px;
      font-size: 12px;
      line-height: 1.2;
      font-weight: 500;
      padding: 6px 17px;
      top: 16px;
      right: 16px;
      color: #FFF;
    }

    .me-result__top__cnt {
      position: absolute;
      width: 50%;
      bottom: 20px;
      right: 0;
      text-align: center;
      color: #fff;
    }

    .me-result__top__cnt .me-result__top__cnt_tle {
      font-size: 40px;
      line-height: 1.2;
      font-weight: 400;
    }

    .me-result__top__cnt .me-result__top__cnt_tle span {
      font-size: 20px;

    }

    .me-result__top__cnt__txt {
      font-size: 12px;
      line-height: 1.2;
      max-width: 123px;
      margin: 0 auto;
    }

    .me-result__top__bottom {
      padding: 35px 20px;
      background: #FFF;
    }

    .me-result__top__bottom h4 {
      color: #3F3636;
      font-size: 22px;
      font-weight: 500;
      line-height: 1.2;
    }

    .me-result__top__bottom__des {
      font-size: 16px;
      line-height: 1.3;
      font-weight: 400;
      margin-top: 15px;
    }

    .me-result__top__bottom__review {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 28px;
    }

    .me-result__top__bottom__review__name {
      color: #757575;
      font-size: 16px;
      line-height: 1.2;
    }

    .me-result__note {
      font-size: 16px;
      line-height: 1.2;
      color: #919191;
      margin-top: 40px;
      max-width: 586px;
    }

    @media (min-width: 768px) and (max-width: 1450px) {
      .me-results {
        padding: 80px 0;
      }

      .me-result__head {
        margin-bottom: 32px;
      }

      .me-result__head h3 {
        font-size: 32px;
      }

      .me-result__head__arrows {
        gap: 29px;
      }

      .me-result__head__arrows svg {
        width: 24px;
      }

      .me-result__before-txt {
        border-radius: 444px;
        font-size: 10px;
        padding: 5px 14px;
        top: 13px;
        left: 13px;
      }

      .me-result__after-txt {
        border-radius: 444px;
        font-size: 10px;
        padding: 5px 14px;
        top: 13px;
        right: 13px;
      }

      .me-result__top__cnt {
        bottom: 16px;
      }

      .me-result__top__cnt .me-result__top__cnt_tle {
        font-size: 32px;
      }

      .me-result__top__cnt .me-result__top__cnt_tle span {
        font-size: 16px;
      }

      .me-result__top__cnt__txt {
        font-size: 10px;
        max-width: 98px;
      }

      .me-result__top__bottom {
        padding: 28px 16px;
      }

      .me-result__top__bottom h4 {
        font-size: 18px;
      }

      .me-result__top__bottom__des {
        font-size: 13px;
        margin-top: 12px;
      }

      .me-result__top__bottom__review {
        margin-top: 22px;
      }

      .me-result__top__bottom__review__name {
        font-size: 13px;
      }

      .me-result__note {
        font-size: 13px;
        margin-top: 32px;
        max-width: 469px;
      }
    }

    @media (max-width: 767px) {
      .me-results {
        padding: 60px 0;
      }

      .me-result__head {
        display: contents;
      }

      .me-result__head__arrows {
        gap: 27px;
        order: 4;
        margin-top: 38px;
        justify-content: flex-end;
        padding-right: 20px;
      }

      .me-result__head__arrows svg {
        width: 23px;
      }

      .me-results .container {
        display: flex;
        flex-direction: column;
      }

      .me-result__head h3 {
        order: 1;
        font-size: 26px;
        text-align: center;
      }

      .me-result__content {
        order: 3;
      }

      .me-result__note {
        order: 2;
        font-size: 10px;
        margin: 8px auto 30px;
        max-width: 300px;
        text-align: center;
      }

      .me-result__before-txt {
        border-radius: 392px;
        font-size: 9px;
        padding: 4px 12px;
        top: 11px;
        left: 11px;
      }

      .me-result__after-txt {

        border-radius: 392px;
        font-size: 9px;

        padding: 4px 12px;
        top: 11px;
        right: 11px;
      }

      .me-result__top__cnt {
        bottom: 14px;
      }

      .me-result__top__cnt .me-result__top__cnt_tle {
        font-size: 28px;
      }

      .me-result__top__cnt .me-result__top__cnt_tle span {
        font-size: 14px;
      }

      .me-result__top__cnt__txt {
        font-size: 10px;
        max-width: 105px;
      }

      .me-result__top__bottom {
        padding: 25px 14px;
      }

      .me-result__top__bottom h4 {
        font-size: 14px;
        font-size: 500;
      }

      .me-result__top__bottom__des {
        font-size: 12px;
        margin-top: 5px;
      }

      .me-result__top__bottom__review {
        margin-top: 20px;
      }

      .me-result__top__bottom__review__name {
        font-size: 12px;

      }

      .me-result__top__bottom__review__img {
        text-align: right;
      }

      .me-result__top__bottom__review__img img {
        width: 70%;
      }
    }
{% endstyle %}

<section class="me-results">
  <custom-swiper watch-overflow="true" slides-per-view="1" space-between="20" loop="false" centered-slides="false"
    navigation="true" pagination="false" breakpoints='{"767":{"slidesPerView":3.3,"spaceBetween":20}}'>
    <div class="container">
      <div class="me-result__head">
        <h3 class="js-me-top">{{ section.settings.heading | escape }}</h3>
        <div class="me-result__head__arrows js-me-top">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="23" viewBox="0 0 30 23" fill="none"
                class="me-result__head__arrows__prev swiper-prev">
                <g clip-path="url(#clip0_7980_1345)">
                  <path
                    d="M1.90735e-06 11.4922C1.90735e-06 11.6737 0.067318 11.8537 0.196098 11.9912L10.44 22.9668L11.5098 21.9688L2.41463 12.2239H30C30 11.4161 29.3444 10.7605 28.5366 10.7605H0.765366C0.488781 10.7605 0.219515 10.8995 0.0878067 11.1439C0.0278072 11.2537 1.90735e-06 11.3737 1.90735e-06 11.4922Z"
                    fill="currentColor" />
                  <path
                    d="M1.52926 8.92683C2.10146 9.49756 3.0278 9.49756 3.59853 8.92683L11.4922 1.03463L10.4576 0L1.53072 8.92683H1.52926Z"
                    fill="currentColor" />
                </g>
                <defs>
                  <clipPath id="clip0_7980_1345">
                    <rect width="30" height="22.9683" fill="white" transform="matrix(-1 0 0 1 30 0)" />
                  </clipPath>
                </defs>
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="23" viewBox="0 0 30 23" fill="none"
                class="me-result__head__arrows__next swiper-next">
                <g clip-path="url(#clip0_7980_1341)">
                  <path
                    d="M30 11.4922C30 11.6737 29.9327 11.8537 29.8039 11.9912L19.56 22.9668L18.4902 21.9688L27.5854 12.2239H0C0 11.4161 0.65561 10.7605 1.46341 10.7605H29.2346C29.5112 10.7605 29.7805 10.8995 29.9122 11.1439C29.9722 11.2537 30 11.3737 30 11.4922Z"
                    fill="currentColor" />
                  <path
                    d="M28.4707 8.92683C27.8985 9.49756 26.9722 9.49756 26.4015 8.92683L18.5078 1.03463L19.5424 0L28.4693 8.92683H28.4707Z"
                    fill="currentColor" />
                </g>
                <defs>
                  <clipPath id="clip0_7980_1341">
                    <rect width="30" height="22.9683" fill="white" />
                  </clipPath>
                </defs>
              </svg>
            </div>
      </div>
      <div class="me-result__content swiper-container">
        <div class="me-result__container swiper-wrapper">
          {% for block in section.blocks %}
            <div class="me-result__slider swiper-slide js-me-top" style="--me-enter-delay: {{ forloop.index0 | times: 100 }}ms" {{ block.shopify_attributes }}>
              <div class="me-result__top">
                {% assign result_image = block.settings.image_mobile | default: block.settings.image_pc %}
                {% if block.settings.image_pc != blank or block.settings.image_mobile != blank %}
                  <picture class="me-result__picture">
                    {% if block.settings.image_pc != blank %}
                      <source media="(min-width: 768px)" srcset="{{ block.settings.image_pc | image_url: width: 3000 }}">
                    {% endif %}
                    <img src="{{ result_image | image_url: width: 1800 }}" alt="{{ result_image.alt | escape }}" loading="lazy">
                  </picture>
                {% endif %}
                {% if block.settings.before_label != blank %}<div class="me-result__before-txt">{{ block.settings.before_label | escape }}</div>{% endif %}
                {% if block.settings.after_label != blank %}<div class="me-result__after-txt">{{ block.settings.after_label | escape }}</div>{% endif %}
                <div class="me-result__top__cnt">
                  <div class="me-result__top__cnt_tle">{{ block.settings.result_value | escape }}<span class="me-result__top__cnt_tle_span">{{ block.settings.result_suffix | escape }}</span></div>
                  {% if block.settings.result_caption != blank %}<div class="me-result__top__cnt__txt">{{ block.settings.result_caption | escape }}</div>{% endif %}
                </div>
              </div>
              <div class="me-result__top__bottom">
                {% if block.settings.review_title != blank %}<h4>{{ block.settings.review_title | escape }}</h4>{% endif %}
                {% if block.settings.review_text != blank %}<div class="me-result__top__bottom__des">{{ block.settings.review_text | escape }}</div>{% endif %}
                <div class="me-result__top__bottom__review">
                  {% if block.settings.customer_name != blank %}<div class="me-result__top__bottom__review__name">{{ block.settings.customer_name | escape }}</div>{% endif %}
                  {% if block.settings.rating_image != blank %}
                    <div class="me-result__top__bottom__review__img">
                      <img src="{{ block.settings.rating_image | image_url: width: 240 }}" alt="{{ block.settings.rating_image.alt | escape }}" loading="lazy">
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% if section.settings.footnote != blank %}<div class="me-result__note js-me-top">{{ section.settings.footnote | escape }}</div>{% endif %}
    </div>
  </custom-swiper>
</section>
{% schema %}
{
