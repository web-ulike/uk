<section class="xmas xmas-gifts"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}><div class="container">
  <div class="xmas-gifts__heading">
    {% render 'xmas-heading', settings_group: section.settings %}
  </div>
  <div class="xmas-gifts__grid">
    {% assign gifts = section.blocks | where: 'type', 'gift' %}
    {% for block in gifts %}
      <article class="xmas-gifts__card to-top"{% unless forloop.first %} style="transition-delay: {{ forloop.index0 | times: 0.1 }}s"{% endunless %} {{ block.shopify_attributes }}>
        <div class="xmas-gifts__art">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 800 | image_tag: widths: '200,400,800', sizes: '(max-width: 700px) 40vw, 400px', loading: 'lazy' }}
          {% elsif block.settings.art == 'gua' %}
            <span class="xmas-gifts__gua" aria-hidden="true"></span>
          {% elsif block.settings.art == 'tote' %}
            <span class="xmas-gifts__tote"><img src="{{ 'xmas-logo-240.png' | asset_url }}" alt="" width="75" height="17" loading="lazy"></span>
          {% endif %}
        </div>
        <h3>{{ block.settings.title | escape }}</h3>
        <div>{{ block.settings.item | escape }}</div>
        <small>{{ block.settings.note | escape }}</small>
      </article>
    {% endfor %}
  </div>
  <ol class="xmas-gifts__steps">
    {% assign steps = section.blocks | where: 'type', 'step' %}
    {% for block in steps %}
      <li class="to-top"{% unless forloop.first %} style="transition-delay: {{ forloop.index0 | times: 0.1 }}s"{% endunless %} {{ block.shopify_attributes }}><span aria-hidden="true">{{ forloop.index }}</span>{{ block.settings.label | escape }}</li>
    {% endfor %}
  </ol>
  {% if section.settings.rules != blank %}
    <xmas-prize-rules>
      <button class="xmas-gifts__trigger to-top" type="button" aria-haspopup="dialog">{{ section.settings.rules_label | escape }}</button>
      <dialog aria-labelledby="rules-title-{{ section.id }}">
        <h3 id="rules-title-{{ section.id }}">{{ section.settings.rules_heading | escape }}</h3>
        {{ section.settings.rules }}
        <form method="dialog"><button autofocus>{{ section.settings.dismiss | escape }}</button></form>
      </dialog>
    </xmas-prize-rules>
  {% endif %}
</div></section>

{% javascript %}
  class XmasPrizeRules extends HTMLElement {
    connectedCallback() {
      this.addEventListener('click', this.openRules);
    }

    disconnectedCallback() {
      this.removeEventListener('click', this.openRules);
    }

    openRules(event) {
      if (event.target.closest('.xmas-gifts__trigger')) {
        this.querySelector('dialog').showModal();
      }
    }
  }
  if (!customElements.get('xmas-prize-rules')) {
    customElements.define('xmas-prize-rules', XmasPrizeRules);
  }
{% endjavascript %}

{% stylesheet %}
.xmas-gifts { padding: var(--xmas-section-space) 0; text-align: center; }
/* Keep the gap to the cards independent of the theme's last-child margin reset. */
.xmas-gifts__heading {
  max-width: 640px;
  margin: 0 auto;
  padding-bottom: clamp(28px, 3.3vw, 48px);
}
.xmas-gifts .xmas-gifts__heading .xmas-intro { margin-inline: auto; }
.xmas-gifts__grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; max-width: 900px; margin: auto; }
.xmas-gifts__card {
  position: relative;
  display: grid;
  grid-row: span 4;
  grid-template-rows: subgrid;
  row-gap: 8px;
  min-width: 0;
  padding: 35px 20px 28px;
  border-top: 3px solid #8b1425;
  background: #f0e7d8;
  overflow-wrap: anywhere;
}
.xmas-gifts__card::after { content: '✧'; position: absolute; top: 12px; right: 18px; color: #a78843; font-size: 26px; }
.xmas-gifts__card h3 { margin: 12px 0 0; font: 400 clamp(26px, 2.3vw, 34px)/1.1 Bodoni-Book, serif; }
.xmas-gifts__card small { display: block; font-size: var(--xmas-small-size); color: #776b62; }
.xmas-gifts__art { height: 165px; display: grid; place-items: center; padding-top: 24px; grid-template: minmax(0, 1fr) / minmax(0, 1fr); }
.xmas-gifts__art > img { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
.xmas-gifts__gua { width: min(100px, 76%); aspect-ratio: 20 / 21; border-radius: 65% 25% 55% 25%; transform: rotate(-30deg); background: linear-gradient(145deg,#d7c7b2,#f7edde,#d3bca6); box-shadow: 8px 14px 18px #9e8d7529; }
.xmas-gifts__tote { position: relative; display: grid; place-items: center; width: min(115px, 85%); aspect-ratio: 23 / 22; background: #d9cbb4; transform: rotate(6deg); box-shadow: 8px 13px 14px #9e8d7526; }
.xmas-gifts__tote::before { content: ''; position: absolute; bottom: 100%; width: 55px; height: 38px; border: 6px solid #c6b599; border-bottom: 0; border-radius: 35px 35px 0 0; }
.xmas-gifts__tote img { width: 65%; height: auto; mix-blend-mode: multiply; filter: grayscale(1) contrast(100); }
.xmas-gifts__steps { display: flex; justify-content: center; flex-wrap: wrap; gap: 16px 32px; margin: 36px 0 20px; padding: 0; list-style: none; font-size: 16px; }
.xmas-gifts__steps span { display: inline-grid; place-items: center; border: 1px solid #c6bbaa; border-radius: 50%; width: 26px; height: 26px; margin-right: 10px; }
.xmas-gifts__trigger { border-bottom: 1px solid #a06b65; padding: 10px 0; color: #801427; font-size: 16px; }
.xmas-gifts dialog { position: fixed; inset: 0; margin: auto; width: min(460px, calc(100% - 40px)); max-height: 85vh; overflow: auto; border: 0; padding: 32px; border-radius: 8px; text-align: left; background: #fbf6ed; color: #342b27; }
.xmas-gifts dialog::backdrop { background: #291e3e77; }
.xmas-gifts dialog h3 { font: 400 30px Bodoni-Book, serif; margin: 0 0 16px; }
.xmas-gifts dialog p { font-size: 16px; line-height: 1.65; }
.xmas-gifts dialog button { background: #861629; color: white; padding: 12px 22px; border-radius: 3px; }
@media (max-width: 700px) {
  .xmas-gifts__grid { gap: 12px; }
  .xmas-gifts__card { padding: 25px 10px 20px; }
  .xmas-gifts__art { height: 140px; padding-top: 26px; }
  .xmas-gifts__card h3 { font-size: clamp(21px, 6vw, 26px); }
  .xmas-gifts__steps { gap: 12px; font-size: 14px; }
  .xmas-gifts__steps li { flex: 1 1 0; min-width: 0; }
  .xmas-gifts__steps span { display: grid; margin: 0 auto 8px; }
}
@media (prefers-reduced-motion: no-preference) {
  .xmas-gifts .to-top:not(.appear) { transform: translateY(24px); }
}
{% endstylesheet %}

