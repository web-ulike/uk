<section class="xmas-gifts"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="container">
    <header class="xmas-gifts__heading">
      <div>
        {% if section.settings.kicker != blank %}
          <p class="xmas-gifts__kicker">{{ section.settings.kicker | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
        {% endif %}
      </div>
      {% if section.settings.description != blank %}
        <p class="xmas-gifts__intro">{{ section.settings.description | escape | newline_to_br }}</p>
      {% endif %}
    </header>

    {% assign gifts = section.blocks | where: 'type', 'gift' %}
    {% if gifts.size > 0 %}
      <div class="xmas-gifts__grid">
        {% for block in gifts %}
          <article class="xmas-gifts__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1500 | image_tag:
                widths: '343,500,700,750,1080,1500',
                sizes: '(max-width: 700px) calc(100vw - 32px), (max-width: 740px) calc(50vw - 34px), (max-width: 1600px) calc(50vw - 50px), 750px',
                loading: 'lazy', class: block.settings.crop
              }}
            {% endif %}
            {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
            {% if block.settings.item != blank %}<p>{{ block.settings.item | escape }}</p>{% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% assign steps = section.blocks | where: 'type', 'step' %}
    {% if steps.size > 0 or section.settings.rules != blank %}
      <xmas-prize-rules class="xmas-gifts__footer">
        {% if steps.size > 0 %}
          <ol class="xmas-gifts__steps" role="list">
            {% for block in steps %}
              <li {{ block.shopify_attributes }}>
                <span aria-hidden="true">{{ forloop.index }}</span>{{ block.settings.label | escape }}
              </li>
            {% endfor %}
          </ol>
        {% endif %}
        {% if section.settings.rules != blank %}
          <button class="xmas-gifts__trigger" type="button" aria-haspopup="dialog" aria-controls="rules-{{ section.id }}">
            {{ section.settings.rules_label | escape }}
          </button>
          <dialog class="xmas-gifts__dialog" id="rules-{{ section.id }}" aria-labelledby="rules-title-{{ section.id }}">
            <form method="dialog">
              <button class="xmas-gifts__close" aria-label="{{ 'general.accessibility.close' | t | escape }}" autofocus>&times;</button>
              <h3 id="rules-title-{{ section.id }}">{{ section.settings.rules_heading | escape }}</h3>
              <div class="xmas-gifts__rules">{{ section.settings.rules }}</div>
              <button class="xmas-gifts__dismiss">{{ section.settings.dismiss | escape }}</button>
            </form>
          </dialog>
        {% endif %}
      </xmas-prize-rules>
    {% endif %}
  </div>
</section>

{% javascript %}
  if (!customElements.get('xmas-prize-rules')) {
    customElements.define('xmas-prize-rules', class extends HTMLElement {
      connectedCallback() { this.addEventListener('click', this.handleClick); }
      disconnectedCallback() { this.removeEventListener('click', this.handleClick); }

      handleClick(event) {
        const dialog = this.querySelector('dialog');
        if (event.target.closest('.xmas-gifts__trigger')) {
          dialog.showModal();
        } else if (event.target === dialog) {
          const bounds = dialog.getBoundingClientRect();
          if (event.clientX < bounds.left || event.clientX > bounds.right ||
              event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
        }
      }
    });
  }
{% endjavascript %}

{% stylesheet %}
  .xmas-gifts {
    padding-block: 80px;
    background: #fbf6ed;
    color: #190a0a;
    font-family: Saans, sans-serif;
    scroll-margin-top: calc(var(--header-height, 0px) * var(--enable-sticky-header, 0) + var(--announcement-bar-height, 0px) * var(--enable-sticky-announcement-bar, 0));
  }
  .xmas-gifts :is(p,h2,h3,h4,ol) { margin: 0; }
  .xmas-gifts__heading {
    display: grid;
    grid-template-columns: minmax(0,13fr) minmax(0,6fr);
    align-items: end;
    margin-bottom: 60px;
  }
  .xmas-gifts__kicker { font: 400 18px/1.5 saans-light, sans-serif; letter-spacing: 2px; color: #a30a41; }
  .xmas-gifts__heading h2 { font: 400 50px/1.2 Saans, sans-serif; letter-spacing: normal; }
  .xmas-gifts__kicker + h2 { margin-top: 10px; }
  .xmas-gifts p.xmas-gifts__intro { max-width: 456px; margin-bottom: 7px; font-size: 14px; line-height: 18px; opacity: .6; }
  .xmas-gifts__grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 30px 20px; }
  .xmas-gifts__card img { display: block; width: 100%; height: auto; aspect-ratio: 750/493; object-fit: cover; object-position: center top; border-radius: 8px; margin-bottom: 30px; }
  .xmas-gifts__card img.cropped { object-position: center 70%; }
  .xmas-gifts__card h3 { font: 400 26px/1.25 Saans, sans-serif; }
  .xmas-gifts__card p { color: #3f3636; font-size: 16px; line-height: 18px; }
  .xmas-gifts__card h3 + p { margin-top: 10px; }
  .xmas-gifts__footer { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; border-top: 1px solid #cfc6be; margin-top: 50px; padding-top: 44px; }
  .xmas-gifts__steps { display: flex; flex-wrap: wrap; align-items: center; gap: 20px clamp(20px,3vw,56px); list-style: none; padding: 0; }
  .xmas-gifts__steps li { display: flex; align-items: center; gap: 20px; font-size: clamp(16px,1.36vw,26px); line-height: 1.2; }
  .xmas-gifts__steps span { display: grid; place-items: center; flex: none; width: 53px; aspect-ratio: 1; border: 1px solid currentColor; border-radius: 50%; font: italic 400 26px/1 Bodoni-Book, serif; }
  .xmas-gifts__trigger, .xmas-gifts__dismiss { border: 0; border-radius: 4px; background: #e0004d; color: #fff; text-transform: uppercase; font: 500 15px/1.5 Saans, sans-serif; cursor: pointer; }
  .xmas-gifts__trigger { margin-left: auto; min-height: 48px; padding: 8px 36px; }
  .xmas-gifts__dialog { position: fixed; inset: 0; width: min(500px,calc(100% - 32px)); max-height: calc(100dvh - 32px); overflow: auto; overscroll-behavior: contain; margin: auto; padding: 0; border: 0; border-radius: 8px; background: #fbfaf4; color: #190a0a; }
  .xmas-gifts__dialog::backdrop { background: rgb(0 0 0 / 50%); }
  .xmas-gifts__dialog form { display: grid; align-content: center; gap: 37px; min-height: 634px; padding: 66px 40px 46px; }
  .xmas-gifts__close { position: absolute; top: 14px; right: 14px; width: 44px; height: 44px; font: 300 32px/1 saans-light, sans-serif; color: inherit; cursor: pointer; }
  .xmas-gifts__dialog h3 { font: 400 36px/1.15 Saans, sans-serif; }
  .xmas-gifts__rules { color: #3f3636; font-size: 14px; line-height: 1.5; letter-spacing: -.196px; }
  .xmas-gifts__rules > * + * { margin-top: 23px; }
  .xmas-gifts__rules h4 { font: 400 18px/1.5 Saans, sans-serif; color: #190a0a; }
  .xmas-gifts__rules h4 + p { margin-top: 8px; }
  .xmas-gifts__dismiss { min-height: 60px; font-size: 18px; }
  @media (max-width: 700px) {
    .xmas-gifts { padding-block: 50px 42px; }
    .xmas-gifts > .container { padding-inline: 16px; }
    .xmas-gifts__heading { grid-template-columns: 1fr; gap: 10px; margin-bottom: 30px; }
    .xmas-gifts__kicker { font-size: 12px; }
    .xmas-gifts__heading h2 { font-size: 30px; }
    .xmas-gifts p.xmas-gifts__intro { margin-bottom: 0; font-size: 12px; }
    .xmas-gifts__grid { grid-template-columns: 1fr; }
    .xmas-gifts__card img { margin-bottom: 20px; border-radius: 0; }
    .xmas-gifts__card img.tall { aspect-ratio: 343/259; }
    .xmas-gifts__card h3 { font-size: 14px; font-weight: 500; }
    .xmas-gifts__card p { font-size: 12px; line-height: normal; opacity: .5; }
    .xmas-gifts__footer { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 27px 16px; margin-top: 24px; padding-top: 24px; }
    .xmas-gifts__steps { display: contents; }
    .xmas-gifts__steps li { gap: 10px; font-size: 14px; }
    .xmas-gifts__steps span { width: 27px; font-size: 12px; }
    .xmas-gifts__trigger { justify-self: start; margin: 0; min-height: 28px; padding: 5px 15px; font-size: 12px; }
    .xmas-gifts__dialog { width: min(343px,calc(100% - 32px)); }
    .xmas-gifts__dialog form { min-height: 496px; padding: 58px 21px 42px; gap: 19px; }
    .xmas-gifts__close { top: 3px; right: 3px; font-size: 24px; }
    .xmas-gifts__dialog h3 { font-size: 26px; }
    .xmas-gifts__rules { font-size: 12px; letter-spacing: -.098px; }
    .xmas-gifts__rules h4 { font-size: 14px; }
    .xmas-gifts__rules > * + * { margin-top: 19px; }
    .xmas-gifts__rules h4 + p { margin-top: 10px; }
    .xmas-gifts__rules p:has(> em:only-child) { font-size: 9px; margin-top: 10px; }
    .xmas-gifts__dismiss { min-height: 50px; font-size: 14px; }
  }
{% endstylesheet %}

