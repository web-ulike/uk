<style>
  .marquee-section {
    --section-background: var(--marquee-background);
    --txt-color: var(--marquee-text-color);
    --cnt-gap: var(--marquee-gap);
    --anim-duration: var(--marquee-speed);
    --item-height: var(--marquee-item-height);
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background: var(--section-background);
  }

  .marquee-section .marquee-tle {
    margin: 0 0 50px;
    color: var(--txt-color, #3f3636);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.64px;
    text-align: center;
  }

  .marquee-section .marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 5%,
      #000 95%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 5%,
      #000 95%,
      transparent
    );
  }

  .marquee-section .marquee-track {
    display: flex;
    align-items: center;
    gap: var(--cnt-gap);
    width: max-content;
    min-width: max-content;
    will-change: transform;
    animation: marquee-scroll var(--anim-duration) linear infinite;
  }

  .marquee-section .marquee-group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--cnt-gap);
  }

  .marquee-section .marquee-item {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: auto;
    height: var(--item-height);
    color: inherit;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .marquee-section .marquee-item:hover {
    opacity: 0.7;
  }

  .marquee-section .marquee-item picture {
    display: block;
    width: auto;
    height: 100%;
  }

  .marquee-section .marquee-item img {
    display: block;
    width: auto;
    max-width: none;
    height: 100%;
    object-fit: contain;
  }

  .marquee-section .marquee-item svg {
    display: block;
    width: auto;
    height: 100%;
  }

  .marquee-section .marquee-wrapper:hover .marquee-track,
  .marquee-section .marquee-wrapper:focus-within .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(var(--marquee-distance), 0, 0);
    }
  }

  @media screen and (max-width: 768px) {
    .marquee-section {
      --cnt-gap: var(--marquee-mobile-gap);
      --anim-duration: var(--marquee-mobile-speed);
      --item-height: var(--marquee-mobile-item-height);
      padding-top: var(--mobile-padding-top);
      padding-bottom: var(--mobile-padding-bottom);
    }

    .marquee-section .marquee-tle {
      margin-bottom: 30px;
      font-size: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-section .marquee-track {
      animation-play-state: paused !important;
    }
  }
</style>

<section
  class="marquee-section"
  data-marquee="{{ section.id }}"
  style="--marquee-background:{{ section.settings.background }};--marquee-text-color:{{ section.settings.text_color }};--marquee-gap:{{ section.settings.gap }}px;--marquee-speed:{{ section.settings.speed }}s;--marquee-item-height:{{ section.settings.item_height }}px;--marquee-mobile-gap:{{ section.settings.mobile_gap }}px;--marquee-mobile-speed:{{ section.settings.mobile_speed }}s;--marquee-mobile-item-height:{{ section.settings.mobile_item_height }}px;--padding-top:{{ section.settings.padding_top }}px;--padding-bottom:{{ section.settings.padding_bottom }}px;--mobile-padding-top:{{ section.settings.mobile_padding_top }}px;--mobile-padding-bottom:{{ section.settings.mobile_padding_bottom }}px;--marquee-distance:0px;"
>
  {% if section.settings.marquee_tle != blank %}<div class="marquee-tle">{{ section.settings.marquee_tle }}</div>{% endif %}

  <div class="marquee-wrapper" data-marquee-wrapper>
    <div class="marquee-track" data-marquee-track>
      <div class="marquee-group" data-marquee-group>
        {% for block in section.blocks %}
          {% liquid
            assign item_tag = 'div'
            if block.settings.link != blank
              assign item_tag = 'a'
            endif
          %}

          <{{ item_tag }} class="marquee-item" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
            <picture>
              {% if block.settings.image_mobile != blank %}<source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 400 }}">{% endif %}
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | default: section.settings.marquee_tle | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </picture>
          </{{ item_tag }}>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
(() => {
  const section = document.querySelector('[data-marquee="{{ section.id }}"]');
  if (!section || section.dataset.marqueeInitialized === 'true') return;

  section.dataset.marqueeInitialized = 'true';

  const wrapper = section.querySelector('[data-marquee-wrapper]');
  const track = section.querySelector('[data-marquee-track]');
  const sourceGroup = section.querySelector('[data-marquee-group]');

  if (!wrapper || !track || !sourceGroup) return;

  let resizeFrame = null;

  const getGap = () => {
    const styles = getComputedStyle(track);
    return parseFloat(styles.columnGap || styles.gap) || 0;
  };

  const removeClones = () => {
    track.querySelectorAll('[data-marquee-clone]').forEach(clone => clone.remove());
  };

  const createClone = () => {
    const clone = sourceGroup.cloneNode(true);
    clone.removeAttribute('data-marquee-group');
    clone.setAttribute('data-marquee-clone', '');
    clone.setAttribute('aria-hidden', 'true');

    clone.querySelectorAll('[id]').forEach(element => element.removeAttribute('id'));
    clone.querySelectorAll('a,button,input,select,textarea').forEach(element => element.setAttribute('tabindex', '-1'));
    clone.querySelectorAll('[data-shopify-editor-block]').forEach(element => element.removeAttribute('data-shopify-editor-block'));

    return clone;
  };

  const update = () => {
    removeClones();

    const groupWidth = sourceGroup.getBoundingClientRect().width;
    const wrapperWidth = wrapper.getBoundingClientRect().width;
    const gap = getGap();

    if (!groupWidth || !wrapperWidth) return;

    const distance = groupWidth + gap;
    const cloneCount = Math.max(2, Math.ceil(wrapperWidth / distance) + 2);

    for (let i = 0; i < cloneCount; i += 1) {
      track.appendChild(createClone());
    }

    section.style.setProperty('--marquee-distance', `${-distance}px`);
  };

  const scheduleUpdate = () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(update);
  };

  const images = [...sourceGroup.querySelectorAll('img')];

  images.forEach(image => {
    if (!image.complete) image.addEventListener('load', scheduleUpdate, { once: true });
  });

  if ('ResizeObserver' in window) {
    const observer = new ResizeObserver(scheduleUpdate);
    observer.observe(wrapper);
    observer.observe(sourceGroup);
    section.marqueeResizeObserver = observer;
  } else {
    window.addEventListener('resize', scheduleUpdate);
  }

  update();

  document.addEventListener('shopify:section:unload', event => {
    if (!event.target.contains(section)) return;
    section.marqueeResizeObserver?.disconnect();
    cancelAnimationFrame(resizeFrame);
  });
})();
</script>

{% schema %}
{
  "name": "Marquee List Pro",
  "blocks": [
    {
      "type": "item",
      "name": "Logo / Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image (Optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional: Make the image clickable"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "marquee_tle",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "range",
      "id": "item_height",
      "min": 40,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Image Height",
      "default": 80
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap between items",
      "default": 60
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Animation Speed",
      "default": 20,
      "info": "Lower value = Faster scrolling"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "range",
      "id": "mobile_item_height",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Image Height",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap between items",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Animation Speed",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3F3636"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Marquee List Pro",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}