<style>
  #shopify-section-{{ section.id }} {
    --trust-bar-background: {{ section.settings.background }};
    --trust-bar-text-color: {{ section.settings.text_color }};
    --trust-bar-mobile-speed: 18s;
  }

  .trust-bar__box.trust-bar {
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    background: var(--trust-bar-background);
  }

  .trust-bar__box .trust-bar__inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .trust-bar__box .trust-bar__track {
    width: 100%;
  }

  .trust-bar__box .trust-bar__group {
    display: flex;
    align-items: center;
    justify-content: space-around;
    width: 100%;
  }

  .trust-bar__box .trust-bar__group--clone {
    display: none;
  }

  .trust-bar__box .trust-bar__item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    gap: 15px;
    min-width: 0;
  }

  .trust-bar__box .trust-bar__icon {
    display: block;
    flex: 0 0 auto;
    width: auto;
    height: {{ section.settings.icon_height }}px;
    object-fit: contain;
  }

  .trust-bar__box .trust-bar__text {
    margin: 0;
    color: var(--trust-bar-text-color);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 400;
    line-height: 1.2;
    white-space: nowrap;
  }

  @media screen and (max-width: 640px) {
    .trust-bar__box.trust-bar {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .trust-bar__box .trust-bar__inner {
      max-width: none;
      padding: 0;
      overflow: hidden;
    }

    .trust-bar__box .trust-bar__track {
      display: flex;
      align-items: center;
      width: max-content;
      will-change: transform;
      animation:
        trust-bar-marquee-{{ section.id }}
        var(--trust-bar-mobile-speed)
        linear
        infinite;
    }

    .trust-bar__box .trust-bar__group {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      flex: 0 0 auto;
      width: auto;
      gap: 36px;
      padding-right: 36px;
    }

    .trust-bar__box .trust-bar__group--clone {
      display: flex;
    }

    .trust-bar__box .trust-bar__item {
      flex: 0 0 auto;
      justify-content: flex-start;
      gap: 8px;
    }

    .trust-bar__box .trust-bar__icon {
      height: {{ section.settings.mobile_icon_height }}px;
    }

    .trust-bar__box .trust-bar__text {
      font-size: {{ section.settings.mobile_text_size }}px;
      white-space: nowrap;
    }

    @keyframes trust-bar-marquee-{{ section.id }} {
      from {
        transform: translate3d(0, 0, 0);
      }

      to {
        transform: translate3d(-50%, 0, 0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-bar__box .trust-bar__track {
      animation-play-state: paused;
    }
  }
</style>

<section class="trust-bar trust-bar__box js-scroll__group">
  <div class="trust-bar__inner">
    <div class="trust-bar__track">

      <div class="trust-bar__group">
        {% for block in section.blocks %}
          <div
            class="trust-bar__item js-scroll__card"
            {{ block.shopify_attributes }}
            style="--reveal-index: {{ forloop.index0 }};"
          >
            {% if block.settings.icon != blank %}
              {{
                block.settings.icon
                | image_url: width: 160
                | image_tag:
                  class: 'trust-bar__icon',
                  loading: 'lazy',
                  alt: block.settings.text
              }}
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="trust-bar__text">
                {{ block.settings.text }}
              </p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div
        class="trust-bar__group trust-bar__group--clone"
        aria-hidden="true"
      >
        {% for block in section.blocks %}
          <div class="trust-bar__item">
            {% if block.settings.icon != blank %}
              {{
                block.settings.icon
                | image_url: width: 160
                | image_tag:
                  class: 'trust-bar__icon',
                  loading: 'lazy',
                  alt: ''
              }}
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="trust-bar__text">
                {{ block.settings.text }}
              </p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Bar",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FBFAF4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#272323"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size - Desktop",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_height",
      "label": "Icon Height - Desktop",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top - Desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom - Desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Text Size - Mobile",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_icon_height",
      "label": "Icon Height - Mobile",
      "min": 14,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding Top - Mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding Bottom - Mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FDA Certified"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "FDA Certified"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "100 Days MONEY - BACK"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Skin Health Alliance"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "CE-MDR"
          }
        }
      ]
    }
  ]
}
{% endschema %}