<div
  class="xmas-visit"
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
>
  <div class="container">
    <div class="xmas-visit__row">
      {% for block in section.blocks %}
        <div
          class="xmas-visit__detail to-top"
          {% unless forloop.first %}
            style="transition-delay: {{ forloop.index0 | times: 0.1 }}s"
          {% endunless %}
          {{ block.shopify_attributes }}
        >
          {% if block.settings.label != blank -%}
            <small class="xmas-visit__label">{{ block.settings.label | escape }}</small>
          {%- endif %}
          {% if block.settings.title != blank -%}
            <strong class="xmas-visit__title">{{ block.settings.title | escape }}</strong>
          {%- endif %}
          {% if block.settings.detail != blank %}
            <p class="xmas-visit__note">{{ block.settings.detail | escape }}</p>
          {% endif %}
        </div>
      {% endfor %}
      {% if section.settings.map_url != blank and section.settings.button != blank %}
        <a
          class="xmas-visit__directions to-top"
          style="transition-delay: {{ section.blocks.size | times: 0.1 }}s"
          href="{{ section.settings.map_url | escape }}"
          target="_blank"
          rel="noopener"
        >
          {{ section.settings.button | escape }}
          {% assign pin = section.settings.pin | default: section.settings.pin_mobile %}
          {% if pin != blank %}
            <picture>
              {% if section.settings.pin_mobile != blank %}
                <source media="(max-width: 700px)" srcset="{{ section.settings.pin_mobile | image_url: width: 44 }}">
              {% endif %}
              {{ pin | image_url: width: 44 | image_tag: width: 22, height: 21, alt: '' }}
            </picture>
          {% elsif section.settings.pin_svg != blank %}
            <span class="xmas-visit__pin" aria-hidden="true">{{ section.settings.pin_svg }}</span>
          {% endif %}
        </a>
      {% endif %}
    </div>
    {% if section.settings.show_divider %}
      <div class="xmas-visit__rule" style="background-color: {{ section.settings.divider_color }};" aria-hidden="true"></div>
    {% endif %}
  </div>
  {% if section.settings.show_bar %}
    <aside class="xmas-visit__bar">
      <div>
        <strong>{{ section.settings.summary | escape }}</strong><small>{{ section.settings.subline | escape }}</small>
      </div>
      {% assign visit_anchor = section.settings.anchor | handleize %}
      <a href="#{% if visit_anchor != blank %}{{ visit_anchor }}{% else %}shopify-section-{{ section.id }}{% endif %}">
        {{- section.settings.visit_label | escape -}}
      </a>
    </aside>
  {% endif %}
</div>

{% stylesheet %}
  .xmas-visit {
    background: #fbf6ed;
    color: #3f3636;
    font-family: Saans, sans-serif;
    scroll-margin-top: calc(
      var(--header-height, 0px) * var(--enable-sticky-header, 0) + var(--announcement-bar-height, 0px) *
        var(--enable-sticky-announcement-bar, 0)
    );
  }

  .xmas-visit img {
    display: block;
  }
  .xmas-visit__row,
  .xmas-visit__rule {
    max-width: 1520px;
    margin-inline: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .xmas-visit .to-top {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .xmas-visit__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 66px 0;
  }

  .xmas-visit__detail {
    display: flex;
    flex: 1 1 470px;
    flex-direction: column;
    gap: 6px;
    max-width: 470px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .xmas-visit__label {
    color: #a30a41;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 2px;
  }

  .xmas-visit__title {
    font-size: 26px;
    font-weight: 500;
    line-height: 1.2;
  }

  .xmas-visit__note {
    margin: 0;
    font-size: 14px;
    line-height: 18px;
    opacity: 0.6;
  }

  .xmas-visit__directions {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 3px;
    max-width: 100%;
    min-height: 48px;
    padding: 6px 20px;
    border-radius: 4px;
    background: #e0004d;
    color: #fff;
    font: 500 15px/1.2 Saans, sans-serif;
    text-align: center;
    text-transform: uppercase;
  }

  .xmas-visit__directions:hover {
    background: #a30a41;
    color: #fff;
  }
  .xmas-visit__directions picture {
    flex: none;
  }
  .xmas-visit__directions img {
    object-fit: contain;
  }
  .xmas-visit__pin,
  .xmas-visit__pin svg {
    display: block;
    width: 22px;
    height: 21px;
    flex: none;
  }
  .xmas-visit__rule {
    height: 0.5px;
  }

  .xmas-visit__bar {
    display: none;
  }
  @media (max-width: 700px) {
    .xmas-visit > .container {
      padding-inline: 16px;
    }
    .xmas-visit__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 48px 0 46px;
    }
    .xmas-visit__detail {
      flex: none;
      max-width: 100%;
    }
    .xmas-visit__detail + .xmas-visit__detail {
      margin-top: 29px;
    }
    .xmas-visit__label {
      font-size: 10px;
    }
    .xmas-visit__title {
      font-size: 18px;
    }
    .xmas-visit__note {
      font-size: 12px;
    }
    .xmas-visit__directions {
      font-size: 12px;
    }
    .xmas-visit__bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 5;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 18px calc(12px + env(safe-area-inset-bottom));
      background: #fff9ef;
      border-top: 1px solid #dad2be;
    }
    .xmas-visit__bar strong {
      font: 500 14px Saans, sans-serif;
    }
    .xmas-visit__bar small {
      display: block;
      font-size: 12px;
    }
    .xmas-visit__bar a {
      padding: 14px 18px;
      border-radius: 3px;
      background: #861629;
      color: white;
      font-size: 14px;
    }
    body:has(.xmas-visit__bar) {
      padding-bottom: calc(70px + env(safe-area-inset-bottom));
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('shopify:section:load', (event) => {
    if (event.target.querySelector('.xmas-visit') && typeof window.initialCheck === 'function') {
      window.initialCheck();
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "Christmas visit details",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Navigation anchor ID"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Map link"
    },
    {
      "type": "image_picker",
      "id": "pin",
      "label": "Directions icon"
    },
    {
      "type": "image_picker",
      "id": "pin_mobile",
      "label": "Mobile directions icon (optional)"
    },
    {
      "type": "textarea",
      "id": "pin_svg",
      "label": "Directions icon SVG",
      "info": "Used when both directions icon images are empty.",
      "default": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8'><path d='M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z'/><circle cx='12' cy='10' r='2.5'/></svg>"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#cfc6be"
    },
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show mobile visit bar",
      "default": true
    },
    {
      "type": "text",
      "id": "summary",
      "label": "Mobile summary",
      "default": "6 Dec · London"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Mobile detail",
      "default": "10 AM–4 PM · Future Stores"
    },
    {
      "type": "text",
      "id": "visit_label",
      "label": "Mobile button",
      "default": "Plan your visit ↗"
    }
  ],
  "presets": [
    {
      "name": "Christmas visit details",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "label": "SAVE THE DATE",
            "title": "6 December · 10 AM–4 PM",
            "detail": "One day only · London local time"
          }
        },
        {
          "type": "detail",
          "settings": {
            "label": "FIND US HERE",
            "title": "Future Stores, Oxford Street",
            "detail": "95 Oxford Street, London W1D 2AD"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Visit detail",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail"
        }
      ]
    }
  ]
}
{% endschema %}
