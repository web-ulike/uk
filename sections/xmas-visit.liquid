<div class="xmas xmas-visit"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="container"><div class="xmas-visit__row">
    {% for block in section.blocks %}
      <div class="to-top"{% unless forloop.first %} style="transition-delay: {{ forloop.index0 | times: 0.1 }}s"{% endunless %} {{ block.shopify_attributes }}>
        <small>{{ block.settings.label | escape }}</small>
        <strong>{{ block.settings.title | escape }}</strong>
        <p>{{ block.settings.detail | escape }}</p>
      </div>
    {% endfor %}
    {% render 'xmas-directions', settings_group: section.settings %}
  </div></div>
  {% if section.settings.show_bar %}
    <aside class="xmas-visit__bar">
      <div><strong>{{ section.settings.summary | escape }}</strong><small>{{ section.settings.subline | escape }}</small></div>
      <a href="#shopify-section-{{ section.id }}">{{ section.settings.visit_label | escape }}</a>
    </aside>
  {% endif %}
</div>

{% stylesheet %}
.xmas-visit__row { display: grid; grid-template-columns: 1.1fr 1.3fr auto; align-items: center; gap: 34px; padding: 36px 0; border-bottom: 1px solid #e3dcd3; }
.xmas-visit__row small { display: block; font-size: 10px; color: #7f2330; letter-spacing: 2px; margin-bottom: 8px; }
.xmas-visit__row strong { font-size: 19px; font-weight: 400; }
.xmas-visit__row p { margin: 4px 0 0; font-size: 13px; color: #716b69; }
.xmas-visit__bar { display: none; }
@media (max-width: 700px) {
  .xmas-visit__row { grid-template-columns: 1fr; justify-items: start; gap: 23px; padding: 30px 0; }
  .xmas-visit__bar { position: fixed; inset: auto 0 0; z-index: 5; display: flex; justify-content: space-between; align-items: center; padding: 12px 18px calc(12px + env(safe-area-inset-bottom)); background: #fff9ef; border-top: 1px solid #dad2be; }
  .xmas-visit__bar strong { font: 500 12px Saans, sans-serif; }
  .xmas-visit__bar small { display: block; font-size: 10px; }
  .xmas-visit__bar a { padding: 14px 18px; border-radius: 3px; background: #861629; color: white; font-size: 11px; }
  body:has(.xmas-visit__bar) { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Christmas visit details",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Navigation anchor ID"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Map link"
    },
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show mobile visit bar",
      "default": true
    },
    {
      "type": "text",
      "id": "summary",
      "label": "Mobile summary",
      "default": "6 Dec · London"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Mobile detail",
      "default": "10 AM–4 PM · Future Stores"
    },
    {
      "type": "text",
      "id": "visit_label",
      "label": "Mobile button",
      "default": "Plan your visit ↗"
    }
  ],
  "presets": [
    {
      "name": "Christmas visit details",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "label": "SAVE THE DATE",
            "title": "6 December · 10 AM–4 PM",
            "detail": "One day only · London local time"
          }
        },
        {
          "type": "detail",
          "settings": {
            "label": "FIND US HERE",
            "title": "Future Stores, Oxford Street",
            "detail": "95 Oxford Street, London W1D 2AD"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Visit detail",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail"
        }
      ]
    }
  ]
}
{% endschema %}
