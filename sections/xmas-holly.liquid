<section class="xmas-holly"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="container">
    <div class="xmas-holly__grid">
      {% if section.settings.kicker != blank or section.settings.heading != blank %}
        <header class="xmas-holly__titles to-top">
          {% if section.settings.kicker != blank %}
            <p class="xmas-holly__kicker">{{ section.settings.kicker | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="xmas-holly__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
          {% endif %}
        </header>
      {% endif %}

      {% if section.settings.image != blank %}
        <div class="xmas-holly__portrait to-top">
          {% assign portrait_alt = section.settings.alt | default: section.settings.image.alt %}
          {{ section.settings.image | image_url: width: 1452 | image_tag:
            widths: '343,500,700,900,1080,1452',
            sizes: '(max-width: 700px) calc(100vw - 32px), (max-width: 1600px) 46vw, 700px',
            loading: 'lazy', alt: portrait_alt
          }}
        </div>
      {% endif %}

      {% if section.settings.description != blank or section.settings.note != blank %}
        <div class="xmas-holly__details to-top">
          {% if section.settings.description != blank %}
            <p class="xmas-holly__description">{{ section.settings.description | escape | newline_to_br }}</p>
          {% endif %}
          {% if section.settings.note != blank %}
            <div class="xmas-holly__note">
              {% if section.settings.show_divider %}
                <span class="xmas-holly__rule" style="background-color: {{ section.settings.divider_color }};" aria-hidden="true"></span>
              {% endif %}
              <p>{{ section.settings.note | escape }}</p>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .xmas-holly {
    background: #fbf6ed;
    color: #190a0a;
    padding-bottom: 80px;
    font-family: Saans, sans-serif;
    scroll-margin-top: calc(var(--header-height, 0px) * var(--enable-sticky-header, 0) + var(--announcement-bar-height, 0px) * var(--enable-sticky-announcement-bar, 0));
  }
  .xmas-holly__grid {
    display: grid;
    grid-template-columns: minmax(0, 700fr) minmax(0, 698fr);
    grid-template-rows: 1fr auto auto 1fr;
    column-gap: 8.0263%;
  }
  .xmas-holly__titles, .xmas-holly__details, .xmas-holly__note {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .xmas-holly__titles, .xmas-holly__details { grid-column: 2; max-width: 456px; }
  .xmas-holly__titles { grid-row: 2; }
  .xmas-holly__details { grid-row: 3; }
  .xmas-holly__titles ~ .xmas-holly__details { margin-top: 10px; }
  .xmas-holly p, .xmas-holly h2 { margin: 0; }
  .xmas-holly__kicker { color: #a30a41; font: 400 18px/1.5 saans-light, sans-serif; letter-spacing: 2px; }
  .xmas-holly__heading { color: inherit; font: 400 56px/1.2 Saans, sans-serif; letter-spacing: normal; }
  .xmas-holly__portrait {
    position: relative;
    grid-area: 1 / 1 / -1 / 2;
    align-self: center;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
  }
  .xmas-holly__portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .xmas-holly__description { color: rgb(63 54 54 / 60%); font-size: 14px; line-height: 18px; }
  .xmas-holly__description:has(+ .xmas-holly__note) { min-height: 85px; }
  .xmas-holly__note { font: italic 400 18px/1.5 saans-light, sans-serif; }
  .xmas-holly__rule { width: 147px; max-width: 100%; height: 0.5px; }
  .xmas-holly__grid:not(:has(.xmas-holly__portrait)) { display: block; }

  @media (max-width: 700px) {
    .xmas-holly { padding-block: 50px; }
    .xmas-holly > .container { padding-inline: 16px; }
    .xmas-holly__grid { display: flex; flex-direction: column; }
    .xmas-holly__titles, .xmas-holly__details { max-width: none; }
    .xmas-holly__titles:has(+ .xmas-holly__portrait) { margin-bottom: 30px; }
    .xmas-holly__kicker { font-size: 12px; }
    .xmas-holly__heading { font-size: 30px; }
    .xmas-holly__portrait { width: 100%; border-radius: 0; }
      .xmas-holly__portrait + .xmas-holly__details { margin-top: 20px; }
    .xmas-holly__description { color: rgb(25 10 10 / 60%); font-size: 12px; }
    .xmas-holly__description:has(+ .xmas-holly__note) { min-height: 0; }
    .xmas-holly__note { color: #1a1a1a; font-size: 14px; line-height: normal; }
  }
  @media (prefers-reduced-motion: reduce) {
    .xmas-holly .to-top { opacity: 1; transform: none; transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('shopify:section:load', (event) => {
    if (event.target.querySelector('.xmas-holly') && typeof window.initialCheck === 'function') {
      window.initialCheck();
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "Christmas guest feature",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Navigation anchor ID"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Image description",
      "default": "Holly Hagan-Blyth"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "CHRISTMAS WITH HOLLY"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Gift inspiration,\nwith Holly."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join Holly Hagan-Blyth at our London Christmas pop-up. Explore the Ulike lineup and get inspired to choose a thoughtful gift for someone you love — or a little treat for yourself."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Appearance note",
      "default": "Appearance time to be announced"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#190a0a"
    }
  ],
  "presets": [
    {
      "name": "Christmas guest feature"
    }
  ]
}
{% endschema %}
