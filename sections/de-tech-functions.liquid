<style>
  #shopify-section-{{ section.id }} .de-tech-functions {
    padding: 100px 0 100px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__title {
    margin: 0 0 60px;
    color: {{ section.settings.title_color }};
    font-size: 50px;
    line-height: 1.25;
    text-align: center;
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__image-wrap {
    display: block;
    width: 100%;
    overflow: hidden;
    background: #f5f5fb;
    position: relative;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__image {
    display: block;
    width: 100%;
    transition: transform 0.45s ease;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__item:hover .de-tech-functions__image {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .de-tech-functions__image-text {
    position: absolute;
    z-index: 2;
    max-width: calc(100% - 32px);
    background: linear-gradient(42deg, #599AE0 -12.58%, #95E4FB 92.02%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: var(--heading-font-family);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.12;
    pointer-events: none;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__image-text--top-left {
    top: 24px;
    left: 24px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__image-text--top-center {
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
  }

  #shopify-section-{{ section.id }} .de-tech-functions__image-text--top-right {
    top: 24px;
    right: 24px;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__image-text--center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  #shopify-section-{{ section.id }} .de-tech-functions__image-text--bottom-left {
    bottom: 24px;
    left: 24px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__image-text--bottom-center {
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
  }

  #shopify-section-{{ section.id }} .de-tech-functions__image-text--bottom-right {
    right: 24px;
    bottom: 24px;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #8b8b8b;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__item-title {
    margin: 30px 0 0;
    color: #190A0A;
    font-family: var(--heading-font-family);
    font-size: 26px;
    font-weight: normal;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__text {
    margin: 13px 0 0;
    color: rgba(25, 10, 10, 0.5);
    font-size: 20px;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .de-tech-functions__note {
    margin: 63px 0 0;
    color: rgba(25, 10, 10, 0.5);
    font-size: 18px;
    line-height: 1.25;
  }


  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} .de-tech-functions {
      padding: 50px 0 46px;
    }

    #shopify-section-{{ section.id }} .de-tech-functions__title {
      margin-bottom: 28px;
      font-size: 20px;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .de-tech-functions__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 20px;
    }

    #shopify-section-{{ section.id }} .de-tech-functions__item:nth-child(1) { order: 1; }
    #shopify-section-{{ section.id }} .de-tech-functions__item:nth-child(2) { order: 3; }
    #shopify-section-{{ section.id }} .de-tech-functions__item:nth-child(3) { order: 2; }
    #shopify-section-{{ section.id }} .de-tech-functions__item:nth-child(4) { order: 4; }

    #shopify-section-{{ section.id }} .de-tech-functions__item-title {
      margin-top: 12px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .de-tech-functions__image-text {
      max-width: calc(100% - 18px);
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .de-tech-functions__image-text--top-left,
    #shopify-section-{{ section.id }} .de-tech-functions__image-text--top-center,
    #shopify-section-{{ section.id }} .de-tech-functions__image-text--top-right {
      top: 14px;
    }

    #shopify-section-{{ section.id }} .de-tech-functions__image-text--bottom-left,
    #shopify-section-{{ section.id }} .de-tech-functions__image-text--bottom-center,
    #shopify-section-{{ section.id }} .de-tech-functions__image-text--bottom-right {
      bottom: 14px;
    }

    #shopify-section-{{ section.id }} .de-tech-functions__image-text--top-left,
    #shopify-section-{{ section.id }} .de-tech-functions__image-text--bottom-left {
      left: 14px;
    }

    #shopify-section-{{ section.id }} .de-tech-functions__image-text--top-right,
    #shopify-section-{{ section.id }} .de-tech-functions__image-text--bottom-right {
      right: 14px;
    }

    #shopify-section-{{ section.id }} .de-tech-functions__text {
      margin-top: 5px;
      font-size: 10px;
    }

    #shopify-section-{{ section.id }} .de-tech-functions__note {
      margin-top: 30px;
      font-size: 10px;
    }

  }
</style>

<section
  class="de-tech-functions"
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | escape }}"{% endif %}
  data-section-anchor="{{ section.settings.anchor_id | escape }}"
>
  <div class="container">
    {%- if section.settings.title != blank -%}
      <h2 class="de-tech-functions__title to-top">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="de-tech-functions__grid">
        {%- for block in section.blocks -%}
          <div class="de-tech-functions__item"{% if block.settings.anchor_id != blank %} id="{{ block.settings.anchor_id | escape }}"{% endif %} {{ block.shopify_attributes }}>
            <div class="de-tech-functions__image-wrap to-top">
              {%- if block.settings.image != blank -%}
                <img
                  loading="lazy"
                  class="de-tech-functions__image"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  {% render 'image-attributes', image: block.settings.image %}
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                >
              {%- else -%}
                <div class="de-tech-functions__placeholder">{{ block.settings.title }}</div>
              {%- endif -%}

              {%- if block.settings.image_text != blank -%}
                <div
                  class="de-tech-functions__image-text de-tech-functions__image-text--{{ block.settings.image_text_position }}"
                >
                  {{ block.settings.image_text }}
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="de-tech-functions__item-title to-top" style="transition-delay: 0.1s">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="de-tech-functions__text to-top" style="transition-delay: 0.2s">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="de-tech-functions__note to-top" style="transition-delay: 0.3s">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>

</section>


{% schema %}
{
  "name": "DE tech functions",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Wichtige Technologien & Funktionen"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#8582d4"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Footnote",
      "default": "*Hinweis: USHR bezeichnet einen Modus, der mehrere IPL-Lichtimpulse nutzt, um Wärme schrittweise aufzubauen und so eine effektivere und gleichzeitig angenehmere Haarentfernung zu ermöglichen."
    }
  ],
  "blocks": [
    {
      "name": "Technology item",
      "type": "item",
      "settings": [
        {
          "type": "text",
          "id": "anchor_id",
          "label": "Item anchor ID"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_text",
          "label": "Image text"
        },
        {
          "type": "select",
          "id": "image_text_position",
          "label": "Image text position",
          "options": [
            {
              "value": "top-left",
              "label": "Top left"
            },
            {
              "value": "top-center",
              "label": "Top center"
            },
            {
              "value": "top-right",
              "label": "Top right"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-center",
              "label": "Bottom center"
            },
            {
              "value": "bottom-right",
              "label": "Bottom right"
            }
          ],
          "default": "top-center"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ice Cooling"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Sorgt für ein angenehmes Hautgefühl und schützt die Haut während der Anwendung."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DE tech functions",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
