                <h3 class="pulse-timer-h3">{{ section.settings.text1 }}</h3>
            {%- endif -%}
            <div class="pulse-timer-center">
                {%- if section.settings.text2 != blank -%}
                    <div class="pulse-timer-p">{{ section.settings.text2 }}</div>
                {%- endif -%}
                {%- if section.settings.text3 != blank -%}
                    <div class="pulse-timer-pt">{{ section.settings.text3 }} </div>
