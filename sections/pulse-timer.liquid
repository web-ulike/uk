<style>
.pulse-timer {
  position: relative;
  z-index: 1;
}

.pulse-timer .img {
  width: 100%;
  position: relative;
  z-index: 1;
}

.pulse-timer .pulse-timer-cont {
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  transform: translateY(-50%);
  z-index: 2;
}
.pulse-timer .pulse-timer-text {
  max-width: 870px;
}

.pulse-timer .pulse-timer-top {
  margin-bottom: 56px;
}

.pulse-timer .pulse-timer-icon {
  display: flex;
  align-items: center;
  gap: 23px;
  margin-bottom: 19px;
}

.pulse-timer .pulse-timer-icon svg {
  display: block;
  margin: 0;
}

.pulse-timer .pulse-timer-icon-txt {
  font-size: 32px;
  line-height: 1.2;
  background: linear-gradient(157deg, #adacee 13.99%, #6e69c9 66.24%);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.pulse-timer .pulse-timer-h3 {
  color: #190a0a;
  font-size: 56px;
  line-height: 1.37;
  font-weight: normal;
  margin: 0;
  max-width: 700px;
}

.pulse-timer .pulse-timer-p {
  color: #190a0a;
  font-size: 24px;
  line-height: 1;
  margin-bottom: 16px;
}

.pulse-timer .pulse-timer-pt {
  font-family: Saans;
  font-size: 40px;
  line-height: 1;
  background: linear-gradient(157deg, #adacee 13.99%, #6e69c9 66.24%);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.pulse-timer .pulse-timer-img {
  margin-top: 128px;
}

.pulse-timer .img-icon {
  width: 100%;
}

@media (max-width: 1500px) {
  .pulse-timer .pulse-timer-text {
    max-width: 600px;
  }

  .pulse-timer .pulse-timer-top {
    margin-bottom: 40px;
  }

  .pulse-timer .pulse-timer-icon {
    gap: 15px;
  }

  .pulse-timer .pulse-timer-icon-txt {
    font-size: 26px;
  }

  .pulse-timer .pulse-timer-icon svg {
    width: 35px;
    height: auto;
  }

  .pulse-timer .pulse-timer-h3 {
    font-size: 45px;
  }

  .pulse-timer .pulse-timer-p {
    font-size: 18px;
  }

  .pulse-timer .pulse-timer-pt {
    font-size: 28px;
  }

  .pulse-timer .pulse-timer-img {
    margin-top: 60px;
  }
}

@media (max-width: 991px) {
  .pulse-timer .pulse-timer-cont,
  .pulse-timer .container,
  .pulse-timer .pulse-timer-text {
    height: 100%;
  }

  .pulse-timer .pulse-timer-cont {
    padding: 40px 0 58px 0;
  }

  .pulse-timer .pulse-timer-text {
    max-width: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .pulse-timer .pulse-timer-img {
    margin-top: 0;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    padding: 18px 10px;
  }

  .pulse-timer .pulse-timer-icon {
    justify-content: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .pulse-timer .pulse-timer-icon-txt {
    font-size: 16px;
  }

  .pulse-timer .pulse-timer-icon svg {
    width: 24px;
    height: auto;
  }

  .pulse-timer .pulse-timer-h3 {
    font-size: 28px;
    max-width: 295px;
    margin: 0 auto;
    text-align: center;
  }

  .pulse-timer .pulse-timer-center {
    margin-top: 17.6vw;
  }

  .pulse-timer .pulse-timer-p {
    font-size: 12px;
  }

  .pulse-timer .pulse-timer-pt {
    font-size: 22px;
  }
}
</style>
<section class="section-box">
<div class="pulse-timer">
    {%- if section.settings.image != blank -%}
        <picture>
        <source srcset="{{ section.settings.image1 | image_url }}" media="(max-width: 991px)">
