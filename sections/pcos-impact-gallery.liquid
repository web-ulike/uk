    }

    #shopify-section-{{ section.id }} .pcos-impact-gallery__stat-icon {
      width: 30px;
      height: 30px;
    }

    #shopify-section-{{ section.id }} .pcos-impact-gallery__stat-icon svg {
      width: 14px;
      height: 14px;
    }

    #shopify-section-{{ section.id }} .pcos-impact-gallery__stat-label {
      color: #6A6A6A;
