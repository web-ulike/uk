<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} .pcos-impact-gallery');
    var activityId = '301870633984196609';

    if (!root || root.dataset.apiReady === 'true') {
      return;
    }

    root.dataset.apiReady = 'true';

    function parseExtend(value) {
      if (!value) {
        return {};
      }

      if (typeof value === 'object') {
        return value;
      }

      try {
        return JSON.parse(value);
      } catch (error) {
        return {};
      }
    }

    function formatNumber(value) {
      var number = Number(value);

      if (!Number.isFinite(number)) {
        return value == null ? '' : String(value);
      }

      return new Intl.NumberFormat('en-US').format(number);
    }

    function formatJoinedTime(timestamp) {
      var numericTimestamp = Number(timestamp);

      if (!numericTimestamp) {
        return '';
      }

      var milliseconds = numericTimestamp < 1000000000000 ? numericTimestamp * 1000 : numericTimestamp;
      var elapsedSeconds = Math.max(0, Math.floor((Date.now() - milliseconds) / 1000));

      if (elapsedSeconds < 60) {
        return 'became a supporter just now';
      }

      var units = [
        { seconds: 31536000, singular: 'yr', plural: 'yrs' },
        { seconds: 2592000, singular: 'mo', plural: 'mos' },
        { seconds: 604800, singular: 'wk', plural: 'wks' },
        { seconds: 86400, singular: 'day', plural: 'days' },
        { seconds: 3600, singular: 'hr', plural: 'hrs' },
        { seconds: 60, singular: 'min', plural: 'mins' }
      ];

      for (var index = 0; index < units.length; index += 1) {
        if (elapsedSeconds >= units[index].seconds) {
          var amount = Math.floor(elapsedSeconds / units[index].seconds);
          var label = amount === 1 ? units[index].singular : units[index].plural;

          return 'became a supporter ' + amount + ' ' + label + ' ago';
        }
      }

      return '';
    }

    function updateActivityInfo(payload) {
      if (!payload || payload.code !== 0 || !payload.data) {
        return;
      }

      var supportersNode = root.querySelector('[data-pcos-supporters]');
      var contributionNode = root.querySelector('[data-pcos-total-contribution]');
      var extend = parseExtend(payload.data.extend);

      if (supportersNode && payload.data.applyCount != null) {
        supportersNode.textContent = formatNumber(payload.data.applyCount);
      }

      if (contributionNode && extend.totalAmount != null) {
        contributionNode.textContent = formatNumber(extend.totalAmount);
      }
    }

    function createCell(value, className) {
      var cell = document.createElement('span');

      if (className) {
        cell.className = className;
      }

      cell.textContent = value || '—';
      return cell;
    }

    function updateBenefitList(payload) {
      if (!payload || payload.code !== 0 || !Array.isArray(payload.data)) {
        return;
      }

      var list = root.querySelector('[data-pcos-benefit-list]');

      if (!list) {
        return;
      }

      list.querySelectorAll('[data-pcos-api-row]').forEach(function (row) {
        row.remove();
      });

      payload.data.forEach(function (benefit, index) {
        var extend = parseExtend(benefit.extend);
        var row = document.createElement('div');
        var nameClass = 'pcos-impact-gallery__name';

        if (index < 2) {
          nameClass += ' pcos-impact-gallery__name--highlight pcos-impact-gallery__name--dot';
        }

        row.className = 'pcos-impact-gallery__row';
        row.setAttribute('data-pcos-api-row', '');
        var nameCell = createCell(extend.userName, nameClass);

        if (extend.userName) {
          nameCell.title = extend.userName;
        }

        row.appendChild(nameCell);
        var emailCell = createCell(benefit.userEmail, 'pcos-impact-gallery__email');

        if (benefit.userEmail) {
          emailCell.title = benefit.userEmail;
        }

        row.appendChild(emailCell);
        row.appendChild(createCell(formatJoinedTime(benefit.createTime)));
        list.appendChild(row);
      });

      startAutoScroll(list);
    }

    function startAutoScroll(list) {
      if (list.children.length <= 5 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }

      var isScrolling = false;

      var intervalId = window.setInterval(function () {
        if (!list.isConnected) {
          window.clearInterval(intervalId);
          return;
        }

        if (isScrolling || document.hidden || !list.firstElementChild) {
          return;
        }

        isScrolling = true;

        var firstRow = list.firstElementChild;
        var styles = window.getComputedStyle(list);
        var gap = parseFloat(styles.rowGap || styles.gap) || 0;
        var distance = firstRow.getBoundingClientRect().height + gap;
        var finished = false;

        function finishScroll() {
          if (finished) {
            return;
          }

          finished = true;
          list.style.transition = 'none';
          list.style.transform = 'translateY(0)';
          list.appendChild(firstRow);
          void list.offsetHeight;
          isScrolling = false;
        }

        list.style.transition = 'transform 500ms ease';
        list.style.transform = 'translateY(-' + distance + 'px)';
        list.addEventListener('transitionend', finishScroll, { once: true });
        window.setTimeout(finishScroll, 650);
      }, 3000);
    }

    function loadImpactData() {

      window.sendUlikeApi('/promotion/queryActivityInfo', {
        scene: 'PCOS_PAGE',
        activityId: activityId
      }).then(updateActivityInfo).catch(function (error) {
        console.error('Unable to load PCOS activity info:', error);
      });

      window.sendUlikeApi('/promotion/queryBenefitInfoList', {
        pageIndex: 1,
        pageSize: 100,
        includeCount: false,
        scene: 'PCOS_PAGE',
        activityId: activityId
      }).then(updateBenefitList).catch(function (error) {
        console.error('Unable to load PCOS benefit list:', error);
      });
    }

    if (document.readyState === 'complete') {
      loadImpactData();
    } else {
      window.addEventListener('load', loadImpactData, { once: true });
    }
  })();
</script>

{% schema %}
{
  "name": "pcos-impact-gallery",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "title", "label": "Title", "default": "Ulike Global Impact Gallery" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Every contribution helps bring light to women's health." },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Connected Now" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "1,652" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Global Impact" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "130,000" },
    { "type": "color", "id": "background", "label": "Background", "default": "#effcfc" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#e5fbfb" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
