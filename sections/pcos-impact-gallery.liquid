<style>
  #shopify-section-{{ section.id }} .pcos-impact-gallery {
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.9) 0%, {{ section.settings.background }} 48%, #f7ffff 100%);
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__inner {
    max-width: 1174px;
    margin: 0 auto;
    padding: 43.073px 115px 60.927px;
    text-align: center;
    border-radius: 30px;
    background: rgba(46, 151, 147, 0.06);
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__logos {
    margin-bottom: 30px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__logo {
    display: block;
    width: auto;
    max-width: 295px;
    max-height: 42px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__title {
    margin: 0 0 8px;
    font-size: 40px;
    line-height: 1.2;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__subtitle {
    max-width: 570px;
    margin: 0 auto 40px;
    color: #5B5B5B;
    font-size: 18px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    max-width: 700px;
    margin: 0 auto 34px;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__stat {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 26px;
    min-height: 140px;
    padding: 26px 30px;
    border-radius: 16px;
    background: linear-gradient(280deg, rgba(214, 246, 248, 0.40) -22.94%, rgba(255, 255, 255, 0.40) 117.05%);
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__stat:nth-child(2) {
    border-radius: 16px;
    background: linear-gradient(283deg, rgba(255, 237, 218, 0.40) -8.83%, rgba(255, 255, 255, 0.40) 122.44%);
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__stat-icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    color: #ffffff;
    background: linear-gradient(135deg, #0DA3AC 0%, #25D0D7 100%);
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__stat:nth-child(2) .pcos-impact-gallery__stat-icon {
    background: linear-gradient(135deg, #FFB13D 0%, #FF8A1F 100%);

  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__stat-icon svg {
    display: block;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__stat-label {
    color: #626262;
    font-size: 18px;
    line-height: 1.2;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__stat-value {
    margin-top: 6px;
    color: {{ section.settings.accent_color }};
    font-size: 48px;
    line-height: 1;
    font-weight: 500;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__stat:nth-child(2) .pcos-impact-gallery__stat-value {
    color: #FF8A1F;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__table {
    max-width: 860px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__row--header {
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__rows-viewport {
    max-height: 340px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__rows {
    display: grid;
    gap: 10px;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__row {
    display: grid;
    grid-template-columns: 210px 1.25fr 1.45fr;
    align-items: center;
    gap: 16px;
    min-height: 60px;
    padding: 10px 28px;
    font-size: 20px;
    line-height: 1.2;
    border-radius: 8px;
    background: #F8FFFF;
    box-shadow: 5px 5px 7px 0 rgba(98, 179, 184, 0.10);
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__row span {
    min-width: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__row--header span {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__row:not(.pcos-impact-gallery__row--header) span:nth-child(2) {
    box-sizing: border-box;
    padding-left: 0;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__row:not(.pcos-impact-gallery__row--header) span:nth-child(3) {
    box-sizing: border-box;
    padding-left: 6%;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__email {
    font-size: 18px;
    letter-spacing: -0.2px;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__row--header {
    min-height: auto;
    padding-top: 0;
    padding-bottom: 0;
    background: transparent;
    box-shadow: none;
    color: rgba(17, 17, 17, 0.48);
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__row .pcos-impact-gallery__name {
    position: relative;
    display: block;
    width: 100%;
    padding: 0 16px 0 8%;
    overflow: hidden;
    color: #1A1A1A;
    font-size: 18px;
    letter-spacing: -0.2px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__name--highlight {
    color: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__name--dot::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00EF88;
    transform: translateY(-50%);
  }

  #shopify-section-{{ section.id }} .pcos-impact-gallery__row span:last-child {
    color: #767676;
    font-size: 20px;
  }

  @media (max-width: 999px) {
