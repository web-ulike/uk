{% javascript %}
  if (!customElements.get('bfcm-gift-cards-2026')) {
    customElements.define('bfcm-gift-cards-2026', class extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.bfcm-offers-2026__gift-track');
        this.previous = this.querySelector('[data-direction="-1"]');
        this.next = this.querySelector('[data-direction="1"]');
        if (!this.track || !this.previous || !this.next) return;

        this.controller = new AbortController();
        const { signal } = this.controller;
        this.previous.addEventListener('click', () => this.move(-1), { signal });
        this.next.addEventListener('click', () => this.move(1), { signal });
        this.track.addEventListener('scroll', () => this.updateControls(), { passive: true, signal });
        this.addEventListener('shopify:block:select', (event) => {
          if (!this.hasAttribute('data-overflow') || !this.track.contains(event.target)) return;
          event.target.scrollIntoView({ block: 'nearest', inline: 'start' });
        }, { signal });
        this.resizeObserver = new ResizeObserver(() => this.updateControls());
        this.resizeObserver.observe(this.track);
        this.updateControls();
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.resizeObserver?.disconnect();
      }

      move(direction) {
        const [firstCard, secondCard] = this.track.children;
        const distance = secondCard.offsetLeft - firstCard.offsetLeft;
        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
        this.track.scrollBy({ left: direction * distance, behavior });
      }

      updateControls() {
        const remaining = this.track.scrollWidth - this.track.clientWidth;
        this.toggleAttribute('data-overflow', remaining > 1);
        this.previous.disabled = this.track.scrollLeft <= 1;
        this.next.disabled = this.track.scrollLeft >= remaining - 1;
      }
    });
  }
{% endjavascript %}

