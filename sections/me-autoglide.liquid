
{% style %}
  .me-autoglide {
        position: relative;
        min-height: 875px;
        overflow: hidden;
        background: #fcfcfc;
        color: #3F3636;
      }


      .me-autoglide__picture {
        position: absolute;
        inset: 0;
        display: block;
      }

      .me-autoglide__picture img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: right center;
      }

      .me-autoglide__content {
        position: relative;
        z-index: 1;
        min-height: 875px;
        padding: 110px 0 150px;
      }

      .me-autoglide__wrapper {
        width: 100%;
        max-width: 550px;
      }

      .me-autoglide__eyebrow {
        display: flex;
        align-items: center;
        gap: 16px;
        color: #E0004D;
        font-size: 26px;
        font-weight: 400;
        line-height: 1.2;
      }

      .me-autoglide__eyebrow svg {
        display: block;
        flex-shrink: 0;
        width: 34px;
        height: 40px;
      }

      .me-autoglide__tle {
        margin: 20px 0 0;
        font-size: 48px;
        font-weight: 400;
        line-height: 1.25;
      }

      .me-autoglide__divider {
        width: 124px;
        height: 2px;
        margin: 24px 0 35px;
        background: #E0004D;
      }

      .me-autoglide__description {
        margin: 0;
        font-size: 18px;
        font-weight: 400;
        line-height: 1.5;
      }

      .me-autoglide__areas {
        margin-top: 64px;
      }

      .me-autoglide__areas img {
        display: block;
        width: 482px;
        max-width: 100%;
        height: auto;
      }

      .me-autoglide__footer {
        position: absolute;
        right: 0;
        bottom: 60px;
        left: 0;
        z-index: 1;
      }

      .me-autoglide__note {
        max-width: 600px;
        margin: 0;
        color: #919191;
        font-size: 12px;
        font-weight: 400;
        line-height: 1.4;
      }

      /* 文字依次上浮 */
      .me-autoglide__wrapper.appear .me-autoglide__eyebrow,
      .me-autoglide__wrapper.appear .me-autoglide__tle,
      .me-autoglide__wrapper.appear .me-autoglide__description {
        animation: me-autoglide-rise .9s cubic-bezier(.22, 1, .36, 1) both;
      }

      .me-autoglide__wrapper.appear .me-autoglide__tle {
        animation-delay: .1s;
      }

      .me-autoglide__wrapper.appear .me-autoglide__description {
        animation-delay: .25s;
      }

      /* 红线从左向右展开 */
      .me-autoglide__wrapper.appear .me-autoglide__divider {
        transform-origin: left center;
        animation: me-autoglide-line .8s cubic-bezier(.22, 1, .36, 1) .18s both;
      }

      /* 整排图标轻微放大、上浮 */
      .me-autoglide__wrapper.appear .me-autoglide__areas {
        animation: me-autoglide-areas 1s cubic-bezier(.22, 1, .36, 1) .35s both;
      }

      /* 闪电图标短暂亮起，只播放一次 */
      .me-autoglide__wrapper.appear .me-autoglide__eyebrow svg {
        animation: me-autoglide-flash 1.2s ease .6s both;
      }

      @keyframes me-autoglide-rise {
        from {
          opacity: 0;
          transform: translateY(22px);
        }

        to {
          opacity: 1;
          transform: none;
        }
      }

      @keyframes me-autoglide-line {
        from {
          opacity: 0;
          transform: scaleX(0);
        }

        to {
          opacity: 1;
          transform: scaleX(1);
        }
      }

      @keyframes me-autoglide-areas {
        from {
          opacity: 0;
          transform: translateY(18px) scale(.96);
        }

        to {
          opacity: 1;
          transform: none;
        }
      }

      @keyframes me-autoglide-flash {

        0%,
        100% {
          filter: drop-shadow(0 0 0 transparent);
        }

        45% {
          filter: drop-shadow(0 0 7px rgba(224, 0, 77, .55));
        }
      }

      @media (max-width: 767px) {
        @keyframes me-autoglide-rise {
          from {
            opacity: 0;
            transform: translateY(14px);
          }

          to {
            opacity: 1;
            transform: none;
          }
        }
      }
      @media (prefers-reduced-motion: reduce) {

        .me-autoglide__wrapper.appear .me-autoglide__eyebrow,
        .me-autoglide__wrapper.appear .me-autoglide__eyebrow svg,
        .me-autoglide__wrapper.appear .me-autoglide__tle,
        .me-autoglide__wrapper.appear .me-autoglide__divider,
        .me-autoglide__wrapper.appear .me-autoglide__description,
        .me-autoglide__wrapper.appear .me-autoglide__areas {
          animation: none;
        }
      }

      @media (min-width: 768px) and (max-width: 1450px) {
        .me-autoglide {
          min-height: 700px;
        }

        .me-autoglide__content {
          min-height: 700px;
          padding: 88px 0 120px;
        }

        .me-autoglide__wrapper {
          max-width: 440px;
        }

        .me-autoglide__eyebrow {
          gap: 13px;
          font-size: 21px;
        }

        .me-autoglide__eyebrow svg {
          width: 27px;
          height: 32px;
        }

        .me-autoglide__tle {
          margin-top: 16px;
          font-size: 38px;
        }

        .me-autoglide__divider {
          width: 99px;
          margin: 19px 0 28px;
        }

        .me-autoglide__description {
          font-size: 14px;
        }

        .me-autoglide__areas {
          margin-top: 51px;
        }

        .me-autoglide__areas img {
          width: 386px;
        }

        .me-autoglide__footer {
          bottom: 48px;
        }

        .me-autoglide__note {
          max-width: 480px;
          font-size: 10px;
        }
      }

      @media (max-width: 767px) {
        .me-autoglide {
          min-height: 700px;
        }

        .me-autoglide__picture {
          top: auto;
          height: 100%;
        }

        .me-autoglide__picture img {
          object-position: right bottom;
        }

        .me-autoglide__content {
          min-height: 700px;
          padding: 40px 0 380px;
        }

        .me-autoglide__wrapper {
          max-width: 100%;
        }

        .me-autoglide__eyebrow {
          gap: 5px;
          font-size: 16px;
        }

        .me-autoglide__eyebrow svg {
          width: 15px;
          height: 22px;
        }

        .me-autoglide__tle {
          max-width: 340px;
          margin-top: 14px;
          font-size: 24px;
          line-height: 1.1;
        }

        .me-autoglide__divider {
          width: 61px;
          height: 2px;
          margin: 16px 0 14px;
        }

        .me-autoglide__description {
          max-width: 345px;
          font-size: 12px;
          line-height: 1.2;
        }

        .me-autoglide__areas {
          margin-top: 26px;
        }

        .me-autoglide__areas img {
          width: 100%;
          max-width: 482px;
        }

        .me-autoglide__footer {
          bottom: 30px;
        }

        .me-autoglide__note {
          max-width: 340px;
          font-size: 12px;
          line-height: 1.2;
        }
      }
{% endstyle %}

<section class="me-autoglide">
  <picture class="me-autoglide__picture">
    {% if section.settings.image_1_mobile != blank or section.settings.image_1_pc != blank -%}
      {%- if section.settings.image_1_pc != blank %}
        <source media="(min-width: 768px)" srcset="{{ section.settings.image_1_pc | image_url: width: 3000 }}">
      {% endif -%}
      <img
        src="{{ section.settings.image_1_mobile | default: section.settings.image_1_pc | image_url: width: 1800 }}"
        width="2048"
        height="933"
        loading="lazy"
        alt="{{ section.settings.image_1_mobile.alt | default: section.settings.image_1_pc.alt | escape }}"
      >
    {%- endif %}
  </picture>

  <div class="me-autoglide__content">
    <div class="container">
      <div class="me-autoglide__wrapper js-me-top">
        <div class="me-autoglide__eyebrow">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 34 40" fill="none" aria-hidden="true">
            <path d="M17 1H31L20 14H29L7 39L13 21H5L17 1Z" stroke="currentColor" stroke-width="1.5"
              stroke-linejoin="round" />
            <path d="M20 5H25L15 17H21" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
          <span>{{ section.settings.text_1 | escape }}</span>
        </div>

        <h2 class="me-autoglide__tle">
          {{ section.settings.text_2 | escape }}
        </h2>

        <div class="me-autoglide__divider" aria-hidden="true"></div>

        <p class="me-autoglide__description">
          {{ section.settings.text_3 | escape }}
        </p>

        <div class="me-autoglide__areas">
          {% if section.settings.image_2 != blank -%}
            <img
              src="{{ section.settings.image_2 | image_url: width: 1800 }}"
              width="482"
              height="124"
              loading="lazy"
              alt="{{ section.settings.image_2.alt | escape }}"
            >
          {%- endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="me-autoglide__footer">
    <div class="container">
      <p class="me-autoglide__note">
        {{ section.settings.text_4 | escape }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Autoglide",
  "settings": [
    {
      "type": "text",
      "id": "text_1",
      "label": "Text 1",
      "default": "AutoGlide Mode"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text 2",
      "default": "Fast, Easy Full-Body Hair Removal"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text 3",
      "default": "Keep the device gliding over your skin. AutoGlide delivers a flash\n              every 0.5 seconds — no repeated button presses required."
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Text 4",
      "default": "*Estimated treatment times based on the recommended usage method.\n            Actual time may vary."
    },
    {
      "type": "image_picker",
      "id": "image_1_pc",
      "label": "Image 1 PC"
    },
    {
      "type": "image_picker",
      "id": "image_1_mobile",
      "label": "Image 1 Mobile"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    }
  ],
  "presets": [
    {
      "name": "Autoglide"
    }
  ]
}
{% endschema %}
