<style>
  #shopify-section-{{ section.id }} .subscribe-prize-2026 {
    position: relative;
    overflow: hidden;
    margin: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__bg {
    display: block;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__bg img {
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026 > .container {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__card {
    position: relative;
    z-index: 1;
    overflow: hidden;
    margin: 0 auto;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(72px, 10vw, 200px);
    padding: 0 32px;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__content {
    flex: 0 1 500px;
    max-width: 500px;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__title {
    margin: 0;
    color: #190A0A;
    font-family: var(--heading-font-family);
    font-size: 48px;
    font-weight: 500;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__subtitle {
    margin-top: 15px;
    color: #190A0A;
    font-size: 20px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__form {
    margin-top: 30px;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__message {
    display: none;
    margin-top: 10px;
    color: {{ section.settings.message_text_color }};
    font-size: 12px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__input {
    width: 100%;
    height: 55px;
    padding: 16px 30px;
    border: 1px solid {{ section.settings.input_border_color }};
    border-radius: 0;
    background: {{ section.settings.input_background }};
    color: {{ section.settings.input_text_color }};
    font-size: 16px;
    outline: 0;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__input::placeholder {
    color: {{ section.settings.input_placeholder_color }};
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 47px;
    min-width: 150px;
    margin-top: 10px;
    padding: 0 20px;
    overflow: hidden;
    border: 0;
    border-radius: {% if section.settings.button_rounded %}999px{% else %}0{% endif %};
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    cursor: pointer;
    font-family: var(--heading-font-family);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__button span {
    position: relative;
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__policy {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    color: {{ section.settings.policy_text_color }};
    font-size: 14px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__policy p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__policy a {
    color: inherit;
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__checkbox {
    position: relative;
    flex: 0 0 11px;
    width: 11px;
    height: 11px;
    margin-top: 0;
    border: 1px solid currentColor;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__checkbox input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__checkbox span {
    position: absolute;
    display: none;
    top: 50%;
    left: 50%;
    width: 3px;
    height: 6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translate(-50%, -58%) rotate(45deg);
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__checkbox input:checked + span {
    display: block;
  }

  #shopify-section-{{ section.id }} .sp26-wheel {
    --sp26-wheel-outer: clamp(420px, 34vw, 664px);
    --sp26-wheel-inner: calc(var(--sp26-wheel-outer) * 0.876506);
    --sp26-wheel-inner-pad: calc((var(--sp26-wheel-outer) - var(--sp26-wheel-inner)) / 2);
    position: relative;
    flex: 0 0 min(45%, var(--sp26-wheel-outer));
    width: min(45%, var(--sp26-wheel-outer));
    max-width: var(--sp26-wheel-outer);
    aspect-ratio: 1;
  }

  #shopify-section-{{ section.id }} .sp26-wheel img {
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .sp26-wheel__layer,
  #shopify-section-{{ section.id }} .sp26-wheel__outer,
  #shopify-section-{{ section.id }} .sp26-wheel__inner,
  #shopify-section-{{ section.id }} .sp26-wheel__flash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .sp26-wheel__outer {
    z-index: 4;
    filter: drop-shadow(0 4px 15px rgba(0, 0, 0, 0.25));
  }

  #shopify-section-{{ section.id }} .sp26-wheel__inner {
    padding: calc(var(--sp26-wheel-inner-pad) / var(--sp26-wheel-outer) * 100%);
    z-index: 0;
    animation: subscribe-prize-2026-rotate-{{ section.id | replace: '-', '_' }} 25s linear infinite;
  }

  #shopify-section-{{ section.id }} .sp26-wheel__flash {
    z-index: 4;
    filter: drop-shadow(0 0 5px rgba(255, 255, 255, 1));
    animation: twinkle 2s infinite ease-in-out;
  }

  #shopify-section-{{ section.id }} .sp26-wheel__flash--delay {
    animation-delay: 1s;
  }

  @keyframes subscribe-prize-2026-rotate-{{ section.id | replace: '-', '_' }} {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  #shopify-section-{{ section.id }} .subscribe-prize-2026__message {
    margin-top: 12px;
    font-size: 12px;
  }

  @media (min-width: 992px) and (max-width: 1440px) {
    #shopify-section-{{ section.id }} .subscribe-prize-2026__inner {
      gap: 120px;
    }
  }

  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} .subscribe-prize-2026 {
      margin: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .subscribe-prize-2026__inner {
      flex-direction: column-reverse;
      gap: 24px;
      min-height: auto;
      padding: 30px 15px;
    }

    #shopify-section-{{ section.id }} .subscribe-prize-2026__card {
      min-height: auto;
    }

    #shopify-section-{{ section.id }} .subscribe-prize-2026__content {
      flex: inherit;
      width: 100%;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .subscribe-prize-2026__title {
      font-size: 24px;
      line-height: 1.18;
    }

    #shopify-section-{{ section.id }} .subscribe-prize-2026__subtitle {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .subscribe-prize-2026__form {
      width: 100%;
      max-width: 360px;
      margin-right: auto;
      margin-left: auto;
    }

    #shopify-section-{{ section.id }} .subscribe-prize-2026__input {
      height: 42px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .subscribe-prize-2026__button {
      height: 42px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .subscribe-prize-2026__policy {
      justify-content: center;
      text-align: left;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .sp26-wheel {
      flex: 0 0 100%;
      width: min(100%, var(--sp26-wheel-outer));
      max-width: 100%;
    }
  }
</style>

<section class="subscribe-prize-2026" id="subscribe-prize-2026-{{ section.id }}">
  {%- liquid
    assign desktop_bg = section.settings.image_b
    assign mobile_bg = section.settings.image_b_mobile
    assign fallback_bg = desktop_bg | default: mobile_bg
  -%}

  {%- if fallback_bg != blank -%}
    <picture class="subscribe-prize-2026__bg">
      {%- if mobile_bg != blank -%}
        <source srcset="{{ mobile_bg | image_url: width: 900 }}" media="(max-width: 991px)">
      {%- endif -%}
      {{
        fallback_bg
        | image_url: width: 2200
        | image_tag:
          width: fallback_bg.width,
          height: fallback_bg.height,
          alt: fallback_bg.alt,
          loading: 'lazy'
      }}
    </picture>
  {%- endif -%}

  <div class="container">
    <div class="subscribe-prize-2026__card">
    <div class="subscribe-prize-2026__inner">
      <div class="subscribe-prize-2026__content">
        {%- if section.settings.title != blank -%}
          <h2 class="subscribe-prize-2026__title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <div class="subscribe-prize-2026__subtitle">{{ section.settings.subtitle }}</div>
        {%- endif -%}

        <div class="subscribe-prize-2026__form">
          <form class="form newsletter-modal__form" data-subscribe-prize-2026-form novalidate>
            <input
              type="email"
              id="newsletter-{{ section.id }}-email"
              name="email"
              placeholder="{{ section.settings.placeholder | escape }}"
              class="subscribe-prize-2026__input"
              autocomplete="email"
              aria-required="true"
            >

            {%- if section.settings.policy_text != blank -%}
              <div class="subscribe-prize-2026__policy">
                <label class="subscribe-prize-2026__checkbox" aria-label="Subscribe consent">
                  <input type="checkbox" aria-required="true" data-subscribe-prize-2026-policy>
                  <span></span>
                </label>
                <div>{{ section.settings.policy_text }}</div>
              </div>
            {%- endif -%}

            <button type="submit" class="subscribe-prize-2026__button">
              <span>{{ section.settings.button_text }}</span>
            </button>

            <div class="subscribe-prize-2026__message" data-subscribe-prize-2026-message></div>
          </form>
        </div>
      </div>

      <div class="sp26-wheel">
        {%- if section.settings.image != blank -%}
          <img
            class="sp26-wheel__outer"
            src="{{ section.settings.image | image_url }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
          >
        {%- endif -%}

        {%- if section.settings.image1 != blank -%}
          <img
            class="sp26-wheel__inner"
            src="{{ section.settings.image1 | image_url }}"
            width="{{ section.settings.image1.width }}"
            height="{{ section.settings.image1.height }}"
            alt="{{ section.settings.image1.alt | escape }}"
            loading="lazy"
          >
        {%- endif -%}

        {%- if section.settings.image2 != blank -%}
          <img
            class="sp26-wheel__layer"
            src="{{ section.settings.image2 | image_url }}"
            width="{{ section.settings.image2.width }}"
            height="{{ section.settings.image2.height }}"
            alt="{{ section.settings.image2.alt | escape }}"
            loading="lazy"
          >
        {%- endif -%}

        {%- if section.settings.image3 != blank -%}
          <img
            class="sp26-wheel__flash"
            src="{{ section.settings.image3 | image_url }}"
            width="{{ section.settings.image3.width }}"
            height="{{ section.settings.image3.height }}"
            alt="{{ section.settings.image3.alt | escape }}"
            loading="lazy"
          >
        {%- endif -%}

        {%- if section.settings.image4 != blank -%}
          <img
            class="sp26-wheel__flash sp26-wheel__flash--delay"
            src="{{ section.settings.image4 | image_url }}"
            width="{{ section.settings.image4.width }}"
            height="{{ section.settings.image4.height }}"
            alt="{{ section.settings.image4.alt | escape }}"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('subscribe-prize-2026-{{ section.id }}');
    if (!section) return;

    var form = section.querySelector('[data-subscribe-prize-2026-form]');
    var message = section.querySelector('[data-subscribe-prize-2026-message]');
    var emailInput = section.querySelector('input[name="email"]');
    var policyInput = section.querySelector('[data-subscribe-prize-2026-policy]');
    var submitButton = section.querySelector('.subscribe-prize-2026__button');
    var MSG = window.ULIKE_MESSAGES || {};
    if (!form || !emailInput || !submitButton) return;

    var showMessage = function (text) {
      if (!message) return;
      message.textContent = text || '';
      message.style.display = text ? 'block' : 'none';
      if (text) {
        window.clearTimeout(message._subscribePrizeTimer);
        message._subscribePrizeTimer = window.setTimeout(function () {
          message.style.display = 'none';
        }, 6000);
      }
    };

    var isValidEmail = function (email) {
      if (typeof validateEmail === 'function') {
        return validateEmail(email);
      }
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    };

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      var email = emailInput.value.trim();
      if (!email) {
        emailInput.focus();
        showMessage(MSG.email_empty || {{ section.settings.email_empty_message | json }});
        return;
      }

      if (!email || !isValidEmail(email)) {
        emailInput.focus();
        showMessage(MSG.email_invalid || {{ section.settings.invalid_message | json }});
        return;
      }

      if (policyInput && !policyInput.checked) {
        policyInput.focus();
        showMessage(MSG.policy_required || {{ section.settings.policy_message | json }});
        return;
      }

      if (typeof window.subscriptionApiNew !== 'function') {
        showMessage(MSG.default_error || {{ section.settings.error_message | json }});
        return;
      }

      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');
      showMessage('');

      window.subscriptionApiNew(email, 'spring_festival', 'USER_SUBSCRIBE').then(function (res) {
        if (res && res.code == 0) {
          emailInput.value = '';
          showMessage({{ section.settings.success_message | json }});
          if (typeof commonGtmEvent === 'function') {
            commonGtmEvent({{ section.settings.gtm_event_name | json }}, '', {{ section.settings.gtm_event_label | json }});
          }
        } else {
          var key = res && res.message ? res.message : '';
          var errorText = key && MSG[key] ? MSG[key] : MSG.default_error || {{ section.settings.error_message | json }};
          showMessage(errorText);
        }
      }).catch(function () {
        showMessage(MSG.default_error || {{ section.settings.error_message | json }});
      }).finally(function () {
        submitButton.disabled = false;
        submitButton.setAttribute('aria-busy', 'false');
      });
    });
  })();
</script>

