                                    fill="#040000" />
                                </svg>
                                </a>
                                <a href="https://pinterest.com/pin/create/button/?url={{ share_url }}{% if pinterest_image != blank %}&media={{ pinterest_image }}{% endif %}&description={{ pinterest_description }}" class="ulike-blog-share-item">
                                <svg xmlns="http://www.w3.org/2000/svg" width="12" height="17" viewBox="0 0 12 17" fill="none">
                                    <path fill-rule="evenodd" clip-rule="evenodd"
