                                    fill="#040000" />
                                </svg>
                                </a>
                                <a href="https://twitter.com/share?{% if twitter_text != blank %}text={{twitter_text}}&{% endif %}url={{ share_url }}" class="ulike-blog-share-item">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none">
                                    <path fill-rule="evenodd" clip-rule="evenodd"
                                    d="M12.8452 2.66401C14.0999 2.64366 14.7678 3.06232 15.4056 3.59448C15.947 3.55219 16.6507 3.27531 17.0652 3.08235C17.1995 3.01496 17.3339 2.94789 17.4682 2.88049C17.2314 3.46605 16.9105 3.92477 16.4172 4.27254C16.3076 4.34979 16.1989 4.45437 16.0615 4.50365C16.0615 4.50587 16.0615 4.50841 16.0615 4.51064C16.7645 4.50397 17.3443 4.21373 17.8949 4.05606C17.8949 4.05859 17.8949 4.06113 17.8949 4.06368C17.6057 4.48457 17.2142 4.9115 16.7965 5.21763C16.6279 5.34033 16.4593 5.46304 16.2907 5.58574C16.2999 6.26699 16.2797 6.91707 16.1406 7.48992C15.3316 10.8188 13.188 13.0791 9.79475 14.047C8.57635 14.3948 6.60727 14.5375 5.21127 14.2203C4.51897 14.0629 3.89359 13.8852 3.30669 13.6503C2.98077 13.5196 2.67879 13.3785 2.38997 13.2176C2.29521 13.1646 2.20035 13.1118 2.10547 13.0587C2.42043 13.0676 2.78871 13.1468 3.14077 13.0949C3.45921 13.0479 3.77153 13.06 4.06539 13.0012C4.79819 12.854 5.44885 12.6594 6.00941 12.359C6.28115 12.2134 6.69349 12.0424 6.88659 11.8326C6.52273 11.8383 6.19281 11.7611 5.92255 11.674C4.87461 11.3351 4.26461 10.7124 3.86777 9.77683C4.18535 9.8083 5.10007 9.88397 5.31393 9.71897C4.91423 9.69894 4.52981 9.48691 4.25503 9.32923C3.41209 8.84637 2.72463 8.03637 2.72979 6.79024C2.84047 6.83824 2.95115 6.88656 3.06173 6.93456C3.27349 7.01625 3.48873 7.05981 3.74137 7.10781C3.84805 7.12784 4.06139 7.18537 4.18387 7.14373C4.17861 7.14373 4.17333 7.14373 4.16807 7.14373C4.00501 6.96985 3.73927 6.85414 3.57537 6.66753C3.03463 6.05209 2.52783 5.1051 2.84837 3.97689C2.92965 3.6908 3.05867 3.43808 3.19611 3.20505C3.20139 3.2076 3.20665 3.20982 3.21193 3.21237C3.27485 3.33285 3.41525 3.42155 3.50433 3.52232C3.78049 3.83576 4.12115 4.11773 4.46837 4.36632C5.65133 5.2135 6.71667 5.73389 8.42763 6.11949C8.86159 6.21709 9.36333 6.29179 9.88171 6.29241C9.73603 5.90427 9.78283 5.27613 9.89751 4.90038C10.1858 3.9556 10.8121 3.27405 11.7309 2.9091C11.9506 2.822 12.1943 2.75841 12.45 2.70725C12.5817 2.69294 12.7135 2.67864 12.8452 2.66401Z"
                                    fill="#040000" />
                                </svg>
                                </a>
                                <a href="mailto:?&subject={{ article.title | escape }}&body={{ share_url }}" class="ulike-blog-share-item">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="19" viewBox="0 0 18 19" fill="none">
                                    <path d="M17 1.53003L11.4 17.53L8.2 10.33M17 1.53003L1 7.13003L8.2 10.33M17 1.53003L8.2 10.33"
