                                </svg>
                                </a>
                            </div>
                        </div>
                    {%- endif -%}
                </div>
                    {%- if block.settings.image1 != blank -%}
                        <div class="ulike-blog-head-adv">
                            <div class="ulike-blog-head-adv-close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="19" height="18" viewBox="0 0 19 18" fill="none">
                                <path d="M13.9531 4.5L4.95312 13.5" stroke="#756B6E" stroke-width="0.969231" stroke-linecap="round"
                                stroke-linejoin="round" />
                                <path d="M4.95312 4.5L13.9531 13.5" stroke="#756B6E" stroke-width="0.969231" stroke-linecap="round"
                                stroke-linejoin="round" />
                            </svg>
                            </div>
                            {%- if block.settings.image1 != blank -%}
                                <div class="ulike-blog-head-adv-img ">
                                    <img
                                    loading="lazy"
                                    class="img"
                                    width=""
                                    height=""
                                    {% render 'image-attributes', image: block.settings.image1, sizes: '300' %}
                                    alt="{{ block.settings.image1.alt | escape }}"
                                >
                                </div>
                            {%- endif -%}
                            <div class="ulike-blog-head-adv-info">
                                {%- if block.settings.text5 != blank -%}
                                    <h3 class="ulike-blog-adv-h3">
                                        {{ block.settings.text5 }}
                                    </h3>
                                {%- endif -%}
                                {%- if block.settings.text6 != blank -%}
                                    <a href="{{ block.settings.link1 }}" class="ulike-blog-adv-link">
                                        {{ block.settings.text6 }}
                                    </a>
                                {%- endif -%}
                            </div>
                        </div>
                    {%- endif -%}
                </div>
            </div>
            </div>
        </div>
    {%- endif -%}
{%- endfor -%}
<script>
  const closeBtn = document.querySelector('.ulike-blog-head-adv-close');
  closeBtn.addEventListener('click', function () {
    const advBox = this.closest('.ulike-blog-head-adv');
    if (advBox) advBox.remove();
  });
</script>
{% schema %}
{
  "name": "ulike-blog-head-new",
  "blocks": [
    {
      "name": "item",
      "type": "item",
      "settings": [
        {
          "type": "text",
          "id": "handle_txt",
          "label": "handle"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
        "type": "checkbox",
        "id": "show_cat",
        "label": "显示分类",
        "default": true
        },
        {
            "type": "text",
            "id": "text7",
            "label": "Text"
        },
        {
            "type": "text",
            "id": "text",
            "label": "Text"
        },
        {
            "type": "text",
            "id": "text1",
            "label": "Text"
        },
        {
            "type": "text",
            "id": "text2",
            "label": "Text"
        },
        {
            "type": "text",
            "id": "text3",
            "label": "Text"
        },
        {
            "type": "url",
            "id": "link",
            "label": "链接"
        },
        {
        "type": "checkbox",
        "id": "show_share",
        "label": "显示分享",
        "default": false
        },
        {
            "type": "text",
            "id": "text4",
            "label": "Text",
            "default":"Share:"
        },
        {
            "type": "header",
            "content": "广告"
        },
        {
            "type": "image_picker",
            "id": "image1",
            "label": "Image"
        },
        {
            "type": "richtext",
            "id": "text5",
            "label": "Text"
        },
        {
            "type": "text",
            "id": "text6",
            "label": "Text",
            "default":"Learn More"
        },
        {
            "type": "url",
            "id": "link1",
            "label": "链接"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "ulike-blog-head-new",
      "blocks": []
    }
  ]
}
{% endschema %}