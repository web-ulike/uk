<style>
.ulike-blog-head .ulike-blog-head-cont {
  display: flex;
}

.ulike-blog-head .ulike-blog-head-img {
  width: 536px;
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  overflow: hidden;
}

.ulike-blog-head .ulike-blog-head-img::before {
  width: 100%;
  padding-top: 75%;
  content: '';
  display: block;
  position: relative;
  z-index: 1;
}

.ulike-blog-head .ulike-blog-head-img .img {
  position: absolute;
  z-index: 2;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  object-fit: cover;
}

.ulike-blog-head .ulike-blog-head-info {
  padding: 30px 32px;
  flex: 1;
  background: #f6f6f6;
  position: relative;
  z-index: 1;
}

.ulike-blog-head .ulike-blog-head-tag {
  display: inline-block;
  padding: 4px;
  background: #fce8ec;
  color: #e0004d;
  font-size: 12px;
  line-height: 1.3;
  margin-bottom: 8px;
}

.ulike-blog-head .ulike-blog-head-h1 {
  color: #190a0a;
  font-size: 60px;
  line-height: 1.2;
  font-family: var(--heading-font-family);
  font-weight: normal;
  margin: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8px;
}

.ulike-blog-head .ulike-blog-head-sub {
  color: #190a0a;
  font-size: 24px;
  line-height: 1.33;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 16px;
}

.ulike-blog-head .ulike-blog-head-time {
  color: #756b6e;
  font-size: 14px;
  line-height: 1.57;
  margin-bottom: 8px;
}

.ulike-blog-head .ulike-blog-head-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ulike-blog-head .ulike-blog-head-link {
  display: flex;
  align-items: center;
  width: fit-content;
  height: 48px;
  border-radius: 4px;
  background: #190a0a;
  color: #fbfaf4;
  font-size: 14px;
  line-height: 1.57;
  font-family: var(--heading-font-family);
  padding: 0 80px;
}

.ulike-blog-head .ulike-blog-head-share {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #190a0a;
  font-size: 14px;
  line-height: 1.57;
  font-family: var(--heading-font-family);
}

.ulike-blog-head .ulike-blog-head-icon {
  display: flex;
  border: 1px solid #d9d9d9;
}

.ulike-blog-head .ulike-blog-share-item {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1px solid #d9d9d9;
}

.ulike-blog-head .ulike-blog-share-item:last-child {
  border-right: none;
}

.ulike-blog-head .ulike-blog-share-item svg {
  display: block;
  margin: 0;
}

.ulike-blog-head-adv {
  position: absolute;
  right: 32px;
  bottom: -20px;
  z-index: 2;
  width: 345px;
  padding: 4px;
  border-radius: 4px;
  background: #fff;
  display: flex;
  gap: 20px;
}

.ulike-blog-head-adv .ulike-blog-head-adv-close {
  position: absolute;
  width: 18px;
  height: 18px;
  top: 4px;
  right: 4px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ulike-blog-head-adv .ulike-blog-head-adv-close svg {
  display: block;
  margin: 0;
  width: 18px;
  height: auto;
}

.ulike-blog-head-adv .ulike-blog-head-adv-img {
  width: 175px;
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  border-radius: 4px;
  overflow: hidden;
}

.ulike-blog-head-adv .ulike-blog-head-adv-img::before {
  width: 100%;
  padding-top: 65%;
  content: '';
  display: block;
  position: relative;
  z-index: 1;
}

.ulike-blog-head-adv .ulike-blog-head-adv-img .img {
  position: absolute;
  z-index: 2;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  object-fit: cover;
}

.ulike-blog-head-adv .ulike-blog-head-adv-info {
  padding: 15px 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10px;
}

.ulike-blog-head-adv .ulike-blog-adv-h3 {
  color: #190a0a;
  font-size: 14px;
  line-height: 1.78;
  font-weight: 500;
  margin: 0;
}

.ulike-blog-head-adv .ulike-blog-adv-h3 p{
    margin:0
}

.ulike-blog-head-adv .ulike-blog-adv-link {
  color: #e0004d;
  font-size: 14px;
  line-height: 1.5;
  background: linear-gradient(0deg, #e0004d 0%, #e0004d 100%) no-repeat;
  background-size: 100% 1px;
  background-position: left bottom;
  width: fit-content;
}

@media (max-width: 1300px) {
  .ulike-blog-head-adv {
    width: 260px;
    gap: 15px;
  }

  .ulike-blog-head-adv .ulike-blog-head-adv-img {
    width: 120px;
  }

  .ulike-blog-head-adv .ulike-blog-head-adv-info {
    padding: 5px 0;
    gap: 5px;
  }

  .ulike-blog-head-adv .ulike-blog-adv-h3 {
    font-size: 12px;
  }

  .ulike-blog-head-adv .ulike-blog-adv-link {
    font-size: 12px;
  }
}

@media (max-width: 1200px) {
  .ulike-blog-head .ulike-blog-head-img {
    width: 460px;
  }
  .ulike-blog-head .ulike-blog-head-h1 {
    font-size: 40px;
  }
  .ulike-blog-head .ulike-blog-head-sub {
    font-size: 18px;
  }
  .ulike-blog-head .ulike-blog-head-link {
    padding: 0 24px;
  }
}

@media (max-width: 991px) {
  .ulike-blog-head .ulike-blog-head-cont {
    flex-direction: column;
  }

  .ulike-blog-head .ulike-blog-head-img {
    width: 100%;
  }

  .ulike-blog-head .ulike-blog-head-info {
    padding: 16px 8px;
    text-align: center;
  }

  .ulike-blog-head .ulike-blog-head-h1 {
    font-size: 36px;
  }

  .ulike-blog-head .ulike-blog-head-sub {
    font-size: 12px;
  }

  .ulike-blog-head .ulike-blog-head-time {
    font-size: 12px;
  }

  .ulike-blog-head .ulike-blog-head-bottom {
    flex-direction: column;
    gap: 16px;
  }

  .ulike-blog-head .ulike-blog-head-link {
    padding: 0 80px;
  }

  .ulike-blog-head-adv {
    position: relative;
    margin: 0 auto;
    right: auto;
    margin-bottom: 16px;
    text-align: left;
  }
}
</style>
{%- capture sizes -%}
  (max-width: 740px) 100vw,
  (max-width: 1200px) 100vw,
  50vw
{%- endcapture -%}
{% assign share_url = shop.url | append: request.path %}
{%- for block in section.blocks -%}
    {%- if block.settings.handle_txt != blank and blog.handle == block.settings.handle_txt -%}
        <div class="ulike-blog-head">
            <div class="container">
            <div class="ulike-blog-head-cont">
                <div class="ulike-blog-head-img">
                    {%- if block.settings.image != blank -%}
                        <img
                            loading="lazy"
                            class="img"
                            width=""
                            height=""
                            {% render 'image-attributes', image: block.settings.image %}
                            alt="{{ block.settings.image.alt | escape }}"
                        >
                    {%- endif -%}
                </div>
                <div class="ulike-blog-head-info">
                    {%- if block.settings.show_cat -%}
                        {%- if block.settings.text7 != blank-%}
                            <div class="ulike-blog-head-tag">
                                {{ block.settings.text7 }}
                            </div>
                        {%- endif -%}
                    {%- endif -%}

                    {%- if block.settings.text != blank -%}
                        <h1 class="ulike-blog-head-h1">{{ block.settings.text }}</h1>
                    {%- endif -%}
                    {%- if block.settings.text1 != blank -%}
                        <div class="ulike-blog-head-sub">
                            {{ block.settings.text1 }}
                        </div>
                    {%- endif -%}
                    {%- if block.settings.text2 != blank -%}
                        <div class="ulike-blog-head-time">{{ block.settings.text2 }}</div>
                    {%- endif -%}
                <div class="ulike-blog-head-bottom">
                    {%- if block.settings.text3 != blank -%}
                        <a href="{{ block.settings.link }}" class="ulike-blog-head-link">{{ block.settings.text3 }}</a>
                    {%- endif -%}
                    {%- if block.settings.show_share -%}
                        <div class="ulike-blog-head-share">
                            {{ block.settings.text4 }}
                            <div class="ulike-blog-head-icon">
                                <a href="https://www.facebook.com/sharer.php?u={{ share_url }}" class="ulike-blog-share-item">
