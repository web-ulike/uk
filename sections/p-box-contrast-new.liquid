                    <div class="cont-text">
                      {{ block.settings.text1 }}
                      {%- if block.settings.text2 != blank -%}
                        <div class="professional-quality-sm">{{ block.settings.text2 }}</div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
