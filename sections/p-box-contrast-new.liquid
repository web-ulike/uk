<style>
.professional-quality {
  padding: 90px 0;
  background: #F2F2F9;
}

  @media (min-width: 1600px) {
    .professional-quality .container {
      max-width: calc(100% - 40px);
    }
  }

.professional-quality .professional-quality-title {
  color: #000;
  text-align: center;
  font-size: 50px;
  line-height: 1.25;
}

.professional-quality .professional-quality-sub {
  color: #3f3636;
  text-align: center;
  font-size: 18px;
  line-height: 1.58;
  max-width:625px;
  margin:0 auto;
  margin-top: 15px;
  
}

.professional-quality .professional-quality-flex {
  display: flex;
  margin-top: 60px;
  gap: 20px;
}

.professional-quality .professional-quality-left {
  width: 34.5%;
  display: flex;
  align-items: flex-end;
  position: relative;
  z-index: 2;
}

.professional-quality .professional-quality-column {
  flex: 1;
  position: relative;
  z-index: 1;
}

.professional-quality .professional-quality-icon {
  width: 100%;
  position: relative;
}

.professional-quality .professional-quality-tag {
  width: 37%;
  max-width: 134px;
  position: absolute;
  top: 50%;
  transform: translate(calc(50% + 22px), -50%);
  right: 0;
  font-family: var(--heading-font-family);
}

.professional-quality .professional-quality-tag svg {
  display: block;
  width: 100%;
  height: auto;
}

.professional-quality .icon {
  display: block;
  width: 9vw;
  max-width: 177px;
  margin: 0 auto;
  border-radius: 50%;
  overflow: hidden;
}
.professional-quality h3.professional-quality-item{
  margin:0;
  font-weight: normal;
}
.professional-quality .professional-quality-item svg {
  display: block;
}

.professional-quality svg {
  width: 20%;
  height: auto;
}

.professional-quality .professional-quality-item {
  padding: 30px 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  text-align: center;
  position: relative;
}

.professional-quality .cont-text {
  position: relative;
}

.professional-quality .cont-text::first-letter {
  font-size: 22px;
  vertical-align: top;
  line-height: 2;
}

.professional-quality .professional-quality-pd {
  padding: 0 10px !important;
  margin-top: -18%;
}

.professional-quality .professional-quality-head {
  color: #6C6AB4;
  font-size: 26px;
  line-height: 1.1;
  font-family: var(--heading-font-family);
  border-radius: 20px 0px 0px 20px;
  background: #EDEBFC;
  width: 54.43%;
  flex: none;
}

.professional-quality .professional-quality-head .professional-quality-item {
  position: relative;
}

.professional-quality .professional-quality-head .professional-quality-item:first-child {
  display: none;
}

.professional-quality .professional-quality-head .professional-quality-item::before {
  content: '';
  display: block;
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 64.5%;
  transform: translateX(-50%);
  border-bottom: 1px solid #B8B7EA;
}

.professional-quality .professional-quality-head .professional-quality-item:last-child::before {
  display: none;
}

.professional-quality .professional-quality-fixed {
  color: #e0004d;
  font-size: 37px;
  line-height: 1.25;
  font-family: var(--heading-font-family);
  border-radius: 20px 20px 20px 0px;
  background: #FFE0E9;
  position: relative;
  z-index: 0;
}

.professional-quality .professional-quality-fixed .professional-quality-item:last-child {
  font-size: 73px;
  font-family: var(--heading-font-family);
  line-height: 1;
}

.professional-quality .professional-quality-right {
  overflow: hidden;
  flex: 1;
  border-radius: 0 0 20px 20px;
  position: relative;
  z-index: 1;
}

.professional-quality .professional-quality-ov {
  padding-top: 7%;
}

.professional-quality .professional-quality-cont {
  display: flex;
  height: 100%;
}

.professional-quality .professional-quality-other {
  color: #190a0a;
  font-size: 37px;
  line-height: 1.25;
  max-width: 25%;
  background: #FBFBFE;
  position: relative;
}

.professional-quality .professional-quality-other::before {
  content: '';
  display: block;
  width: 0;
  height: 85%;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  border-right: 1px solid #E4DDDD;
  position: absolute;
}

.professional-quality .professional-quality-other:last-child::before {
  display: none;
}

.professional-quality .professional-quality-other:first-child {
  border-radius: 20px 0 0 20px;
}

.professional-quality .professional-quality-other:last-child {
  border-radius: 0 20px 20px 0;
}

.professional-quality .professional-quality-other .professional-quality-item:last-child {
  font-size: 46px;
}

.professional-quality .txt::first-letter {
  font-size: 22px;
  vertical-align: top;
  line-height: 2;
}

.professional-quality .professional-quality-fixed .professional-quality-sm {
  height: 40px;
  display: flex;
  padding: 8px;
  justify-content: center;
  align-items: center;
  border-radius: 20px;
  background: #E0004D;
  color: #F2F2F9;
  font-size: 23px;
  line-height: 1;
  font-style: italic;
  position: absolute;
  right: 0;
  bottom: 100%;
}

.professional-quality .professional-quality-sm {
  font-size: 16px;
  line-height: 1;
}

.professional-quality .professional-quality-bottom {
  margin-top: 25px;
  color: rgba(63, 54, 54, 0.6);
  font-size: 12px;
  line-height: 1.5;
  padding-left: calc(34.5% + 10px);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
}

.professional-quality .professional-quality-arraw {
  display: none;
  gap: 20px;
}

@media (max-width:1700px) {
  .professional-quality .professional-quality-fixed {
    font-size: 27px;
  }

  .professional-quality .professional-quality-fixed .professional-quality-item:last-child {
    font-size: 53px;
  }

  .professional-quality .professional-quality-fixed .professional-quality-sm {
    zoom: .7;
  }

  .professional-quality .professional-quality-other {
    font-size: 27px;
  }

  .professional-quality .professional-quality-other .professional-quality-item:last-child {
    font-size: 36px;
  }

  .professional-quality .cont-text::first-letter {
    font-size: 20px;
    line-height: 1.7;
  }

  .professional-quality .txt::first-letter {
    font-size: 18px;
    line-height: 1.8;
  }
}

@media (max-width: 1300px) {
  .professional-quality .professional-quality-head {
    font-size: 16px;
  }

  .professional-quality .professional-quality-fixed {
    font-size: 22px;
  }

  .professional-quality .professional-quality-other {
    font-size: 22px;
  }

  .professional-quality .professional-quality-fixed .professional-quality-item:last-child {
    font-size: 32px;
  }

  .professional-quality .professional-quality-other .professional-quality-item:last-child {
    font-size: 26px;
  }

  .professional-quality .professional-quality-sm {
    font-size: 12px;
  }

  .professional-quality .professional-quality-fixed .professional-quality-sm {
    zoom: .5;
  }

  .professional-quality .cont-text::first-letter {
    font-size: 15px;
  }

  .professional-quality .txt::first-letter {
    font-size: 14px;
    line-height: 1.6;
  }
}

@media (max-width: 991px) {
  .professional-quality {
    padding: 50px 0;
  }

  .professional-quality .professional-quality-left {
    width: auto;
  }

  .professional-quality .professional-quality-head {
    font-size: 12px;
    width: 97px;
    flex: none;
    border-radius: 10px 0 0 10px;
  }

  .professional-quality .professional-quality-ov {
    padding-top: 30px;
  }

  .professional-quality .icon {
    width: 69px;
    min-width: auto;
  }

  .professional-quality .professional-quality-pd {
    margin-top: -30px;
  }

  .professional-quality .professional-quality-fixed {
    width: 120px;
    font-size: 14px;
    flex: none;
    border-radius: 10px 10px 10px 0;
  }

  .professional-quality .professional-quality-other {
    font-size: 14px;
  }

  .professional-quality .professional-quality-fixed .professional-quality-item:last-child {
    font-size: 27px;
  }

  .professional-quality .professional-quality-other .professional-quality-item:last-child {
    font-size: 17px;
  }

  .professional-quality .professional-quality-item {
    padding: 20px 5px;
  }

  .professional-quality .professional-quality-title {
    font-size: 28px;
  }

  .professional-quality .professional-quality-sub {
    font-size: 14px;
  }

  .professional-quality .professional-quality-flex {
    margin-top: 20px;
    gap: 10px;
  }

  .professional-quality .professional-quality-tag {
    width: 40px;
    transform: translate(calc(50% + 8px), -50%);
  }

  .professional-quality .professional-quality-tag svg {
    width: 100% !important;
  }

  .professional-quality .professional-quality-item svg {
    width: 25px;
  }

  .professional-quality .professional-quality-other {
    max-width: 100%;
    width: 120px;
    flex-shrink: 0;
    flex: none;
  }

  .professional-quality .professional-quality-right {
    overflow-x: auto;
    border-radius: 0 0 10px 10px;
  }

  .professional-quality .professional-quality-other:first-child {
    border-radius: 0 0 0 10px;
  }

  .professional-quality .professional-quality-other:last-child {
    border-radius: 0 0 10px 0;
  }

  .professional-quality .professional-quality-right::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  .professional-quality .professional-quality-right::-webkit-scrollbar-track {
    background: transparent;
    border-radius: 6px;
  }

  .professional-quality .professional-quality-right::-webkit-scrollbar-thumb {
    background-color: #aaa;
    border-radius: 6px;
  }

  .professional-quality .professional-quality-right::-webkit-scrollbar-thumb:hover {
    background-color: #555;
  }

  .professional-quality .professional-quality-column {
    padding: 0;
  }

  .professional-quality .professional-quality-bottom {
    padding-left: 0;
    margin-top: 20px;
  }

  .professional-quality .cont-text::first-letter {
    font-size: 12px;
  }

  .professional-quality .txt::first-letter {
    font-size: 12px;
    line-height: 1.4;
  }
}

@media (max-width: 460px) {
  .professional-quality .professional-quality-right {
    overflow-x: hidden;
  }

  .professional-quality .professional-quality-other {
    width: 100%;
  }

  .professional-quality .professional-quality-other::before {
    display: none;
  }

  .professional-quality .professional-quality-bottom {
    flex-direction: column-reverse;
    text-align: center;
  }

  .professional-quality .professional-quality-msg {
    max-width: 280px;
    margin: 0 auto;
  }

  .professional-quality .professional-quality-arraw {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .professional-quality .professional-quality-arraw-item {
    cursor: pointer;
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .professional-quality .professional-quality-arraw-item:hover {
    opacity: 1;
  }

  .professional-quality .professional-quality-arraw svg {
    display: block;
    width: auto;
  }
}
</style>

<section>
  <div class="professional-quality to-top">
    <div class="container">
      <div class="professional-quality-title">{{ section.settings.text }}</div>
      <div class="professional-quality-sub">{{ section.settings.text1 }}</div>
      <div class="professional-quality-flex">
        <div class="professional-quality-left">
          <div class="professional-quality-column professional-quality-head">
            <div class="professional-quality-item"></div>
            {%- if section.settings.text2 != blank -%}
              <h3 class="professional-quality-item">{{ section.settings.text2 }}</h3>
            {%- endif -%}
            {%- if section.settings.text3 != blank -%}
              <h3 class="professional-quality-item">{{ section.settings.text3 }}</h3>
            {%- endif -%}
            {%- if section.settings.text4 != blank -%}
              <h3 class="professional-quality-item">{{ section.settings.text4 }}</h3>
            {%- endif -%}
            {%- if section.settings.text5 != blank -%}
              <h3 class="professional-quality-item">{{ section.settings.text5 }}</h3>
            {%- endif -%}
            {%- if section.settings.text6 != blank -%}
              <h3 class="professional-quality-item">{{ section.settings.text6 }}</h3>
            {%- endif -%}
            {%- if section.settings.text7 != blank -%}
              <h3 class="professional-quality-item">{{ section.settings.text7 }}</h3>
            {%- endif -%}
          </div>
          {%- for block in section.blocks -%}
            {%- if forloop.index == 1 -%}
              <div class="professional-quality-column professional-quality-fixed">
                <div class="professional-quality-item professional-quality-pd">
                  <div class="professional-quality-icon">
                    {%- if block.settings.image != blank -%}
                        <img loading="lazy" class="icon" width="" height="" {% render 'image-attributes', image: block.settings.image %}>
                    {%- endif -%}
                    {%- if section.settings.image != blank -%}
                      <div class="professional-quality-tag">
                        <img loading="lazy" width="" height="" {% render 'image-attributes', image: section.settings.image %}>
                      </div>
                    {%- endif -%}
                  </div>
                  
                </div>
                {%- if section.settings.text2 != blank -%}
                  <div class="professional-quality-item">
                    {%- if block.settings.text != blank -%}
                      <div class="professional-quality-text">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if section.settings.text3 != blank -%}
                  <div class="professional-quality-item">
