
{% style %}
.me-schedule {
      position: relative;
      overflow: hidden;
      background: #e2d9d4;
      color: #3F3636;
    }

    .me-schedule,
    .me-schedule * {
      box-sizing: border-box;
    }

    .me-schedule__picture {
      position: absolute;
      inset: 0;
      display: block;
    }

    .me-schedule__picture img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .me-schedule__content {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 1560px;
      min-height: 847px;
      margin: 0 auto;
      padding: 120px 20px;
    }

    .me-schedule__wrapper {
      width: 100%;
      max-width: 448px;
    }

    .me-schedule__head {
      display: flex;
      flex-direction: column;
    }

    .me-schedule__tle {
      margin: 0;
      font-size: 48px;
      font-weight: 400;
      line-height: 1.25;
    }

    .me-schedule__description {
      margin: 24px 0 0;
      color: #190A0A;
      font-size: 24px;
      line-height: 1.2;
    }

    .me-schedule__divider {
      width: 124px;
      height: 2px;
      margin-top: 40px;
      background: #E0004D;
    }

    .me-schedule__cards {
      display: grid;
      gap: 16px;
      margin-top: 42px;
    }

    .me-schedule__card {
      min-width: 0;
      padding: 18px 22px;
      background: rgba(255, 250, 252, .96);
    }

    .me-schedule__card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }

    .me-schedule__label {
      display: inline-flex;
      flex-shrink: 0;
      align-items: center;
      gap: 8px;
      margin: 0;
      color: #E0004D;
      font-size: 18px;
      font-weight: 500;
      line-height: 1.2;
    }

    .me-schedule__calendar {
      display: block;
      flex-shrink: 0;
      width: 17px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.3;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .me-schedule__frequency {
      margin: 0;
      color: #190A0A;
      font-size: 16px;
      line-height: 1.2;
    }

    .me-schedule__timeline {
      position: relative;
      margin-top: 22px;
    }

    .me-schedule__track {
      position: absolute;
      top: 13px;
      right: calc(100% / 14);
      left: calc(100% / 14);
      height: 1px;
      background: #aaa;
      transform-origin: left center;
    }

    .me-schedule__days {
      position: relative;
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      padding: 0;
      margin: 0;
      list-style: none;
    }

    .me-schedule__day {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 0;
    }

    .me-schedule__dot {
      position: relative;
      display: grid;
      place-items: center;
      width: 27px;
      height: 27px;
    }

    .me-schedule__dot::before {
      content: "";
      width: 8px;
      height: 8px;
      border: 1px solid #999;
      border-radius: 50%;
      background: #fff;
    }

    .me-schedule__day--active .me-schedule__dot {
      border-radius: 50%;
      background: #FFDFE9;
    }

    .me-schedule__day--active .me-schedule__dot::before {
      width: 11px;
      height: 6px;
      margin-top: -3px;
      border: 0;
      border-bottom: 2px solid #E0004D;
      border-left: 2px solid #E0004D;
      border-radius: 0;
      background: transparent;
      transform: rotate(-45deg);
    }

    .me-schedule__day-label {
      margin-top: 6px;
      color: #898282;
      font-size: 12px;
      line-height: 1.2;
      white-space: nowrap;
    }

    .me-schedule__day-label em {
      margin-right: 5px;
      color: #3F3636;
      font-style: normal;
    }

    .me-schedule__note {
      max-width: 650px;
      margin: 38px 0 0;
      color: #919191;
      font-size: 12px;
      line-height: 1.4;
    }

    /* 入场动画：复用 js-me-top + appear */
    .me-schedule__content.appear .me-schedule__tle,
    .me-schedule__content.appear .me-schedule__description,
    .me-schedule__content.appear .me-schedule__card,
    .me-schedule__content.appear .me-schedule__note {
      animation: me-schedule-rise .9s cubic-bezier(.22, 1, .36, 1) var(--schedule-delay, 0s) both;
    }

    .me-schedule__description {
      --schedule-delay: .1s;
    }

    .me-schedule__card--1 {
      --schedule-delay: .22s;
    }

    .me-schedule__card--2 {
      --schedule-delay: .34s;
    }

    .me-schedule__note {
      --schedule-delay: .45s;
    }

    .me-schedule__content.appear .me-schedule__divider {
      transform-origin: left center;
      animation: me-schedule-line .85s cubic-bezier(.22, 1, .36, 1) .16s both;
    }

    .me-schedule__content.appear .me-schedule__track {
      animation: me-schedule-line 1s cubic-bezier(.22, 1, .36, 1) calc(var(--schedule-delay) + .2s) both;
    }

    .me-schedule__content.appear .me-schedule__day--active .me-schedule__dot {
      animation: me-schedule-check .65s cubic-bezier(.22, 1, .36, 1) calc(var(--schedule-delay) + var(--check-delay, .4s)) both;
    }

    @keyframes me-schedule-rise {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes me-schedule-line {
      from {
        opacity: 0;
        transform: scaleX(0);
      }

      to {
        opacity: 1;
        transform: scaleX(1);
      }
    }

    @keyframes me-schedule-check {
      from {
        opacity: 0;
        transform: scale(.6);
        box-shadow: 0 0 0 0 rgba(224, 0, 77, .2);
      }

      65% {
        opacity: 1;
        transform: scale(1);
        box-shadow: 0 0 0 7px rgba(224, 0, 77, 0);
      }

      to {
        opacity: 1;
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(224, 0, 77, 0);
      }
    }

    @media (min-width: 768px) and (max-width: 1450px) {
      .me-schedule__content {
        max-width: 1248px;
        min-height: 678px;
        padding: 96px 16px;
      }

      .me-schedule__wrapper {
        max-width: 358px;
      }

      .me-schedule__tle {
        font-size: 38px;
      }

      .me-schedule__description {
        margin-top: 19px;
        font-size: 19px;
      }

      .me-schedule__divider {
        width: 99px;
        margin-top: 32px;
      }

      .me-schedule__cards {
        gap: 13px;
        margin-top: 34px;
      }

      .me-schedule__card {
        padding: 14px 18px;
      }

      .me-schedule__card-head {
        gap: 11px;
      }

      .me-schedule__label {
        gap: 6px;
        font-size: 14px;
      }

      .me-schedule__calendar {
        width: 14px;
        height: 16px;
      }

      .me-schedule__frequency {
        font-size: 13px;
      }

      .me-schedule__timeline {
        margin-top: 18px;
      }

      .me-schedule__track {
        top: 11px;
      }

      .me-schedule__dot {
        width: 22px;
        height: 22px;
      }

      .me-schedule__dot::before {
        width: 6px;
        height: 6px;
      }

      .me-schedule__day-label {
        margin-top: 5px;
        font-size: 10px;
      }

      .me-schedule__note {
        max-width: 520px;
        margin-top: 30px;
        font-size: 10px;
      }
    }

    @media (max-width: 767px) {
      .me-schedule__picture img {
        object-position: center bottom;
      }

      .me-schedule__content {
        display: flex;
        flex-direction: column;
        min-height: max(714px, 190.4vw);
        padding: 40px 16px 32px;
      }

      .me-schedule__wrapper {
        max-width: none;
      }

      .me-schedule__tle {
        max-width: 345px;
        font-size: 24px;
        line-height: 1.1;
      }

      .me-schedule__divider {
        order: 1;
        width: 124px;
        margin-top: 20px;
      }

      .me-schedule__description {
        order: 2;
        margin-top: 18px;
        font-size: 12px;
        line-height: 1.25;
      }

      .me-schedule__cards {
        gap: 12px;
        margin-top: 26px;
      }

      .me-schedule__card {
        padding: 13px 16px 12px;
      }

      .me-schedule__card-head {
        gap: 12px;
      }

      .me-schedule__label {
        gap: 6px;
        font-size: 14px;
      }

      .me-schedule__calendar {
        width: 13px;
        height: 16px;
      }

      .me-schedule__frequency {
        font-size: 12px;
        line-height: 1.2;
      }

      .me-schedule__timeline {
        margin-top: 16px;
      }

      .me-schedule__track {
        top: 10px;
      }

      .me-schedule__dot {
        width: 21px;
        height: 21px;
      }

      .me-schedule__dot::before {
        width: 6px;
        height: 6px;
      }

      .me-schedule__day--active .me-schedule__dot::before {
        width: 9px;
        height: 5px;
        border-width: 1.5px;
      }

      .me-schedule__day-label {
        margin-top: 5px;
        font-size: 10px;
      }

      .me-schedule__day-label em {
        margin-right: 3px;
      }

      .me-schedule__note {
        max-width: 350px;
        margin: auto 8px 0;
        padding-top: 260px;
        font-size: 12px;
        line-height: 1.2;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .me-schedule .me-schedule__content.appear * {
        animation: none;
      }
    }
{% endstyle %}

<section class="me-schedule">
      <picture class="me-schedule__picture">
        
        {% if section.settings.image_1_mobile != blank or section.settings.image_1_pc != blank %}{% if section.settings.image_1_pc != blank %}<source media="(min-width: 768px)" srcset="{{ section.settings.image_1_pc | image_url: width: 3000 }}">{% endif %}<img src="{{ section.settings.image_1_mobile | default: section.settings.image_1_pc | image_url: width: 1800 }}" width="1920" height="847" loading="lazy" alt="{{ section.settings.image_1_mobile.alt | default: section.settings.image_1_pc.alt | escape }}">{% endif %}
      </picture>

      <div class="me-schedule__content js-me-top">
        <div class="me-schedule__wrapper">
          <div class="me-schedule__head">
            <h2 class="me-schedule__tle">
              {{ section.settings.text_1 | escape }}
            </h2>

            <p class="me-schedule__description">
              {{ section.settings.text_2 | escape }}
            </p>

            <div class="me-schedule__divider" aria-hidden="true"></div>
          </div>

          <div class="me-schedule__cards">
            <!-- 第一阶段 -->
            <div class="me-schedule__card me-schedule__card--1">
              <div class="me-schedule__card-head">
                <h3 class="me-schedule__label">
                  <svg class="me-schedule__calendar" viewBox="0 0 20 22" aria-hidden="true">
                    <rect x="2" y="5" width="16" height="15" rx="1" />
                    <path d="M6 2v6M14 2v6M2 11h16" />
                  </svg>
                  <span>{{ section.settings.text_3 | escape }}</span>
                </h3>

                <p class="me-schedule__frequency">
                  {{ section.settings.text_4 | escape }}
                </p>
              </div>

              <div class="me-schedule__timeline">
                <div class="me-schedule__track" aria-hidden="true"></div>

                <ol class="me-schedule__days" aria-label="Example weekly schedule">
                  <li class="me-schedule__day">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label"><em>{{ section.settings.text_5 | escape }}</em>{{ section.settings.text_6 | escape }}</span>
                  </li>
                  <li class="me-schedule__day me-schedule__day--active" style="--check-delay: .35s"
                    aria-label="Day 2, treatment">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_7 | escape }}</span>
                  </li>
                  <li class="me-schedule__day">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_8 | escape }}</span>
                  </li>
                  <li class="me-schedule__day me-schedule__day--active" style="--check-delay: .5s"
                    aria-label="Day 4, treatment">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_9 | escape }}</span>
                  </li>
                  <li class="me-schedule__day">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_10 | escape }}</span>
                  </li>
                  <li class="me-schedule__day me-schedule__day--active" style="--check-delay: .65s"
                    aria-label="Day 6, treatment">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_11 | escape }}</span>
                  </li>
                  <li class="me-schedule__day">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_12 | escape }}</span>
                  </li>
                </ol>
              </div>
            </div>

            <!-- 第二阶段 -->
            <div class="me-schedule__card me-schedule__card--2">
              <div class="me-schedule__card-head">
                <h3 class="me-schedule__label">
                  <svg class="me-schedule__calendar" viewBox="0 0 20 22" aria-hidden="true">
                    <rect x="2" y="5" width="16" height="15" rx="1" />
                    <path d="M6 2v6M14 2v6M2 11h16" />
                  </svg>
                  <span>{{ section.settings.text_13 | escape }}</span>
                </h3>

                <p class="me-schedule__frequency">
                  {{ section.settings.text_14 | escape }}
                </p>
              </div>

              <div class="me-schedule__timeline">
                <div class="me-schedule__track" aria-hidden="true"></div>

                <ol class="me-schedule__days" aria-label="Example maintenance schedule">
                  <li class="me-schedule__day">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label"><em>{{ section.settings.text_15 | escape }}</em>{{ section.settings.text_16 | escape }}</span>
                  </li>
                  <li class="me-schedule__day">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_17 | escape }}</span>
                  </li>
                  <li class="me-schedule__day me-schedule__day--active" style="--check-delay: .4s"
                    aria-label="Week 3, treatment">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_18 | escape }}</span>
                  </li>
                  <li class="me-schedule__day">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_19 | escape }}</span>
                  </li>
                  <li class="me-schedule__day me-schedule__day--active" style="--check-delay: .6s"
                    aria-label="Week 5, treatment">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_20 | escape }}</span>
                  </li>
                  <li class="me-schedule__day">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_21 | escape }}</span>
                  </li>
                  <li class="me-schedule__day">
                    <span class="me-schedule__dot" aria-hidden="true"></span>
                    <span class="me-schedule__day-label">{{ section.settings.text_22 | escape }}</span>
                  </li>
                </ol>
              </div>
            </div>
          </div>
        </div>

        <p class="me-schedule__note">
          {{ section.settings.text_23 | escape }}
        </p>
      </div>
    </section>

