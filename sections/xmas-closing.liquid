<section class="xmas xmas-closing"><div class="container">
  {% render 'xmas-heading', settings_group: section.settings %}
  {% render 'xmas-directions', settings_group: section.settings, delay: 0.3 %}
</div></section>

{% stylesheet %}
.xmas.xmas-closing {
  padding-block: var(--xmas-section-space);
  border-top: 1px solid #dfc59b;
  background: radial-gradient(ellipse at top, #fff9ee, #f0e1c9);
  color: #651625;
  text-align: center;
}

.xmas-closing .xmas-kicker {
  color: #78501f;
}

.xmas-closing .xmas-intro {
  color: #53433c;
}

.xmas-closing .xmas-directions {
  margin-top: 32px;
  background: #741a2c;
  color: #fff9ee;
}

.xmas-closing .xmas-directions:hover {
  background: #571020;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Christmas closing banner",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "MAKE IT A ULIKE CHRISTMAS"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Glow Your Way This Christmas."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "6 December · 10 AM–4 PM\nFuture Stores · 95 Oxford Street, London W1D 2AD"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Map link"
    }
  ],
  "presets": [
    {
      "name": "Christmas closing banner"
    }
  ]
}
{% endschema %}
