<section class="xmas xmas-closing"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}><div class="container">
  {% render 'xmas-heading', settings_group: section.settings %}
  {% render 'xmas-directions', settings_group: section.settings, delay: 0.3 %}
</div></section>

{% stylesheet %}
.xmas.xmas-closing {
  padding-block: var(--xmas-section-space);
  background: radial-gradient(ellipse at top, #a0202f, #670b18);
  color: #fff;
  text-align: center;
}

.xmas.xmas-closing .xmas-kicker {
  color: #efd09a;
}

.xmas.xmas-closing .xmas-intro {
  color: #f8d8d4;
}

.xmas-closing .xmas-directions {
  margin-top: 32px;
  background: #fff2df;
  color: #701521;
}

.xmas-closing .xmas-directions:hover {
  background: #efd09a;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Christmas closing banner",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Navigation anchor ID"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "MAKE IT A ULIKE CHRISTMAS"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Glow Your Way This Christmas."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "6 December · 10 AM–4 PM\nFuture Stores · 95 Oxford Street, London W1D 2AD"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Map link"
    }
  ],
  "presets": [
    {
      "name": "Christmas closing banner"
    }
  ]
}
{% endschema %}
