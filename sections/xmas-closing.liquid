<section class="xmas-closing"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  {% if section.settings.background_image != blank %}
    {{ section.settings.background_image
      | image_url: width: 2400
      | image_tag: class: 'xmas-closing__background', widths: '480, 750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: ''
    }}
  {% endif %}
  <div class="xmas-closing__content">
    {% if section.settings.kicker != blank %}
      <p class="xmas-closing__kicker to-top">{{ section.settings.kicker | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="xmas-closing__title to-top" style="transition-delay: 100ms">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="xmas-closing__details to-top" style="transition-delay: 200ms">{{ section.settings.description | escape | newline_to_br }}</p>
    {% endif %}
    {% if section.settings.map_url != blank and section.settings.button != blank %}
      <a class="xmas-closing__button to-top" style="transition-delay: 300ms" href="{{ section.settings.map_url | escape }}" target="_blank" rel="noopener">
        {{ section.settings.button | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% javascript %}
  document.addEventListener('shopify:section:load', (event) => {
    if (event.target.querySelector('.xmas-closing') && typeof window.initialCheck === 'function') {
      window.initialCheck();
    }
  });
{% endjavascript %}

{% stylesheet %}
  .xmas-closing {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 446px;
    padding: 60px 16px;
    background: radial-gradient(ellipse 93% 95% at 50% 4.87%, #a00920, #6a000f);
    font-family: Saans, sans-serif;
    text-align: center;
    scroll-margin-top: calc(
      var(--header-height, 0px) * var(--enable-sticky-header, 0) +
      var(--announcement-bar-height, 0px) * var(--enable-sticky-announcement-bar, 0)
    );
  }

  .xmas-closing__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .xmas-closing__content {
    position: relative;
    display: grid;
    width: min(100%, 750px);
    justify-items: center;
    gap: 14px;
    overflow-wrap: anywhere;
  }

  .xmas-closing__content > * { margin: 0; }
  .xmas-closing__kicker {
    color: #f5c1a7;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  .xmas-closing__title {
    color: #f5c1a7;
    font: italic 400 60px/1.1 "Bodoni 72", Bodoni-Book, serif;
    letter-spacing: normal;
  }
  @supports (background-clip: text) {
    .xmas-closing__title {
      background: linear-gradient(149deg, #f5c1a7 15.2%, #fcdbca 98.93%);
      background-clip: text;
      color: transparent;
    }
  }
  .xmas-closing__details {
    max-width: 500px;
    color: #f9d1bd;
    font-size: 20px;
    line-height: 1.5;
  }
  .xmas-closing__button {
    display: inline-grid;
    place-items: center;
    min-height: 48px;
    padding: 6px 37px;
    border-radius: 4px;
    background: #e0004d;
    color: #fff;
    font: 500 15px/1.5 Saans, sans-serif;
    text-transform: uppercase;
    text-decoration: none;
  }
  .xmas-closing__content > * + .xmas-closing__button { margin-top: 26px; }

  @media (prefers-reduced-motion: reduce) {
    .xmas-closing .to-top { opacity: 1; transform: none; transition: none; }
  }

  @media (max-width: 700px) {
    .xmas-closing { min-height: 0; }
    .xmas-closing__kicker, .xmas-closing__details { font-size: 12px; }
    .xmas-closing__title { font-size: 28px; }
    .xmas-closing__button { min-height: 38px; padding: 10px 30px; font-size: 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Christmas closing banner",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Navigation anchor ID"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "MAKE IT A ULIKE CHRISTMAS"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Glow Your Way This Christmas."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "6 December · 10 AM–4 PM\nFuture Stores · 95 Oxford Street, London W1D 2AD"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Map link"
    }
  ],
  "presets": [
    {
      "name": "Christmas closing banner"
    }
  ]
}
{% endschema %}
