<section class="xmas xmas-closing"><div class="container">
  {% render 'xmas-heading', settings_group: section.settings %}
  {% render 'xmas-directions', settings_group: section.settings, delay: 0.3 %}
</div></section>

{% stylesheet %}
.xmas.xmas-closing { background: radial-gradient(ellipse at 50% 0,#a32232,#680b18); color: #fff7ec; text-align: center; padding: var(--xmas-section-space) 0; }
.xmas-closing .xmas-kicker { color: #ecd299; font-size: var(--xmas-small-size); }
.xmas-closing .xmas-intro { color: #efdcd1; font-size: var(--xmas-body-size); line-height: 1.65; }
.xmas-closing .xmas-directions { background: #fff3df; color: #771324; margin-top: 32px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Christmas closing banner",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "MAKE IT A ULIKE CHRISTMAS"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Glow Your Way This Christmas."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "6 December · 10 AM–4 PM\nFuture Stores · 95 Oxford Street, London W1D 2AD"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Map link"
    }
  ],
  "presets": [
    {
      "name": "Christmas closing banner"
    }
  ]
}
{% endschema %}
