  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} .pcos-champion-share');
    if (!root || root.dataset.ready === 'true') {
      return;
    }

    root.dataset.ready = 'true';

    var frameNode = root.querySelector('[data-share-frame]');
    var captureNode = root.querySelector('[data-share-capture]');
    var certificateContentNode = root.querySelector('[data-certificate-content]');
    var medalBadgeNode = root.querySelector('[data-medal-badge]');
    var medalImageNode = root.querySelector('[data-medal-image]');
    var apiHost = 'https://api.ulike.com/eu/';
    var claimEndpoint = '/promotion/sendBenefit';
    var queryEndpoint = '/promotion/queryBenefitInfoList';
    var claimActivityId = '331531677895491585';
    var shareTitle = "I joined Ulike's PCOS campaign as a supporter and unlocked this medal! View here:";
    var fileName = 'pcos-awareness-champion.png';
    var medalConfigs = {};
    var dynamicDataPromise = null;
    var html2CanvasPromise = null;

    root.querySelectorAll('[data-medal-config]').forEach(function (node) {
      medalConfigs[node.dataset.pcosType] = {
        imageUrl: node.dataset.imageUrl || '',
        description: node.dataset.description || ''
      };
    });

    function setField(name, value) {
      var node = root.querySelector('[data-dynamic-field="' + name + '"]');
      if (node && value !== null && value !== undefined && value !== '') {
        node.textContent = value;
      }
    }

    function normalizePcosType(value) {
      var type = String(value || '').toUpperCase();
      return /^PCOS[1-5]$/.test(type) ? type : 'PCOS1';
    }

    function parseExtend(value) {
      if (!value) {
        return {};
      }

      if (typeof value === 'object') {
        return value;
      }

      try {
        return JSON.parse(value);
      } catch (error) {
        return {};
      }
    }

    function generateGUID() {
      if (window.crypto && window.crypto.randomUUID) {
        return window.crypto.randomUUID();
      }

      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (character) {
        var random = Math.random() * 16 | 0;
        var value = character === 'x' ? random : (random & 0x3 | 0x8);

        return value.toString(16);
      });
    }

    function sendUlikeApi(url, data) {
      var payload = Object.assign({}, data, {
        siteCode: 'UK',
        language: window.Shopify && window.Shopify.locale ? window.Shopify.locale : 'en',
        requestId: generateGUID()
      });

      return fetch(apiHost + url, {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      }).then(function (response) {
        if (!response.ok) {
          throw new Error('Request failed');
        }

        return response.json();
      });
    }

    function getQueryParams() {
      return new URLSearchParams(window.location.search);
    }

    function getClaimParams() {
      var params = getQueryParams();
      var orderId = params.get('order_id') || params.get('orderId') || params.get('resourceId');
      var email = params.get('email') || params.get('userEmail');

      return {
        orderId: orderId ? orderId.trim() : '',
        email: email ? email.trim() : ''
      };
    }

    function formatDate(timestamp) {
      var seconds = Number(timestamp);
      if (!seconds) {
        return '';
      }

      return new Intl.DateTimeFormat('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric'
      }).format(new Date(seconds * 1000));
    }

    function applyMedal(type) {
      var medal = medalConfigs[normalizePcosType(type)] || {};
      if (medal.description) {
        setField('quote', medal.description);
      }

      if (medal.imageUrl && medalBadgeNode && medalImageNode) {
        medalImageNode.crossOrigin = 'anonymous';
        medalImageNode.src = medal.imageUrl;
        medalBadgeNode.hidden = false;
      } else if (medalBadgeNode) {
        medalBadgeNode.hidden = true;
      }
    }

    function applyBenefit(benefit) {
      if (!benefit) {
        return;
      }

      var extend = parseExtend(benefit.extend);
      var type = normalizePcosType(extend.pcosType || getRequestedPcosType());

      applyMedal(type);
      setField('number', benefit.instanceId);
      setField('name', extend.userName);
      setField('date', formatDate(benefit.createTime));

      if (certificateContentNode) {
        certificateContentNode.hidden = false;
      }

      if (frameNode) {
        delete frameNode.dataset.loading;
      }
    }

    function getRequestedPcosType() {
      var params = getQueryParams();
      return normalizePcosType(params.get('pcosType') || root.dataset.defaultPcosType);
    }

    function getBenefitByType(items, type) {
      if (!Array.isArray(items) || !items.length) {
        return null;
      }

      return items.find(function (item) {
        return normalizePcosType(parseExtend(item.extend).pcosType) === type;
      }) || items[0];
    }

    function loadDynamicData() {
      var pcosType = getRequestedPcosType();
      var claimParams = getClaimParams();

      if (claimParams.orderId && claimParams.email) {
        dynamicDataPromise = sendUlikeApi(claimEndpoint, {
          merchantCode: 'ULIKE',
          scene: 'PCOS',
          activityId: claimActivityId,
          userEmail: claimParams.email,
          extend: {
            resourceId: claimParams.orderId
          }
        })
        .then(function (payload) {
          if (!payload || payload.code !== 0 || payload.success === false) {
            throw new Error('Invalid response');
          }

          var benefit = payload.data;
          if (!benefit) {
            return;
          }

          applyBenefit(benefit);
        })
        .catch(function () {});

        return dynamicDataPromise;
      }

      var queryData = {
        pageIndex: 1,
        pageSize: 20,
        includeCount: false,
        scene: 'PCOS',
        activityId: claimActivityId,
        extend: {
          pcosType: pcosType
        }
      };

      if (claimParams.email) {
        queryData.userEmail = claimParams.email;
      }

      dynamicDataPromise = sendUlikeApi(queryEndpoint, queryData)
      .then(function (payload) {
        if (!payload || payload.code !== 0 || payload.success === false) {
          throw new Error('Invalid response');
        }

        var benefit = Array.isArray(payload.data) ? getBenefitByType(payload.data, pcosType) : payload.data;
        if (!benefit) {
          return;
        }

        applyBenefit(benefit);
      })
      .catch(function () {});

      return dynamicDataPromise;
    }

    loadDynamicData();

    function getHtml2Canvas() {
      return new Promise(function (resolve, reject) {
        if (window.html2canvas) {
          resolve(window.html2canvas);
          return;
        }

        if (!html2CanvasPromise) {
          html2CanvasPromise = new Promise(function (scriptResolve, scriptReject) {
            var script = document.querySelector('[data-html2canvas-script]');
            if (!script) {
              scriptReject(new Error('html2canvas missing'));
              return;
            }

            script.onload = function () {
              scriptResolve(window.html2canvas);
            };
            script.onerror = scriptReject;
          });
        }

        html2CanvasPromise.then(resolve).catch(reject);
      });
    }

    function waitForFonts() {
      if (document.fonts && document.fonts.ready) {
        return document.fonts.ready.catch(function () {});
      }

      return Promise.resolve();
    }

    function waitForImages(node) {
      var images = Array.prototype.slice.call(node.querySelectorAll('img'));
      return Promise.all(images.map(function (image) {
        if (image.complete && image.naturalWidth > 0) {
          return Promise.resolve();
        }

        return new Promise(function (resolve) {
          image.addEventListener('load', resolve, { once: true });
          image.addEventListener('error', resolve, { once: true });
        });
      }));
    }

    function imageToDataUrl(image) {
      var url = image.currentSrc || image.src;
      if (!url || url.indexOf('data:') === 0) {
        return Promise.resolve(null);
      }

      return fetch(url, { mode: 'cors', credentials: 'omit' })
        .then(function (response) {
          if (!response.ok) {
            throw new Error('Image request failed');
          }

          return response.blob();
        })
        .then(function (blob) {
          return new Promise(function (resolve, reject) {
            var reader = new FileReader();
            reader.onload = function () {
              resolve({
                image: image,
                src: image.getAttribute('src'),
                srcset: image.getAttribute('srcset'),
                sizes: image.getAttribute('sizes'),
                dataUrl: reader.result
              });
            };
            reader.onerror = reject;
            reader.readAsDataURL(blob);
          });
        })
        .catch(function () {
          return null;
        });
    }

    function inlineCaptureImages() {
      var images = Array.prototype.slice.call(captureNode.querySelectorAll('img'));
      return Promise.all(images.map(imageToDataUrl)).then(function (items) {
        var restoreItems = items.filter(Boolean);

        restoreItems.forEach(function (item) {
          item.image.removeAttribute('srcset');
          item.image.removeAttribute('sizes');
          item.image.setAttribute('src', item.dataUrl);
        });

        return function restoreImages() {
          restoreItems.forEach(function (item) {
            if (item.srcset) {
              item.image.setAttribute('srcset', item.srcset);
            }

            if (item.sizes) {
              item.image.setAttribute('sizes', item.sizes);
            }

            if (item.src) {
              item.image.setAttribute('src', item.src);
            }
          });
        };
      });
    }

    function prepareCaptureLayout() {
      var logoWrap = captureNode.querySelector('.pcos-champion-share__logos');
      var logo = captureNode.querySelector('.pcos-champion-share__logo');

      if (logoWrap) {
        logoWrap.style.display = 'grid';
        logoWrap.style.width = '100%';
        logoWrap.style.placeItems = 'center';
        logoWrap.style.textAlign = 'center';
      }

      if (logo) {
        logo.style.display = 'block';
        logo.style.marginLeft = 'auto';
        logo.style.marginRight = 'auto';
        logo.style.justifySelf = 'center';
      }
    }

    function buildCanvas() {
      prepareCaptureLayout();

      if (!dynamicDataPromise) {
        dynamicDataPromise = Promise.resolve();
      }

      return Promise.all([dynamicDataPromise, getHtml2Canvas(), waitForFonts()]).then(function (results) {
        var html2canvas = results[1];
        return waitForImages(captureNode).then(function () {
          return html2canvas;
        });
      }).then(function (html2canvas) {
        var restoreImages = function () {};

        return inlineCaptureImages().then(function (restore) {
          restoreImages = restore;
          return waitForImages(captureNode);
        }).then(function () {
          return html2canvas(captureNode, {
            backgroundColor: null,
            scale: Math.max(2, window.devicePixelRatio || 1),
            useCORS: true,
            allowTaint: false,
            logging: false
          });
        }).then(function (canvas) {
          restoreImages();

          return canvas;
        }).catch(function (error) {
          restoreImages();

          throw error;
        });
      });
    }

    function canvasToBlob(canvas) {
      return new Promise(function (resolve) {
        canvas.toBlob(resolve, 'image/png', 0.96);
      });
    }

    function downloadBlob(blob) {
      var link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = fileName;
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.setTimeout(function () {
        URL.revokeObjectURL(link.href);
      }, 1000);
    }

    function getShareUrl(platform) {
      var url = encodeURIComponent(window.location.href);
      var text = encodeURIComponent(shareTitle);

      if (platform === 'facebook') {
        return 'https://m.facebook.com/sharer/sharer.php?u=' + url + '&quote=' + text;
      }

      if (platform === 'x') {
        return 'https://twitter.com/intent/tweet?url=' + url + '&text=' + text;
      }

      if (platform === 'whatsapp') {
        return 'https://api.whatsapp.com/send?text=' + text + '%20' + url;
      }

      if (platform === 'sms') {
        return 'sms:?&body=' + text + '%20' + url;
      }

      if (platform === 'instagram') {
        return 'https://www.instagram.com/';
      }

      return '';
    }

    function copyShareLink() {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(window.location.href).catch(function () {});
      }

      return Promise.resolve();
    }

    function isMobileDevice() {
      return /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
    }

    function sharePage(platform) {
      if (platform === 'instagram') {
        copyShareLink();
        window.open(getShareUrl(platform), '_blank', 'noopener,noreferrer');
        return;
      }

      var shareUrl = getShareUrl(platform);
      if (shareUrl) {
        if (platform === 'facebook' && isMobileDevice()) {
          window.location.href = shareUrl;
          return;
        }

        window.open(shareUrl, '_blank', 'noopener,noreferrer');
        return;
      }

      copyShareLink();
    }

    root.querySelectorAll('[data-share-platform]').forEach(function (button) {
      button.addEventListener('click', function () {
        sharePage(button.dataset.sharePlatform);
      });
    });

    var downloadButton = root.querySelector('[data-share-download]');
    if (downloadButton) {
      downloadButton.addEventListener('click', function () {
        buildCanvas()
          .then(canvasToBlob)
          .then(function (blob) {
            downloadBlob(blob);
          })
          .catch(function () {});
      });
    }

    var copyButton = root.querySelector('[data-share-copy]');
    if (copyButton) {
      copyButton.addEventListener('click', function () {
        copyShareLink();
      });
    }

  })();
</script>

