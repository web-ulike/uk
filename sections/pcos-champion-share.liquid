{%- liquid
  assign card_bg = section.settings.card_background
  assign share_bg = section.settings.share_background
  assign logo_image = section.settings.logo_image
  assign spark_image = section.settings.spark_image
  assign divider_image = section.settings.divider_image
  assign facebook_icon = section.settings.facebook_icon
  assign x_icon = section.settings.x_icon
  assign whatsapp_icon = section.settings.whatsapp_icon
  assign instagram_icon = section.settings.instagram_icon
  assign sms_icon = section.settings.sms_icon
  assign download_icon = section.settings.download_icon
  assign copy_icon = section.settings.copy_icon
-%}
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
<link rel="dns-prefetch" href="//api.ulike.com">
<link rel="preconnect" href="https://api.ulike.com" crossorigin>

<style>
  @font-face {
    font-family: 'Cloister Black';
    src: url({{ 'CloisterBlack.ttf' | asset_url }}) format('truetype');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Saans";
    src: url('{{ "Saans-Regular.otf" | asset_url }}') format('opentype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Saans";
    src: url('{{ "Saans-Medium.otf" | asset_url }}') format('opentype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  #shopify-section-{{ section.id }}{
    font-family: 'Saans', Arial, Helvetica, sans-serif;
  }

  body {
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share {
    display: flex;
    justify-content: center;
    background: #ffffff;
    padding: 2px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__frame {
    position: relative;
    width: 100%;
    max-width: 750px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__frame[data-loading] .pcos-champion-share__content,
  #shopify-section-{{ section.id }} .pcos-champion-share__frame[data-loading] .pcos-champion-share__actions-inner {
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__certificate,
  #shopify-section-{{ section.id }} .pcos-champion-share__actions {
    position: relative;
    overflow: hidden;
    background: #f8f7f4;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__certificate {
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__actions {
    margin-top: {{ section.settings.panel_gap }}px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__bg {
    position: relative;
    z-index: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 110px 70px 42px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__content[hidden] {
    display: flex !important;
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__frame[data-loading] .pcos-champion-share__skeleton {
    display: flex;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton--certificate {
    padding: 110px 70px 42px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton--actions {
    padding: 70px 62px 40px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-item {
    position: relative;
    overflow: hidden;
    background: rgba(47, 149, 160, .12);
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-item::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .65), transparent);
    animation: pcos-champion-share-skeleton 1.25s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-logo {
    width: 330px;
    max-width: 58%;
    height: 36px;
    margin-bottom: 42px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-badge {
    width: 390px;
    max-width: 58%;
    height: 390px;
    margin-bottom: 26px;
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-spark {
    width: 42px;
    height: 42px;
    margin-bottom: 18px;
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-title {
    width: 470px;
    max-width: 74%;
    height: 34px;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-number {
    width: 250px;
    height: 64px;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-name {
    width: 160px;
    height: 24px;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-quote {
    width: 360px;
    max-width: 68%;
    height: 18px;
    margin-bottom: 34px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-date {
    width: 150px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-share-title {
    width: 110px;
    height: 24px;
    margin-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-row {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 22px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-label {
    width: 54px;
    height: 12px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-line {
    width: 100%;
    height: 2px;
    margin: 40px 0 34px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-row--utility {
    width: 46%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @keyframes pcos-champion-share-skeleton {
    to {
      transform: translateX(100%);
    }
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__logos {
    display: grid;
    width: 100%;
    min-height: 36px;
    place-items: center;
    margin-bottom: 26px;
    text-align: center;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__logo {
    display: block;
    width: auto;
    max-width: 330px;
    height: auto;
    max-height: 64px;
    margin: 0 auto;
    justify-self: center;
    object-fit: contain;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__badge {
    display: flex;
    width: 390px;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__badge[hidden] {
    display: flex !important;
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__badge img {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
    border-radius: 50%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__spark {
    display: flex;
    justify-content: center;
    min-height: 76px;
    margin: 0 0 14px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__spark img {
    display: block;
    width: 76px;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__title {
    color: #2E2E2E;
    margin: 0 0 8px;
    font-size: 44px;
    line-height: 1.2;
    text-transform: uppercase;
    font-family: 'Abhaya Libre', serif;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__number {
    color: #2F95A0;
    width: 100%;
    margin: 0;
    text-align: center;
    text-shadow: 0 1px 2.4px rgba(0, 0, 0, 0.25);
    font-family: 'Cloister Black', Georgia, 'Times New Roman', serif;
    font-size: 104px;
    font-style: normal;
    font-weight: 300;
    line-height: 1.25;
    font-variant-numeric: lining-nums tabular-nums;
    font-feature-settings: "lnum" 1, "tnum" 1;
  }


  #shopify-section-{{ section.id }} .pcos-champion-share__name {
    min-height: 1.2em;
    margin-bottom: 12px;
    color: #2E2E2E;
    text-align: center;
    font-size: 22px;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__quote {
    margin-bottom: 20px;
    color: #2E2E2E;
    font-size: 16px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__date {
    min-height: 1.2em;
    color: #2E2E2E;
    font-family: 'Saans', Arial, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__actions-inner {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 46px 62px 40px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__share-title {
    margin: 0 0 30px;
    color: #2E2E2E;
    font-family: 'Abhaya Libre', serif;
    font-size: 22px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__button-row {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 22px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__button-row--utility {
    width: 46%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__button {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    border: 0;
    background: transparent;
    color: #2b2623;
    font: inherit;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__icon {
    display: flex;
    width: 80px;
    height: 80px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: #2F95A0;
    transition: background-color .2s ease, transform .2s ease;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__button:hover .pcos-champion-share__icon,
  #shopify-section-{{ section.id }} .pcos-champion-share__button .pcos-champion-share__icon:hover,
  #shopify-section-{{ section.id }} .pcos-champion-share__button:focus-visible .pcos-champion-share__icon {
    background-color: #21D8D8;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__button--dark .pcos-champion-share__icon {
    background-color: #2E2E2E;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__button--dark:hover .pcos-champion-share__icon,
  #shopify-section-{{ section.id }} .pcos-champion-share__button--dark .pcos-champion-share__icon:hover,
  #shopify-section-{{ section.id }} .pcos-champion-share__button--dark:focus-visible .pcos-champion-share__icon {
    background-color: #515151;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__icon img {
    display: block;
    width: auto;
    max-width: 22px;
    height: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__button:first-child .pcos-champion-share__icon img {
    width: 14px;
    max-width: 14px;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__label {
    overflow-wrap: anywhere;
    font-size: 13px;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__line {
    display: block;
    flex-shrink: 0;
    width: 100%;
    margin: 34px 0 24px;
    text-align: center;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .pcos-champion-share__line img {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    min-height: 1px;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .pcos-champion-share {
      padding: 32px 16px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__frame {
      max-width: 750px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__content {
      padding: 86px 20px 30px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__logos {
      margin-bottom: 60px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__logo {
      max-width: 406px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__badge {
      width: 464px;
      margin-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__spark {
      min-height: 91px;
      margin-bottom: 17px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__spark img {
      width: 80px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__title {
      margin-bottom: 10px;
      font-size: 52px;
       width: 80%;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__number {
      font-size: 104px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__name {
      margin-bottom: 18px;
      font-size: 40px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__quote {
      margin-bottom: 20px;
      font-size: 28px;
      min-height: 60px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__date {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__actions-inner {
      padding: 87px 60px 20px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__share-title {
      margin-bottom: 24px;
      font-size: 36px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__button-row {
      gap: 0px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__button {
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__icon {
      width: 80px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__icon img {
      max-width: 40px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__button:first-child .pcos-champion-share__icon img {
      width: 26px;
      max-width: 26px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__label {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__line {
      margin: 41px 0 29px;
    }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .pcos-champion-share {
      width: 100vw;
      max-width: 100vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__frame {
      width: 100%;
      max-width: none;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__bg {
      width: 100% !important;
      max-width: none !important;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__logo {
      max-width: 46vw;
      max-height: 9vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__content {
      padding: 10vw 10vw 6vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton--certificate {
      padding: 10vw 10vw 6vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-logo {
      width: 46vw;
      height: 9vw;
      margin-bottom: 4vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-badge {
      width: 58vw;
      height: 58vw;
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-spark {
      width: 8vw;
      height: 8vw;
      margin-bottom: 2vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-title {
      width: 68vw;
      height: 7vw;
      margin-bottom: 2vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-number {
      width: 34vw;
      height: 12vw;
      margin-bottom: 4vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-name {
      width: 28vw;
      height: 5vw;
      margin-bottom: 3vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-quote {
      width: 58vw;
      height: 14px;
      margin-bottom: 6vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-date {
      width: 26vw;
      height: 12px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__logos {
      min-height: 9vw;
      margin-bottom: 4vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__badge {
      width: 58vw;
      margin-bottom: 0vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__spark {
      min-height: 12vw;
      margin-bottom: 0vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__spark img {
      width: 12vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__title {
      margin-bottom: 2vw;
      font-size: 7vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__number {
      font-size: 12vw;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__name {
      margin: 5vw 0px 3vw;
      font-size: 5vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__quote {
      margin-bottom: 6vw;
      font-size: 14px;
      min-height: 40px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__date {
      {% comment %} font-size: 3vw; {% endcomment %}
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__actions-inner {
      padding: 9vw 6vw 7vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton--actions {
      padding: 9vw 6vw 7vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-share-title {
      width: 22vw;
      height: 6vw;
      margin-bottom: 4vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-row {
      gap: 0;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-icon {
      width: 13vw;
      height: 13vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-label {
      width: 12vw;
      height: 12px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-line {
      margin: 4px 0;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__skeleton-row--utility {
      width: 50%;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__share-title {
      margin-bottom: 4vw;
      font-size: 6vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__button-row {
      gap: 0px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__button-row--utility {
      width: 50%;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__button {
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__icon {
      width: 13vw;
      height: 13vw;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__label {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__line {
      display: block;
      flex-shrink: 0;
      width: 100%;
      margin: 4px 0;
    }

    #shopify-section-{{ section.id }} .pcos-champion-share__line img {
      display: block;
      width: 100%;
      max-width: none;
      height: auto;
    }

  }
</style>



<section
  class="pcos-champion-share"
  data-section-id="{{ section.id }}"
  data-activity-id="{{ section.settings.activity_id | escape }}"
  data-default-pcos-type="{{ section.settings.default_pcos_type | escape }}"
>
  <div class="pcos-champion-share__medal-configs" hidden>
    <span
      data-medal-config
      data-pcos-type="PCOS1"
      data-description="{{ section.settings.pcos1_description | escape }}"
