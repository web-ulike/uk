<style>
  #shopify-section-{{ section.id }} .ulike-home-comparison {
    display: block;
    color: #fff;
    background: #1a1a1a;
    font-family: Saans, sans-serif;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__inner {
    display: grid;
    grid-template-columns: minmax(0, 36%) minmax(0, 1fr);
    gap: clamp(48px, 9.32vw, 179px);
    width: min(1520px, calc(100% - 80px));
    min-height: 662px;
    margin: 0 auto;
    padding: 110px 0 80px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__intro {
    position: relative;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__title {
    margin: 0;
    font-family: var(--heading-font-family);
    font-size: 48px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .01em;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__title-mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 21px;
    font-size: 18px;
    font-family: saans-light, sans-serif;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding-bottom: 4px;
    border-bottom: .5px solid currentColor;
    color: inherit;
    font-size: 14px;
    font-family: Saans, sans-serif;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__link svg {
    display: block;
    width: 14px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__notes {
    max-width: 476px;
    margin: 212px 0 0;
    color: #8b8b8b;
    font-size: 12px;
    font-family: saans-light, sans-serif;
    line-height: 1.79;
    letter-spacing: .01em;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__notes p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__comparison {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__track {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__card {
    position: relative;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__card + .ulike-home-comparison__card::before {
    position: absolute;
    top: 0;
    left: -20px;
    width: 1px;
    height: 455px;
    background: repeating-linear-gradient(to bottom, #a2a2a2 0 5px, transparent 5px 10px) left / .5px 100% no-repeat;
    content: '';
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__media {
    position: relative;
    height: 213px;
    overflow: hidden;
    border-radius: 4px;
    background: #555;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__card--ulike:not(.ulike-home-comparison__card--custom-desktop) .ulike-home-comparison__image {
    position: absolute;
    left: -2.4%;
    width: 102.4%;
    max-width: none;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__card--salon:not(.ulike-home-comparison__card--custom-desktop) .ulike-home-comparison__image {
    position: absolute;
    top: -19.5%;
    left: -10%;
    width: 171%;
    height: 203%;
    max-width: none;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__card--custom-desktop .ulike-home-comparison__image {
    position: static;
    width: 100%;
    height: 100%;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__name {
    margin: 17px 0 15px;
    font-family: var(--heading-font-family);
    font-size: 26px;
    font-weight: 400;
    line-height: 28px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0 0 0 10px;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__row {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 46px;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__row img {
    display: block;
    flex: 0 0 auto;
    width: 19.8644px;
    height: 19.8644px;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__row picture {
    display: block;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__row-text {
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: .01em;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__card--ulike .ulike-home-comparison__row-text {
    font-family: var(--heading-font-family);
    font-size: 20px;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__row-text strong {
    color: #c5c4ff;
    font-weight: inherit;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__card--ulike .ulike-home-comparison__row:last-child strong {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .ulike-home-comparison__arrows,
  #shopify-section-{{ section.id }} .ulike-home-comparison__notes--mobile {
    display: none;
  }

  @media (max-width: 1199px) and (min-width: 768px) {
    #shopify-section-{{ section.id }} .ulike-home-comparison__inner {
      grid-template-columns: minmax(0, 33%) minmax(0, 1fr);
      gap: 30px;
      width: calc(100% - 48px);
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__title { font-size: 36px; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__track { gap: 20px; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__card + .ulike-home-comparison__card::before { left: -10px; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__row { gap: 9px; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__row-text,
    #shopify-section-{{ section.id }} .ulike-home-comparison__card--ulike .ulike-home-comparison__row-text { font-size: 13px; }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .ulike-home-comparison__inner {
      display: block;
      width: 100%;
      min-height: 706px;
      padding: 60px 0 38px;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__intro { padding: 0 16px; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__title {
      font-size: 24px;
      line-height: 24px;
      letter-spacing: -.26px;
      text-align: center;
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__title-desktop { display: none; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__title-mobile { display: inline; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__more {
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
      font-size: 12px;
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__link {
      gap: 5px;
      padding-bottom: 4px;
      font-size: 12px;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__link svg { width: 11.3333px; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__notes--desktop { display: none; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__comparison {
      width: 100%;
      margin-top: 34px;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 16px;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__comparison::-webkit-scrollbar { display: none; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__track {
      display: flex;
      gap: 14px;
      width: max-content;
      padding: 0 16px;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__card {
      flex: 0 0 230px;
      width: 230px;
      scroll-snap-align: start;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__card + .ulike-home-comparison__card::before {
      top: 0;
      left: -7px;
      width: 1px;
      height: 354px;
      background: repeating-linear-gradient(to bottom, #fff 0 3px, transparent 3px 6px) left / .5px 100% no-repeat;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__media {
      width: 230px;
      height: 200px;
      border-radius: 4px;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__card--ulike:not(.ulike-home-comparison__card--custom-mobile) .ulike-home-comparison__image {
      top: -1%;
      left: -1.7%;
      width: 109.6%;
      height: 101.5%;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__card--salon:not(.ulike-home-comparison__card--custom-mobile) .ulike-home-comparison__image {
      top: -8.5%;
      left: -17.4%;
      width: 146.5%;
      height: 112.5%;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__card--custom-mobile .ulike-home-comparison__image {
      position: static;
      top: auto;
      left: auto;
      width: 100%;
      height: 100%;
      max-width: 100%;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__name {
      margin: 10px 0 4px;
      font-size: 14px;
      line-height: 28px;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__list { padding-left: 15px; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__row {
      gap: 9px;
      min-height: 30px;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__row img {
      width: 13.2424px;
      height: 13.2424px;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__card--salon .ulike-home-comparison__row img {
      width: 14.375px;
      height: 14.375px;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__row-text,
    #shopify-section-{{ section.id }} .ulike-home-comparison__card--ulike .ulike-home-comparison__row-text {
      font-size: 12px;
      line-height: 1.2;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__card--ulike .ulike-home-comparison__row:last-child strong { text-decoration: none; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__arrows {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 62.6992px;
      height: 24px;
      margin: 35px 0 0 16px;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__arrow {
      position: relative;
      display: block;
      flex: 0 0 23px;
      width: 23px;
      height: 24px;
      padding: 0;
      overflow: hidden;
      border: 0;
      border-radius: 0;
      background: transparent;
      cursor: pointer;
      appearance: none;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__arrow svg {
      position: absolute;
      top: 4px;
      display: block;
      width: 62.6992px;
      max-width: none;
      height: 16px;
      pointer-events: none;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__arrow--previous svg { left: 0; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__arrow--next svg { right: 0; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__arrow svg path { opacity: 1; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__arrow:disabled {
      opacity: .5;
      cursor: default;
    }
    #shopify-section-{{ section.id }} .ulike-home-comparison__arrow:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    #shopify-section-{{ section.id }} .ulike-home-comparison__notes--mobile {
      display: block;
      max-width: none;
      margin: 30px 16px 0;
      font-size: 9px;
      line-height: 1.79;
      letter-spacing: .01em;
    }
  }
</style>

<ulike-home-comparison class="ulike-home-comparison">
  <div class="ulike-home-comparison__inner">
    <div class="ulike-home-comparison__intro">
      <h2 class="ulike-home-comparison__title">
        <span class="ulike-home-comparison__title-desktop">{{ section.settings.title_desktop | escape | newline_to_br }}</span>
        <span class="ulike-home-comparison__title-mobile">{{ section.settings.title_mobile | escape }}</span>
      </h2>
      <div class="ulike-home-comparison__more">
        {% if section.settings.subtitle != blank %}<span>{{ section.settings.subtitle | escape }}</span>{% endif %}
        {% if section.settings.link_text != blank %}
          {% if section.settings.link != blank %}<a class="ulike-home-comparison__link" href="{{ section.settings.link }}">{% else %}<span class="ulike-home-comparison__link">{% endif %}
            {{ section.settings.link_text | escape }}
            <svg xmlns="http://www.w3.org/2000/svg" width="12" height="9" viewBox="0 0 12 9" fill="none" aria-hidden="true" focusable="false">
              <g clip-path="url(#ulike-comparison-link-arrow-{{ section.id }})">
                <path d="M11.3333 4.34185C11.3333 4.41041 11.3079 4.47841 11.2593 4.53037L7.38933 8.67671L6.9852 8.29967L10.4211 4.61828H0C0 4.3131 0.247675 4.06543 0.552846 4.06543H11.0442C11.1487 4.06543 11.2504 4.11795 11.3002 4.21028C11.3228 4.25174 11.3333 4.29707 11.3333 4.34185Z" fill="white"/>
                <path d="M10.756 3.37236C10.5398 3.58797 10.1898 3.58797 9.97424 3.37236L6.99219 0.390862L7.38305 0L10.7554 3.37236H10.756Z" fill="white"/>
              </g>
              <defs>
                <clipPath id="ulike-comparison-link-arrow-{{ section.id }}">
                  <rect width="11.3333" height="8.67691" fill="white"/>
                </clipPath>
              </defs>
            </svg>
          {% if section.settings.link != blank %}</a>{% else %}</span>{% endif %}
        {% endif %}
      </div>
      {% if section.settings.note_1 != blank or section.settings.note_2 != blank %}
        <div class="ulike-home-comparison__notes ulike-home-comparison__notes--desktop">
          {% if section.settings.note_1 != blank %}<p>{{ section.settings.note_1 | escape }}</p>{% endif %}
          {% if section.settings.note_2 != blank %}<p>{{ section.settings.note_2 | escape }}</p>{% endif %}
        </div>
      {% endif %}
    </div>

    <div class="ulike-home-comparison__comparison" data-comparison-scroll>
      <div class="ulike-home-comparison__track">
        {% for block in section.blocks %}
          {% assign kind = block.settings.kind %}
          {% if kind == 'salon' %}
            {% assign desktop_fallback = 'ulike-home-comparison-desktop-salon.png' %}
            {% assign mobile_fallback = 'ulike-home-comparison-mobile-salon.png' %}
          {% else %}
            {% assign desktop_fallback = 'ulike-home-comparison-desktop-ulike.jpg' %}
            {% assign mobile_fallback = 'ulike-home-comparison-desktop-ulike.jpg' %}
          {% endif %}
          {% assign desktop_image = block.settings.image_desktop %}
          {% assign mobile_image = block.settings.image_mobile | default: desktop_image %}
          <div class="ulike-home-comparison__card ulike-home-comparison__card--{{ kind }}{% if desktop_image != blank %} ulike-home-comparison__card--custom-desktop{% endif %}{% if mobile_image != blank %} ulike-home-comparison__card--custom-mobile{% endif %}" {{ block.shopify_attributes }}>
            <div class="ulike-home-comparison__media">
              <picture>
                {% if mobile_image != blank %}
                  <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 700 }}">
                {% else %}
                  <source media="(max-width: 767px)" srcset="{{ mobile_fallback | asset_url }}">
                {% endif %}
                {% if desktop_image != blank %}
                  <img class="ulike-home-comparison__image" src="{{ desktop_image | image_url: width: 1000 }}" alt="{{ block.settings.image_alt | default: block.settings.title | escape }}" width="379" height="213" loading="lazy">
                {% else %}
                  <img class="ulike-home-comparison__image" src="{{ desktop_fallback | asset_url }}" alt="{{ block.settings.image_alt | default: block.settings.title | escape }}" width="379" height="213" loading="lazy">
                {% endif %}
              </picture>
            </div>
            {% if block.settings.title != blank %}<h3 class="ulike-home-comparison__name">{{ block.settings.title | escape }}</h3>{% endif %}
            <ul class="ulike-home-comparison__list">
              {% for i in (1..4) %}
                {% assign text_key = 'text_' | append: i %}
                {% assign row_text = block.settings[text_key] %}
                {% if row_text != blank %}
                  {% if kind == 'salon' %}
                    {% case i %}
                      {% when 1 %}{% assign icon_pc = 'desktop-frame457393924.svg' %}{% assign icon_m = 'mobile-frame457393924.svg' %}
                      {% when 2 %}{% assign icon_pc = 'desktop-frame457393923.svg' %}{% assign icon_m = 'mobile-frame457393923.svg' %}
                      {% when 3 %}{% assign icon_pc = 'desktop-frame457393923.svg' %}{% assign icon_m = 'mobile-frame457393922.svg' %}
                      {% when 4 %}{% assign icon_pc = 'desktop-frame457393921.svg' %}{% assign icon_m = 'mobile-frame457393921.svg' %}
                    {% endcase %}
                  {% else %}
                    {% case i %}
                      {% when 1 %}{% assign icon_pc = 'desktop-frame457393928.svg' %}{% assign icon_m = 'mobile-frame457393928.svg' %}
                      {% when 2 %}{% assign icon_pc = 'desktop-frame457393928.svg' %}{% assign icon_m = 'mobile-frame457393927.svg' %}
                      {% when 3 %}{% assign icon_pc = 'desktop-frame457393926.svg' %}{% assign icon_m = 'mobile-frame457393926.svg' %}
                      {% when 4 %}{% assign icon_pc = 'desktop-frame457393926.svg' %}{% assign icon_m = 'mobile-frame457393925.svg' %}
                    {% endcase %}
                  {% endif %}
                  {% assign icon_pc_path = 'ulike-home-comparison-' | append: icon_pc %}
                  {% assign icon_m_path = 'ulike-home-comparison-' | append: icon_m %}
                  {% if kind == 'salon' %}
                    {% assign icon_image = section.settings.icon_wrong %}
                  {% else %}
                    {% assign icon_image = section.settings.icon_correct %}
                  {% endif %}
                  <li class="ulike-home-comparison__row">
                    <picture aria-hidden="true">
                      {% if icon_image != blank %}
                        <source media="(max-width: 767px)" srcset="{{ icon_image | image_url: width: 40 }}">
                        <img src="{{ icon_image | image_url: width: 40 }}" alt="" width="20" height="20">
                      {% else %}
                        <source media="(max-width: 767px)" srcset="{{ icon_m_path | asset_url }}">
                        <img src="{{ icon_pc_path | asset_url }}" alt="" width="20" height="20">
                      {% endif %}
                    </picture>
                    <span class="ulike-home-comparison__row-text">{{ row_text }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ulike-home-comparison__arrows">
      <button class="ulike-home-comparison__arrow ulike-home-comparison__arrow--previous" type="button" aria-label="Previous comparison" data-comparison-previous disabled>
        <svg aria-hidden="true" focusable="false" preserveAspectRatio="none" overflow="visible" style="display: block;" width="62.6992" height="16.001" viewBox="0 0 62.6992 16.001" fill="none" xmlns="http://www.w3.org/2000/svg">
<g>
<path opacity="0.5" d="M19.8799 7.49707C20.4426 7.49707 20.8994 7.95384 20.8994 8.5166H1.68262L8.01855 15.3057L7.27344 16.001L0.136719 8.35449C0.0470439 8.2587 4.29153e-05 8.13319 0 8.00684C0 7.92426 0.019724 7.84013 0.0615234 7.76367C0.15336 7.59368 0.340676 7.49707 0.533203 7.49707H19.8799ZM8.00684 0.720703L2.50781 6.21875C2.11021 6.61635 1.46503 6.61635 1.06641 6.21875H1.06738L7.28613 0L8.00684 0.720703Z" fill="white"/>
<path d="M61.2666 7.49756C61.4591 7.49767 61.6465 7.5941 61.7383 7.76416C61.7801 7.84062 61.7998 7.92474 61.7998 8.00732C61.7997 8.13363 61.7527 8.25923 61.6631 8.35498L54.5264 16.0005L53.7812 15.3052L60.1172 8.51709H40.8994C40.8994 7.95442 41.3563 7.49772 41.9189 7.49756H61.2666ZM60.7324 6.21924H60.7334C60.3348 6.61684 59.6886 6.61684 59.291 6.21924L53.792 0.721191L54.5127 0.000488281L60.7324 6.21924Z" fill="white"/>
</g>
</svg>
      </button>
      <button class="ulike-home-comparison__arrow ulike-home-comparison__arrow--next" type="button" aria-label="Next comparison" data-comparison-next>
        <svg aria-hidden="true" focusable="false" preserveAspectRatio="none" overflow="visible" style="display: block;" width="62.6992" height="16.001" viewBox="0 0 62.6992 16.001" fill="none" xmlns="http://www.w3.org/2000/svg">
<g>
<path opacity="0.5" d="M19.8799 7.49707C20.4426 7.49707 20.8994 7.95384 20.8994 8.5166H1.68262L8.01855 15.3057L7.27344 16.001L0.136719 8.35449C0.0470439 8.2587 4.29153e-05 8.13319 0 8.00684C0 7.92426 0.019724 7.84013 0.0615234 7.76367C0.15336 7.59368 0.340676 7.49707 0.533203 7.49707H19.8799ZM8.00684 0.720703L2.50781 6.21875C2.11021 6.61635 1.46503 6.61635 1.06641 6.21875H1.06738L7.28613 0L8.00684 0.720703Z" fill="white"/>
<path d="M61.2666 7.49756C61.4591 7.49767 61.6465 7.5941 61.7383 7.76416C61.7801 7.84062 61.7998 7.92474 61.7998 8.00732C61.7997 8.13363 61.7527 8.25923 61.6631 8.35498L54.5264 16.0005L53.7812 15.3052L60.1172 8.51709H40.8994C40.8994 7.95442 41.3563 7.49772 41.9189 7.49756H61.2666ZM60.7324 6.21924H60.7334C60.3348 6.61684 59.6886 6.61684 59.291 6.21924L53.792 0.721191L54.5127 0.000488281L60.7324 6.21924Z" fill="white"/>
</g>
</svg>
      </button>
    </div>

    {% if section.settings.note_1 != blank or section.settings.note_2 != blank %}
      <div class="ulike-home-comparison__notes ulike-home-comparison__notes--mobile">
        {% if section.settings.note_1 != blank %}<p>{{ section.settings.note_1 | escape }}</p>{% endif %}
        {% if section.settings.note_2 != blank %}<p>{{ section.settings.note_2 | escape }}</p>{% endif %}
      </div>
    {% endif %}
  </div>
</ulike-home-comparison>

<script>
  if (!customElements.get('ulike-home-comparison')) {
    customElements.define('ulike-home-comparison', class extends HTMLElement {
      connectedCallback() {
        const scroll = this.querySelector('[data-comparison-scroll]');
        const previous = this.querySelector('[data-comparison-previous]');
        const next = this.querySelector('[data-comparison-next]');
        if (!scroll || !previous || !next) return;
        this._comparisonEvents?.abort();
        this._comparisonResize?.disconnect();
        this._comparisonEvents = new AbortController();
        const signal = this._comparisonEvents.signal;
        const update = () => {
          const max = Math.max(0, scroll.scrollWidth - scroll.clientWidth);
          previous.disabled = scroll.scrollLeft <= 1;
          next.disabled = scroll.scrollLeft >= max - 1;
        };
        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        const move = (direction) => {
          const cards = scroll.querySelectorAll('.ulike-home-comparison__card');
          const max = Math.max(0, scroll.scrollWidth - scroll.clientWidth);
          const firstLeft = cards[0]?.getBoundingClientRect().left || 0;
          const positions = Array.from(cards, (card, index) => {
            if (index === 0) return 0;
            if (index === cards.length - 1) return max;
            return Math.min(max, card.getBoundingClientRect().left - firstLeft);
          });
          const target = direction > 0
            ? positions.find((position) => position > scroll.scrollLeft + 1) ?? max
            : positions.reverse().find((position) => position < scroll.scrollLeft - 1) ?? 0;
          scroll.scrollTo({ left: target, behavior });
        };
        previous.addEventListener('click', () => move(-1), { signal });
        next.addEventListener('click', () => move(1), { signal });
        scroll.addEventListener('scroll', update, { passive: true, signal });
        window.addEventListener('resize', update, { passive: true, signal });
        this._comparisonResize = new ResizeObserver(update);
        this._comparisonResize.observe(scroll);
        const track = scroll.querySelector('.ulike-home-comparison__track');
        if (track) this._comparisonResize.observe(track);
        this._comparisonFrame = requestAnimationFrame(update);
        update();
      }
      disconnectedCallback() {
        this._comparisonEvents?.abort();
        this._comparisonResize?.disconnect();
        cancelAnimationFrame(this._comparisonFrame);
      }
    });
  }
</script>

