        { "type": "inline_richtext", "id": "text_1", "label": "Row 1", "default": "Long-lasting hair reduction" },
        { "type": "inline_richtext", "id": "text_2", "label": "Row 2", "default": "Comfortable 10-minute sessions" },
        { "type": "inline_richtext", "id": "text_3", "label": "Row 3", "default": "Convenient at-home use" },
        { "type": "inline_richtext", "id": "text_4", "label": "Row 4", "default": "One-time investment of <strong>£399.99</strong>" }
