<style>
  #shopify-section-{{ section.id }} {
    --comparison-bg: {{ section.settings.background }};
    --comparison-text: {{ section.settings.text_color }};
    --comparison-accent: {{ section.settings.accent_color }};
    --comparison-border: {{ section.settings.border_color }};
    --comparison-padding-top: {{ section.settings.padding_top }}px;
    --comparison-padding-bottom: {{ section.settings.padding_bottom }}px;
    --comparison-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --comparison-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .method-comparison {
    width: 100%;
    overflow: hidden;
    padding-top: var(--comparison-padding-top);
    padding-bottom: var(--comparison-padding-bottom);
    color: var(--comparison-text);
    background: var(--comparison-bg);
  }


  .method-comparison__title {
    margin: 0 0 48px;
    color: var(--comparison-text);
    font-family: var(--heading-font-family);
    font-size: 48px;
    font-weight: 400;
    line-height: 124.583%;
    text-align: center;
  }

  .method-comparison__scroll {
    width: 100%;
  }

  .method-comparison__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .method-comparison__item {
    min-width: 0;
  }

  .method-comparison__media {
    position: relative;
    width: 100%;
    aspect-ratio: 2.48 / 1;
    overflow: hidden;
    background: #eee;
    border-radius: 8px;
  }

  .method-comparison__image,
  .method-comparison__media > svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .method-comparison__name {
    margin: 17px 4px 15px;
    color: var(--comparison-text);
    font-size: 28px;
    font-weight: 400;
    line-height: 1;
        font-family: var(--heading-font-family);
  }

  .method-comparison__list {
    margin: 0;
    padding: 26px 0 20px;
    border-top: 1px solid var(--comparison-border);
  }

  .method-comparison__row {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 42px;
    padding: 0 4px;
  }

  .method-comparison__icon {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
  }

  .method-comparison__item--positive .method-comparison__icon::before {
    position: absolute;
    top: 1px;
    left: 4px;
    width: 6px;
    height: 11px;
    border-right: 1.5px solid var(--comparison-accent);
    border-bottom: 1.5px solid var(--comparison-accent);
    content: '';
    transform: rotate(45deg);
  }

  .method-comparison__item--negative .method-comparison__icon::before,
  .method-comparison__item--negative .method-comparison__icon::after {
    position: absolute;
    top: 7px;
    left: 1px;
    width: 15px;
    height: 1.5px;
    background: var(--comparison-text);
    content: '';
  }

  .method-comparison__item--negative .method-comparison__icon::before {
    transform: rotate(45deg);
  }

  .method-comparison__item--negative .method-comparison__icon::after {
    transform: rotate(-45deg);
  }

  .method-comparison__row-text {
    color: var(--comparison-text);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.35;
  }

  .method-comparison__row-text strong {
    font-style: normal;
    font-weight: 400;
       font-family: var(--heading-font-family);
  }

  .method-comparison__item--positive .method-comparison__row-text strong {
    color: var(--comparison-accent);
  }

  .method-comparison__footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 24px;
    border-top: 1px solid var(--comparison-border);
  }

  .method-comparison__footer-text {
    color: var(--comparison-text);
    font-size: 18px;
    line-height: normal;
  }

  .method-comparison__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--comparison-text);
    font-size: 14px;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .method-comparison__link-label {
    padding-bottom: 3px;
    border-bottom: 1px solid currentColor;
  }

  .method-comparison__link svg {
    display: block;
    width: 16px;
    height: auto;
    transition: transform 0.3s ease;
  }

  .method-comparison__link:hover svg {
    transform: translateX(4px);
  }

  @media screen and (max-width: 1023px) {

    .method-comparison__title {
      font-size: 36px;
    }

    .method-comparison__name {
      font-size: 21px;
    }

    .method-comparison__row-text {
      font-size: 15px;
    }
  }

  @media screen and (max-width: 767px) {
    .method-comparison {
      padding-top: var(--comparison-mobile-padding-top);
      padding-bottom: var(--comparison-mobile-padding-bottom);
    }


    .method-comparison__title {
      margin: 0 16px 27px;
      font-size: 24px;
      line-height: 1;
      white-space: nowrap;
    }

    .method-comparison__scroll {
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 0 16px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
    }

    .method-comparison__scroll::-webkit-scrollbar {
      display: none;
    }

    .method-comparison__grid {
      display: flex;
      gap: 11px;
      width: max-content;
    }

    .method-comparison__item {
      flex: 0 0 230px;
      width: 230px;
      scroll-snap-align: start;
    }

    .method-comparison__media {
      width: 230px;
      aspect-ratio: 230 / 200;
      border-radius: 4px;
    }

    .method-comparison__name {
      margin: 16px 0 10px;
      font-size: 14px;
      line-height: 1.2;
    }

    .method-comparison__list {
      padding: 10px 0 8px;
    }

    .method-comparison__row {
      gap: 10px;
      min-height: 34px;
      padding: 0;
    }

    .method-comparison__icon {
      width: 12px;
      height: 12px;
    }

    .method-comparison__item--positive .method-comparison__icon::before {
      top: 0;
      left: 3px;
      width: 5px;
      height: 9px;
      border-width: 1px;
    }

    .method-comparison__item--negative .method-comparison__icon::before,
    .method-comparison__item--negative .method-comparison__icon::after {
      top: 5px;
      width: 12px;
      height: 1px;
    }

    .method-comparison__row-text {
      font-size: 12px;
      line-height: 1.25;
      white-space: nowrap;
    }

    .method-comparison__footer {
      gap: 8px;
      margin: 0;
      padding-top: 15px;
    }

    .method-comparison__footer-text {
      font-size: 12px;
      white-space: nowrap;
    }

    .method-comparison__link {
      gap: 5px;
      font-size: 12px;
      white-space: nowrap;
    }

    .method-comparison__link svg {
      width: 14px;
    }
    .method-comparison .container{
    }
  }
</style>

<section class="method-comparison">
  <div class="method-comparison__container container js-scroll__group">

    {% if section.settings.title != blank %}
      <h2 class="method-comparison__title js-scroll__header">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <div class="method-comparison__scroll">
      <div class="method-comparison__grid">

        {% for block in section.blocks %}
          <div class="method-comparison__item method-comparison__item--{{ block.settings.type }} js-scroll__card" style="--reveal-index: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            <div class="method-comparison__media">
              {% if block.settings.image != blank %}
                <img
                  class="method-comparison__image"
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 460 }} 460w,
                    {{ block.settings.image | image_url: width: 800 }} 800w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(max-width: 767px) 230px, 50vw"
                  alt="{{ block.settings.title | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'method-comparison__image' }}
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <h3 class="method-comparison__name">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            <div class="method-comparison__list">
              {% for i in (1..4) %}
                {% assign key = 'text_' | append: i %}
                {% assign text = block.settings[key] %}

                {% if text != blank %}
                  <div class="method-comparison__row">
                    <span
                      class="method-comparison__icon"
                      aria-hidden="true"
                    ></span>

                    <div class="method-comparison__row-text">
                      {{ text }}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}

      </div>
    </div>

    {% if section.settings.footer_text != blank or section.settings.link_text != blank %}
      <div class="method-comparison__footer">
        {% if section.settings.footer_text != blank %}
          <span class="method-comparison__footer-text">
            {{ section.settings.footer_text }}
          </span>
        {% endif %}

        {% if section.settings.link_text != blank %}
          <a
            class="method-comparison__link"
            href="{{ section.settings.link }}"
          >
            <span class="method-comparison__link-label">
              {{ section.settings.link_text }}
            </span>

            <svg
              viewBox="0 0 18 12"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 1L17 6M17 6L12 11M17 6H1"
                stroke="currentColor"
                stroke-width="1"
              />
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Method Comparison",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Air 10 vs. Long-term options"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "Compare More Hair Removal Methods."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#403A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF1D5D"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#D8D8D8"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 92
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 58
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "comparison",
      "name": "Comparison Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ulike IPL"
        },
        {
          "type": "select",
          "id": "type",
          "label": "Icon Type",
          "options": [
            {
              "value": "positive",
              "label": "Check"
            },
            {
              "value": "negative",
              "label": "Cross"
            }
          ],
          "default": "positive"
        },
        {
          "type": "inline_richtext",
          "id": "text_1",
          "label": "Text 1",
          "default": "Long-lasting hair reduction"
        },
        {
          "type": "inline_richtext",
          "id": "text_2",
          "label": "Text 2",
          "default": "Comfortable 10-minute sessions"
        },
        {
          "type": "inline_richtext",
          "id": "text_3",
          "label": "Text 3",
          "default": "Convenient at-home use"
        },
        {
          "type": "inline_richtext",
          "id": "text_4",
          "label": "Text 4",
          "default": "One-time investment of <strong>£399.99</strong>"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Method Comparison",
      "blocks": [
        {
          "type": "comparison",
          "settings": {
            "title": "Ulike IPL",
            "type": "positive",
            "text_1": "Long-lasting hair reduction",
            "text_2": "Comfortable 10-minute sessions",
            "text_3": "Convenient at-home use",
            "text_4": "One-time investment of <strong>£399.99</strong>"
          }
        },
        {
          "type": "comparison",
          "settings": {
            "title": "Salon",
            "type": "negative",
            "text_1": "Require 1–2 years of regular treatments",
            "text_2": "Longer treatment sessions",
            "text_3": "Repeated salon visits required",
            "text_4": "Higher long-term costs (around £XXX)"
          }
        }
      ]
    }
  ]
}
{% endschema %}