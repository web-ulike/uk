                      <path d="m4 24 12 3h13M17 12l17 6M22 11l15 6" />
                    </svg>
                  </span>

                  <span class="me-modes__icon">
                    <svg viewBox="0 0 40 36">
                      <path d="M29 3q5 7 1 13l-1 5q0 4-7 4l-3 8" />
                      <path d="M8 10q-2 10 1 14l-2 9M9 23l13 2" />
