
<style>
  .swiper-wrapper {
    height: auto;
  }
  .product-area-box {
    position: relative;
    z-index: 1;
    padding: 50px 0;
    background: #fff;
  }

  .product-area-box .product-blog-cont{
    overflow: hidden;
  }

  .hide-cbl .product-blog-cont{
    max-width:1180px;
    margin:0 auto;
  }

  .product-area-box .product-blog-det{
    max-width: calc(100% - 337px);
  }

  .hide-cbl .product-blog-det{
    max-width: none;
  }

  .product-area-box .product-blog-top{
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }

  .product-area-box .product-blog-arraws{
    display: flex;
    gap: 60px;
  }

  .product-area-box .product-blog-arraw{
    cursor: pointer;
    width: 40px;
  }

  .product-area-box .swiper-button-disabled{
    opacity: .5;
  }

  .product-area-box .product-blog-arraws svg{
    width: 100%;
    height: auto;
    display: block;
  }

  .product-area-box .product-area-new-h3 {
    color: #000;
    font-size: 30px;
    font-weight: normal;
    font-family: var(--heading-font-family);
    line-height: 1.5;
    margin: 0;
  }

  .product-area-box .product-area-swiper {
    padding: 24px 0;
  }

  .product-area-box .product-area-list {
    display: flex;
    {% comment %} gap: 20px; {% endcomment %}
  }

  .product-area-box .product-area-item {
    position: relative;
    overflow: hidden;
    {% comment %} flex: 1; {% endcomment %}
     width:calc(33.333% - 23.5px);
    z-index: 1;
  }

  .product-area-box .product-area-tag {
    position: absolute;
    background: #e7004c;
    font-size: 12px;
    font-family: var(--heading-font-family);
    color: #fff;
    top: 15px;
    left: 15px;
    z-index: 3;
    padding: 8px 20px;
    line-height: 1;
    overflow: hidden;
  }

  .product-area-box .product-area-tag::before {
    position: absolute;
    content: '';
    display: block;
    width: 200%;
    height: 200%;
    z-index: 2;
    background: linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0) 40%,
      rgba(255, 255, 255, 0.5) 50%,
      rgba(255, 255, 255, 0) 60%
    );
    animation: scanning 3s linear infinite;
  }
  @keyframes scanning {
    0% {
      transform: translate(-100%, -100%);
    }
    100% {
      transform: translate(100%, 100%);
    }
  }

  .product-area-box .product-area-img-list {
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .product-area-box .product-area-img-item {
    width: 100%;
    overflow: hidden;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    display: none;
  }
  .product-area-box .product-area-img-item.active {
    position: relative;
    display: block;
  }
  .product-area-box .product-area-img-item.close {
    z-index: 3;
    transition: width 0.6s ease;
    width: 0%;
    height: 100%;
    display: block;
  }
  .product-area-box .product-area-img-item.close .img {
    width: auto;
    max-width: none;
    height: 100%;
  }
  .product-area-box .product-area-item .img {
    display: block;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .product-area-box .product-area-item .h-show {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .product-area-box .product-area-item .h-hide {
    transition: opacity 0.4s ease;
  }

  @media (min-width: 991px) {
    .product-area-box .product-area-img-item:hover .h-hide {
      opacity: 0;
    }

    .product-area-box .product-area-img-item:hover .h-show {
      opacity: 1;
    }
    .product-area-box .product-area-btn-item:hover {
      background: #3f3636;
    }
  }

  .product-area-box .product-area-cont {
    background: #f8f8f8;
    padding: 32px 24px 24px;
    position: relative;
  }

  .product-area-box .product-area-dot {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    gap: 12px;
  }

  .product-area-box .product-area-dot-item {
    position: relative;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    background: linear-gradient(to bottom, #fff 80%, rgba(0, 0, 0, 0.1) 100%);
    box-shadow: inset 0px 0px 2px 1px rgba(0, 0, 0, 0.05), inset 0px 0px 2px 1px rgba(255, 255, 255, 0.05);
  }

  .product-area-box .product-area-dot-item::after {
    border-radius: inherit;
    box-shadow: inset 0 1px 1px rgb(0 0 0 / 10%);
    content: '';
    display: block;
    height: inherit;
    position: absolute;
    width: inherit;
  }

  .product-area-box .product-area-dot-item::before {
    position: absolute;
    content: '';
    display: block;
    width: 120%;
    height: 120%;
    border-radius: 50%;
    border: 1px solid #d9d9d9;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .product-area-box .product-area-dot-item.active::before {
    border-color: #000;
  }

  .product-area-box .product-area-cont-top {
    position: relative;
  }

  .product-area-box .product-area-h3 {
    font-size: 39px;
    font-family: var(--heading-font-family);
    color: #181a1d;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.5px;
    font-weight: normal;
  }

  .product-area-box .product-area-p {
    color: #181a1d;
    font-size: 12px;
    line-height: 1.7;
    margin-top: 12px;
  }

  .product-area-box .product-area-star {
    position: absolute;
    right: 0;
    top: 0px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #190a0a;
    font-size: 14px;
    line-height: 1;
    font-family: var(--heading-font-family);
    cursor: pointer;
  }

  .product-area-box .product-area-star p {
    margin: 0;
  }
  .product-area-box .product-area-star strong {
    font-weight: normal;
    text-decoration: underline;
  }

  .product-area-box .product-area-btn {
    display: flex;
    justify-content: center;
    margin-top: 24px;
    overflow: hidden;
  }

  .product-area-box .product-area-btn-item {
    background: #000;
    flex: 1;
    color: #fff;
    font-size: 16px;
    height: 48px;
    line-height: 1;
    border-radius: 2px;
    font-family: var(--heading-font-family);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: all 0.4s ease;
  }
  .product-area-box .product-area-btn-item p {
    margin: 0;
  }
  .product-area-box .product-area-btn-item p strong {
    font-weight: normal;
    margin-left: 20px;
  }

  .product-area-box .product-area-msg {
    color: #65666a;
    text-align: center;
    font-size: 12px;
    line-height: 1.6;
    margin-top: 16px;
  }

  .product-area-box .product-area-pagination {
    display: none;
  }

  @media (max-width: 1400px) {
    .product-area-box .product-area-h3 {
      font-size: 26px;
    }
    .product-area-box .product-area-p {
      font-size: 16px;
    }
    .product-area-box .product-area-price {
      font-size: 20px;
    }
    .product-area-box .product-area-btn-item {
      height: 55px;
    }
  }

  @media (max-width: 991px) {
    .product-area-box {
      padding-bottom: 60px;
      overflow: hidden;
    }

    .product-area-box .product-blog-det{
      max-width: none;
    }

    .product-area-box .product-area-item {
      flex: auto;
      width: 321px;
      flex-shrink: 0;
      {% comment %} min-width: 313px; {% endcomment %}
    }

    .product-area-box .product-area-swiper {
      padding-bottom: 48px;
    }

    .product-area-box .product-area-cont {
      padding: 32px 12px 12px;
    }

    .product-area-box .product-blog-arraws{
        display:none;
    }

    .product-area-box .product-area-h3 {
      font-size: 25px;
    }
    .product-area-box .product-area-p {
      font-size: 13px;
      line-height: 1.5;
      margin-top: 16px !important;
    }

    .product-area-box .product-area-star {
      font-size: 12px;
      gap: 8px;
      top: 10px;
    }

    .product-area-box .product-area-star .star {
      width: 63px;
    }

    .product-area-box .product-area-btn-item {
      height: 44px;
      font-size: 14px;
    }

    .product-area-box .product-area-dot {
      gap: 13px;
    }

    .product-area-box .product-area-dot-item::before {
      width: 130%;
      height: 130%;
    }

    .product-area-box .product-area-dot-item {
      width: 18px;
      height: 18px;
    }

    .product-area-box .product-area-dot-item.active {
      width: 20px;
      height: 20px;
    }

    .product-area-box .product-area-tag {
      font-size: 12px;
      padding: 5px 12px;
    }
    .product-area-box .product-area-msg {
      line-height: 1.5;
      margin-top: 10px;
    }

    .product-area-box .product-area-pagination {
      display: block;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      bottom: 80px;
      top: auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .product-area-box .swiper-pagination-bullet {
      background: #cdc6c7;
      display: block;
      opacity: 1;
    }

    .product-area-box .swiper-pagination-bullet-active {
      background: #190a0a;
    }

    .product-area-box .product-area-btn-item p strong {
      margin-left: 8px;
    }
  }
</style>
<section class="section-box">
  <div class="product-area-box {% if section.settings.show_cb %}hide-cbl{% endif %}">
    {%- assign color_swatch_config = settings.color_swatch_config | newline_to_br | split: '<br />' -%}
    <div class="container">
        <div class="product-blog-cont">
            <div class="product-blog-det">
                <div class="product-blog-top">
                    {%- if section.settings.title != blank -%}
                        <h3 class="product-area-new-h3">{{ section.settings.title }}</h3>
                    {%- endif -%}
                    <div class="product-blog-arraws">
                        <div class="product-blog-arraw product-blog-arraw-left">
                            <svg xmlns="http://www.w3.org/2000/svg" width="41" height="41" viewBox="0 0 41 41" fill="none">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M24.1003 33.8243L24.6054 34.3293L25.6155 33.3192L25.1104 32.8141L20.4992 28.2029L16.1526 23.8563C15.5947 23.2984 14.6902 23.2984 14.1323 23.8563L19.4891 29.213L24.1003 33.8243ZM11.6003 20.3141C11.3213 20.5931 11.3213 21.0453 11.6003 21.3243C11.6942 21.4182 11.8078 21.4805 11.9278 21.5112L11.9278 21.5335L12.1038 21.5335L12.1069 21.5335L12.6421 21.5335L19.9639 21.5335L27.2857 21.5335L29.0715 21.5335C29.8605 21.5335 30.5001 20.8939 30.5001 20.1049L27.2857 20.1049L13.8298 20.1049L25.1104 8.82427L25.6155 8.3192L24.6054 7.30904L24.1003 7.81412L11.6003 20.3141Z" fill="#190A0A"/>
                                <circle cx="20.5" cy="20.7578" r="19.2857" transform="rotate(-180 20.5 20.7578)" stroke="#190A0A" stroke-width="1.42857"/>
                            </svg>
                        </div>
                        <div class="product-blog-arraw product-blog-arraw-right">
                            <svg xmlns="http://www.w3.org/2000/svg" width="41" height="41" viewBox="0 0 41 41" fill="none">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M16.8997 7.69136L16.3946 7.18628L15.3845 8.19643L15.8896 8.70151L20.5008 13.3127L24.8474 17.6593C25.4053 18.2172 26.3098 18.2172 26.8677 17.6593L21.511 12.3026L16.8997 7.69136ZM29.3997 21.2015C29.6787 20.9226 29.6787 20.4703 29.3997 20.1914C29.3058 20.0974 29.1922 20.0351 29.0722 20.0045V19.9821H28.8962H28.8931H28.3579H21.0361H13.7143H11.9285C11.1395 19.9821 10.4999 20.6217 10.4999 21.4107H13.7143H27.1702L15.8896 32.6914L15.3845 33.1964L16.3946 34.2066L16.8997 33.7015L29.3997 21.2015Z" fill="#190A0A"/>
                                <circle cx="20.5" cy="20.7578" r="19.2857" stroke="#190A0A" stroke-width="1.42857"/>
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="product-area-swiper">
                    <div class="product-area-list swiper-wrapper">
                    {%- for block in section.blocks -%}
                        {%- liquid
                        assign se_stts = block.settings
                        if se_stts.product != blank
                            assign product = se_stts.product
                        endif
                        -%}
                        <div class="product-area-item product-area-mp swiper-slide">
                        {%- if block.settings.tag != blank -%}
                            <div class="product-area-tag">{{ block.settings.tag }}</div>
                        {%- endif -%}
                        <div class="product-area-img-list">
                            {%- if block.settings.image != blank -%}
                            <div class="product-area-img-item active">
                                <img
                                loading="lazy"
                                class="img {% if block.settings.image_1 != blank %}h-hide{% endif %}"
                                width="{{ block.settings.image.width }}"
                                height="{{ block.settings.image.height }}"
                                {% render 'image-attributes', image: block.settings.image %}
                                alt="{{ block.settings.image.alt | escape }}"
                                >
                                {%- if block.settings.image_1 != blank -%}
                                <img
                                    loading="lazy"
                                    class="img h-show"
                                    width="{{ block.settings.image_1.width }}"
                                    height="{{ block.settings.image_1.height }}"
                                    {% render 'image-attributes', image: block.settings.image_1 %}
                                    alt="{{ block.settings.image_1.alt | escape }}"
                                >
                                {%- endif -%}
                            </div>
                            {%- endif -%}
                            {%- if block.settings.image1 != blank -%}
                            <div class="product-area-img-item">
                                <img
                                loading="lazy"
                                class="img {% if block.settings.image1_1 != blank %}h-hide{% endif %}"
                                width="{{ block.settings.image1.width }}"
                                height="{{ block.settings.image1.height }}"
                                {% render 'image-attributes', image: block.settings.image1 %}
                                alt="{{ block.settings.image1.alt | escape }}"
                                >
                                {%- if block.settings.image1_1 != blank -%}
                                <img
                                    loading="lazy"
                                    class="img h-show"
                                    width="{{ block.settings.image1_1.width }}"
                                    height="{{ block.settings.image1_1.height }}"
                                    {% render 'image-attributes', image: block.settings.image1_1 %}
                                    alt="{{ block.settings.image1_1.alt | escape }}"
                                >
                                {%- endif -%}
                            </div>
                            {%- endif -%}
                            {%- if block.settings.image2 != blank -%}
                            <div class="product-area-img-item">
                                <img
                                loading="lazy"
                                class="img {% if block.settings.image2_1 != blank %}h-hide{% endif %}"
                                width="{{ block.settings.image2.width }}"
                                height="{{ block.settings.image2.height }}"
                                {% render 'image-attributes', image: block.settings.image2 %}
                                alt="{{ block.settings.image2.alt | escape }}"
                                >
                                {%- if block.settings.image2_1 != blank -%}
                                <img
                                    loading="lazy"
                                    class="img h-show"
                                    width="{{ block.settings.image2_1.width }}"
                                    height="{{ block.settings.image2_1.height }}"
                                    {% render 'image-attributes', image: block.settings.image2_1 %}
                                    alt="{{ block.settings.image2_1.alt | escape }}"
                                >
                                {%- endif -%}
                            </div>
                            {%- endif -%}
                        </div>
                        <div class="product-area-cont">
                            <div class="product-area-cont-top">
                            {%- if block.settings.title != blank -%}
                                <h3 class="product-area-h3">
                                {{ block.settings.title }}
                                </h3>
                            {%- endif -%}
                            {%- if block.settings.content != blank -%}
                                <div class="product-area-p">
                                {{ block.settings.content }}
                                </div>
                            {%- endif -%}
                            {%- if settings.settings.show_color -%}
                                <div class="product-area-dot">
                                    {%- if block.settings.color != blank -%}
                                    <div
                                        class="product-area-dot-item active"
                                        style="{% render 'color-swatch-style', color_swatch_config: color_swatch_config, value: block.settings.color %};background-size: 100% 100%;"
                                    ></div>
                                    {%- endif -%}
                                    {%- if block.settings.color1 != blank -%}
                                    <div
                                        class="product-area-dot-item"
                                        style="{% render 'color-swatch-style', color_swatch_config: color_swatch_config, value: block.settings.color1 %};background-size: 100% 100%;"
                                    ></div>
                                    {%- endif -%}
                                    {%- if block.settings.color2 != blank -%}
                                    <div
                                        class="product-area-dot-item"
                                        style="{% render 'color-swatch-style', color_swatch_config: color_swatch_config, value: block.settings.color2 %};background-size: 100% 100%;"
                                    ></div>
                                    {%- endif -%}
                                </div>
                            {%- endif -%}
                            </div>
                            {%- if block.settings.btn_txt != blank -%}
                            <div class="product-area-btn-box">
                                <div class="product-area-btn">
                                <a
                                    href="{{ block.settings.link }}"
                                    title="{{ block.settings.title }}"
                                    aria-label="{{ block.settings.title }}"
                                    class="product-area-btn-item"
                                >
                                    {{ block.settings.btn_txt }}
                                    {% if product.selected_or_first_available_variant.metafields.custom.page_price != blank %}
                                        {{
                                        product.selected_or_first_available_variant.metafields.custom.page_price
                                        | times: 100
                                        | money
                                        }}
                                    {% else %}
                                        {{ product.selected_or_first_available_variant.price | money }}
                                   {% endif %}
                                    {% comment %} {{ product.selected_or_first_available_variant.price | money }} {% endcomment %}
                                </a>
                                </div>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.msg_txt != blank -%}
                            <div class="product-area-msg">{{ block.settings.msg_txt }}</div>
                            {%- endif -%}
                        </div>
                        </div>
                    {%- endfor -%}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="product-area-pagination"></div>
  </div>
</section>
<script>
  window.addEventListener('DOMContentLoaded', function() {
    let swiper{{ section.id | replace: "template--", "" | replace: "__", ""  }} = new Swiper(".product-area-swiper", {
      slidesPerView: "auto",
      spaceBetween: 16,
      navigation: {
        nextEl: ".product-blog-arraw-right",
        prevEl: ".product-blog-arraw-left",
      },
      pagination: {
        el: ".product-area-pagination",
        clickable: true,
      },
      breakpoints: {
        991: {
          spaceBetween: 32,
        },
      }
    });
  })
{%- if settings.settings.show_color -%}
  window.addEventListener('load', function () {
    $('html').on('click', '.product-area-box .product-area-dot-item', function () {
      let $this = $(this)
      let index = $this.index()
      if ($this.hasClass('active')) return
      $this.closest('.product-area-item').find('.product-area-img-item.close').removeClass('close')
      $this.addClass('active').siblings().removeClass('active')
      $this.closest('.product-area-item').find('.product-area-img-item.active').removeClass('active').addClass('close')
      $this.closest('.product-area-item').find('.product-area-img-item').eq(index).addClass('active')
      setTimeout(() => {
        $this.closest('.product-area-item').find('.product-area-img-item.close').removeClass('close')
      }, 600)
    })
  });
{%- endif -%}
</script>
{% schema %}
{
  "name": "product-blog",
  "blocks": [
    {
      "name": "item",
      "type": "item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "产品选择"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Hover Image"
        },
        {
          "type": "text",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "image_picker",
          "id": "image1",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image1_1",
          "label": "Hover Image"
        },
        {
          "type": "text",
          "id": "color1",
          "label": "Color"
        },
        {
          "type": "image_picker",
          "id": "image2",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image2_1",
          "label": "Hover Image"
        },
        {
          "type": "text",
          "id": "color2",
          "label": "Color"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ulike Air 10"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Heading",
          "default": "<p>Visible results in 3 weeks Full body treatments in 12 minutes</p>"
        },
        {
          "type": "text",
          "id": "btn_txt",
          "label": "Button text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "msg_txt",
          "label": "Text"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cb",
      "label": "关闭侧边栏",
      "default": false
    },
    {
