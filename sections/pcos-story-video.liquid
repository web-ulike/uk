  @media (max-width: 374px) {
    #shopify-section-{{ section.id }} .pcos-story-video {
      padding-left: 16px;
      padding-right: 16px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__list {
      width: calc(100% + 32px);
      margin-left: -16px;
      padding-left: 16px;
      padding-right: 16px;
      scroll-padding-left: 16px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__person {
      flex-basis: 188px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__controls {
      width: calc(100% - 40px);
      min-width: 0;
      column-gap: 8px;
      padding-left: 12px;
      padding-right: 12px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__community {
      padding-left: 22px;
      padding-right: 18px;
    }
  }
</style>

{%- assign first_story_block = section.blocks.first -%}
{%- assign default_video_url = section.settings.video_url -%}
{%- assign default_poster_image = section.settings.image -%}
{%- if default_video_url == blank and first_story_block != blank -%}
  {%- assign default_video_url = first_story_block.settings.video_url -%}
{%- endif -%}
{%- if default_poster_image == blank and first_story_block != blank -%}
  {%- assign default_poster_image = first_story_block.settings.image -%}
{%- endif -%}
<section class="pcos-story-video">
  <div class="pcos-story-video__inner container">
    {%- if section.settings.title != blank -%}
      <h2 class="pcos-story-video__title to-top">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <div class="pcos-story-video__subtitle to-top">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    <div class="pcos-story-video__panel">
      <div class="pcos-story-video__side">
        <div class="pcos-story-video__side-title to-top" >Experts &amp; Stories</div>
        <div class="pcos-story-video__list">
          {%- for block in section.blocks -%}
            <button
              class="pcos-story-video__person{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-pcos-story-trigger
              data-index="{{ forloop.index0 }}"
              data-title="{{ block.settings.video_title | default: section.settings.video_title | escape }}"
              data-caption-title="{{ block.settings.caption_title | default: section.settings.caption_title | escape }}"
              data-caption="{{ block.settings.caption | default: section.settings.caption | escape }}"
              data-tag="{{ block.settings.tag_text | default: section.settings.tag_text | escape }}"
              data-video="{{ block.settings.video_url | default: section.settings.video_url | escape }}"
              data-poster="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 }}{% elsif forloop.first and section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 }}{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 140 | image_tag: class: 'pcos-story-video__avatar', loading: 'lazy' }}
              {%- endif -%}
              <div>
                <div class="pcos-story-video__name to-top" style="transition-delay: 0.{{ forloop.index }}s">{{ block.settings.name }}</div>
                {%- if block.settings.role != blank -%}
                  <div class="pcos-story-video__role to-top" style="transition-delay: 0.{{ forloop.index }}s">{{ block.settings.role }}</div>
                {%- endif -%}
                <div class="pcos-story-video__meta to-top" style="transition-delay: 0.{{ forloop.index }}s">{{ block.settings.meta }}</div>
              </div>
              <span class="pcos-story-video__person-icon" aria-hidden="true">
                <svg class="pcos-story-video__person-icon-play" xmlns="http://www.w3.org/2000/svg" width="37" height="36" viewBox="0 0 37 36" fill="none">
                  <path d="M18.1504 35.4551C28.0915 35.4551 36.1504 27.6201 36.1504 17.9551C36.1504 8.29009 28.0915 0.455078 18.1504 0.455078C8.20926 0.455078 0.150391 8.29009 0.150391 17.9551C0.150391 27.6201 8.20926 35.4551 18.1504 35.4551Z" fill="#D9D9D9"/>
                  <path d="M14.3057 12.5377C14.3057 11.7642 15.1678 11.3028 15.8114 11.7318L22.1719 15.9722L23.1681 16.6363L24.2932 17.3864C24.6455 17.6212 24.6455 18.1388 24.2932 18.3736L15.8114 24.0282C15.1678 24.4573 14.3057 23.9959 14.3057 23.2224V12.5377Z" fill="white"/>
                </svg>
                <svg class="pcos-story-video__person-icon-pause" xmlns="http://www.w3.org/2000/svg" width="36" height="37" viewBox="0 0 36 37" fill="none">
                  <path d="M18 35.88C27.9411 35.88 36 27.848 36 17.94C36 8.03201 27.9411 0 18 0C8.05887 0 0 8.03201 0 17.94C0 27.848 8.05887 35.88 18 35.88Z" fill="#0DA3AC"/>
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M20.2985 25.4839L20.2985 11.0488C21.153 11.0488 21.8457 11.7415 21.8457 12.596L21.8457 25.4839L20.2985 25.4839Z" fill="white"/>
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M13.9021 25.4839L13.9021 11.0488C14.7565 11.0488 15.4492 11.7415 15.4492 12.596L15.4492 25.4839L13.9021 25.4839Z" fill="white"/>
                </svg>
              </span>
            </button>
          {%- endfor -%}
        </div>
      </div>
      <div class="pcos-story-video__content">
        <div class="pcos-story-video__media-title to-top" data-pcos-story-title>{{ section.settings.video_title }}</div>
        <div class="pcos-story-video__media" data-pcos-story-media>
          {%- if default_video_url != blank -%}
            <video data-pcos-story-video playsinline preload="metadata" poster="{% if default_poster_image != blank %}{{ default_poster_image | image_url: width: 1200 }}{% endif %}">
              <source src="{{ default_video_url | escape }}">
            </video>
            <button class="pcos-story-video__big-play" type="button" aria-label="Play video" data-pcos-story-big-play></button>
            <div class="pcos-story-video__controls" data-pcos-story-controls>
              <button class="pcos-story-video__control-btn pcos-story-video__control-btn--play" type="button" aria-label="Play video" aria-pressed="false" data-pcos-story-play>
                <svg class="pcos-story-video__play-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1.53688 5.97801C0.871153 5.55437 0 6.03258 0 6.82167V17.1783C0 17.9674 0.87115 18.4456 1.53688 18.022L9.67424 12.8437C10.2917 12.4507 10.2917 11.5493 9.67425 11.1563L1.53688 5.97801Z" fill="currentColor"/>
                </svg>
                <svg class="pcos-story-video__pause-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  <rect x="4" y="5" width="4" height="14" rx="1" fill="currentColor"/>
                  <rect x="13" y="5" width="4" height="14" rx="1" fill="currentColor"/>
                </svg>
              </button>
              <span class="pcos-story-video__time" data-pcos-story-time>0:00 / 0:00</span>
              <button class="pcos-story-video__control-btn pcos-story-video__control-btn--mute" type="button" aria-label="Mute video" data-pcos-story-mute>
                <svg viewBox="0 0 21 21" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2.50781 7.52478V12.5412H5.85207L10.0324 16.7215V3.34445L5.85207 7.52478H2.50781ZM13.7947 10.033C13.7947 8.55314 12.9419 7.28232 11.7045 6.66363V13.394C12.9419 12.7836 13.7947 11.5128 13.7947 10.033ZM11.7045 2.70068V4.42298C14.1208 5.142 15.8849 7.38265 15.8849 10.033C15.8849 12.6833 14.1208 14.924 11.7045 15.643V17.3653C15.0572 16.6045 17.557 13.6113 17.557 10.033C17.557 6.45462 15.0572 3.4615 11.7045 2.70068Z" fill="currentColor"/>
                </svg>
              </button>
              <button class="pcos-story-video__control-btn pcos-story-video__control-btn--fullscreen" type="button" aria-label="Fullscreen video" data-pcos-story-fullscreen>
                <svg viewBox="0 0 21 21" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.85377 11.7048H4.18164V15.8851H8.36197V14.213H5.85377V11.7048ZM4.18164 8.3605H5.85377V5.85231H8.36197V4.18018H4.18164V8.3605ZM14.2144 14.213H11.7062V15.8851H15.8866V11.7048H14.2144V14.213ZM11.7062 4.18018V5.85231H14.2144V8.3605H15.8866V4.18018H11.7062Z" fill="currentColor"/>
                </svg>
              </button>
              <div class="pcos-story-video__progress" role="slider" aria-label="Video progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0" data-pcos-story-progress>
                <span class="pcos-story-video__progress-fill" data-pcos-story-progress-fill></span>
                <span class="pcos-story-video__progress-thumb" data-pcos-story-progress-thumb>
                  {%- if section.settings.tag_icon != blank -%}
                    {{ section.settings.tag_icon | image_url: width: 40 | image_tag: loading: 'lazy', class: 'pcos-story-video__progress-thumb-img' }}
                  {%- endif -%}
                </span>
              </div>
            </div>
          {%- elsif default_poster_image != blank -%}
            {{ default_poster_image | image_url: width: 1200 | image_tag: loading: 'lazy', data-pcos-story-image: '' }}
          {%- else -%}
            <div class="pcos-story-video__media-placeholder" data-pcos-story-placeholder>No video selected</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var triggers = section.querySelectorAll('[data-pcos-story-trigger]');
    var media = section.querySelector('[data-pcos-story-media]');
    var video = section.querySelector('[data-pcos-story-video]');
    var title = section.querySelector('[data-pcos-story-title]');
    var captionTitle = section.querySelector('[data-pcos-story-caption-title]');
    var caption = section.querySelector('[data-pcos-story-caption]');
    var tag = section.querySelector('[data-pcos-story-tag]');
    var tagText = section.querySelector('[data-pcos-story-tag-text]');
    var bigPlay = section.querySelector('[data-pcos-story-big-play]');
    var playBtn = section.querySelector('[data-pcos-story-play]');
    var muteBtn = section.querySelector('[data-pcos-story-mute]');
    var fullscreenBtn = section.querySelector('[data-pcos-story-fullscreen]');
    var progress = section.querySelector('[data-pcos-story-progress]');
    var progressFill = section.querySelector('[data-pcos-story-progress-fill]');
    var progressThumb = section.querySelector('[data-pcos-story-progress-thumb]');
    var time = section.querySelector('[data-pcos-story-time]');
    var hideTimer;

    function formatTime(seconds) {
      if (!isFinite(seconds)) return '0:00';
      var minutes = Math.floor(seconds / 60);
      var secs = Math.floor(seconds % 60);
      return minutes + ':' + String(secs).padStart(2, '0');
    }

    function setActiveButton(activeButton) {
      triggers.forEach(function (button) {
        button.classList.toggle('is-active', button === activeButton);
        button.classList.remove('is-playing');
      });
      updatePlayingState();
    }

    function updateProgress() {
      if (!video || !progressFill || !progress || !time) return;
      var percent = video.duration ? (video.currentTime / video.duration) * 100 : 0;
      progressFill.style.width = percent + '%';
      if (progressThumb) progressThumb.style.left = percent + '%';
      progress.setAttribute('aria-valuenow', Math.round(percent));
      time.textContent = formatTime(video.currentTime) + ' / ' + formatTime(video.duration);
    }

    function updatePlayingState() {
      if (!media || !video) return;
      var isPlaying = !video.paused && !video.ended;
      media.classList.toggle('is-playing', isPlaying);
      triggers.forEach(function (button) {
        var shouldShowPause = button.classList.contains('is-active') && isPlaying;
        button.classList.toggle('is-playing', shouldShowPause);
      });
      if (playBtn) {
        playBtn.setAttribute('aria-label', isPlaying ? 'Pause video' : 'Play video');
        playBtn.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
      }
    }

    function updateMuteState() {
      if (!video || !muteBtn) return;
      var isMuted = video.muted || video.volume === 0;
      muteBtn.classList.toggle('is-muted', isMuted);
      muteBtn.setAttribute('aria-label', isMuted ? 'Unmute video' : 'Mute video');
      muteBtn.setAttribute('aria-pressed', isMuted ? 'true' : 'false');
    }

    function showControlsTemporarily() {
      if (!media) return;
      media.classList.add('is-control-visible');
      clearTimeout(hideTimer);
    }

    function hideControls() {
      if (!media) return;
      clearTimeout(hideTimer);
      media.classList.remove('is-control-visible');
    }

    function loadStory(button, shouldPlay) {
      if (!button) return;
      setActiveButton(button);
      if (title) title.textContent = button.dataset.title || '';
      if (captionTitle) captionTitle.textContent = button.dataset.captionTitle || '';
      if (caption) caption.innerHTML = button.dataset.caption || '';
      if (tagText) tagText.textContent = button.dataset.tag || '';

      if (video && button.dataset.video) {
        var wasMuted = video.muted;
        video.pause();
        video.innerHTML = '<source src="' + button.dataset.video + '">';
        if (button.dataset.poster) video.setAttribute('poster', button.dataset.poster);
        video.muted = wasMuted;
        video.load();
        updateMuteState();
        updatePlayingState();
        if (shouldPlay) {
          video.play().catch(function () {});
        }
        showControlsTemporarily();
      }
    }

    triggers.forEach(function (button) {
      button.addEventListener('click', function () {
        if (button.classList.contains('is-active')) {
          togglePlay();
          return;
        }

        var shouldContinuePlaying = video && !video.paused && !video.ended;
        loadStory(button, shouldContinuePlaying);
      });
    });

    function togglePlay() {
      if (!video) return;
      if (video.paused) {
        video.play().catch(function () {});
      } else {
        video.pause();
      }
      showControlsTemporarily();
    }

    if (bigPlay) bigPlay.addEventListener('click', togglePlay);
    if (playBtn) {
      playBtn.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        togglePlay();
      });
    }
    if (video) {
      video.addEventListener('click', togglePlay);
      video.addEventListener('play', updatePlayingState);
      video.addEventListener('pause', updatePlayingState);
      video.addEventListener('ended', updatePlayingState);
      video.addEventListener('timeupdate', updateProgress);
      video.addEventListener('loadedmetadata', function () {
        updateProgress();
        updatePlayingState();
      });
      updatePlayingState();
    }

    if (muteBtn && video) {
      updateMuteState();
      muteBtn.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        video.muted = !video.muted;
        updateMuteState();
        showControlsTemporarily();
      });
      video.addEventListener('volumechange', updateMuteState);
    }

    if (fullscreenBtn && media) {
      fullscreenBtn.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        if (document.fullscreenElement) {
          document.exitFullscreen();
        } else if (media.requestFullscreen) {
          media.requestFullscreen();
        }
        showControlsTemporarily();
      });
    }

    if (progress && video) {
      progress.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        var rect = progress.getBoundingClientRect();
        var percent = (event.clientX - rect.left) / rect.width;
        video.currentTime = Math.max(0, Math.min(percent, 1)) * (video.duration || 0);
        showControlsTemporarily();
      });
    }

    if (media) {
      media.addEventListener('mouseenter', showControlsTemporarily);
      media.addEventListener('mousemove', showControlsTemporarily);
      media.addEventListener('mouseleave', hideControls);
      media.addEventListener('touchstart', showControlsTemporarily, { passive: true });
      document.addEventListener('touchstart', function (event) {
        if (!media.contains(event.target)) {
          hideControls();
        }
      }, { passive: true });
    }
  })();
</script>

{% schema %}
{
  "name": "pcos-story-video",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Personal Journeys. Powerful Voices." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Four women share powerful, moving stories." },
    { "type": "text", "id": "video_title", "label": "Video title", "default": "Understanding PCOS" },
    { "type": "text", "id": "tag_text", "label": "Tag text", "default": "PCOS Education" },
    { "type": "image_picker", "id": "tag_icon", "label": "Tag icon" },
    { "type": "url", "id": "video_url", "label": "Video URL" },
    { "type": "image_picker", "id": "image", "label": "Fallback image" },
    { "type": "text", "id": "caption_title", "label": "Caption title", "default": "About this video" },
    { "type": "textarea", "id": "caption", "label": "Caption", "default": "A story of visibility, support, and shared confidence." },
    { "type": "text", "id": "community_text", "label": "Community text", "default": "Join our community" },
    { "type": "text", "id": "community_subtext", "label": "Community subtext", "default": "You are not alone" },
    { "type": "url", "id": "community_link", "label": "Community link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Mobile padding top", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Mobile padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "name", "label": "Name", "default": "Veronica" },
        { "type": "text", "id": "role", "label": "Role", "default": "Endocrinologist" },
        { "type": "text", "id": "meta", "label": "Meta", "default": "Her Story" },
        { "type": "text", "id": "video_title", "label": "Video title" },
        { "type": "url", "id": "video_url", "label": "Video URL" },
        { "type": "image_picker", "id": "image", "label": "Poster image" },
        { "type": "text", "id": "caption_title", "label": "Caption title" },
        { "type": "textarea", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "tag_text", "label": "Tag text" }
      ]
    }
  ],
  "presets": [
    { "name": "pcos-story-video" }
  ]
}
{% endschema %}
