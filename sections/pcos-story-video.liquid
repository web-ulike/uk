<style>
  #shopify-section-{{ section.id }} .pcos-story-video {
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .pcos-story-video__title {
    margin: 0 0 7px;
    color: #1A1A1A;
    font-size: 40px;
    line-height: 1.2;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__subtitle {
    max-width: 800px;
    margin: 0 0 50px;
    color: rgba(31, 31, 31, 0.62);
    font-size: 18px;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__panel {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    align-items: start;
    gap: 30px;
    width: 100%;
    padding: 30px 34px 30px 60px;
    border-radius: 10px;
    background: #f7f7f7;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__side-title,
  #shopify-section-{{ section.id }} .pcos-story-video__content-title {
    margin: 0 0 35px;
    color: #242424;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__content {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__side,
  #shopify-section-{{ section.id }} .pcos-story-video__content {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__list {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .pcos-story-video__list:has(> :nth-child(5)) {
      max-height: calc((130px * 4) + (16px * 3));
      overflow-y: auto;
      padding-right: 8px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__list:has(> :nth-child(5))::-webkit-scrollbar {
      width: 6px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__list:has(> :nth-child(5))::-webkit-scrollbar-track {
      background: rgba(13, 163, 172, 0.12);
      border-radius: 999px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__list:has(> :nth-child(5))::-webkit-scrollbar-thumb {
      background: #0DA3AC;
      border-radius: 999px;
    }
  }

  #shopify-section-{{ section.id }} .pcos-story-video__person {
    position: relative;
    display: grid;
    grid-template-columns: 107px minmax(0, 1fr) 40px;
    gap: 16px;
    min-height: 130px;
    padding: 12.5px 24px 12.5px 16px;
    border-radius: 16px;
    align-items: center;
    width: 100%;
    border: 1px solid transparent;
    background: #ffffff;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__person.is-active {
    border-radius: 16px;
    border: 0.993px solid #0DA3AC;
    background: #ECF6F7;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__person-icon {
    position: relative;
    display: block;
    width: 37px;
    height: 37px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__person-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__person-icon-pause {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__person.is-playing .pcos-story-video__person-icon-play {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__person.is-playing .pcos-story-video__person-icon-pause {
    display: block !important;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__avatar {
    width: 107px;
    height: 107px;
    object-fit: cover;
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__name {
    color: #1A1A1A;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__role {
    margin: 8px 0px;
    color: #20b8c2;
    font-size: 18px;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__meta {
    margin-top: 8px;
    color: #767676;
    font-size: 14px;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__media-title {
    margin: 0 0 35px;
    color: #242424;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__media {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #ddd;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__media video,
  #shopify-section-{{ section.id }} .pcos-story-video__media img {
    display: block;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__media-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #e5e5e5;
    color: rgba(31, 31, 31, 0.48);
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__big-play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.42);
    color: #ffffff;
    transform: translate(-50%, -50%);
    cursor: pointer;
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__big-play::before {
    content: '';
    margin-left: 4px;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-left: 15px solid currentColor;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__media.is-playing .pcos-story-video__big-play {
    opacity: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__controls {
    position: absolute;
    left: 50%;
    bottom: 24px;
    z-index: 3;
    display: grid;
    grid-template-columns: 24px auto minmax(0, 1fr) 21px 21px;
    grid-template-rows: 24px 4px;
    align-items: center;
    column-gap: 18px;
    row-gap: 16px;
    width: calc(100% - 108px);
    max-width: 600px;
    min-height: 82px;
    padding: 22px 38px 18px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 18px;
    background: rgba(18, 17, 13, 0.66);
    color: #ffffff;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  #shopify-section-{{ section.id }} .pcos-story-video__media:hover .pcos-story-video__controls,
  #shopify-section-{{ section.id }} .pcos-story-video__media.is-control-visible .pcos-story-video__controls,
  #shopify-section-{{ section.id }} .pcos-story-video__controls:focus-within {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  #shopify-section-{{ section.id }} .pcos-story-video__control-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: currentColor;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__control-btn svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__control-btn--play {
    grid-column: 1;
    grid-row: 1;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__control-btn--play .pcos-story-video__pause-icon {
    display: none;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__media.is-playing .pcos-story-video__control-btn--play .pcos-story-video__play-icon {
    display: none;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__media.is-playing .pcos-story-video__control-btn--play .pcos-story-video__pause-icon {
    display: block;
  }


  #shopify-section-{{ section.id }} .pcos-story-video__control-btn--mute {
    grid-column: 4;
    grid-row: 1;
    width: 21px;
    height: 21px;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__control-btn--mute::after {
    content: '';
    position: absolute;
    left: 2px;
    top: 50%;
    width: 18px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0;
    transform: rotate(-45deg) translateY(-50%);
    transform-origin: center;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__control-btn--mute.is-muted::after {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__control-btn--fullscreen {
    grid-column: 5;
    grid-row: 1;
    width: 21px;
    height: 21px;
  }



  #shopify-section-{{ section.id }} .pcos-story-video__progress {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 2;
    align-self: center;
    width: 100%;
    height: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.32);
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .pcos-story-video__progress-thumb {
    position: absolute;
    left: 0;
    top: 50%;
    width: 20px;
    height: 28px;
    color: #20c6c8;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__progress-thumb svg,
  #shopify-section-{{ section.id }} .pcos-story-video__progress-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__progress-fill {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: #20b8c2;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__time {
    grid-column: 2;
    grid-row: 1;
    min-width: 86px;
    color: rgba(255, 255, 255, 0.95);
    font-size: 14px;
    line-height: 24px;
    white-space: nowrap;
  }


  #shopify-section-{{ section.id }} .pcos-story-video__caption-wrap {
    position: relative;
    margin-top: 22px;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__caption {
    min-height: 117px;
    padding: 14px 200px 14px 24px;
    border-radius: 8px;
    color: #8B8B8B;
    font-size: 14px;
    font-weight: 400;
    line-height: 120%;
    border-radius: 16px;
    background: rgba(196, 196, 196, 0.20);
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__caption strong {
    display: block;
    margin-bottom: 10px;
    color: #1A1A1A;
    font-family: Saans, var(--text-font-family);
    font-size: 24px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__caption-text {
    display: block;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__tag {
    position: absolute;
    right: 22px;
    top: 50%;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 53px;
    padding: 0 16px;
    border-radius: 999px;
    background: #f3ffff;
    color: #21D8D8;
    font-family: Saans, var(--text-font-family);
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    transform: translateY(-50%);
  }

  #shopify-section-{{ section.id }} .pcos-story-video__tag-icon {
    display: block;
    width: 29px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__community {
    display: grid;
    grid-template-columns: 49px minmax(0, 1fr) 14px;
    gap: 10px;
    align-items: center;
    margin-top: 16px;
    min-height: 93px;
    padding: 22px 24px;
    border-radius: 16px;
    background: #3AB4BB;
    color: #ffffff;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__community-icon {
    width: 32px;
    height: 32px;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__community-title {
    display: block;
    font-size: 20px;
    line-height: 1.15;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__community-text {
    display: block;
    margin-top: 4px;
    color: #FFF;
    font-size: 14px;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__community-arrow {
    display: block;
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .pcos-story-video__community-arrow svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .pcos-story-video {
      padding: {{ section.settings.mobile_padding_top | default: section.settings.padding_top }}px 20px {{ section.settings.mobile_padding_bottom | default: section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__inner.container {
      max-width: 100%;
      padding-left: 0;
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__title {
      max-width: 80%;
      margin: 0 auto 10px;
      text-align: center;
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__subtitle {
      max-width: 80%;
      margin: 0 auto 24px;
      text-align: center;
      font-size: 12px;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__panel {
      display: block;
      padding: 0;
      border-radius: 0;
      background: transparent;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__side-title,
    #shopify-section-{{ section.id }} .pcos-story-video__content-title {
      margin: 0 0 10px;
      font-size: 12px;
      line-height: 1.2;
      font-weight: 500;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__list {
      display: flex;
      gap: 14px;
      width: calc(100% + 40px);
      margin-left: -20px;
      margin-bottom: 18px;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 0 20px 4px;
      scroll-padding-left: 20px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__list::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__person {
      flex: 0 0 190px;
      grid-template-columns: 50px minmax(0, 1fr) 20px;
      gap: 10px;
      min-height: 70px;
      padding: 7px 8px 7px 10px;
      border-radius: 8px;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__person.is-active {
      border-radius: 8px;
      border: 0.993px solid #0DA3AC;
      background: #ECF6F7;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__person:hover {
      transform: none;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__avatar {
      width: 50px;
      height: 50px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__name {
      font-size: 10px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__role {
      margin: 4px 0px;
      font-size: 10px;
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__meta {
      margin-top: 3px;
      font-size: 8px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__person-icon {
      width: 20px;
      height: 20px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__content {
      margin-top: 0;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__media-title {
      margin: 0 0 10px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__media {
      border-radius: 16px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__big-play {
      width: 30px;
      height: 30px;
      background: rgba(0, 0, 0, 0.6);
    }

    #shopify-section-{{ section.id }} .pcos-story-video__big-play::before {
      margin-left: 3px;
      border-top-width: 8px;
      border-bottom-width: 8px;
      border-left-width: 12px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__controls {
      left: 50%;
      bottom: 22px;
      grid-template-columns: 16px auto minmax(0, 1fr) 16px 16px;
      grid-template-rows: 16px 3px;
      width: calc(100% - 104px);
      min-width: 260px;
      min-height: 42px;
      padding: 8px 16px 10px;
      column-gap: 12px;
      row-gap: 8px;
      border-radius: 10px;
      background: rgba(18, 17, 13, 0.62);
      opacity: 0;
      pointer-events: none;
      transform: translateX(-50%) translateY(8px);
    }

    #shopify-section-{{ section.id }} .pcos-story-video__time {
      min-width: 54px;
      font-size: 7px;
      line-height: 16px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__control-btn {
      width: 16px;
      height: 16px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__control-btn--mute,
    #shopify-section-{{ section.id }} .pcos-story-video__control-btn--fullscreen {
      width: 16px;
      height: 16px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__control-btn--mute::after {
      left: 1px;
      width: 14px;
      height: 1.5px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__progress {
      height: 3px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__progress-thumb {
      width: 12px;
      height: 17px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__caption-wrap {
      margin-top: 15px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__caption {
      min-height: 70px;
      padding: 12px 15px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
      font-size: 8px;
      color: #8B8B8B;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__caption strong {
      margin-bottom: 8px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__tag {
      position: absolute;
      right: 16px;
      top: 12px;
      bottom: auto;
      gap: 6px;
      min-height: 24px;
      margin-top: 0;
      padding: 0 10px;
      font-size: 8px;
      line-height: 1;
      transform: none;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__tag-icon {
      width: 10px;
      height: 14px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__community {
      grid-template-columns: 30px minmax(0, 1fr) 30px;
      gap: 14px;
      min-height: 52px;
      margin-top: 12px;
      padding: 10px 18px 10px 22px;
      border-radius: 8px;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__community > svg {
      width: 30px;
      height: 30px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__community-title {
      font-size: 16px;
      font-weight: 400;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__community-text {
      margin-top: 4px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .pcos-story-video__community-arrow {
     
    }
