<style>
  #shopify-section-{{ section.id }} .ulike-moments {
    overflow: hidden;
    background: #fffffc;
    padding: 80px 0 73px;
    font-family: Saans, sans-serif;
  }

  #shopify-section-{{ section.id }} .ulike-moments__title {
    margin: 0 20px 70px;
    color: #1a1a1a;
    font-size: 48px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .ulike-moments__slider {
    position: relative;
  }

  #shopify-section-{{ section.id }} .ulike-moments__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  #shopify-section-{{ section.id }} .ulike-moments__track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .ulike-moments__track::before,
  #shopify-section-{{ section.id }} .ulike-moments__track::after {
    content: '';
    flex: 0 0 max(20px, calc((100vw - 880px) / 2));
  }

  #shopify-section-{{ section.id }} .ulike-moments__card {
    position: relative;
    flex: 0 0 880px;
    height: 460px;
    overflow: hidden;
    border-radius: 8px;
    background: #faf6f1;
    scroll-snap-align: center;
  }

  #shopify-section-{{ section.id }} .ulike-moments__image {
    position: absolute;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card--intimate .ulike-moments__image {
    top: -21.1%;
    left: -3.75%;
    width: 114.55%;
    height: 122.4%;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card--beach .ulike-moments__image {
    right: -10%;
    bottom: 0;
    width: 156.9%;
    height: 136.1%;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card--occasion .ulike-moments__image {
    top: 0;
    left: -5.23%;
    width: 119.3%;
    height: 125.2%;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card--business .ulike-moments__image {
    top: -15.4%;
    left: -2.84%;
    width: 115.6%;
    height: 123.3%;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card--custom .ulike-moments__image {
    inset: 0;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card::after {
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    height: 49.35%;
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, .3));
    content: '';
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .ulike-moments__content {
    position: absolute;
    z-index: 2;
    bottom: 26px;
    left: 53px;
    width: min(505px, calc(100% - 106px));
    color: #fff;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card-title {
    margin: 0 0 11px;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .ulike-moments__description {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .ulike-moments__navigation {
    position: absolute;
    z-index: 3;
    top: 50%;
    right: 60px;
    display: flex;
    gap: 12px;
    transform: translateY(-50%);
  }

  #shopify-section-{{ section.id }} .ulike-moments__arrow {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    padding: 0;
    border: 1px solid #190a0a;
    border-radius: 5px;
    background: #fff;
    color: #190a0a;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ulike-moments__arrow svg {
    width: 21px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .ulike-moments__arrow:disabled {
    opacity: .35;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .ulike-moments__arrow:focus-visible {
    outline: 2px solid #190a0a;
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .ulike-moments {
      padding: 40px 0 39px;
    }

    #shopify-section-{{ section.id }} .ulike-moments__title {
      margin: 0 19px 31px;
      font-size: 24px;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .ulike-moments__track {
      scroll-padding-inline: 19px;
    }

    #shopify-section-{{ section.id }} .ulike-moments__track::before {
      flex-basis: 19px;
    }

    #shopify-section-{{ section.id }} .ulike-moments__track::after {
      flex-basis: calc(100vw - 276px);
    }

    #shopify-section-{{ section.id }} .ulike-moments__card {
      flex-basis: 257px;
      height: 314px;
      border-radius: 4px;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--intimate .ulike-moments__image {
      top: 0;
      left: -53.3%;
      width: 218.7%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--beach .ulike-moments__image {
      right: -98%;
      bottom: 0;
      width: 359.5%;
      height: 137.3%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--occasion .ulike-moments__image {
      top: 0;
      left: -45.9%;
      width: 197.3%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--business .ulike-moments__image {
      top: 0;
      left: -72.4%;
      width: 219.1%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--custom .ulike-moments__image {
      inset: 0;
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--mobile-custom .ulike-moments__image {
      inset: 0;
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card::after {
      height: 100%;
      background: linear-gradient(to bottom, rgba(0, 0, 0, .01) 64%, rgba(25, 10, 10, .5));
    }

    #shopify-section-{{ section.id }} .ulike-moments__content {
      bottom: 16px;
      left: 16px;
      width: 224px;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card-title {
      margin-bottom: 3px;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .ulike-moments__description {
      font-size: 12px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .ulike-moments__navigation {
      position: static;
      justify-content: flex-end;
      gap: 20px;
      margin: 31px 58px 0 19px;
      transform: none;
    }

    #shopify-section-{{ section.id }} .ulike-moments__arrow {
      width: 21px;
      height: 16px;
      border: 0;
      border-radius: 0;
      background: transparent;
    }
  }

</style>

<section class="ulike-moments" data-ulike-moments="{{ section.id }}" aria-label="{{ section.settings.title | escape }}">
  {% if section.settings.title != blank %}
    <h2 class="ulike-moments__title">{{ section.settings.title | escape }}</h2>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="ulike-moments__slider">
      <div class="ulike-moments__track" data-moments-track tabindex="0" aria-label="{{ section.settings.title | escape }}">
        {% for block in section.blocks %}
          {% liquid
            assign default_image_filename = blank
            assign default_image_height = 982
            case block.settings.default_image
              when 'intimate'
                assign default_image_filename = 'ulike-moments-intimate.jpg'
              when 'beach'
                assign default_image_filename = 'ulike-moments-beach.jpg'
                assign default_image_height = 1119
              when 'occasion'
                assign default_image_filename = 'ulike-moments-occasion.jpg'
                assign default_image_height = 734
              when 'business'
                assign default_image_filename = 'ulike-moments-business.jpg'
            endcase
            assign desktop_image = block.settings.desktop_image
            assign mobile_image = block.settings.mobile_image
          %}
          <article class="ulike-moments__card ulike-moments__card--{% if desktop_image != blank %}custom{% else %}{{ block.settings.default_image }}{% endif %}{% if mobile_image != blank %} ulike-moments__card--mobile-custom{% endif %}" {{ block.shopify_attributes }}>
            {% if desktop_image != blank %}
              <picture>
                {% if mobile_image != blank %}
                  <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 750 }}">
                {% endif %}
                <img class="ulike-moments__image" src="{{ desktop_image | image_url: width: 1800 }}" alt="" width="{{ desktop_image.width }}" height="{{ desktop_image.height }}" loading="lazy">
              </picture>
            {% elsif default_image_filename != blank %}
              <picture>
                {% if mobile_image != blank %}
                  <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 750 }}">
                {% endif %}
                <img class="ulike-moments__image" src="{{ default_image_filename | asset_url }}" alt="" width="1760" height="{{ default_image_height }}" loading="lazy">
              </picture>
            {% endif %}
            <div class="ulike-moments__content">
              {% if block.settings.title != blank %}<h3 class="ulike-moments__card-title">{{ block.settings.title | escape }}</h3>{% endif %}
              {% if block.settings.description != blank %}<p class="ulike-moments__description">{{ block.settings.description | escape }}</p>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
      {% if section.blocks.size > 1 %}
        <div class="ulike-moments__navigation">
          <button class="ulike-moments__arrow" type="button" data-moments-prev aria-label="Previous card">
            <svg viewBox="0 0 21 16" fill="none" aria-hidden="true"><path d="M8 1 1 8l7 7M1 8h20" stroke="currentColor" stroke-width="1"/></svg>
          </button>
          <button class="ulike-moments__arrow" type="button" data-moments-next aria-label="Next card">
            <svg viewBox="0 0 21 16" fill="none" aria-hidden="true"><path d="m13 1 7 7-7 7M20 8H0" stroke="currentColor" stroke-width="1"/></svg>
          </button>
        </div>
      {% endif %}
    </div>
  {% endif %}
</section>

<script>
  (() => {
    const id = {{ section.id | json }};
    const init = () => {
      const section = document.querySelector(`[data-ulike-moments="${id}"]`);
      if (!section || section.dataset.momentsReady === 'true') return;
      const track = section.querySelector('[data-moments-track]');
      const cards = Array.from(section.querySelectorAll('.ulike-moments__card'));
      if (!track || cards.length < 2) return;
      section.dataset.momentsReady = 'true';
      const prev = section.querySelector('[data-moments-prev]');
      const next = section.querySelector('[data-moments-next]');
      const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
      const position = (card) => isMobile()
        ? card.offsetLeft - 19
        : card.offsetLeft + card.offsetWidth / 2 - track.clientWidth / 2;
      const currentIndex = () => cards.reduce((closest, card, index) =>
        Math.abs(position(card) - track.scrollLeft) < Math.abs(position(cards[closest]) - track.scrollLeft) ? index : closest, 0);
      const update = () => {
        const index = currentIndex();
        if (prev) prev.disabled = index === 0;
        if (next) next.disabled = index === cards.length - 1;
      };
      const goTo = (index, behavior = 'smooth') => {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollTo({ left: position(cards[index]), behavior: reducedMotion ? 'auto' : behavior });
        window.setTimeout(update, behavior === 'smooth' && !reducedMotion ? 400 : 0);
      };
      prev?.addEventListener('click', () => goTo(Math.max(0, currentIndex() - 1)));
      next?.addEventListener('click', () => goTo(Math.min(cards.length - 1, currentIndex() + 1)));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      if (!isMobile() && cards.length > 2) goTo(1, 'auto');
      else update();
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
    else init();
    document.addEventListener('shopify:section:load', event => {
      if (event.target.querySelector?.(`[data-ulike-moments="${id}"]`)) init();
    });
  })();
</script>

{% schema %}
{
  "name": "Ulike Moments",
  "tag": "section",
  "class": "section-ulike-moments",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Built for Every Moment" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment card",
      "settings": [
        { "type": "select", "id": "default_image", "label": "Default image", "options": [
          { "value": "intimate", "label": "Intimate Moments" },
          { "value": "beach", "label": "Beach Getaway" },
          { "value": "occasion", "label": "Special Occasion Ready" },
          { "value": "business", "label": "Business Ready" }
        ], "default": "intimate" },
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Uses the desktop or default image when empty." },
        { "type": "text", "id": "title", "label": "Title", "default": "Intimate Moments" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A gentle mode designed for delicate areas, leaving skin feeling soft and smooth." }
      ]
    }
  ],
  "presets": [
    { "name": "Ulike Moments", "blocks": [
      { "type": "moment", "settings": { "default_image": "intimate", "title": "Intimate Moments", "description": "A gentle mode designed for delicate areas, leaving skin feeling soft and smooth." } },
      { "type": "moment", "settings": { "default_image": "beach", "title": "Beach Getaway", "description": "A bikini-sensitive-area mode designed for comfort, helping reduce the look of redness and irritation." } },
      { "type": "moment", "settings": { "default_image": "occasion", "title": "Special Occasion Ready", "description": "A smoothing mode for the shoulders, neck, and back, so you’re ready for every special occasion." } },
      { "type": "moment", "settings": { "default_image": "business", "title": "Business Ready", "description": "A quick touch-up mode for small areas, perfect for busy mornings and last-minute grooming." } }
    ] }
  ]
}
{% endschema %}
