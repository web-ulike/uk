<style>
#shopify-section-{{ section.id }} .officially-banner{
  position: relative;
  height: 320vh;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-cont{
  position: sticky;
  height: 100vh;
  min-height: 100vh;
  top: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-picture{
  display: block;
  position: relative;
  z-index: 1;
  width: 100%;
  min-width: 100%;
  height: 100%;
  overflow: hidden;
  transform: scale(1);
  transform-origin: center center;
  top: 0;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-img{
  display: block;
  position: relative;
  z-index: 1;
  width: 100% !important;
  min-width: 100%;
  height: 100% !important;
  max-width: none;
  object-fit: cover !important;
  object-position: center;
}


#shopify-section-{{ section.id }} .officially-banner .officially-banner-text{
  position: absolute;
  width: 100%;
  left: 0;
  top: 15%;
  transform: none;
  text-align: center;
  z-index: 2;
  color: #000;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-badge{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 21px;
  margin-bottom: 10px;
  padding: 2px 12px;
  border: 1px solid #E0004D;
  border-radius: 999px;
  color: #E0004D;
  font-size: 12px;
  line-height: 1;
  font-weight: 400;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-title{
  font-size: 60px;
  line-height: 1.2;
  letter-spacing: 0.6px;
  color: #000;
  font-weight: 400;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-title-picture{
  display: block;
  width: fit-content;
  max-width: 860px;
  margin: 4px auto 10px;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-title-img{
  display: block;
  width: 100%;
  height: auto;
  max-width: 100%;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-sub{
  font-size: 20px;
  line-height: 1.5;
  letter-spacing: 0.2px;
  color: #000;
  font-weight: 400;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-sub strong,
#shopify-section-{{ section.id }} .officially-banner .officially-banner-sub b,
#shopify-section-{{ section.id }} .officially-banner .officially-banner-sub em{
  color: #E0004D;
  font-family: var(--heading-font-family);
  font-weight: inherit;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-btn{
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
  text-decoration: none;
  line-height: 1.3;
  letter-spacing: 0.18px;
  font-size: 14px;
  width: 205px;
  height: 42px;
  border-radius: 42px;
  cursor: pointer;
  border: 2px solid #000;
  margin: 0 auto;
  margin-top: 18px;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-btn span{
  color: #fff;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-note{
  position: absolute;
  left: 50%;
  bottom: 42px;
  z-index: 5;
  width: min(92%, 880px);
  transform: translateX(-50%);
  color: #DFDFDF;
  text-align: center;
  font-family: Saans, sans-serif;
  font-size: 18px;
  font-style: normal;
  font-weight: 380;
  line-height: 150%;
  letter-spacing: 0.18px;
  pointer-events: none;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-svg{
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  opacity: 0;
  transform: scale(1.08);
  transform-origin: center center;
  pointer-events: none;
  will-change: opacity, transform;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-svg-picture,
#shopify-section-{{ section.id }} .officially-banner .officially-banner-svg-picture .img-svg{
  display: block;
  width: 100%;
  height: 100%;
}

#shopify-section-{{ section.id }} .officially-banner .officially-banner-svg-picture .img-svg{
  object-fit: cover;
  max-width: none;
}

@media (max-width:1100px) {
}

@media (max-width:991px) {
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-cont{
    height: 100vh;
    min-height: 100vh;
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-picture{
    transform: scale(1);
    top: 0;
    height: 100%;
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-picture .officially-banner-img{
    height: 100% !important;
    object-fit: cover !important;
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-svg{
    width: 100%;
    height: 100%;
    transform: scale(1.08);
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-svg-picture,
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-svg .img-svg{
    width: 100%;
    min-width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .officially-banner .pc-box{
    display: none;
  }
  #shopify-section-{{ section.id }} .officially-banner .mb-box{
    display: block;
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-text{
    transform: none;
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-badge{
    min-height: 21px;
    margin-bottom: 8px;
    padding: 2px 10px;
    font-size: 9px;
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-title{
    font-size: 34px;
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-title-picture{
    max-width: 78%;
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-sub{
    font-size: 14px;
    width: 80%;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-btn{
    font-size: 12px;
    width: 165px;
    height: 35px;
  }
  #shopify-section-{{ section.id }} .officially-banner .officially-banner-note{
    bottom: 30px;
    width: 88%;
    font-size: 9px;
    line-height: 150%;
  }
}
</style>

{%- liquid
  assign image_pc = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image_pc
  assign svg_pc = section.settings.svg_image
  assign svg_mobile = section.settings.svg_image_mobile | default: svg_pc
  assign title_image_pc = section.settings.title_image
  assign title_image_mobile = section.settings.title_image_mobile | default: title_image_pc
-%}

<section class="section-box">
  <div class="officially-banner">
    <div class="officially-banner-cont">
      {%- if image_pc != blank -%}
        <picture class="officially-banner-picture">
          {%- if image_mobile != blank -%}
            <source
              media="(max-width: 991px)"
              srcset="{{ image_mobile | image_url: width: 900 }}"
            >
          {%- endif -%}
          <img
            class="img officially-banner-img"
            width="{{ image_pc.width }}"
            height="{{ image_pc.height }}"
            {% render 'image-attributes', image: image_pc %}
            alt="{{ image_pc.alt | escape }}"
          >
        </picture>
      {%- endif -%}
      <div class="officially-banner-text">
        {%- if section.settings.badge_text != blank -%}
          <div class="officially-banner-badge">{{ section.settings.badge_text }}</div>
        {%- endif -%}
        {%- if title_image_pc != blank -%}
          <picture class="officially-banner-title-picture">
            {%- if title_image_mobile != blank -%}
              <source
                media="(max-width: 991px)"
                srcset="{{ title_image_mobile | image_url: width: 700 }}"
              >
            {%- endif -%}
            <img
              class="officially-banner-title-img"
              src="{{ title_image_pc | image_url: width: 1200 }}"
              width="{{ title_image_pc.width }}"
              height="{{ title_image_pc.height }}"
              alt="{{ title_image_pc.alt | default: section.settings.text | escape }}"
              loading="lazy"
            >
          </picture>
        {%- elsif section.settings.text != blank -%}
          <div class="officially-banner-title">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.text1 != blank -%}
          <div class="officially-banner-sub">{{ section.settings.text1 }}</div>
        {%- endif -%}
        {%- if section.settings.text2 != blank -%}
          {%- if section.settings.button_link != blank -%}
            <a class="officially-banner-btn btn-diy" href="{{ section.settings.button_link }}">
              <div class="btn-txt" text="{{ section.settings.text2 | escape }}">
                <span>{{ section.settings.text2 }}</span>
              </div>
            </a>
          {%- else -%}
            <div class="officially-banner-btn btn-diy" onclick="btnScrollToTop{{ section.id | replace: '-', '_' }}()">
              <div class="btn-txt" text="{{ section.settings.text2 | escape }}">
                <span>{{ section.settings.text2 }}</span>
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- if section.settings.note_text != blank -%}
        <div class="officially-banner-note">{{ section.settings.note_text }}</div>
      {%- endif -%}
      <div class="officially-banner-svg">
        {%- if svg_pc != blank -%}
          <picture class="officially-banner-svg-picture">
            {%- if svg_mobile != blank -%}
              <source
                media="(max-width: 991px)"
                srcset="{{ svg_mobile | image_url: width: 900 }}"
              >
            {%- endif -%}
            <img
              class="img-svg"
              width="{{ svg_pc.width }}"
              height="{{ svg_pc.height }}"
              {% render 'image-attributes', image: svg_pc %}
              alt="{{ svg_pc.alt | escape }}"
            >
          </picture>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<script>
  function btnScrollToTop{{ section.id | replace: '-', '_' }}() {
    var target = document.querySelector('#product-components .product-left-panel') || document.querySelector('#product-components');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth' });
    }
  }
  
  function bannerScrollTo{{ section.id | replace: '-', '_' }}(){
    if (!window.ScrollTrigger || !window.gsap) return;

    var root = document.querySelector('#shopify-section-{{ section.id }} .officially-banner');
    if (!root) return;

    ScrollTrigger.getAll().forEach(function(trigger) {
      if (trigger.vars && trigger.vars.id === 'de-officially-banner-{{ section.id }}') {
        trigger.kill();
      }
    });

    var text = root.querySelector('.officially-banner-text');
    var note = root.querySelector('.officially-banner-note');
    var image = root.querySelector('.officially-banner-img');
    var secondImage = root.querySelector('.officially-banner-svg');

    if (!image || !secondImage) return;

    gsap.set(image, { scale: 1, yPercent: 0, transformOrigin: 'center center' });
    gsap.set(secondImage, { autoAlpha: 0, scale: 1.08, transformOrigin: 'center center' });
    if (text) gsap.set(text, { autoAlpha: 1, yPercent: 0 });
    if (note) gsap.set(note, { autoAlpha: 1, yPercent: 0 });

    var tl = gsap.timeline();
    if (text) {
      tl.to(text, { yPercent: 0, autoAlpha: 1, duration: 0.28, ease: 'none' }, 0);
      tl.to(text, { yPercent: -40, autoAlpha: 0, duration: 0.34, ease: 'power1.inOut' }, 0.34);
    }
    if (note) {
      tl.to(note, { yPercent: 0, autoAlpha: 1, duration: 0.42, ease: 'none' }, 0);
      tl.to(note, { yPercent: 20, autoAlpha: 0, duration: 0.3, ease: 'power1.inOut' }, 0.52);
    }
    tl.to(secondImage, { autoAlpha: 1, scale: 1, duration: 0.78, ease: 'power1.inOut' }, 0.62);

    ScrollTrigger.create({
      id: 'de-officially-banner-{{ section.id }}',
      trigger: root,
      start: "top top",
      end: "+=220%",
      scrub: true,
      invalidateOnRefresh: true,
      animation: tl
    })
  }
  document.addEventListener('DOMContentLoaded', () => {
    bannerScrollTo{{ section.id | replace: '-', '_' }}()
  })

  document.addEventListener('shopify:section:load', (event) => {
    if (!event.target || event.target.id !== 'shopify-section-{{ section.id }}') return;
    bannerScrollTo{{ section.id | replace: '-', '_' }}()
  })
</script>
{% schema %}
{
  "name": "DE Officially Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image Mobile"
    },
    {
      "type": "image_picker",
      "id": "svg_image",
      "label": "Svg"
    },
    {
      "type": "image_picker",
      "id": "svg_image_mobile",
      "label": "Svg Mobile"
    },
    {
      "type": "image_picker",
      "id": "title_image",
      "label": "Title Image"
    },
    {
      "type": "image_picker",
      "id": "title_image_mobile",
      "label": "Title Image Mobile"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Title"
    },
    {
      "type": "html",
      "id": "text1",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "text2",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "html",
      "id": "note_text",
      "label": "Middle Note Text",
      "default": "* Basierend auf dem weltweiten Absatz von Haarentfernungsgeräten,<br>2022–2024. Quelle: Frost & Sullivan, 2025."
    }
  ],
  "presets": [
    {
      "name": "DE Officially Banner"
    }
  ]
}
{% endschema %}
