<style>
         #shopify-section-{{ section.id }} {
      --section-background: {{ section.settings.background }};
       background: var(--section-background);
   }
     .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px);
    padding-bottom: calc({{ section.settings.padding_bottom }}px);
  }
@media screen and (max-width: 768px){
  .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.mobile_padding_top }}px);
    padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px );
  }
}
 
   /* product-differentiation start */
.product-differentiation{
  position: relative;
  padding-top: 18px;
}
.product-differentiation-container{
  display: flex;
  justify-content: flex-end;
}

.product-differentiation-rt{
  width: 50%;
  position: relative;
}
.product-differentiation-rt-cnt{
position: absolute;
width: 100%;
height: 100%;
inset: 0;
display: flex;
align-items: flex-end;
padding: 30px;
}
.differentiation-rt-cnt-box{
  display: flex;
  gap: 49px;
  align-items: center;
}
.differentiation-rt-cnt-box img{
  max-width: 132px;
}
.differentiation-rt-cnt-ta {
  color: #FFF;
}
.differentiation-rt-cnt-ta .differentiation-pt-tle{
font-size: 31px;
font-weight: 500;
line-height: 34.934px;
letter-spacing: 0.699px;
margin-bottom: 16px;
}
.differentiation-rt-cnt-ta a{
  display: flex;
  align-items: center;
  gap: 16px;
  position: relative;
  line-height: 2;
    font-family: var(--heading-font-family);
}
.differentiation-rt-cnt-ta a::before{ 
  content: '';
  position: absolute;
  width: 100%;
  height: 2px;
  background-color: #fff;
  bottom: 0;
     transition: transform 0.3s ease;
     transform-origin: left center;
  transform: scaleX(0);
}
.differentiation-rt-cnt-ta a:hover::before{
transform: scaleX(1);
}
.product-differentiation-lt{
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}
.product-differentiation-lt .container{
      height: 100%;
}
.differentiation-lt-box-wrp{
  display: flex;
   height: 100%;
}
.differentiation-lt-box{
  width: 50%;
  display: flex;
  flex-direction: column;
  padding: 120px 63px 80px 0;
  justify-content: space-between;
}
.differentiation-lt-box h3{
  color:  #3F3636;
font-size: 48px;
font-style: normal;
font-weight: 400;
line-height: 120%; 
}
.differentiation-lt-bottom{
  color:  #3F3636;
font-size: 32px;
font-style: normal;
font-weight: 400;
line-height: 150%; 
}
.differentiation-lt-bottom .differentiation-lt-bt-item{
  padding-bottom: 20px;
  margin-bottom: 20px;
  border-bottom: 1px solid #3F3636;
  position: relative;
      display: flex;
    align-items: center;
    gap: 15px;
}
.product-differentiation-rt .product-differentiation-pic{
 
}
.product-differentiation-pic img{
  width: 100%;
 height: 839px;
  object-fit: cover;
}
.differentiation-lt-bottom .differentiation-lt-bt-item::before{
  content: "";
  display: block;
  width: 10px;
  height: 10px;
  background-color: #3F3636;
  border-radius: 50%;
}
  @media screen and (max-width: 1023px) {
    .product-differentiation{
      padding-top:90px;
    }
    .differentiation-rt-cnt-box img{
      width: 62px;
    }
    .product-differentiation-rt-cnt{
      padding: 10px 15px;
    }
    .differentiation-rt-cnt-ta .differentiation-pt-tle{
      font-size: 15px;
      line-height: 1;
      margin-bottom: 7px;
    }
    .product-differentiation-container{
      flex-direction: column-reverse;
      padding: 0 var(--container-gutter);
    }
    .product-differentiation-rt{
      width: 100%;
    }
    .product-differentiation-pic img {
    height: auto;
}
.product-differentiation-lt{
  position: static;
}
.differentiation-lt-box-wrp{
  height: auto;
}
.differentiation-lt-box{
  width: 100%;
  padding: 0;
          align-items: center;
}
.product-differentiation-lt .container {
    height: auto;
    --container-gutter:0;
}
.differentiation-lt-box h3{
  position: absolute;
  top: 0;
  font-size: 24px;
  text-align: center;
  max-width: 291px;
}
.differentiation-lt-bottom{
  width: 100%;
  padding-top: 32px;
  font-size: 14px;

}
.differentiation-lt-bottom .differentiation-lt-bt-item::before{
  width: 6px;
    height: 6px;
}
.differentiation-lt-bottom .differentiation-lt-bt-item{
      padding-bottom: 10px;
    margin-bottom: 10px;
    gap: 5px;
}
.differentiation-rt-cnt-ta a{
  font-size: 11px;
  gap: 8px;
}
.differentiation-rt-cnt-ta a svg{
  width: 13px;

}
.differentiation-rt-cnt-box{
  gap: 23px;
}
  }
   /* product-differentiation end */
</style>

  <section>
   <div class="product-differentiation">
    <div class="product-differentiation-container">
      <div class="product-differentiation-lt">
        <div class="container">
          <div class="differentiation-lt-box-wrp">
        <div class="differentiation-lt-box">
          <h3 class="to-top">{{ section.settings.tle }}</h3>
          <div class="differentiation-lt-bottom to-top" style="transition-delay: 0.2s;">

             {% for block in section.blocks %}
            <div class="differentiation-lt-bt-item">
             {{  block.settings.txt }}
            </div>
            {%  endfor %}
             


          </div>
        </div>
        </div>

        </div>
      </div>
      <div class="product-differentiation-rt to-top" style="transition-delay: 0.4s;">
          <picture class="product-differentiation-pic">
               {%- if section.settings.image_mobile -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url }}">
               {%- endif -%}
           {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt }}" loading="lazy" decoding="async">
            {%- endif -%}
            </picture>
            <div class="product-differentiation-rt-cnt">
              <div class="differentiation-rt-cnt-box">
                {%- if section.settings.product_image -%}
                <img src="{{ section.settings.product_image | image_url }}" alt="">
                  {%- endif -%}
                <div class="differentiation-rt-cnt-ta">
                  <div class="differentiation-pt-tle">{{  section.settings.product_name }}</div>
                  <a href="{{ section.settings.link }}">
                   {{ section.settings.link_txt }}
                    <svg  width="28" height="22" viewBox="0 0 28 22" fill="none">
  <path d="M0.00390625 10.6721L25.4028 10.6709" stroke="#FFFFFC" stroke-width="1.18134"/>
  <path d="M20.0859 5.35547L26.3069 10.6727L20.0859 15.8552" stroke="#FFFFFC" stroke-width="1.18134" stroke-linejoin="round"/>
</svg>
                  </a>
                </div>
              </div>
            </div>
      </div>
    </div>
  </div>
  </section>


{% schema %}
{
  "name": "product-differentiation",
  "settings": [
    {
      "type": "text",
      "id": "tle",
      "label": "Title"
    },
        {
      "type": "text",
      "id": "txt",
      "label": "Text"
    },
               {
          "type": "image_picker",
          "id": "image",
          "label": "Images"
        },
     {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Images"
        },

  {
      "type": "text",
      "id": "product_name",
      "label": "Product Name"
    },
           {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Images"
        },
          {
          "type": "text",
          "id": "link_txt",
          "label": "Link text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
  ],
  "blocks": [
    {
        "type": "item",
        "name": "item",
        "settings": [
            {
      "type": "text",
      "id": "txt",
      "label": "Text"
    },
        ]
      }
  ],
  "presets": [
    {
      "name": "product-differentiation",
      "settings": {},
      "blocks": [
      ]
    }
  ]
}
{% endschema %}