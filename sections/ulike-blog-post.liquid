<script>
  function generateToc(contentSelector, firstHeadingSelector = null) {
    const content = document.querySelector(contentSelector);
    if (!content) return;

    const article = content.querySelector('.ulike-blog-post-article');
    if (!article) return;

    // 获取内容中的所有标题
    let headings = Array.from(article.querySelectorAll("h1, h2, h3, h4, h5, h6"));

    // 如果指定了单独的h1
    if (firstHeadingSelector) {
      const firstHeading = document.querySelector(firstHeadingSelector);
      if (firstHeading) {
        // 给ID（如果没有）
        if (!firstHeading.id) firstHeading.id = "heading-first";
        // 放到最前面
        headings.unshift(firstHeading);
      }
    }

    const tocList = content.querySelector('.ulike-blog-post-toc-list');

    headings.forEach((heading, index) => {
      if (!heading.id) heading.id = "heading-" + index;

      const link = document.createElement("a");
      link.href = "#" + heading.id;

      const sep = document.createElement('span');
      sep.textContent = heading.textContent;
      link.appendChild(sep);

      link.style.display = "block";
      link.style.marginLeft = (parseInt(heading.tagName.substring(1)) - 1) * 8 + "px";

      link.addEventListener("click", function (e) {
        e.preventDefault();
        tocList.style.display = "none";
        setTimeout(() => {
          const target = document.getElementById(heading.id);
          const offset = 100; // 留出导航位置
          const bodyTop = document.body.getBoundingClientRect().top;
          const elementTop = target.getBoundingClientRect().top;
          const targetPosition = elementTop - bodyTop - offset;
          window.scrollTo({
            top: targetPosition,
            behavior: "smooth"
          });
        }, 100);
      });

      tocList.appendChild(link);
    });

    // TOC切换显示
    const tocTab = content.querySelector('.ulike-blog-post-toc-tab');
    tocTab && tocTab.addEventListener("click", function () {
      tocList.style.display = tocList.style.display === "block" ? "none" : "block";
    });
  }

  // 使用方式
  generateToc(".ulike-blog-post",".ulike-blog-head h1");
//asss
class TableScrollHelper {
  constructor(options = {}) {
    const defaults = {
      containerSelector: 'body',
      minWidth: 520,
      maxHeight: 400,
      horizontalIcon: 'https://cdn.shopify.com/s/files/1/0656/9079/6273/files/icon_eabd190c-e511-45d5-b6d2-597d62c0cdd5.svg',
      verticalIcon: 'https://cdn.shopify.com/s/files/1/0656/9079/6273/files/icon_eabd190c-e511-45d5-b6d2-597d62c0cdd5.svg',
      bothIcon: 'https://cdn.shopify.com/s/files/1/0656/9079/6273/files/icon_eabd190c-e511-45d5-b6d2-597d62c0cdd5.svg',
      textMap: {
        horizontal: 'Scroll',
        vertical: 'Scroll',
        both: 'Scroll'
      },
      toastDuration: 9000,
      showOnScroll: true,
      initialDelay: 1000,
      userScrollGrace: 150
    };
    this.opt = Object.assign({}, defaults, options);
    this.wrappers = [];
    this.toastShownSet = new WeakSet();
    this._onWindowResize = this._onWindowResize.bind(this);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => this._init());
    } else {
      this._init();
    }
  }

  _init() {
    const container = document.querySelector(this.opt.containerSelector) || document.body;
    const tables = container.querySelectorAll('table');
    if (!tables.length) return;
    tables.forEach(table => this._ensureWrapper(table));
    window.addEventListener('resize', this._onWindowResize);
  }

  _ensureWrapper(table) {
    let wrapper = table.closest('.table-scroll-wrapper');
    if (!wrapper) {
      wrapper = document.createElement('div');
      wrapper.className = 'table-scroll-wrapper';
      table.parentNode.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    }
    if (!this.wrappers.includes(wrapper)) this.wrappers.push(wrapper);
    this._applyScrollSettings(wrapper);
  }

  // 新增：更可靠地计算表格“真实内容宽度”（针对复杂表格或单元格宽度超出时）
  _calcTableContentWidth(table) {
    try {
      let maxRowWidth = 0;
      const rows = table.rows || [];
      for (let r = 0; r < rows.length; r++) {
        const cells = rows[r].cells;
        let rowWidth = 0;
        for (let c = 0; c < cells.length; c++) {
          // 使用 scrollWidth 以包含单元格内的溢出内容
          rowWidth += cells[c].scrollWidth || cells[c].offsetWidth || 0;
        }
        if (rowWidth > maxRowWidth) maxRowWidth = rowWidth;
      }
      return maxRowWidth || table.scrollWidth || 0;
    } catch (e) {
      return table.scrollWidth || 0;
    }
  }

  _applyScrollSettings(wrapper) {
    const table = wrapper.querySelector('table');
    if (!table) return;

    // 为了精确测量表格真实高度，先临时移除 wrapper 的 maxHeight（仅在测量时）
    const prevMaxH = wrapper.style.maxHeight || '';
    wrapper.style.maxHeight = 'none';

    // 强制 layout（读取属性以确保 layout 更新）
    const _ = table.offsetWidth + table.offsetHeight;

    // 获取准确尺寸（使用多种方法取最大值以更可靠判断）
    const tableScrollWidth = Math.max(
      table.scrollWidth || 0,
      Math.round(table.getBoundingClientRect().width || 0),
      Math.round(this._calcTableContentWidth(table) || 0)
    );
    const tableScrollHeight = table.scrollHeight || 0;
    const wrapperClientWidth = Math.round(wrapper.getBoundingClientRect().width || wrapper.clientWidth || 0);

    // 判断条件:
    // - 横向：表格内容宽度 > wrapper 可视宽度（确实会出现横向滚动） AND 表格内容宽度 > minWidth（阈值）
    const needHorizontal = (tableScrollWidth > wrapperClientWidth + 0.5) && (tableScrollWidth > this.opt.minWidth);
    // - 纵向：表格内容高度 > maxHeight（阈值），因为我们希望把纵向滚动限制在设定高度之上
    const needVertical = tableScrollHeight > this.opt.maxHeight + 0.5;

    // 应用滚动设置
    // 先重置
    wrapper.style.overflowX = '';
    wrapper.style.overflowY = '';
    wrapper.style.maxHeight = '';

    if (needHorizontal && needVertical) {
      wrapper.style.overflowX = 'auto';
      wrapper.style.overflowY = 'auto';
      wrapper.style.maxHeight = this.opt.maxHeight + 'px';
    } else if (needHorizontal) {
      wrapper.style.overflowX = 'auto';
      // 禁止纵向滚动以避免双轴影响布局（你原先的逻辑）
      wrapper.style.overflowY = 'auto';
      wrapper.style.maxHeight = 'none';
    } else if (needVertical) {
      wrapper.style.overflowY = 'auto';
      wrapper.style.overflowX = 'auto';
      wrapper.style.maxHeight = this.opt.maxHeight + 'px';
    } else {
      wrapper.style.maxHeight = prevMaxH;
      wrapper.style.overflow = 'hidden';
      return;
    }

    // 改善移动端滚动体验
    wrapper.style.webkitOverflowScrolling = 'touch';

    if (getComputedStyle(wrapper).position === 'static') {
      wrapper.style.position = 'relative';
    }

    this._attachIntersectionObserver(wrapper, { needHorizontal, needVertical });
  }

  _attachIntersectionObserver(wrapper, flags) {
    if (this.toastShownSet.has(wrapper)) return;

    const onIntersect = (entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          if (!this.toastShownSet.has(wrapper)) {
            this.toastShownSet.add(wrapper);
            if (this.opt.showOnScroll) {
              this._showToast(wrapper, flags);
            } else {
              setTimeout(() => this._showToast(wrapper, flags), this.opt.initialDelay);
            }
          }
          observer.unobserve(wrapper);
          observer.disconnect();
        }
      });
    };

    const observer = new IntersectionObserver(onIntersect, { threshold: 0.5 });
    observer.observe(wrapper);
  }

  _showToast(wrapper, { needHorizontal, needVertical }) {
    const direction = (needHorizontal && needVertical) ? 'both' : (needHorizontal ? 'horizontal' : 'vertical');
    const icon = direction === 'both' ? (this.opt.bothIcon || this.opt.horizontalIcon)
               : (direction === 'horizontal' ? this.opt.horizontalIcon : this.opt.verticalIcon);
    const text = this.opt.textMap[direction] || '';

    // remove existing toast if any
    const existing = wrapper.querySelector('.table-toast');
    if (existing) existing.remove();

    const toast = document.createElement('div');
    toast.className = `table-toast ${direction}`;
    toast.innerHTML = `<img src="${icon}" alt="${direction}"><span>${text}</span>`;
    // 确保 toast 使用绝对定位（你 wrapper 被设置为 relative）
    toast.style.position = 'absolute';
    toast.style.zIndex = 9999;
    wrapper.appendChild(toast);

    // ensure layout, then position relative to wrapper's current scroll (center of visible area)
    const positionToast = () => {
      const vw = wrapper.clientWidth;
      const vh = wrapper.clientHeight;
      const tw = toast.offsetWidth;
      const th = toast.offsetHeight;
      // center inside visible area, so add scrollLeft/scrollTop
      const left = wrapper.scrollLeft + Math.round((vw - tw) / 2);
      const top  = wrapper.scrollTop  + Math.round((vh - th) / 2);
      toast.style.left = left + 'px';
      toast.style.top  = top + 'px';
    };

    // show with animation
    requestAnimationFrame(() => {
      positionToast();
      requestAnimationFrame(() => toast.classList.add('show'));
    });

    // only hide when user scrolls the wrapper (NOT when window scrolls)
    const shownAt = Date.now();
    const onWrapperScroll = (ev) => {
      const isUser = ev?.isTrusted === true;
      const elapsed = Date.now() - shownAt;
      if (isUser && elapsed >= this.opt.userScrollGrace) {
        this._hideToast(toast, wrapper, onWrapperScroll, onResize);
      } else {
        // if not user or still in grace window, just reposition
        requestAnimationFrame(positionToast);
      }
    };

    const onResize = () => {
      if (toast && toast.parentElement) positionToast();
    };

    wrapper.addEventListener('scroll', onWrapperScroll, { passive: true });
    window.addEventListener('resize', onResize);

    const timeoutId = setTimeout(() => {
      this._hideToast(toast, wrapper, onWrapperScroll, onResize);
    }, this.opt.toastDuration);

    toast._cleanup = { onWrapperScroll, onResize, timeoutId };
  }

  _hideToast(toast, wrapper, onWrapperScroll, onResize) {
    if (!toast || !toast.parentElement) return;
    toast.classList.remove('show');
    try {
      if (onWrapperScroll) wrapper.removeEventListener('scroll', onWrapperScroll, { passive: true });
      if (onResize) window.removeEventListener('resize', onResize);
      if (toast._cleanup && toast._cleanup.timeoutId) clearTimeout(toast._cleanup.timeoutId);
    } catch (e) {}
    setTimeout(() => { if (toast && toast.parentElement) toast.remove(); }, 300);
  }

  _onWindowResize() {
    this.wrappers.forEach(wrapper => this._applyScrollSettings(wrapper));

    this.wrappers.forEach(wrapper => {
      const toast = wrapper.querySelector('.table-toast');
      if (toast) {
        const vw = wrapper.clientWidth;
        const vh = wrapper.clientHeight;
        const tw = toast.offsetWidth;
        const th = toast.offsetHeight;
        toast.style.left = wrapper.scrollLeft + Math.round((vw - tw) / 2) + 'px';
        toast.style.top  = wrapper.scrollTop  + Math.round((vh - th) / 2) + 'px';
      }
    });
  }

  destroy() {
    window.removeEventListener('resize', this._onWindowResize);
    this.wrappers.forEach(wrapper => {
      const t = wrapper.querySelector('.table-toast');
      if (t && t._cleanup) {
        wrapper.removeEventListener('scroll', t._cleanup.onWrapperScroll, { passive: true });
        window.removeEventListener('resize', t._cleanup.onResize);
        clearTimeout(t._cleanup.timeoutId);
      }
      wrapper.style.overflow = '';
      wrapper.style.overflowX = '';
      wrapper.style.overflowY = '';
      wrapper.style.maxHeight = '';
      wrapper.style.webkitOverflowScrolling = '';
    });
    this.wrappers = [];
    this.toastShownSet = new WeakSet();
  }
}

