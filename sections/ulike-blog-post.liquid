/* Toast */
.table-scroll-wrapper {
  position: relative;
  overflow: hidden; /* JS 根据需要切换 overflowX/overflowY/auto */
  border: 1px solid #e6e6e6;
  border-radius: 6px;
  margin-bottom: 20px;
}

/* 确保表格默认宽度按内容，不要强制100% */
.table-scroll-wrapper table {
  border-collapse: collapse;
}

/* Toast（放在 wrapper 内部，绝对定位，相对于 wrapper） */
.table-toast {
  position: absolute;
  z-index: 9999;
  background: rgba(25, 10, 10, 0.40);
  color: #fff;
  padding: 5px 34px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
  opacity: 0;
  transform: translateY(-8px);
  transition: opacity 0.28s ease, transform 0.28s ease;
  pointer-events: none;
  white-space: nowrap;
}
.table-toast.show {
  opacity: 1;
  transform: translateY(0);
}
.table-toast img {
  width: 20px;
  height: 20px;
  display: block;
  margin:0 !important;
}

/* 小动画 */
.table-toast.horizontal img { animation: moveX 1s infinite ease-in-out; }
.table-toast.vertical img { animation: moveY 1s infinite ease-in-out; }
.table-toast.both img { animation: moveBoth 1s infinite ease-in-out; }

@keyframes moveX { 0%,100%{transform:translateX(0)}50%{transform:translateX(6px)} }
@keyframes moveY { 0%,100%{transform:translateY(0)}50%{transform:translateY(6px)} }
@keyframes moveBoth { 0%,100%{transform:translate(0,0)}50%{transform:translate(4px,4px)} }

