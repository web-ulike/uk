{%- liquid
  assign se_bks = section.blocks
-%}

document.addEventListener('DOMContentLoaded', () => {


  function renderBlogProducts(products, containerSelector = '.ipl-purchase') {
    products.forEach((p) => {
      const product = p.product;
      if (!product) return;

      const html = `
        <div class="blogCommodityHtml" data-sort="${p.sort}">
          <div class="product-container">
            ${ p.showImg?
              `<div class="product-image-container">
                <div class="product-image">
                  <img src="https:${product.featured_image}" alt="${product.title}" loading="lazy">
                </div>
              </div>`
            :''}
            <div class="product-details">
            ${p.discount_percent > 0 ? `<div class="discount-tag">${p.discount_percent}% OFF</div>` : ''}
              <div class="product-name">${product.title}</div>
              <div class="product-rating">
                <div class="jdgm-widget jdgm-preview-badge" data-id="${product.id}">
                  ${p.judgemeBadge || ''}
                </div>
              </div>
              <p class="product-description">${p.descHtml || ''}</p>
              <div class="product-price">
                ${ p.page_price?
                `<span class="price-now">${ p.page_price }</span>`:''}
                ${p.discount_percent > 0 ? `<span class="price-old">${ p.original_price }</span>` : ''}
              </div>
              <div class="product-buttons">
                ${p.btn_text_1 ? `<button class="shop-now-btn" onclick="buyProduct(${product.variants[0]?.id}, '', '${p.discountCode || ''}')">${p.btn_text_1}</button>` : ''}
                ${p.btn_text_2 ? `<button class="add-to-cart-btn" onclick="addToCart(${product.variants[0]?.id}, '', '', '${p.discountCode || ''}')">${p.btn_text_2}</button>` : ''}
                ${p.btn_link_3 ? `<button class="add-to-cart-btn" onclick="window.location.href='${p.btn_link_3}${p.btn_link_3.includes('?') ? '&' : '?'}utm_source=seo&utm_medium=cta&utm_campaign=blog_cv&utm_content=cta3'">${p.btn_text_3 || 'LEARN MORE'}</button>` : ''}
              </div>
            </div>
          </div>
          <div class="m-pay-buttom">
            <div class="product-buttons">
              ${p.btn_text_1 ? `<button class="shop-now-btn" onclick="buyProduct(${product.variants[0]?.id}, '', '${p.discountCode || ''}')">${p.btn_text_1}</button>` : ''}
              ${p.btn_text_2 ? `<button class="add-to-cart-btn" onclick="addToCart(${product.variants[0]?.id}, '', '', '${p.discountCode || ''}')">${p.btn_text_2}</button>` : ''}
              ${p.btn_link_3 ? `<button class="add-to-cart-btn" onclick="window.location.href='${p.btn_link_3}'">${p.btn_text_3 || 'LEARN MORE'}</button>` : ''}
            </div>
          </div>
        </div>
      `;

  
      const target = document.querySelector(`${containerSelector}[data-sort="${p.sort}"]`);
      if (target) target.outerHTML = html;
    });
  }


  const products = [
    {% for block in se_bks %}
      {%- liquid
        assign b_stts = block.settings
        assign product = all_products[b_stts.product]
        assign page_price = product.variants.first.metafields.custom.page_price | plus: 0
        assign original_price = product.variants.first.price | plus: 0
      %}
      {%- assign original_price_yuan = original_price | divided_by: 100 -%}
      {%- assign discount = original_price_yuan | minus: page_price -%}
      {%- assign discount_percent = discount | times: 100 | divided_by: original_price_yuan | round -%}

      {
        sort: "{{ b_stts.sort | default: block.id }}",
        showImg:{{ b_stts.show_img | json }},
        product: {{ all_products[b_stts.product] | json }},
        judgemeBadge:`{{ b_stts.product.metafields.judgeme.badge | default:'' }}`,
        page_price: `{{ all_products[b_stts.product].variants.first.metafields.custom.page_price | times: 100 | round | money | default :'' }}`,
        descHtml: {{ b_stts.descHtml | json | default :'' }},
        discount_percent:`{{ discount_percent }}`,
        original_price:`{{ original_price | money | default :'' }}`,
        discountCode: {{ b_stts.discountCode | json }},
        btn_text_1: {{ b_stts.btn_text_1 | json }},
        btn_text_2: {{ b_stts.btn_text_2 | json }},
        btn_text_3: {{ b_stts.btn_text_3 | json }},
        btn_link_3: {{ b_stts.btn_link_3 | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];


  renderBlogProducts(products);

});
</script>
