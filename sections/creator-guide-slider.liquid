{% style %}
.creator-guide-cus {
  width: 100%;
  padding-top: var(--padding-top);
  padding-bottom: var(--padding-bottom);
  overflow: hidden;
  color: var(--text-color);
  background: var(--section-bg);
}

.creator-guide-cus custom-swiper { display: block; width: 100%; }

.creator-guide-cus .creator-guide__header {
  margin-bottom: 50px;
  text-align: center;
}

.creator-guide-cus .creator-guide__title {
  margin: 0;
  color: inherit;
  font-size: 48px;
  font-weight: 400;
  line-height: 119.167%;
  letter-spacing: -0.64px;
      font-family: var(--heading-font-family);
}

.creator-guide-cus .creator-guide__subtitle {
  margin-top: 16px;
  color: inherit;
  font-size: 20px;
  line-height: normal;
}

.creator-guide-cus .creator-guide__subtitle p { margin: 0; }

.creator-guide-cus .creator-guide__swiper { position: relative; }
.creator-guide-cus .swiper-container { width: 100%; overflow: hidden; }
.creator-guide-cus .swiper-wrapper { align-items: stretch; }
.creator-guide-cus .swiper-slide { height: auto; }

.creator-guide-cus .creator-guide-card {
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: var(--card-radius);
  color: #fff;
  text-decoration: none;
  background: #eee;
}

.creator-guide-cus .creator-guide-card__picture {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.creator-guide-cus .creator-guide-card__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .7s cubic-bezier(.22,1,.36,1);
}

.creator-guide-cus .creator-guide-card:hover .creator-guide-card__image { transform: scale(1.035); }

.creator-guide-cus .creator-guide-card__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:rgba(0, 0, 0, 0.20);
}

.creator-guide-cus .creator-guide-card__content {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  padding: 0 30px 44px;
  text-align: center;
}

.creator-guide-cus .creator-guide-card__title {
  margin: 0;
  color: #fff;
  font-family: var(--heading-font-family);
  font-size: 22px;
  font-weight: 400;
  line-height: 1.5;
}

.creator-guide-cus .creator-guide-card__description {
  max-width: 330px;
  margin: 0px auto 0;
  color: #fff;
  font-size: 14px;
  line-height: 1.5;
}

.creator-guide-cus .creator-guide-card__description p { margin: 0; }

.creator-guide-cus .creator-guide-card__button {
  display: inline-flex;
  min-width: 155px;
  min-height: 48px;
  margin-top: 21px;
  padding: 12px 25px;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  color: var(--button-text-color);
  font-size: 14px;
  font-weight: 400;
   font-family: var(--heading-font-family);
  line-height: 1;
  text-transform: uppercase;
  background: var(--button-bg);
  transition: opacity .3s ease, transform .3s ease;
}

.creator-guide-cus .creator-guide-card:hover .creator-guide-card__button {
 background: #190A0A;
 color: #FFF;

}

.creator-guide-cus .creator-guide__arrows {
  display: flex;
  margin-top: 24px;
  align-items: center;
  justify-content: flex-end;
  gap: 24px;
}

.creator-guide-cus .creator-guide__arrow {
  display: flex;
  width: 36px;
  height: 36px;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  color: var(--text-color);
  background: transparent;
  cursor: pointer;
  transition: opacity .3s ease, transform .3s ease;
}

.creator-guide-cus .creator-guide__arrow svg { display: block; width: 31px; height: auto; }
.creator-guide-cus .creator-guide__arrow.swiper-prev:hover { transform: translateX(-3px); }
.creator-guide-cus .creator-guide__arrow.swiper-next:hover { transform: translateX(3px); }
.creator-guide-cus .creator-guide__arrow.swiper-button-disabled { opacity: .25; pointer-events: none; }

.creator-guide-cus .creator-guide-pagination { display: none; }

@media screen and (max-width: 767px) {
  .creator-guide-cus {
    padding-top: var(--mobile-padding-top);
    padding-bottom: var(--mobile-padding-bottom);
  }

  .creator-guide-cus .creator-guide__header { margin-bottom: 38px; }
  .creator-guide-cus .creator-guide__title { font-size: 24px; line-height: 1.25; letter-spacing: normal; }
  .creator-guide-cus .creator-guide__subtitle { margin-top: 10px; font-size: 12px; line-height: 1.25;}

  .creator-guide-cus .swiper-container { overflow: visible; }

  .creator-guide-cus .creator-guide-card { aspect-ratio: 3 / 4; }
  .creator-guide-cus .creator-guide-card__content { padding: 0 20px 28px; }
  .creator-guide-cus .creator-guide-card__title { font-size: 14px; }
  .creator-guide-cus .creator-guide-card__description {font-size: 12px; }
  .creator-guide-cus .creator-guide-card__button { min-width: 108px; min-height: 34px; margin-top: 15px; padding: 10px 20px; font-size: 12px; }

  .creator-guide-cus .creator-guide__arrows { display: none; }

  .creator-guide-cus .creator-guide-pagination {
    position: relative;
    display: block;
    margin-top: 18px;
    --swiper-pagination-bullet-width: 9px;
    --swiper-pagination-bullet-height: 9px;
    --swiper-pagination-bullet-inactive-color: #CDC6C7;
    --swiper-pagination-bullet-inactive-opacity: 1;
    --swiper-pagination-color: #190A0A;
  }

  .creator-guide-cus .creator-guide-pagination .swiper-pagination { position: static; }
}
{% endstyle %}

<section
  class="creator-guide creator-guide-cus"
  style="
    --section-bg:{{ section.settings.background }};
    --text-color:{{ section.settings.text_color }};
    --button-bg:{{ section.settings.button_background }};
    --button-text-color:{{ section.settings.button_text_color }};
    --card-radius:{{ section.settings.card_radius }}px;
    --padding-top:{{ section.settings.padding_top }}px;
    --padding-bottom:{{ section.settings.padding_bottom }}px;
    --mobile-padding-top:{{ section.settings.mobile_padding_top }}px;
    --mobile-padding-bottom:{{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="container">
    <div class="creator-guide__header js-scroll__header">
      {% if section.settings.title != blank %}
        <h2 class="creator-guide__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <div class="creator-guide__subtitle">{{ section.settings.subtitle }}</div>
      {% endif %}
    </div>

    <custom-swiper
      class="creator-guide__swiper"
      slides-per-view="4"
      space-between="20"
      loop="false"
      centered-slides="false"
      navigation="{% if section.blocks.size > 4 %}true{% else %}false{% endif %}"
      pagination="true"
      breakpoints='{
        "0":{"slidesPerView":1.2,"spaceBetween":12},
        "480":{"slidesPerView":1.4,"spaceBetween":14},
        "768":{"slidesPerView":2.2,"spaceBetween":16},
        "1024":{"slidesPerView":3,"spaceBetween":18},
        "1280":{"slidesPerView":4,"spaceBetween":20}
      }'
    >
      <div class="swiper-container js-scroll__group">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% liquid
              assign desktop_image = block.settings.desktop_image
              assign mobile_image = block.settings.mobile_image | default: desktop_image
              assign card_link = block.settings.link
            %}

            <div class="swiper-slide" style="--reveal-index:{{ forloop.index0 }};" {{ block.shopify_attributes }}>
              {% if card_link != blank %}
                <a href="{{ card_link }}" class="creator-guide-card js-scroll__card">
              {% else %}
                <div class="creator-guide-card js-scroll__card">
              {% endif %}

                {% if desktop_image != blank %}
                  <picture class="creator-guide-card__picture">
                    {% if mobile_image != blank %}
                      <source
                        media="(max-width: 767px)"
                        srcset="
                          {{ mobile_image | image_url: width: 500 }} 500w,
                          {{ mobile_image | image_url: width: 700 }} 700w,
                          {{ mobile_image | image_url: width: 900 }} 900w
                        "
                        sizes="85vw"
                      >
                    {% endif %}

                    {{
                      desktop_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        class: 'creator-guide-card__image',
                        widths: '400,600,800,1000,1200',
                        sizes: '(max-width: 767px) 85vw, 25vw'
                    }}
                  </picture>
                {% endif %}

                <div class="creator-guide-card__overlay"></div>

                <div class="creator-guide-card__content">
                  {% if block.settings.title != blank %}
                    <h3 class="creator-guide-card__title">{{ block.settings.title }}</h3>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <div class="creator-guide-card__description">{{ block.settings.description }}</div>
                  {% endif %}

                  {% if block.settings.button_text != blank %}
                    <span class="creator-guide-card__button">{{ block.settings.button_text }}</span>
                  {% endif %}
                </div>

              {% if card_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 4 %}
        <div class="creator-guide__arrows">
          <button type="button" class="creator-guide__arrow swiper-prev" aria-label="Previous">
            <svg viewBox="0 0 30 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 1L1 9M1 9L9 17M1 9H29" stroke="currentColor"/>
            </svg>
          </button>

          <button type="button" class="creator-guide__arrow swiper-next" aria-label="Next">
            <svg viewBox="0 0 30 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M21 1L29 9M29 9L21 17M29 9H1" stroke="currentColor"/>
            </svg>
          </button>
        </div>
      {% endif %}

      <div class="creator-guide-pagination">
        <div class="swiper-pagination"></div>
      </div>
    </custom-swiper>
  </div>
</section>

{% schema %}
{
  "name": "Creator guide slider",
  "tag": "section",
  "class": "section-creator-guide-slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Loved by Creators Worldwide"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>See how real creators make Ulike part of their beauty routine.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#190A0A"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#190A0A"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "🖥 Desktop Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "📱 Mobile Settings"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "header",
          "content": "🖥 Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "header",
          "content": "📱 Mobile Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "If empty, desktop image will be used."
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "How IPL works"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>IPL principles, comparison with traditional methods, safety Q&A</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Creator guide slider",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "How IPL works",
            "description": "<p>IPL principles, comparison with traditional methods, safety Q&A</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Which one is suitable for me?",
            "description": "<p>Recommended based on skin tone, hair color and usage scenarios</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "How to use it for best results?",
            "description": "<p>Cycle Management, User Guide, Timeline of Real User Results</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Recommended Other Products",
            "description": "<p>LED face mask, skin beauty device</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}