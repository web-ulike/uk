<style>
.benefits-list {
  padding: 80px 0 120px 0;
  position: relative;
  z-index: 1;
}

.benefits-list .benefits-title {
  font-size: 60px;
  font-family: var(--heading-font-family);
  text-align: center;
  line-height: 1;
  color: #000;
}

.benefits-list .benefits-sub {
  font-size: 20px;
  color: #000;
  text-align: center;
  margin-top: 15px;
  line-height: 1.2;
}

.benefits-list .benefits-cont {
  display: flex;
  justify-content: center;
  gap: 30px;
  margin-top: 50px;
}

.benefits-list .benefits-item {
  width: calc(25% - 22.5px);
  position: relative;
  border-radius: 10px;
  overflow: hidden;
  background: linear-gradient(137deg, #f1dce0 2%, #e1daf9 110%);
}

.benefits-list .benefits-popup-icon {
  position: absolute;
  width: 30px;
  height: 30px;
  right: 11px;
  top: 11px;
  z-index: 3;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background: #b7aade;
  font-size: 16px;
  color: #fff;
  cursor: pointer;
}

.benefits-list .benefits-item-cont {
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height:100%;
  position: relative;
  z-index: 2;
}
.benefits-list .img {
  display: block;
  margin: 0 auto;
  {% comment %} width: 50%; {% endcomment %}
  height: 130px;
  width: auto;
  object-fit: contain;
}

.benefits-list .benefits-text {
  font-size: 20px;
  color: #000;
  text-align: center;
  line-height: 1.2;
  font-family: var(--heading-font-family);
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 10px;
  flex: 1;
  align-items: center;
}

.benefits-list .text-btn{
  width: 217px;
  height: 37px;
  max-width:100%;
  color: #FFEFD3;
  font-size: 20px;
  line-height: 1;
  font-family: var(--heading-font-family);
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(90deg, #F4345A 0.07%, #B4003E 99.93%);
  border-radius: 40px;
}

  .bf-diy.benefits-list{
    padding-bottom:60px;
  }

.bf-diy .img {
   width: 100%;
}

.chr-2024 .benefits-item{
  background: linear-gradient(180deg, #E9EFF9 0.3%, #F3F4F7 99.48%);
}
.chr-2024 .benefits-popup-icon{
  color:#000;
  background:linear-gradient(180deg, #f3f4f7 20%, #fff 94.92%);
}
.chr-2024 .text-btn{
  color:#fff;
  background: linear-gradient(180deg, #e0004d 0%, #ff7595 94.92%);
  transition: all 0.3s ease-in-out;
}
  .chr-2024 .text-btn:hover{
    border:1px solid #e0004d;
    background:#fff;
    color:#e0004d;
  }
  .chr-2024.benefits-list{
    background: var(--bg-url) no-repeat;
    background-size: 100% 100%;
  }
  .chr-2024.benefits-list .img {
    width:65%;
    max-width:260px;
  }
@media (min-width: 1600px) {
  .bf-diy .img {
     width: 63%;
  }
}
.bf-diy .benefits-title{
  color:transparent;
  background: linear-gradient(0deg, #fff3d4 0%, #ffe2ab 100%);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.2;
}

.bf-diy .benefits-sub{
  color: #FFF;
}
.bf-diy .benefits-item::before{
  background: linear-gradient(140deg, #3E2F23 8.06%, #070401 50.78%, #3E2F23 92.93%);
  position: absolute;
  content: '';
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  z-index: 1;
}
.bf-diy .benefits-item{
  background: linear-gradient(270deg, #ffe2ab 0.2%, #fffdf7 99.8%);
  border: 1.5px solid transparent;
}
.bf-diy .benefits-popup-icon{
  background: linear-gradient(299deg, #FFE2AB 2.42%, #FFFDF7 99.49%);
  color:#000;
}
.bf-diy .benefits-text{
  color: #FFEFD3;
  margin-top:0;
}
  .bf-diy.benefits-list::before{
  position: absolute;
  content: '';
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  z-index: 0;
  background: url(https://cdn.shopify.com/s/files/1/0656/9079/6273/files/20241115-100809.jpg) no-repeat;
  background-size: 100% 100%;
  mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
}

  .bf-diy .container{
    position: relative;
    z-index: 1;
  }

@media (max-width: 1500px) {
  .benefits-list .benefits-cont {
    gap: 20px;
  }
  .benefits-list .benefits-item {
    width: calc(25% - 15px);
  }
  .benefits-list .benefits-text {
    gap: 10px;
    margin-top: 20px;
    font-size: 16px;
  }
  /* .benefits-list .benefits-text img {
    max-height: 25px;
  } */
}

@media (max-width: 1200px) {
  .benefits-list .benefits-text {
    font-size: 14px;
  }
}

@media (max-width: 991px) {
   .bf-diy.benefits-list::before{
    background: url(https://cdn.shopify.com/s/files/1/0656/9079/6273/files/20241115-100634.jpg) no-repeat;
    background-size: 100% 100%;
  }
  .benefits-list {
    padding: 60px 0;
  }
  .benefits-list .benefits-title {
    font-size: 28px;
  }
  .benefits-list .benefits-sub {
    font-size: 14px;
    margin-top: 10px;
  }
  .benefits-list .benefits-cont {
    flex-wrap: wrap;
    margin-top: 30px;
  }
  .benefits-list .benefits-item {
    width: calc(50% - 10px);
  }
  .bf-diy .benefits-popup-icon{
    width: 20px;
    height: 20px;
    right: 6px;
    top: 6px;
  }
  .chr-2024.benefits-list{
    background: var(--bg-url-m) no-repeat;
    background-size: 100% 100%;
  }
}

@media (max-width: 640px) {
  .benefits-list .benefits-item {
    width: 100%;
  }
  .bf-diy .benefits-item ,.chr-2024 .benefits-item{
    width: calc(50% - 10px);
  }
  
   .bf-diy .benefits-item-cont{
    padding:10px;
  }
  .bf-diy .benefits-text{
    margin-top:5px;
    font-size:12px;
  }
  .bf-diy .benefits-cont{
    gap:10px;
  }
  .benefits-list .text-btn{
    height:30px;
    font-size:12px;
  }
  .chr-2024 .benefits-item-cont{
    padding:20px 10px;
  }
  .chr-2024.benefits-list .img{
    width:90%;
  }
}
  .benefits-popup {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
  display: none;
}

.benefits-popup .benefits-popup-cont {
  width: 95%;
  max-width: 340px;
  background: #fff;
  font-size: 18px;
  color: #000;
  line-height: 1.3;
  text-align: center;
  border-radius: 10px;
  padding: 30px 20px;
  font-family: var(--heading-font-family);
  box-shadow: 0px 15px 30px rgba(0, 0, 0, 0.2);
}

.benefits-popup .benefits-popup-close {
  display: none;
  position: absolute;
  right: 10px;
  top: 10px;
  width: 30px;
  height: 30px;
  cursor: pointer;
}

.benefits-popup .benefits-popup-close::before,
.benefits-popup .benefits-popup-close::after {
  content: '';
  display: block;
  position: absolute;
  width: 22px;
  height: 2px;
  background: #000;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
}

.benefits-popup .benefits-popup-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

@media (max-width: 991px) {
  .benefits-popup {
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background: rgba(0, 0, 0, 0.4);
  }
  .benefits-popup .benefits-popup-cont {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding:40px 15px;
  }
  .benefits-popup .benefits-popup-close {
    display: block;
  }
}
</style>
<section class="section-box">
  <div class="benefits-list to-top {{ section.settings.text2 }}" {% if section.settings.image != blank %}style="--bg-url:url({{ section.settings.image | image_url  }});--bg-url-m:url({{ section.settings.image1 | image_url }});"{% endif %}>
    <div class="container">
      <div class="benefits-title">{{ section.settings.text }}</div>
      {%- if section.settings.text1 != blank -%}
        <div class="benefits-sub">{{ section.settings.text1 }}</div>
      {%- endif -%}
      <div class="benefits-cont">
        {%- for block in section.blocks -%}
        <div class="benefits-item to-top" style="transition-delay: 0.{{ forloop.index }}s">
          <div class="benefits-popup-icon" data-txt="{{ block.settings.text1 }}">?</div>
          <div class="benefits-item-cont">
            {%- if block.settings.image != blank -%}
              <img loading="lazy" class="img" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" {% render 'image-attributes', image: block.settings.image %} alt="{{ block.settings.image.alt | escape }}" >
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="benefits-text">
                {{ block.settings.text }}
              </div>
            {%- endif -%}
            {%- if block.settings.image1 != blank or block.settings.image2 != blank or block.settings.btn_text != blank -%}
              <div class="benefits-text">
                {%- if block.settings.image1 != blank or block.settings.btn_text != blank -%}
                  <a href="{{ block.settings.link }}" target="_blank" {% if block.settings.btn_text != blank %}class="text-btn"{% endif %}>
                    {%- if block.settings.image2 != blank -%}
                      <img loading="lazy" width="{{ block.settings.image1.width }}" height="{{ block.settings.image1.height }}" {% render 'image-attributes', image: block.settings.image1 %} alt="{{ block.settings.image1.alt | escape }}" >
                    {%- endif -%}
                    {%- if block.settings.btn_text != blank -%}{{ block.settings.btn_text }}{%- endif -%}
                  </a>
                {%- endif -%}
                {%- if block.settings.image2 != blank -%}
                  <a href="{{ block.settings.link1 }}" target="_blank">
                    <img loading="lazy" width="{{ block.settings.image2.width }}" height="{{ block.settings.image2.height }}" {% render 'image-attributes', image: block.settings.image2 %} alt="{{ block.settings.image2.alt | escape }}" >
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  <div class="benefits-popup">
    <div class="benefits-popup-cont">
      <div class="benefits-popup-close"></div>
      <div class="benefits-popup-p">
      </div>
    </div>
  </div>
</section>
<script>
  window.addEventListener('load', function () {
    function showPopup() {
      let $p = $('.benefits-list')
      let $item = $p.find('.benefits-popup-icon')
      let $popup = $('.benefits-popup')
      if (window.innerWidth > 991) {
        $item.hover(function () {
          let index = $(this).closest('.benefits-item').index()
          let offSet = $(this).offset()
          let scrollTop = $(window).scrollTop();
          let text = $(this).attr('data-txt')
          $popup.find('.benefits-popup-p').html(text)
          let leftW = offSet.left
          if (index == $p.find('.benefits-item').length - 1) {
            leftW = offSet.left - $popup.width() + 20
          }
          $popup.css({ left: leftW + 'px', top: offSet.top - $popup.height()- scrollTop + 'px' })
          $popup.fadeIn()
        }, function () {
          $('.benefits-popup').fadeOut()
        })
      } else {
        $item.click(function () {
          let text = $(this).attr('data-txt')
          $popup.find('.benefits-popup-p').html(text)
          $popup.fadeIn()
        })

        $popup.find('.benefits-popup-close').click(function () {
          $popup.fadeOut()
        })
      }
    }
    showPopup()
  })
</script>
