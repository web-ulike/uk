<style>
   /* Luxury Video Modal 样式  */
.luxury-video-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.4s ease, visibility 0.4s ease;
}

.luxury-video-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(8px);
}

.luxury-video-content {
  position: relative;
  width: 90%;
  max-width: 1000px;
  background: #000;
  border-radius: 4px;
  
  transform: scale(0.9);
  transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); 
}

.luxury-video-overlay.is-active {
  visibility: visible;
  opacity: 1;
}

.luxury-video-overlay.is-active .luxury-video-content {
  transform: scale(1);
}
.luxury-video-wrapper {
  position: relative;
  padding-top: 56.25%; 
}

.luxury-video-wrapper video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  outline: none;
  border-radius: 4px;
}

.luxury-video-close {
  position: absolute;
  top: -40px;
  right: -10px;
  background: none;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 10px;
  transition: transform 0.3s ease;
}

.luxury-video-close:hover {
  transform: rotate(90deg);
}
body.no-scroll {
  overflow: hidden !important;
}
   /* Luxury Video Modal 样式  */
</style>

  <section>
    <luxury-video-modal id="globalVideoModal"></luxury-video-modal>
  </section>


