<div class="xmas-banner">
  <h1 class="visually-hidden">{{ section.settings.heading | escape }}</h1>
  {% assign hero = section.settings.image | default: section.settings.mobile_image %}
  <picture>
    {% if section.settings.mobile_image != blank %}
      {% assign mobile = section.settings.mobile_image %}
      <source media="(max-width: 700px)" width="{{ mobile.width }}" height="{{ mobile.height }}" srcset="{{ mobile | image_url: width: 480 }} 480w, {{ mobile | image_url: width: 780 }} 780w, {{ mobile | image_url: width: 1200 }} 1200w" sizes="100vw">
    {% endif %}
    {% if hero != blank %}
      {{ hero | image_url: width: 2400 | image_tag: widths: '480,780,1080,1440,1920,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.alt }}
    {% else %}
      <img src="{{ 'xmas-banner-1672.jpg' | asset_url }}" srcset="{{ 'xmas-banner-780.jpg' | asset_url }} 780w, {{ 'xmas-banner-1672.jpg' | asset_url }} 1672w" sizes="100vw" width="1672" height="941" loading="eager" fetchpriority="high" alt="{{ section.settings.alt | escape }}">
    {% endif %}
  </picture>
</div>

{% stylesheet %}
.xmas-banner img { display: block; width: 100%; height: auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "Christmas image banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Accessible heading",
      "default": "Glow Your Way This Christmas."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Banner description",
      "default": "Ulike Christmas Pop-Up in London. Find Christmas gift inspiration with Holly Hagan-Blyth on Oxford Street."
    }
  ],
  "presets": [
    {
      "name": "Christmas image banner"
    }
  ]
}
{% endschema %}
