{% assign hero = section.settings.image | default: section.settings.mobile_image %}
<section class="xmas-banner">
  {% if hero != blank %}
    <picture class="xmas-banner__media">
      {% if section.settings.mobile_image != blank %}
        {% assign mobile = section.settings.mobile_image %}
        <source
          media="(max-width: 700px)"
          width="{{ mobile.width }}"
          height="{{ mobile.height }}"
          srcset="{{ mobile | image_url: width: 480 }} 480w, {{ mobile | image_url: width: 780 }} 780w, {{ mobile | image_url: width: 1200 }} 1200w"
          sizes="100vw"
        >
      {% endif %}
      {{
        hero
        | image_url: width: 2880
        | image_tag:
          widths: '480,780,1080,1440,1920,2400,2880',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.alt
      }}
    </picture>
  {% endif %}
  <div class="xmas-banner__overlay">
    <div class="xmas-banner__copy">
      {% if section.settings.kicker != blank %}
        <p class="xmas-banner__kicker">{{ section.settings.kicker | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="xmas-banner__title">{{ section.settings.heading | escape | newline_to_br }}</h1>
      {% endif %}
      {% assign mobile_description = section.settings.mobile_description %}
      {% if section.settings.description != blank %}
        <p class="xmas-banner__description{% if mobile_description != blank %} xmas-banner__description--desktop{% endif %}">
          {{- section.settings.description | escape | newline_to_br -}}
        </p>
      {% endif %}
      {% if mobile_description != blank %}
        <div class="xmas-banner__description xmas-banner__description--mobile">{{ mobile_description }}</div>
      {% endif %}
      {% if section.settings.button_label != blank and section.settings.button_url != blank %}
        <a class="xmas-banner__button xmas-banner__button--desktop" href="{{ section.settings.button_url | escape }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {% endif %}
      {% assign mobile_url = section.settings.mobile_button_url | default: section.settings.button_url %}
      {% assign mobile_label = section.settings.mobile_button_label | default: section.settings.button_label %}
      {% if mobile_label != blank and mobile_url != blank %}
        <a class="xmas-banner__button xmas-banner__button--mobile" href="{{ mobile_url | escape }}">
          {{- mobile_label | escape -}}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .xmas-banner {
    display: grid;
    background: #480819;
    color: #f5c1a7;
    font-family: Saans, sans-serif;
  }
  .xmas-banner__media,
  .xmas-banner__overlay {
    grid-area: 1 / 1;
    min-width: 0;
  }
  .xmas-banner__media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .xmas-banner__overlay {
    align-self: center;
    padding: 24px 0 24px 10.4167%;
    pointer-events: none;
  }
  .xmas-banner__copy {
    display: grid;
    justify-items: start;
    gap: clamp(8px, 0.73vw, 14px);
    width: min(32vw, 408px);
    overflow-wrap: anywhere;
  }
  .xmas-banner__copy > * {
    margin: 0;
  }
  .xmas-banner__kicker {
    font-size: clamp(10px, 0.84vw, 16px);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .xmas-banner__title {
    max-width: 6.19em;
    color: #fbc693;
    font: italic 400 clamp(30px, 3.125vw, 60px) / 1.1 'Bodoni 72', Bodoni-Book, serif;
    letter-spacing: normal;
  }
  @supports (background-clip: text) {
    .xmas-banner__title {
      background: linear-gradient(87deg, #fbc693 6%, #fdfade 106%);
      background-clip: text;
      color: transparent;
    }
  }
  .xmas-banner__description {
    font-size: clamp(13px, 1.042vw, 20px);
    line-height: 1.5;
  }
  .xmas-banner__description--mobile {
    display: none;
  }
  .xmas-banner__description--mobile a {
    pointer-events: auto;
  }
  .xmas-banner__button {
    display: inline-grid;
    place-items: center;
    pointer-events: auto;
    margin-top: clamp(8px, 1.36vw, 26px);
    min-height: 48px;
    padding: 6px 37px;
    border-radius: 4px;
    color: white;
    background: #e0004d;
    font: 500 15px/1.5 Saans, sans-serif;
    text-transform: uppercase;
  }
  .xmas-banner__button--mobile {
    display: none;
  }
  @media (hover: hover) {
    .xmas-banner__button:hover {
      background-color: #a30a41;
      color: #fff;
    }
  }
  @media (max-width: 700px) {
    .xmas-banner__overlay {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 11px 16px;
    }
    .xmas-banner__overlay::before {
      content: '';
      height: 13.14%;
      min-height: 24px;
      flex-shrink: 0;
    }
    .xmas-banner__copy {
      width: min(100%, 215px);
      justify-items: center;
      gap: 5px;
      text-align: center;
      color: #f9d1bd;
    }
    .xmas-banner__kicker {
      font-size: 10px;
      line-height: 1.5;
      letter-spacing: normal;
    }
    .xmas-banner__title {
      max-width: none;
      background: none;
      color: inherit;
      font-size: 28px;
      font-style: normal;
      line-height: 1.2;
    }
    .xmas-banner__description {
      font-size: 12px;
    }
    .xmas-banner__description--desktop,
    .xmas-banner__button--desktop {
      display: none;
    }
    .xmas-banner__description--mobile {
      display: block;
    }
    .xmas-banner__button--mobile {
      display: inline-grid;
      margin-top: 11px;
      min-height: 38px;
      padding: 10px 30px;
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Christmas image banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "Ulike Christmas Pop-Up · London"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Glow Your Way This Christmas."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Banner description",
      "default": "Ulike Christmas Pop-Up in London. Find Christmas gift inspiration with Holly Hagan-Blyth on Oxford Street."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Find Christmas gift inspiration with Holly Hagan-Blyth on Oxford Street."
    },
    {
      "type": "html",
      "id": "mobile_description",
      "label": "Mobile description (HTML)",
      "info": "Leave blank to use Description on mobile."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Desktop button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Desktop button link"
    },
    {
      "type": "text",
      "id": "mobile_button_label",
      "label": "Mobile button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "mobile_button_url",
      "label": "Mobile button link"
    }
  ],
  "presets": [
    {
      "name": "Christmas image banner"
    }
  ]
}
{% endschema %}
