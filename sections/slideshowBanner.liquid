          "label": "Title size - PC",
          "min": 30,
          "max": 130,
          "step": 1,
          "unit": "px",
          "default": 64
        },
        {
          "type": "range",
          "id": "title_logo_text_size_pc",
          "label": "Text size - PC",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 20
        },
        {
          "type": "color",
          "id": "title_logo_subtle_color_pc",
          "label": "subTitle color - PC",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "title_logo_tle_color_pc",
          "label": "Title color - PC",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "title_logo_text_color_pc",
          "label": "Text color - PC",
          "default": "#ffffff"
        },

        {
          "type": "header",
          "content": "Font - Mobile"
        },
                  {
            "type": "checkbox",
