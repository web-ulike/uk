          "id": "tag_background",
          "label": "Tag Background Color",
          "default": "#E0004D"
        },
        {
          "type": "color",
          "id": "tag_text_color",
          "label": "Tag Text Color",
          "default": "#ffffff"
        },
        {
          "type": "header",
          "content": "Font - Desktop"
        },
        {
          "type": "range",
          "id": "title_logo_width_pc",
          "label": "Logo width - PC",
          "min": 20,
          "max": 1000,
          "step": 10,
          "unit": "px",
          "default": 300
        },
        {
          "type": "range",
          "id": "title_logo_subtle_size_pc",
          "label": "subTitle size - PC",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
