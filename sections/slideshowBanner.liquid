<style>
    #shopify-section-{{ section.id }} {
      --progress-bar-color: {{ section.blocks.first.settings.text_color.red }}, {{ section.blocks.first.settings.text_color.green }}, {{ section.blocks.first.settings.text_color.blue }};
      --section-autoplay-duration: {% if section.settings.autoplay %}{{ section.settings.cycle_speed }}s{% else %}0s{% endif %};
      --section-animation-play-state: paused;
      background-color: {{ section.settings.background }}; /* Allows to set a placeholder color while loading */
    }

    {%- for block in section.blocks -%}
      {%- assign text_position = block.settings.text_position | split: '_' | first -%}
       {%- assign mobile_text_position = block.settings.mobile_text_position | split: '_' | first -%}

      {%- case text_position -%}
        {%- when 'top' -%}
          {%- assign section_items_alignment = 'flex-start' -%}
        {%- when 'middle' -%}
          {%- assign section_items_alignment = 'center' -%}
        {%- when 'bottom' -%}
          {%- assign section_items_alignment = 'flex-end' -%}
      {%- endcase -%}

      {%- case mobile_text_position -%}
        {%- when 'top' -%}
          {%- assign mobile_section_items_alignment = 'flex-start' -%}
        {%- when 'middle' -%}
          {%- assign mobile_section_items_alignment = 'center' -%}
        {%- when 'bottom' -%}
          {%- assign mobile_section_items_alignment = 'flex-end' -%}
      {%- endcase -%}

      #block-{{ section.id }}-{{ block.id }} {
        --heading-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
        --text-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
        --primary-button-background: {{ block.settings.button_background }};
        --primary-button-text-color: {{ block.settings.button_text_color }};

        --button-text-color-second: {{ block.settings.button_text_color_second }};
        --button-background-color-second: {{ block.settings.button_background_second }};

        --section-blocks-alignment: {{ section_items_alignment }};
        --section-mobile-blocks-alignment: {{ mobile_section_items_alignment }};

        --section-blocks-overlay-color: {{ block.settings.overlay_color.red }}, {{ block.settings.overlay_color.green }}, {{ block.settings.overlay_color.blue }};
        --section-blocks-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
        --grid-gap:0;

          --title-logo-width-pc: {{ block.settings.title_logo_width_pc }}px;
           --title-logo-subtitle-size-pc: {{ block.settings.title_logo_subtle_size_pc }}px;
          --title-logo-title-size-pc: {{ block.settings.title_logo_tle_size_pc }}px;
          --title-logo-text-size-pc: {{ block.settings.title_logo_text_size_pc }}px;
           --title-logo-subtitle-color-pc: {{ block.settings.title_logo_subtle_color_pc }};
          --title-logo-title-color-pc: {{ block.settings.title_logo_tle_color_pc }};
          --title-logo-text-color-pc: {{ block.settings.title_logo_text_color_pc }};

          --title-logo-width-mobile: {{ block.settings.title_logo_width_mobile }}px;
          --title-logo-subtitle-size-mobile: {{ block.settings.title_logo_subtle_size_mobile }}px;
          --title-logo-title-size-mobile: {{ block.settings.title_logo_tle_size_mobile }}px;
          --title-logo-text-size-mobile: {{ block.settings.title_logo_text_size_mobile }}px;
           --title-logo-subtitle-color-mobile: {{ block.settings.title_logo_subtle_color_mobile }};
          --title-logo-title-color-mobile: {{ block.settings.title_logo_tle_color_mobile }};
          --title-logo-text-color-mobile: {{ block.settings.title_logo_text_color_mobile }};
          --tag-border-radius-pc:{{ block.settings.tag_size_pc }}px;
          --tag-border-radius-mb:{{ block.settings.tag_size_mb }}px;
           --content-padding-mobile:{{ block.settings.content_padding_mobile}}px;
      }
    {%- endfor -%}
     .slide-show__title p{
      margin:0 !important;
      }
       .slide-show__txt p{
         margin:0 !important;
      }
          .slide-show__sub{
        font-size: var(--title-logo-subtitle-size-mobile);
        color: var(--title-logo-subtitle-color-mobile);
         line-height: normal;
      }
      .slide-show__title{
        font-size: var(--title-logo-title-size-mobile);
        color: var(--title-logo-title-color-mobile);
        margin: 10px 0;
         line-height: 1.2;
      }
      .slide-show__txt{
       font-size: var(--title-logo-text-size-mobile);
        color: var(--title-logo-text-color-mobile);
          line-height: 1.5;
      }
      .slideshow__slide .button-group, .slideshow__slide .button-wrapper{
       margin-top:16px;
      }

        .slideshow__slide .button-group__wrapper {
          display: inline-grid;
          gap: 7px;
          grid-template-columns: 1fr 1fr;
              margin: 0;
      }
      .slideshow-button{
          display: inline-flex;
          {% comment %} width: 155px;
          height: 48px; {% endcomment %}
          padding: 13px 25px;
          justify-content: center;
          align-items: center;
          gap: 10px;
          border-radius: 4px;
          color: var(--primary-button-text-color);
          text-align: center;
          font-size: 12px;
          font-style: normal;
          font-family: var(--heading-font-family);
          line-height: 1;
          background:var(--primary-button-background);
          transition: all 0.4s ease;
      }

       .slideshow-button.slideshow-button--primary{
          color: var(--button-text-color-second);
          background:var(--button-background-color-second);
      }
   .slideshow-button:hover{
  opacity:0.6;
  }
  .slideshow__progress-bar:before, .slideshow__progress-bar:after{
  background:#FBFAF4;
  }
  .slideshow__progress-bar:after {
      background: #190A0A;
  }
  .slideshow {
  --progress-bar-color:#190A0A;
  }

  .slide-show-title_logo {
            display: block;
      width: var(--title-logo-width-mobile);
          margin-bottom: 15px;
          margin-top: 15px;
      max-width: 100%;
      height: auto;
  }
  .slideshow .slide-show-title_logo img {
      display: block;
      margin: 0;
      width: 100%;
      height: 100%;
  }
  .content-box--text-center .slide-show-title_logo  {
              margin-left: auto;
          margin-right: auto;
  }
  [dir=ltr] .content-box--text-right .slide-show-title_logo {
      margin-right: 0;
          margin-left: auto;
  }
  [dir=rtl] .content-box--text-right .slide-show-title_logo {
      margin-left: 0;
         margin-right: auto;
  }
         .js #shopify-section-header.dark-diy .header--transparent {
         --header-text-color: 0, 0, 0;
       }

     .js .dark-diy .header--transparent .header__logo-image--transparent{
       opacity: 0;
     }
     .js .dark-diy .header--transparent .header__logo-image:not(:last-child){
       opacity: 1;
     }
native-video{display:block}
native-video video{display:block;width:100%;height:100%}
    @media screen and (min-width: 741px) {
      .slide-show__sub{
        font-size: var(--title-logo-subtitle-size-pc);
        color: var(--title-logo-subtitle-color-pc);

      }
      .slide-show__title{
        font-size: var(--title-logo-title-size-pc);
        color: var(--title-logo-title-color-pc);
        line-height: 1.1;
        margin: 16px 0;
      }
      .slide-show__txt{
       font-size: var(--title-logo-text-size-pc);
        color: var(--title-logo-text-color-pc);
      }
      .slideshow__slide .button-group, .slideshow__slide .button-wrapper{
       margin-top:40px;
      }
            .slideshow__slide .button-group__wrapper {
          gap: 32px;
      }
          .slideshow-button{
          padding: 17px 40px;
          gap: 10px;
          border-radius: 4px;
          font-size: 14px;
      }
      .slide-show-title_logo {
      margin-bottom: 25px;
      margin-top: 25px;
      width: var(--title-logo-width-pc);
  }
   }
   @media screen and (max-width: 740px) {
      .slideshow__text-wrapper--mobile-top.vertical-breather {
          padding-block-start: max(var(--vertical-breather), calc((var(--header-height) + 20px) * var(--enable-transparent-header)));
      }
        .slideshow__text-wrapper--mobile-top.vertical-breather.vertical-breather__custom {
          padding-block-start: var(--content-padding-mobile);
      }
      .slideshow__text-wrapper--mobile-bottom.vertical-breather.vertical-breather__custom {
          padding-block-end: var(--content-padding-mobile);
      }
     [dir="ltr"] .content-box--mobile-left {
      margin-right: auto;
    }

    [dir="rtl"] .content-box--mobile-left {
      margin-left: auto;
    }

    [dir="ltr"] .content-box--mobile-right {
      margin-left: auto;
    }

    [dir="rtl"] .content-box--mobile-right {
      margin-right: auto;
    }

    [dir="ltr"] .content-box--mobile-center, [dir="rtl"] .content-box--mobile-center{
        margin-left: 24px;
      margin-right: 24px;
    }

  [dir="ltr"]  .content-box--mobile-text-center,[dir="rtl"]  .content-box--mobile-text-center  {
    text-align: center;
  }

  [dir="ltr"] .content-box--mobile-text-right {
    text-align: right;
  }

  [dir="rtl"]  content-box--mobile-text-right {
    text-align: left;
  }

  [dir="ltr"] .content-box--mobile-text-left {
    text-align: left;
  }

  [dir="rtl"]  content-box--mobile-text-left {
    text-align: right;
  }
  [dir="ltr"]  .content-box--mobile-text-center .slide-show-title_logo,[dir="rtl"]  .content-box--mobile-text-center  .slide-show-title_logo{
        margin-left: auto;
     margin-right: auto;
  }

  [dir="ltr"] .content-box--mobile-text-right  .slide-show-title_logo{
      margin-right: 0;
      margin-left: auto;
  }

  [dir="rtl"]  content-box--mobile-text-right .slide-show-title_logo {
      margin-left: 0;
         margin-right: auto;
  }

  [dir="ltr"] .content-box--mobile-text-left .slide-show-title_logo{
      margin-left: 0;
         margin-right: auto;
  }

  [dir="rtl"]  content-box--mobile-text-left .slide-show-title_logo {
      margin-right: 0;
          margin-left: auto;
  }


  }


  .slideshow__controls {
      position: absolute;
      left: 50%;
      display: flex;
      transform: translateX(-50%);
      padding: 0 24px;
      z-index: 2;
      pointer-events: none;
      bottom: 34px;
             width: 284px;
             gap:26px;
  }

  .slideshow__controls .slideshow__arrow {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    color: #190A0A;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .slideshow__controls .slideshow__arrow:hover {
    transform: scale(1.05);
  }
  .slideshow__controls .slideshow__nav{
  position: static;
      transform: translateX(0%);
      padding: 0;
      align-items: center;
  }
.slideshow__progress-bar{
  margin: 0 4px;
flex-basis: 24px;
    overflow: hidden;
    display: block;
    border-radius: 23px;
    transition: all .4s;
        padding: 0;
        height: 6px;
}
.slideshow__progress-bar[aria-current="true"]{
flex-basis: 60px;
}
.slideshow__progress-bar:before, .slideshow__progress-bar:after {
    height: 6px;
    top: calc(50% - 3px);
    border-radius: 23px;
}
.slideshow .slideshow-tag {
    display: inline-flex;
    font-size: 14px;
    color: #fff;
    line-height: 1.2;
    padding: 5px 12px;
    position: relative;
    overflow: hidden;
    border-radius: var(--tag-border-radius-pc);
    background: #E0004D;
}
.slideshow .slideshow-tag::before {
    position: absolute;
    content: '';
    display: block;
    width: 200%;
    height: 200%;
    z-index: 2;
    background: linear-gradient(-45deg, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.5) 50%, rgba(255, 255, 255, 0) 60%);
    animation: slideshowScanning 2.2s linear infinite;
}
  @keyframes slideshowScanning {
        0% {
            transform: translate(-50%, -50%);
        }
        100% {
            transform: translate(50%, 50%);
        }
    }
  @media screen and (max-width: 740px) {
    .slideshow__controls {
      padding: 0 12px;
          bottom: 15px;
    }

     .slideshow__controls .slideshow__arrow { display: none; }
     .slideshow__progress-bar{
      margin: 0 4px;
flex-basis: 18px;
    border-radius: 17px;
            height: 5px;
    }
    .slideshow__progress-bar[aria-current="true"]{
flex-basis: 45px;
}
.slideshow__progress-bar:before, .slideshow__progress-bar:after {
    height: 5px;
    top: calc(50% - 2.5px);
    border-radius: 17px;
}
.slideshow .slideshow-tag {
    border-radius: var(--tag-border-radius-mb);
}
.slideshow__slide-inner.slideshow__slide-inner_cus_container .container{
padding-left:0;
padding-right:0;
}
  }
</style>

<section class="section section--flush">
  <slide-show
    {% if section.settings.show_initial_transition %}
      reveal-on-scroll
    {% endif %}
    {% if section.settings.autoplay %}
      auto-play
    {% endif %}
    transition-type="{{ section.settings.transition_type | escape }}"
    class="slideshow slideshow--{{ section.settings.section_height }}"
  >
    <div class="slideshow__slide-list">
      {%- for block in section.blocks -%}
        {%- comment -%}
          ------------------------------------------------------------------------------------------------------------------
          IMAGE PART
          ------------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

        {%- assign image = block.settings.image -%}
        {%- assign split_image = block.settings.split_image -%}
        {%- assign mobile_image = block.settings.mobile_image -%}
        {%- assign video = block.settings.video -%}
        {%- assign mobile_video = block.settings.mobile_video -%}

        {%- assign image_aspect_ratio = image.aspect_ratio | default: 2.63 -%}

        {%- comment -%}
          If the image is split and that we want to preserve the ratio, we have to multiply the ratio by 2 (as each image
          only account for half the screen size)
        {%- endcomment -%}

        {%- if image != blank and split_image != blank and section.settings.section_height == 'auto' -%}
          {%- assign image_aspect_ratio = image_aspect_ratio | times: 2.0 -%}
        {%- endif -%}

        {%- if forloop.index > 2 -%}
          {%- assign loading_attribute_value = 'lazy' -%}
        {%- else -%}
          {%- assign loading_attribute_value = 'eager' -%}
        {%- endif -%}

        {% comment %}
          {%- capture slide_content -%}
          <div class="slideshow__image-wrapper {% if mobile_image != blank %}hidden-pocket{% endif %}" {% if section.settings.transition_type == 'reveal' and section.settings.show_initial_transition or forloop.first == false %}reveal-visibility{% endif %}>
            {%- if image != blank -%}
              {%- capture sizes_attributes -%}{% if split_image != blank %}(min-width: 1000px) 50vw{% else %}100vw{% endif %}{%- endcapture -%}
              {{- image | image_url: width: 3000 | image_tag: loading: loading_attribute_value, draggable: false, class: 'slideshow__image', sizes: sizes_attributes, widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000' -}}
            {%- else -%}
              {% capture image_name %}lifestyle-{% cycle '1', '2' %}{%- endcapture -%}
              {{- image_name | placeholder_svg_tag: 'slideshow__image slideshow__image--placeholder' -}}
            {%- endif -%}
          </div>

          {%- comment -%}If a second image (split image) is uploaded, we use it. Note that we use the same ratio as the first image (to have equal column height){% endcomment %}
          {%- if image != blank and split_image != blank -%}
            <div class="slideshow__image-wrapper slideshow__image-wrapper--secondary hidden-pocket" {% if section.settings.transition_type == 'reveal' and section.settings.show_initial_transition or forloop.first == false %}reveal-visibility{% endif %}>
              {{- split_image | image_url: width: 3000 | image_tag: loading: loading_attribute_value, draggable: false, class: 'slideshow__image', sizes: '50vw', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000' -}}
            </div>
          {%- endif -%}

          {%- if mobile_image != blank -%}
            <div class="slideshow__image-wrapper hidden-lap-and-up" {% if section.settings.transition_type == 'reveal' and section.settings.show_initial_transition or forloop.first == false %}reveal-visibility{% endif %}>
              {{- mobile_image | image_url: width: 3000 | image_tag: loading: loading_attribute_value, draggable: false, class: 'slideshow__image', sizes: '100vw', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000' -}}
            </div>
          {%- endif -%}

          {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          CONTENT PART
          ----------------------------------------------------------------------------------------------------------------
          {%- endcomment -%}
        {% endcomment %}

        {%- capture slide_content -%}
            <div class="slideshow__image-wrapper {% if mobile_image != blank or mobile_video != blank %}hidden-pocket{% endif %}" {% if section.settings.transition_type == 'reveal' and section.settings.show_initial_transition or forloop.first == false %}reveal-visibility{% endif %}>
              {%- if video != blank -%}
                <native-video autoplay class="slideshow__image-wrapper{% if mobile_video != blank or mobile_image != blank %} hidden-pocket{% endif %}" data-device="{% if mobile_video != blank or mobile_image != blank %}desktop{% else %}all{% endif %}">
                  <template>
                    {{- video | video_tag: controls: false, autoplay: true, muted: true, playsinline: true, loop: true, preload: 'none', class: 'slideshow__image slideshow__video' -}}
                  </template>
                </native-video>
              {%- elsif image != blank -%}
                {%- capture sizes_attributes -%}{% if split_image != blank %}(min-width: 1000px) 50vw{% else %}100vw{% endif %}{%- endcapture -%}
                {{ image | image_url: width: 3000 | image_tag: loading: loading_attribute_value, draggable: false, class: 'slideshow__image', sizes: sizes_attributes, widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000' }}
              {%- else -%}
                {%- capture image_name -%}lifestyle-{% cycle '1', '2' %}{%- endcapture -%}
                {{ image_name | placeholder_svg_tag: 'slideshow__image slideshow__image--placeholder' }}
              {%- endif -%}
            </div>
            {%- if image != blank and split_image != blank and video == blank -%}
            <div class="slideshow__image-wrapper slideshow__image-wrapper--secondary hidden-pocket" {% if section.settings.transition_type == 'reveal' and section.settings.show_initial_transition or forloop.first == false %}reveal-visibility{% endif %}>
              {{ split_image | image_url: width: 3000 | image_tag: loading: loading_attribute_value, draggable: false, class: 'slideshow__image', sizes: '50vw', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000' }}
            </div>
            {%- endif -%}
            {%- if mobile_video != blank or mobile_image != blank -%}
            <div class="slideshow__image-wrapper hidden-lap-and-up" {% if section.settings.transition_type == 'reveal' and section.settings.show_initial_transition or forloop.first == false %}reveal-visibility{% endif %}>
              {%- if mobile_video != blank -%}
                <native-video autoplay class="slideshow__image-wrapper hidden-lap-and-up" data-device="mobile">
                  <template>
                    {{- mobile_video | video_tag: controls: false, autoplay: true, muted: true, playsinline: true, loop: true, preload: 'none', class: 'slideshow__image slideshow__video' -}}
                  </template>
                </native-video>
              {%- elsif mobile_image != blank -%}
                {{ mobile_image | image_url: width: 3000 | image_tag: loading: loading_attribute_value, draggable: false, class: 'slideshow__image', sizes: '100vw', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000' }}
              {%- endif -%}
            </div>
            {%- endif -%}

          {%- capture section_content -%}
            {%- if block.settings.subheading != blank -%}
              <div class="slide-show__sub">
                <split-lines {% if section.settings.transition_type != 'fade' and section.settings.show_initial_transition or forloop.first == false %}reveal{% endif %}>{{ block.settings.subheading | escape }}</split-lines>
              </div>
            {%- endif -%}

            
             {%- if block.settings.tag_txt != blank -%}
                  <div class="slideshow-tag img_reveal_animate" style="background:{{ block.settings.tag_background }};color:{{ block.settings.tag_text_color }};">{{ block.settings.tag_txt }}</div>
              {%- endif -%}


              {%- if block.settings.title_logo_image != blank -%}
               <picture class="slide-show-title_logo img_reveal_animate" reveal>
                     {%- if block.settings.mobile_title_logo_image -%}
              <source media="(max-width: 767px)" srcset="{{ block.settings.mobile_title_logo_image | image_url}}">
                {%- endif -%}
              {%- if block.settings.title_logo_image -%}
              <img class="slide-show-title_logo_img" src="{{ block.settings.title_logo_image | image_url }}" alt="{{ block.settings.title_logo_image.alt }}">
              {%- endif -%}
                </picture>
              {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h2 class="slide-show__title js-slide-show__title">
              {{ block.settings.title }}
              </h2>
            {%- endif -%}

             {%- if block.settings.txt != blank -%}
              <div class="slide-show__txt js-slide-show__txt">
                {{ block.settings.txt  }}
              </div>
            {%- endif -%}

            


            {%- capture buttons -%}
              {%- if block.settings.button_1_text != blank -%}
                <a href="{{ block.settings.button_1_link }}" class="slideshow-button">{{ block.settings.button_1_text | escape }}</a>
              {%- endif -%}

              {%- if block.settings.button_2_text != blank -%}
                <a href="{{ block.settings.button_2_link }}" class="slideshow-button slideshow-button--primary">{{ block.settings.button_2_text | escape }}</a>
              {%- endif -%}

            {%- endcapture -%}

            {%- if block.settings.button_1_text != blank and block.settings.button_2_text != blank -%}
              <div class="button-group" {% if section.settings.transition_type != 'fade' and section.settings.show_initial_transition or forloop.first == false %}reveal{% endif %}>
                <div class="button-group__wrapper">
                  {{- buttons -}}
                </div>
              </div>
            {%- elsif buttons != blank -%}
              <div class="button-wrapper" {% if section.settings.transition_type != 'fade' and section.settings.show_initial_transition or forloop.first == false %}reveal{% endif %}>
                {{- buttons -}}
              </div>
            {%- endif -%}
          {%- endcapture -%}

          {%- if section_content != blank -%}
            <div class="container">
              {%- assign text_alignment = block.settings.text_position | split: '_' | first -%}
              {%- assign text_position = block.settings.text_position | split: '_' | last -%}
              {%- assign mobile_text_alignment = block.settings.mobile_text_position | split: '_' | first -%}
              {%- assign mobile_text_position = block.settings.mobile_text_position | split: '_' | last -%}
              <div class="slideshow__text-wrapper slideshow__text-wrapper--{{ text_alignment }}  slideshow__text-wrapper--mobile-{{ mobile_text_alignment }} vertical-breather {% if block.settings.is_custom_content_padding == true %} vertical-breather__custom{% endif %}">
                <div class="content-box content-box--medium content-box--text-{{ text_position }} content-box--{{ text_position }}  content-box--mobile-text-{{ mobile_text_position }} content-box--mobile-{{ mobile_text_position }} text-container">
                  {{- section_content -}}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endcapture -%}

        {%- comment -%}If only the button 1 link is filled, then we make the whole slide clickable{%- endcomment -%}

        {%- capture slide_attributes -%}
          {{ block.shopify_attributes }}
          id="block-{{ section.id }}-{{ block.id }}"
          class="slideshow__slide {% if split_image != blank %}slideshow__slide--split{% endif %} {% if section.settings.transition_type == 'sweep' %}slideshow__slide--sweep{% endif %}"
          {% unless forloop.first %}hidden{% endunless %}
          {% if section.settings.section_height == 'auto' %}
            style="--image-aspect-ratio: {{ image_aspect_ratio }}; --mobile-image-aspect-ratio: {{ mobile_image.aspect_ratio | default: image_aspect_ratio | default: 1 }};"
          {% endif %}
        {%- endcapture -%}

        <slide-show-item
          {% if section.settings.transition_type != 'reveal'
            and section.settings.show_initial_transition
            or forloop.first == false
          %}
            reveal-visibility
          {% endif %}
          {{ slide_attributes }}
        >
          {%- if block.settings.button_1_link != blank
            and block.settings.button_1_text == blank
            and block.settings.button_2_text == blank
          -%}
            <a class="slideshow__slide-inner {%  if block.settings.is_custom_container_padding_mb == true %}  slideshow__slide-inner_cus_container{% endif %}" href="{{ block.settings.button_1_link }}">
              {{- slide_content -}}
            </a>
          {%- else -%}
            <div class="slideshow__slide-inner {%  if block.settings.is_custom_container_padding_mb == true %}  slideshow__slide-inner_cus_container{% endif %}">
              {{- slide_content -}}
            </div>
          {%- endif -%}
        </slide-show-item>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="slideshow__controls">
        <button type="button" class="slideshow__arrow slideshow__arrow--prev" aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="23" viewBox="0 0 30 23" fill="none">
            <g clip-path="url(#clip0_3221_3000)">
              <path d="M1.90735e-06 11.4924C1.90735e-06 11.6739 0.067318 11.8539 0.196098 11.9915L10.44 22.9671L11.5098 21.969L2.41463 12.2242H30C30 11.4164 29.3444 10.7607 28.5366 10.7607H0.765366C0.488781 10.7607 0.219515 10.8998 0.0878067 11.1442C0.0278072 11.2539 1.90735e-06 11.3739 1.90735e-06 11.4924Z" fill="#190A0A"/>
              <path d="M1.53121 8.92683C2.10341 9.49756 3.02975 9.49756 3.60048 8.92683L11.4941 1.03463L10.4595 0L1.53268 8.92683H1.53121Z" fill="#190A0A"/>
            </g>
            <defs>
              <clipPath id="clip0_3221_3000">
                <rect width="30" height="22.9683" fill="white" transform="matrix(-1 0 0 1 30 0)"/>
              </clipPath>
            </defs>
          </svg>
        </button>
        <page-dots
          {% if section.settings.autoplay %}
            animation-timer
          {% endif %}
          class="slideshow__nav container"
        >
          {%- for block in section.blocks -%}
            <button
              class="slideshow__progress-bar"
              aria-controls="block-{{ section.id }}-{{ block.id }}"
              data-color="{{ block.settings.color_reverse }}"
              {% if forloop.first %}
                aria-current="true"
              {% endif %}
            >
              <span class="visually-hidden">{{ 'general.accessibility.go_to_slide' | t: num: forloop.index }}</span>
            </button>
          {%- endfor -%}
        </page-dots>

        <button type="button" class="slideshow__arrow slideshow__arrow--next" aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="23" viewBox="0 0 30 23" fill="none">
            <g clip-path="url(#clip0_3221_3004)">
              <path d="M30 11.4924C30 11.6739 29.9327 11.8539 29.8039 11.9915L19.56 22.9671L18.4902 21.969L27.5854 12.2242H0C0 11.4164 0.65561 10.7607 1.46341 10.7607H29.2346C29.5112 10.7607 29.7805 10.8998 29.9122 11.1442C29.9722 11.2539 30 11.3739 30 11.4924Z" fill="#190A0A"/>
              <path d="M28.4688 8.92683C27.8966 9.49756 26.9702 9.49756 26.3995 8.92683L18.5059 1.03463L19.5405 0L28.4673 8.92683H28.4688Z" fill="#190A0A"/>
            </g>
            <defs>
              <clipPath id="clip0_3221_3004">
                <rect width="30" height="22.9683" fill="white"/>
              </clipPath>
            </defs>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </slide-show>
</section>

{% schema %}
{
  "name": "SlideshowBanner",
  "class": "shopify-section--slideshow",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        {
          "value": "auto",
          "label": "Original image ratio"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "fit",
          "label": "Fit screen height"
        }
      ],
      "info": "Choose \"Original image ratio\" to not cut images. [Learn more](https://help.shopify.com/en/manual/online-store/images/theme-images#best-practices-for-slideshows-and-full-width-images)",
      "default": "auto"
    },
    {
      "type": "select",
      "id": "transition_type",
      "label": "Transition type",
      "options": [
        {
          "value": "sweep",
          "label": "Sweep"
        },
        {
          "value": "reveal",
          "label": "Reveal"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ],
      "default": "sweep"
    },
    {
      "type": "checkbox",
      "id": "show_initial_transition",
      "label": "Show initial transition",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate between slides",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "sec",
      "label": "Change slides every",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "info": "Used while slideshow image is loading",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
          {
          "type": "checkbox",
          "id": "color_reverse",
          "label": "Header text color reverse",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image",
          "info": "2160 x 1080px .jpg recommended, 1080 x 1080px .jpg recommended if split",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "If a video is selected, it will be used instead of the desktop image."
        },
        {
          "type": "image_picker",
          "id": "split_image",
          "info": "1080 x 1080px .jpg recommended. Won't show up on mobile.",
          "label": "Split image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "1000 x 1400px .jpg recommended. If none is set, desktop image will be used."
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video",
          "info": "If a mobile video is selected, it will be used instead of the mobile image."
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            {
              "value": "top_left",
              "label": "Top left"
            },
            {
              "value": "top_center",
              "label": "Top center"
            },
            {
              "value": "top_right",
              "label": "Top right"
            },
            {
              "value": "middle_left",
              "label": "Middle left"
            },
            {
              "value": "middle_center",
              "label": "Middle center"
            },
            {
              "value": "middle_right",
              "label": "Middle right"
            },
            {
              "value": "bottom_left",
              "label": "Bottom left"
            },
            {
              "value": "bottom_center",
              "label": "Bottom center"
            },
            {
              "value": "bottom_right",
              "label": "Bottom right"
            }
          ],
          "default": "middle_center"
        },
        {
          "type": "select",
          "id": "mobile_text_position",
          "label": "Mobile Text position",
          "options": [
            {
              "value": "top_left",
              "label": "Top left"
            },
            {
              "value": "top_center",
              "label": "Top center"
            },
            {
              "value": "top_right",
              "label": "Top right"
            },
            {
              "value": "middle_left",
              "label": "Middle left"
            },
            {
              "value": "middle_center",
              "label": "Middle center"
            },
            {
              "value": "middle_right",
              "label": "Middle right"
            },
            {
              "value": "bottom_left",
              "label": "Bottom left"
            },
            {
              "value": "bottom_center",
              "label": "Bottom center"
            },
            {
              "value": "bottom_right",
              "label": "Bottom right"
            }
          ],
          "default": "middle_center"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Slide subheading"
        },
        {
          "type": "richtext",
          "id": "title",
