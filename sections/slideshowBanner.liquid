          "info": "Title Logo"
        },
        {
          "type": "image_picker",
          "id": "mobile_title_logo_image",
          "label": "Mobile Title image",
          "info": "Mobile Title Logo"
        },
        {
          "type": "richtext",
          "id": "txt",
          "label": "Text",
          "default": "<p>Tell your story</p>"
        },
        {
          "type": "text",
          "id": "button_1_text",
          "label": "Button 1 text"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Button 1 link",
          "info": "Leave the \"Button 1 text\" and \"Button 2\" settings empty to make the slide fully clickable."
        },
        {
          "type": "text",
          "id": "button_2_text",
          "label": "Button 2 text"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Button 2 link"
        },

       {
          "type": "header",
          "content": "Tag Active"
        },

         {
