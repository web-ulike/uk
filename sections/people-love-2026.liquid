<style>
.people-love-2026 { position:relative; width:100%; overflow:hidden; padding:var(--padding-top) 0 var(--padding-bottom); background:var(--background); color:#1a1a1a; font-family:Saans, sans-serif; }
.people-love-2026 * { box-sizing:border-box; }
.people-love-2026__container { max-width:1560px; padding:0 20px; margin:0 auto; }
.people-love-2026__header { display:flex; align-items:flex-end; justify-content:space-between; gap:32px; margin-bottom:60px; }
.people-love-2026__title { margin:0; color:inherit; font-family:Saans, sans-serif; font-size:48px; font-weight:500; line-height:1.2; }
.people-love-2026__title p { margin:0; }
.people-love-2026__navigation { display:flex; flex-shrink:0; gap:30px; padding:0 3px 13px 0; }
.people-love-2026__arrow { position:relative; display:flex; align-items:center; justify-content:center; width:31.35px; height:24px; padding:0; border:0; background:transparent; cursor:pointer; }
.people-love-2026__arrow::before { position:absolute; inset:-10px; content:''; }
.people-love-2026__arrow:focus-visible, .people-love-2026__play:focus-visible { outline:2px solid #1a1a1a; outline-offset:5px; }
.people-love-2026__arrow:disabled { opacity:.25; cursor:default; }
.people-love-2026__arrow-icon { position:relative; display:block; overflow:hidden; width:31.35px; height:24px; pointer-events:none; }
.people-love-2026__arrow-icon img { position:absolute; top:0; left:-61.35px; max-width:none; }
.people-love-2026__arrow--prev .people-love-2026__arrow-icon { transform:scaleX(-1); }
.people-love-2026__arrow-mobile { display:none; }
.people-love-2026 .swiper-container { width:100%; overflow:hidden; }
.people-love-2026 .swiper-wrapper { align-items:stretch; }
.people-love-2026 .swiper-slide { width:376px; height:auto; flex-shrink:0; }
.people-love-2026__card { position:relative; width:376px; height:460px; overflow:hidden; border-radius:8px; }
.people-love-2026__review { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:24px; background:var(--card-background); text-align:center; }
.people-love-2026__stars { flex-shrink:0; margin-bottom:59px; }
.people-love-2026__stars img { display:block; width:121px; height:21.718px; }
.people-love-2026__review-title { margin:0; font-family:inherit; font-size:30px; font-weight:400; line-height:1.2; }
.people-love-2026__review-text { width:100%; margin:24px 0 0; font-size:18px; line-height:1.2; }
.people-love-2026__review-text p { margin:0; }
.people-love-2026__review-author { margin-top:59px; }
.people-love-2026__review-name { margin:0; font-family:inherit; font-size:24px; font-weight:500; line-height:1.2; }
.people-love-2026__review-meta { display:flex; align-items:center; justify-content:center; gap:8px; margin-top:4px; color:#8b8b8b; font-size:14px; line-height:1.2; }
.people-love-2026__verified, .people-love-2026__verified img { display:block; width:16px; height:16px; }
.people-love-2026__video-card { background:#f8f8f8; }
.people-love-2026__video-media, .people-love-2026__video-cover, .people-love-2026__video { position:absolute; inset:0; display:block; width:100%; height:100%; }
.people-love-2026__video-cover, .people-love-2026__video { object-fit:cover; }
.people-love-2026__fallback-cover--portrait { transform:scaleX(-1); }
.people-love-2026__fallback-cover--treatment { height:144.71%; top:-11.92%; }
.people-love-2026__video { z-index:2; opacity:0; visibility:hidden; background:#000; }
.people-love-2026__video-card.is-playing .people-love-2026__video-cover { visibility:hidden; }
.people-love-2026__video-card.is-playing .people-love-2026__video { visibility:visible; opacity:1; }
.people-love-2026__video-card::after { position:absolute; inset:0; z-index:3; content:''; pointer-events:none; background:linear-gradient(180deg,rgba(0,0,0,.005) 64.167%,rgba(25,10,10,.5) 100%); }
.people-love-2026__video-card.is-playing::after, .people-love-2026__video-card.is-playing .people-love-2026__video-info { opacity:0; visibility:hidden; pointer-events:none; }
.people-love-2026__video-info { position:absolute; right:24px; bottom:34px; left:24px; z-index:4; display:flex; align-items:center; justify-content:space-between; gap:8px; color:#fff; }
.people-love-2026__video-person { min-width:0; }
.people-love-2026__video-name { margin:0; font-family:inherit; font-size:18px; font-weight:500; line-height:1.2; }
.people-love-2026__video-position { margin-top:4px; font-size:12px; line-height:1.2; }
.people-love-2026__play { flex:0 0 auto; width:40px; height:40px; padding:0; border:0; border-radius:50%; background:transparent; cursor:pointer; }
.people-love-2026__play img { display:block; width:100%; height:auto; }
@media screen and (min-width:768px) and (max-width:1199px) { .people-love-2026__title { font-size:36px; } }
@media screen and (max-width:767px) {
 .people-love-2026 { padding:var(--mobile-padding-top) 0 var(--mobile-padding-bottom); }
 .people-love-2026 [data-people-love-slider] { display:flex; flex-direction:column; }
 .people-love-2026__container, .people-love-2026__header { display:contents; }
 .people-love-2026__title { order:1; margin:0 20px 32px 19px; font-size:24px; line-height:1.2; text-align:left; }
 .people-love-2026 .swiper-container { order:2; }
 .people-love-2026__navigation { order:3; align-self:flex-end; gap:20px; margin-top:32px; margin-right:calc(20px + 10.21vw); padding:0; }
 .people-love-2026__arrow, .people-love-2026__arrow-icon { width:20.9px; height:16px; }
 .people-love-2026__arrow-icon img { left:-40.899px; }
 .people-love-2026__arrow-desktop { display:none; }
 .people-love-2026__arrow-mobile { display:block; }
 .people-love-2026 .swiper-slide, .people-love-2026__card { width:257px; }
 .people-love-2026__card { height:314px; border-radius:4px; }
 .people-love-2026__review { padding:16.4px; }
 .people-love-2026__stars { margin-bottom:40px; }
 .people-love-2026__stars img { width:83.57px; height:15px; }
 .people-love-2026__review-title { font-size:24px; }
 .people-love-2026__review-text { margin-top:16.4px; font-size:12px; }
 .people-love-2026__review-author { margin-top:40px; }
 .people-love-2026__review-name { font-size:16px; }
 .people-love-2026__review-meta { font-size:10px; gap:4px; }
 .people-love-2026__verified, .people-love-2026__verified img { width:10px; height:10px; }
 .people-love-2026__video-info { left:17px; right:16px; bottom:22px; }
 .people-love-2026__video-name { font-size:14px; }
 .people-love-2026__video-position { font-size:12px; margin-top:2.736px; white-space:nowrap; }
 .people-love-2026__play { width:32px; height:32px; }
}

</style>

<section class="people-love-2026" data-people-love-2026="{{ section.id }}" style="--padding-top:{{ section.settings.padding_top }}px;--padding-bottom:{{ section.settings.padding_bottom }}px;--mobile-padding-top:{{ section.settings.mobile_padding_top }}px;--mobile-padding-bottom:{{ section.settings.mobile_padding_bottom }}px;--background:{{ section.settings.background }};--card-background:{{ section.settings.card_background }};--star-color:{{ section.settings.star_color }};">
  <div data-people-love-slider data-loop="{{ section.settings.loop }}">
    <div class="people-love-2026__container">
      <div class="people-love-2026__header">
        {% if section.settings.rich_title != blank %}
          <div class="people-love-2026__title" role="heading" aria-level="2">{{ section.settings.rich_title }}</div>
        {% elsif section.settings.title != blank %}
          <h2 class="people-love-2026__title">{{ section.settings.title | escape }}</h2>
        {% endif %}
        
        {% if section.blocks.size > 1 %}
          <div class="people-love-2026__navigation">
            <button class="people-love-2026__arrow people-love-2026__arrow--prev swiper-prev" type="button" aria-label="Previous"><span class="people-love-2026__arrow-icon" aria-hidden="true"><img class="people-love-2026__arrow-desktop" src="{{ 'people-love-2026-desktop-frame2147223561.svg' | asset_url }}" width="94.049" height="24" alt=""><img class="people-love-2026__arrow-mobile" src="{{ 'people-love-2026-mobile-frame2147223561.svg' | asset_url }}" width="62.699" height="16" alt=""></span></button>
            <button class="people-love-2026__arrow people-love-2026__arrow--next swiper-next" type="button" aria-label="Next"><span class="people-love-2026__arrow-icon" aria-hidden="true"><img class="people-love-2026__arrow-desktop" src="{{ 'people-love-2026-desktop-frame2147223561.svg' | asset_url }}" width="94.049" height="24" alt=""><img class="people-love-2026__arrow-mobile" src="{{ 'people-love-2026-mobile-frame2147223561.svg' | asset_url }}" width="62.699" height="16" alt=""></span></button>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="swiper-container">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }} style="--reveal-index:{{ forloop.index0 }};">
            {% if block.settings.card_type == 'review' %}
              <div class="people-love-2026__card people-love-2026__review">
                <div class="people-love-2026__stars" aria-label="5 out of 5 stars"><picture><source media="(max-width: 767px)" srcset="{{ 'people-love-2026-mobile-group457395058.svg' | asset_url }}"><img src="{{ 'people-love-2026-desktop-group457395058.svg' | asset_url }}" width="121" height="21.718" alt="" loading="lazy"></picture></div>

                {% if block.settings.review_title != blank %}<h3 class="people-love-2026__review-title">{{ block.settings.review_title | escape }}</h3>{% endif %}
                {% if block.settings.review_text != blank %}<div class="people-love-2026__review-text">{{ block.settings.review_text }}</div>{% endif %}

                <div class="people-love-2026__review-author">
                  {% if block.settings.reviewer_name != blank %}<div class="people-love-2026__review-name">{{ block.settings.reviewer_name | escape }}</div>{% endif %}

                  {% if block.settings.reviewer_meta != blank %}
                    <div class="people-love-2026__review-meta">
                      <span>{{ block.settings.reviewer_meta | escape }}</span>
                      {% if block.settings.show_verified %}
                        <span class="people-love-2026__verified" aria-label="Verified">
                          <picture><source media="(max-width: 767px)" srcset="{{ 'people-love-2026-mobile-group2085663725.svg' | asset_url }}"><img src="{{ 'people-love-2026-desktop-group2085663725.svg' | asset_url }}" width="16" height="16" alt="" loading="lazy"></picture>
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% else %}
              {% liquid
                assign fallback_cover = 'people-love-2026-desktop-frame2147223909.png'
                case block.settings.default_cover
                  when 'mask'
                    assign fallback_cover = 'people-love-2026-desktop-frame2147223911.png'
                  when 'device'
                    assign fallback_cover = 'people-love-2026-desktop-frame2147223913.png'
                  when 'treatment'
                    assign fallback_cover = 'people-love-2026-desktop-frame2147223914.png'
                endcase
                assign card_image = block.settings.image
                if card_image == blank and block.settings.video != blank
                  assign card_image = block.settings.video.preview_image
                endif
              %}

              <div class="people-love-2026__card people-love-2026__video-card" data-inline-video-card>
                <div class="people-love-2026__video-media">
                  {% if card_image != blank %}
                    <img class="people-love-2026__video-cover" src="{{ card_image | image_url: width: 900 }}" srcset="{{ card_image | image_url: width: 400 }} 400w, {{ card_image | image_url: width: 600 }} 600w, {{ card_image | image_url: width: 900 }} 900w" sizes="(max-width: 767px) 257px, 376px" alt="{{ block.settings.expert_name | escape }}" width="{{ card_image.width }}" height="{{ card_image.height }}" loading="lazy">
                  {% else %}
                    <img class="people-love-2026__video-cover people-love-2026__fallback-cover people-love-2026__fallback-cover--{{ block.settings.default_cover | default: 'portrait' }}" src="{{ fallback_cover | asset_url }}" width="376" height="460" alt="{{ block.settings.expert_name | escape }}" loading="lazy">
                  {% endif %}

                  {% if block.settings.video != blank %}
                    {{ block.settings.video | video_tag: autoplay: false, loop: false, muted: false, controls: true, playsinline: true, preload: 'metadata', class: 'people-love-2026__video' }}
                  {% elsif block.settings.video_url != blank %}
                    <video class="people-love-2026__video" src="{{ block.settings.video_url | escape }}" controls playsinline preload="metadata"></video>
                  {% endif %}
                </div>

                <div class="people-love-2026__video-info">
                  <div class="people-love-2026__video-person">
                    {% if block.settings.expert_name != blank %}<div class="people-love-2026__video-name">{{ block.settings.expert_name | escape }}</div>{% endif %}
                    {% if block.settings.expert_position != blank %}<div class="people-love-2026__video-position">{{ block.settings.expert_position | escape }}</div>{% endif %}
                  </div>

                  {% if block.settings.video != blank or block.settings.video_url != blank %}
                    <button class="people-love-2026__play" type="button" aria-label="Play video" data-inline-video-play><picture><source media="(max-width: 767px)" srcset="{{ 'people-love-2026-mobile-frame2147223910.svg' | asset_url }}"><img src="{{ 'people-love-2026-desktop-frame2147223910.svg' | asset_url }}" width="40" height="40" alt=""></picture></button>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

<script>
(() => {
  const sectionId = {{ section.id | json }};
  const selector = `[data-people-love-2026="${sectionId}"]`;
  const init = () => {
    const section = document.querySelector(selector);
    if (!section || section.peopleLoveCleanup) return;
    const host = section.querySelector('[data-people-love-slider]');
    const container = host.querySelector('.swiper-container');
    const prev = host.querySelector('.swiper-prev');
    const next = host.querySelector('.swiper-next');
    const cards = [...host.querySelectorAll('[data-inline-video-card]')];
    const media = window.matchMedia('(max-width: 767px)');
    const controller = new AbortController();
    let swiper, frame, stopped = false;
    const reset = card => {
      card.querySelector('video')?.pause();
      card.classList.remove('is-playing');
    };
    const updateButtons = () => {
      if (!swiper) return;
      if (prev) prev.disabled = swiper.isLocked || (!swiper.params.loop && swiper.isBeginning);
      if (next) next.disabled = swiper.isLocked || (!swiper.params.loop && swiper.isEnd);
    };
    const desktopOffset = () => Math.max(20, (container.clientWidth - 1520) / 2 - 28);
    const createSwiper = () => {
      if (stopped) return;
      if (typeof Swiper === 'undefined') { frame = requestAnimationFrame(createSwiper); return; }
      cards.forEach(reset);
      swiper?.destroy(true, true);
      const mobile = media.matches;
      const count = host.querySelectorAll('.swiper-slide').length;
      swiper = new Swiper(container, {
        slidesPerView: 'auto',
        spaceBetween: mobile ? 16 : 24,
        centeredSlides: false,
        slidesOffsetBefore: mobile ? 19 : desktopOffset(),
        slidesOffsetAfter: mobile ? 20 : desktopOffset(),
        initialSlide: mobile || count < 6 ? 0 : 2,
        loop: host.dataset.loop === 'true',
        watchOverflow: true,
        navigation: prev && next ? { prevEl: prev, nextEl: next } : false,
        on: {
          slideChangeTransitionStart: () => cards.forEach(reset),
          slideChange: updateButtons,
          reachBeginning: updateButtons,
          reachEnd: updateButtons,
          lock: updateButtons,
          unlock: updateButtons,
          resize: instance => {
            instance.params.slidesOffsetBefore = media.matches ? 19 : desktopOffset();
            instance.params.slidesOffsetAfter = media.matches ? 20 : desktopOffset();
            instance.update();
            updateButtons();
          }
        }
      });
      updateButtons();
    };
    cards.forEach(card => {
      const video = card.querySelector('video');
      const button = card.querySelector('[data-inline-video-play]');
      if (!video || !button) return;
      button.addEventListener('click', () => {
        cards.filter(other => other !== card).forEach(reset);
        card.classList.add('is-playing');
        video.play()?.catch(() => reset(card));
      }, { signal: controller.signal });
      video.addEventListener('ended', () => { reset(card); video.currentTime = 0; }, { signal: controller.signal });
    });
    media.addEventListener('change', createSwiper);
    section.peopleLoveCleanup = () => {
      stopped = true;
      cancelAnimationFrame(frame);
      controller.abort();
      media.removeEventListener('change', createSwiper);
      cards.forEach(reset);
      swiper?.destroy(true, true);
      delete section.peopleLoveCleanup;
    };
    createSwiper();
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
  document.addEventListener('shopify:section:load', event => { if (event.target.querySelector(selector)) init(); });
  document.addEventListener('shopify:section:unload', event => event.target.querySelector(selector)?.peopleLoveCleanup?.());
})();

</script>

