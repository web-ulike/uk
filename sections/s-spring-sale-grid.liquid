{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section id="shopify-section-{{ sid }}" class="s-spring-sale">
  <div class="s-spring-sale__inner container">
    {% if st.heading != blank %}
      <h2 class="s-spring-sale__heading">{{ st.heading }}</h2>
    {% endif %}

    <div class="s-spring-sale__grid">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        <a
          {% if bs.link != blank %}
            href="{{ bs.link }}"
          {% else %}
            href="javascript:void(0);"
          {% endif %}
          class="s-spring-sale__card {% if forloop.first %}is-large{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="s-spring-sale__content">
            {% if bs.title != blank %}
              <div class="s-spring-sale__title">{{ bs.title }}</div>
            {% endif %}

            {% if bs.subtitle != blank %}
              <div class="s-spring-sale__subtitle">{{ bs.subtitle }}</div>
            {% endif %}
          </div>

          {% if bs.image != blank %}
            <div class="s-spring-sale__image-wrap">
              {{
                bs.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '320,480,640,800,1000,1200',
                  sizes: '(max-width: 768px) 50vw, 33vw',
                  class: 's-spring-sale__image',
                  alt: bs.title | escape
              }}
            </div>
          {% endif %}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ sid }} {
    --ss-bg: {{ st.section_bg }};
    --ss-card-bg: {{ st.card_bg }};
    --ss-title: {{ st.title_color }};
    --ss-subtitle: {{ st.subtitle_color }};
  }

  #shopify-section-{{ sid }}.shopify-section,
  #shopify-section-{{ sid }} {
    background: var(--ss-bg);
  }

  #shopify-section-{{ sid }} .s-spring-sale {
    background: var(--ss-bg);
    padding: 30px 0 22px;
  }


  #shopify-section-{{ sid }} .s-spring-sale__heading {
    margin: 0 0 22px;
    text-align: center;
    color: #1f1f1f;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: 0;
  }

  #shopify-section-{{ sid }} .s-spring-sale__grid {
    display: grid;
    grid-template-columns: 1.12fr 1fr 1fr;
    grid-auto-rows: 142px;
    gap: 12px;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-height: 142px;
    padding: 16px 18px 12px;
    border-radius: 8px;
    background: var(--ss-card-bg);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
  }

  #shopify-section-{{ sid }} .s-spring-sale__card.is-large {
    grid-row: span 2;
    min-height: 296px;
    padding: 24px 20px 16px;
  }

  #shopify-section-{{ sid }} .s-spring-sale__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 260px;
    margin: 0 auto;
  }

  #shopify-section-{{ sid }} .s-spring-sale__title {
    color: var(--ss-title);
    font-size: 14px;
    line-height: 1.35;
    font-weight: 500;
  }

  #shopify-section-{{ sid }} .s-spring-sale__subtitle {
    margin-top: 3px;
    color: var(--ss-subtitle);
    font-size: 12px;
    line-height: 1.3;
    font-weight: 500;
  }

  #shopify-section-{{ sid }} .s-spring-sale__image-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    flex: 1 1 auto;
    margin-top: 8px;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card.is-large .s-spring-sale__image-wrap {
    margin-top: 10px;
  }

  #shopify-section-{{ sid }} .s-spring-sale__image {
    display: block;
    max-width: 100%;
    height: auto;
    width: auto;
    max-height: 88px;
    object-fit: contain;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card.is-large .s-spring-sale__image {
    max-height: 170px;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card:nth-child(2) {
    padding: 18px 22px 14px 26px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sid }} .s-spring-sale {
      padding: 28px 0;
    }


    #shopify-section-{{ sid }} .s-spring-sale__heading {
      text-align: left;
      font-size: 26px;
      line-height: 1.15;
      margin-bottom: 18px;
      max-width: 260px;
    }

    #shopify-section-{{ sid }} .s-spring-sale__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      gap: 10px;
    }

    #shopify-section-{{ sid }} .s-spring-sale__card,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-large {
      min-height: 164px;
      grid-row: auto;
      padding: 14px 12px 10px;
      border-radius: 8px;
    }

    #shopify-section-{{ sid }} .s-spring-sale__title {
      font-size: 14px;
      line-height: 1.35;
    }

    #shopify-section-{{ sid }} .s-spring-sale__subtitle {
      font-size: 13px;
      line-height: 1.3;
    }

    #shopify-section-{{ sid }} .s-spring-sale__image-wrap,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-large .s-spring-sale__image-wrap {
      margin-top: 10px;
    }

    #shopify-section-{{ sid }} .s-spring-sale__image,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-large .s-spring-sale__image {
      max-height: 95px;
    }
  }
</style>

