{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<section id="shopify-section-{{ sid }}" class="s-spring-sale">
  <div class="s-spring-sale__inner container">
    {% if st.heading != blank %}
      <h2 class="s-spring-sale__heading">{{ st.heading }}</h2>
    {% endif %}

    <div class="s-spring-sale__grid">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        <div
          class="s-spring-sale__card{% if forloop.first %} is-large{% endif %}{% if forloop.index == 2 %} is-wide{% endif %}{% unless forloop.first or forloop.index == 2 %} is-small{% endunless %}"
          {{ block.shopify_attributes }}
        >
          <div class="s-spring-sale__content">
            {% if bs.title != blank %}
              <div class="s-spring-sale__title">{{ bs.title }}</div>
            {% endif %}

            {% if bs.subtitle != blank %}
              <div class="s-spring-sale__subtitle">{{ bs.subtitle }}</div>
            {% endif %}
          </div>

          {% if bs.image != blank or bs.image_mobile != blank %}
            <div class="s-spring-sale__image-wrap">
              {% if bs.image != blank or bs.image_mobile != blank %}
                <picture>
                  {% if bs.image_mobile != blank %}
                    <source
                      media="(max-width: 768px)"
                      srcset="
                        {{ bs.image_mobile | image_url: width: 320 }} 320w,
                        {{ bs.image_mobile | image_url: width: 480 }} 480w,
                        {{ bs.image_mobile | image_url: width: 640 }} 640w,
                        {{ bs.image_mobile | image_url: width: 800 }} 800w
                      "
                      sizes="50vw"
                    >
                  {% endif %}
                  {{
                    bs.image | default: bs.image_mobile
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '320,480,640,800,1000,1200',
                      sizes: '(max-width: 768px) 50vw, 33vw',
                      class: 's-spring-sale__image',
                      alt: bs.title | escape
                  }}
                </picture>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ sid }} {
    --ss-bg: {{ st.section_bg }};
    --ss-card-bg: linear-gradient(357deg, #FFEBF1 -11.72%, #FFFBFB 106.5%);
    --ss-title: {{ st.title_color }};
    --ss-subtitle: {{ st.subtitle_color }};
  }

  #shopify-section-{{ sid }}.shopify-section,
  #shopify-section-{{ sid }} {
    background: var(--ss-bg);
  }

  #shopify-section-{{ sid }} .s-spring-sale {
    background: var(--ss-bg);
    padding: 30px 0 22px;
  }


  #shopify-section-{{ sid }} .s-spring-sale__heading {
    margin: 0 0 40px;
    text-align: center;
    color: #190A0A;
    font-weight: inherit;
    font-size: 48px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ sid }} .s-spring-sale__grid {
    display: grid;
    grid-template-columns: 1fr 0.5fr 0.5fr;
    grid-template-areas:
      "large wide wide"
      "large small1 small2";
    align-items: stretch;
    gap: 24px;
    width: 100%;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card.is-large {
    grid-area: large;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card.is-wide {
    grid-area: wide;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card:nth-child(3) {
    grid-area: small1;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card:nth-child(4) {
    grid-area: small2;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 50px 18px;
    border-radius: 8px;
    background: var(--ss-card-bg);
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card.is-large {
     padding: 50px 20px;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card.is-wide {
    padding: 20px 90px;
    flex-direction: initial;
    justify-content: center;
    align-items: center;
  }

  #shopify-section-{{ sid }} .s-spring-sale__content {
    position: relative;
    z-index: 2;
    text-align: center;
    margin: 0 auto;
    width: 100%;
    min-width: 0;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card.is-small .s-spring-sale__content {
    top: 24px;
    position: absolute;
  }

  #shopify-section-{{ sid }} .s-spring-sale__title {
    color: var(--ss-title);
    font-size: 32px;
    line-height: 1.35;
    font-weight: 500;
  }

  #shopify-section-{{ sid }} .s-spring-sale__subtitle {
    color: var(--ss-subtitle);
    font-size: 24px;
    line-height: 1.2;
  }

  #shopify-section-{{ sid }} .s-spring-sale__image-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card.is-large .s-spring-sale__image-wrap {
    margin-top: 10px;
  }

  #shopify-section-{{ sid }} .s-spring-sale__image {
    display: block;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }

  #shopify-section-{{ sid }} .s-spring-sale__image-wrap picture {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 100%;
    max-width: 100%;
  }

  #shopify-section-{{ sid }} .s-spring-sale__card.is-large .s-spring-sale__image {
    max-height: 460px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sid }} .s-spring-sale {
      padding: 28px 0;
    }


    #shopify-section-{{ sid }} .s-spring-sale__heading {
      text-align: left;
      font-size: 26px;
      line-height: 1.15;
      margin-bottom: 18px;
      max-width: 260px;
    }

    #shopify-section-{{ sid }} .s-spring-sale__grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      width: 100%;
    }

    #shopify-section-{{ sid }} .s-spring-sale__card,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-large,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-wide {
      min-height: 138px;
      grid-area: auto;
      grid-row: auto;
      flex: 0 0 calc(50% - 5px);
      width: calc(50% - 5px);
      max-width: calc(50% - 5px);
      min-width: 0;
      padding: 12px 10px 8px;
      border-radius: 8px;
      box-sizing: border-box;
    }

    #shopify-section-{{ sid }} .s-spring-sale__grid > * {
      min-width: 0;
    }

    #shopify-section-{{ sid }} .s-spring-sale__title {
      font-size: 13px;
      line-height: 1.3;
    }

    #shopify-section-{{ sid }} .s-spring-sale__subtitle {
      margin-top: 2px;
      font-size: 12px;
      line-height: 1.25;
    }

    #shopify-section-{{ sid }} .s-spring-sale__image-wrap,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-large .s-spring-sale__image-wrap,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-wide .s-spring-sale__image-wrap,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-small .s-spring-sale__image-wrap {
      margin-top: 0;
      padding-top: 52px;
    }

    #shopify-section-{{ sid }} .s-spring-sale__image,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-large .s-spring-sale__image,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-wide .s-spring-sale__image,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-small .s-spring-sale__image {
      max-height: 78px;
    }

    #shopify-section-{{ sid }} .s-spring-sale__card::before,
    #shopify-section-{{ sid }} .s-spring-sale__card::after {
      display: none !important;
      content: none !important;
    }

    #shopify-section-{{ sid }} .s-spring-sale__card,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-large,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-wide,
    #shopify-section-{{ sid }} .s-spring-sale__content,
    #shopify-section-{{ sid }} .s-spring-sale__image-wrap,
    #shopify-section-{{ sid }} .s-spring-sale__image-wrap picture,
    #shopify-section-{{ sid }} .s-spring-sale__image {
      float: none !important;
      transform: none !important;
      left: auto !important;
      right: auto !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    #shopify-section-{{ sid }} .s-spring-sale__content,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-large .s-spring-sale__content,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-wide .s-spring-sale__content,
    #shopify-section-{{ sid }} .s-spring-sale__card.is-small .s-spring-sale__content {
      position: absolute;
      transform: none !important;
      left: auto;
      right: auto;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    #shopify-section-{{ sid }} .s-spring-sale__card:nth-child(odd):last-child {
      margin-right: auto;
    }
  }
</style>

{% schema %}
{
  "name": "Spring sale grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Spring Sale Your First Order"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f9ecef"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title color",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Card subtitle color",
      "default": "#ff4f84"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Sale card",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Extra £20 OFF Your First Order"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Up to 40% OFF"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Card image (mobile)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spring sale grid",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Extra £20 OFF Your First Order",
            "subtitle": "Up to 40% OFF"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "120-Day Money Back Guarantee",
            "subtitle": ""
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "FREE Express Shipping",
            "subtitle": ""
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Special 5 Free Gift",
            "subtitle": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}