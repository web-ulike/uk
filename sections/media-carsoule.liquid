<style>
         #shopify-section-{{ section.id }} {
      --section-background: {{ section.settings.background }};
       background: var(--section-background);
   }
     .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px);
    padding-bottom: calc({{ section.settings.padding_bottom }}px);
  }
@media screen and (max-width: 768px){
  .media-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.mobile_padding_top }}px);
    padding-bottom: calc({{ section.settings.mobile_padding_bottom }}px );
  }
}
  /* media-carousel start */
    .media-carousel{
      overflow: hidden;
    }
    .media-carousel h2{
      color:  #190A0A;
text-align: center;
font-size: 44px;
font-weight: 400;
line-height: 120%; 
margin-bottom: 65px;
    }
    .media-carousel-nav{
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 39px;
      gap: 54px;
    }
     .media-carousel-pagination{
      --swiper-pagination-color:#3F3636;
      --swiper-pagination-bullet-width:10px;
      --swiper-pagination-bullet-height:10px;
      --swiper-pagination-bullet-horizontal-gap:5px;
     }
    .media-carousel-pagination .swiper-pagination{
      position: static;
      display: flex;
    }
    .media-carousel-nav svg{
      cursor: pointer;
      display: block;
    }

 .media-carousel .swiper-slide {
  transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
}
 .media-carousel .swiper-slide:not(.swiper-slide-active) {
  transform: scale(0.9);
}
.media-carousel .play-button{
  display: flex;
  position: absolute;
  top: 50%;
  left: 50%;
  width: 75px;
height: 75px;
  transform: translate(-50%,-50%);
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.media-carousel .play-button svg{
  display: block;
  width: 100%;
  height: 100%;
}
.media-carousel .play-button:hover {
  transform: translate(-50%, -50%) scale(1.1);
  filter: drop-shadow(0 10px 15px rgba(0, 0, 0, 0.4));
}
.media-carousel .play-button:active {
  transform: translate(-50%, -50%) scale(0.95);
}
.media-carousel .play-button::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  z-index: -1;
  animation: pulse-ring 2s infinite ease-out;
}
@keyframes pulse-ring {
  0% {
    transform: scale(0.8);
    opacity: 1;
  }
  100% {
    transform: scale(1.6);
    opacity: 0;
  }
}
  @media screen and (max-width: 1023px) {
.media-carousel h2{
  font-size: 24px;
  margin: 0 auto;
  margin-bottom: 44px;
  max-width: 278px;
}
.media-carousel-nav{
  gap: 19px;
  margin-top: 20px;
}
.media-carousel-pagination {
    --swiper-pagination-bullet-width: 6px;
    --swiper-pagination-bullet-height: 6px;
    --swiper-pagination-bullet-horizontal-gap: 3px;
}
.media-carousel .play-button{
  width: 50px;
height: 50px;
}
  }
    /* media-carousel end */
</style>

  <section>
   <div class="media-carousel media-{{ section.id }}-padding">
    <h2 class="to-top">{{ section.settings.tle }}</h2>
        <custom-swiper-new 
  slides-per-view="1.3" 
  space-between="5" 
  loop="true" 
  centered-slides="true"
  pagination="true"
  navigation="true"
  disable-on=""
  breakpoints='{"768":{"slidesPerView": 2,"spaceBetween": 0}}'
>
    <div class="media-carousel-container swiper-container to-top">
      <div class="media-carousel-wrapper swiper-wrapper">


 {% for block in section.blocks %}

        <div class="media-carousel-list swiper-slide">
           <picture class="media-carousel-img">
                     {%- if block.settings.image_mobile -%}
          <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url }}">
               {%- endif -%}
           {%- if block.settings.image -%}
          <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt }}" loading="lazy" decoding="async">
            {%- endif -%}
            </picture>


            {% if block.settings.video %}

                 {% assign video_url = '' %}

                {% for source in block.settings.video.sources %}
                {% if source.mime_type == 'video/mp4' %}
                    {% assign video_url = source.url %}
                {% endif %}
                {% endfor %}


            <div class="play-button" data-video="{{ video_url }}">
              <svg  width="75" height="75" viewBox="0 0 75 75" fill="none">
                <g clip-path="url(#clip0_2066_159)">
                  <path d="M37.4996 74.9999C28.8481 74.995 20.4642 71.9997 13.7683 66.5213C7.07238 61.0429 2.47604 53.4183 0.757919 44.9392C-0.960203 36.46 0.305531 27.6476 4.3407 19.9948C8.37588 12.3419 14.9324 6.31926 22.8996 2.94694C32.0636 -0.925218 42.3905 -0.99839 51.6085 2.74352C60.8264 6.48544 68.1804 13.7359 72.0526 22.8999C75.9247 32.064 75.9979 42.3909 72.256 51.6088C68.5141 60.8268 61.2636 68.1808 52.0996 72.0529C47.4808 74.0078 42.5149 75.0101 37.4996 74.9999ZM29.3806 22.0709C29.1153 22.0709 28.861 22.1763 28.6734 22.3638C28.4859 22.5514 28.3806 22.8057 28.3806 23.0709V51.9259C28.3806 52.1039 28.4281 52.2787 28.5182 52.4322C28.6084 52.5857 28.7378 52.7123 28.8933 52.7991C29.0487 52.8858 29.2245 52.9295 29.4024 52.9256C29.5804 52.9217 29.7541 52.8704 29.9056 52.7769L53.3456 38.3519C53.4903 38.2623 53.6097 38.1371 53.6925 37.9884C53.7753 37.8396 53.8188 37.6722 53.8188 37.5019C53.8188 37.3317 53.7753 37.1643 53.6925 37.0155C53.6097 36.8668 53.4903 36.7416 53.3456 36.6519L29.8996 22.2209C29.7436 22.1243 29.564 22.0724 29.3806 22.0709Z" fill="white"/>
                </g>
                <defs>
                  <clipPath id="clip0_2066_159">
                    <rect width="75" height="75" fill="white"/>
                  </clipPath>
                </defs>
              </svg>
            </div>
        {% endif %}


        </div>
          {% endfor %}




      </div>
    </div>
    <div class="media-carousel-nav to-top">
      <svg  width="30" height="23" viewBox="0 0 30 23" fill="none" class="swiper-prev">
        <g clip-path="url(#clip0_2066_170)">
          <path d="M1.90735e-06 11.4922C1.90735e-06 11.6737 0.067318 11.8537 0.196098 11.9912L10.44 22.9668L11.5098 21.9688L2.41463 12.2239H30C30 11.4161 29.3444 10.7605 28.5366 10.7605H0.765366C0.488781 10.7605 0.219515 10.8995 0.0878067 11.1439C0.0278072 11.2537 1.90735e-06 11.3737 1.90735e-06 11.4922Z" fill="#190A0A"/>
          <path d="M1.53121 8.92683C2.10341 9.49756 3.02975 9.49756 3.60048 8.92683L11.4941 1.03463L10.4595 0L1.53268 8.92683H1.53121Z" fill="#190A0A"/>
        </g>
        <defs>
          <clipPath id="clip0_2066_170">
            <rect width="30" height="22.9683" fill="white" transform="matrix(-1 0 0 1 30 0)"/>
          </clipPath>
        </defs>
      </svg>

       <div class="media-carousel-pagination">
            <div class="swiper-pagination"></div>
        </div>


      <svg width="30" height="23" viewBox="0 0 30 23" fill="none" class="swiper-next">
  <g clip-path="url(#clip0_2066_166)">
    <path d="M30 11.4922C30 11.6737 29.9327 11.8537 29.8039 11.9912L19.56 22.9668L18.4902 21.9688L27.5854 12.2239H0C0 11.4161 0.65561 10.7605 1.46341 10.7605H29.2346C29.5112 10.7605 29.7805 10.8995 29.9122 11.1439C29.9722 11.2537 30 11.3737 30 11.4922Z" fill="#190A0A"/>
    <path d="M28.4688 8.92683C27.8966 9.49756 26.9702 9.49756 26.3995 8.92683L18.5059 1.03463L19.5405 0L28.4673 8.92683H28.4688Z" fill="#190A0A"/>
  </g>
  <defs>
    <clipPath id="clip0_2066_166">
      <rect width="30" height="22.9683" fill="white"/>
    </clipPath>
  </defs>
</svg>

    </div>

</custom-swiper-new>
  </div>
  </section>

{% schema %}
{
  "name": "media-carsoule",
  "settings": [
    {
      "type": "text",
      "id": "tle",
      "label": "Title"
    },
       {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
         {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
     {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
        "type": "item",
        "name": "item",
        "settings": [
                          {
          "type": "image_picker",
          "id": "image",
          "label": "Images"
        },
     {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Images"
        },
                    {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
             {
          "type": "video",
          "id": "mb_video",
          "label": "Mobile Video"
        }
        ]
      }
  ],
  "presets": [
    {
      "name": "media-carsoule",
      "settings": {},
      "blocks": [
      ]
    }
  ]
}
{% endschema %}