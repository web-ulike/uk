
{% style %}
.me-technology {
      padding: 100px 0;
      background: #fff;
      color: #413939;
      overflow: hidden;
    }

    .me-technology__head {
      text-align: center;
    }

    .me-technology__tle {
      margin: 0;
      font-size: 44px;
      font-weight: 400;
      line-height: 1.25;
    }

    .me-technology__txt {
      margin: 16px 0 0;
      font-size: 18px;
      line-height: 1.2;
    }

    .me-technology__scroll {
      margin-top: 44px;
    }

    .me-technology__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px 108px;
    }

    .me-technology__card {
      min-width: 0;
    }

    .me-technology__inner {
      position: relative;
      height: 100%;
      min-height: 242px;
      padding: 40px 20px;
      overflow: hidden;
      isolation: isolate;
      border-radius: 10px;
      background: #FFF8FA;
      text-align: center;
      transition: transform .4s ease, box-shadow .4s ease, background .4s ease;
    }

    .me-technology__inner::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background: linear-gradient(110deg, transparent 20%, #fff9 48%, transparent 75%);
      transform: translateX(-150%);
    }

    .me-technology__icon {
      display: block;
      width: 80px;
      height: 80px;
      margin: 0 auto 13px;
      color: #E0004D;
      transition: transform .45s ease;
    }

    .me-technology__icon svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .me-technology__icon text {
      fill: currentColor;
      stroke: none;
      font-family: Arial, sans-serif;
    }

    .me-technology__name {
      margin: 0;
      font-size: 26px;
      font-weight: 400;
      line-height: 1.25;
    }

    .me-technology__desc {
      margin: 13px 0 0;
      color: #a29a9e;
      font-size: 18px;
      line-height: 1.25;
    }

    .me-technology__note {
      margin: 18px 0 0;
      color: #928b8e;
      font-size: 12px;
      line-height: 1.4;
    }

    .me-technology__scroll:focus-visible {
      outline: 2px solid #e0004d;
      outline-offset: 5px;
    }

    .me-technology__head.js-me-top.appear {
      animation: me-tech-title .85s cubic-bezier(.16, 1, .3, 1) both;
    }

    .me-technology__card.js-me-top.appear {
      animation: me-tech-card .9s cubic-bezier(.16, 1, .3, 1) var(--me-delay, 0ms) both;
    }

    .me-technology__card.js-me-top.appear .me-technology__inner::after {
      animation: me-tech-shine 1.2s ease var(--me-delay, 0ms) both;
    }

    @keyframes me-tech-title {
      from {
        opacity: 0;
        transform: translateY(26px);
        filter: blur(7px);
      }

      to {
        opacity: 1;
        transform: none;
        filter: blur(0);
      }
    }

    @keyframes me-tech-card {
      from {
        opacity: 0;
        transform: perspective(900px) translateY(55px) rotateX(9deg) scale(.95);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes me-tech-shine {
      to {
        transform: translateX(150%);
      }
    }

    @media (hover: hover) and (pointer: fine) {
      .me-technology__card:hover .me-technology__inner {
        transform: translateY(-8px);
        background: #fff2f7;
        box-shadow: 0 18px 40px #e0004d12;
      }

      .me-technology__card:hover .me-technology__icon {
        transform: translateY(-4px) rotate(-5deg) scale(1.08);
      }
    }

    .me-technology__navagation {
      display: flex;
      align-items: center;
      gap: 27px;
      margin-top: 27px;
      justify-content: flex-end;
      padding-right: 28px;
      display: none;
    }

    .me-technology__navagation svg {
      width: 23px;
      cursor: pointer;
    }

    .me-technology__navagation .me-technology__navagation__arrows.swiper-button-disabled {
      opacity: 0.6;
    }

    @media (min-width: 768px) and (max-width: 1450px) {
      .me-technology {
        padding: 77px 0;
      }

      .me-technology .container {}

      .me-technology__tle {
        font-size: 35px;
      }

      .me-technology__txt {
        margin-top: 13px;
        font-size: 14px;
      }

      .me-technology__scroll {
        margin-top: 35px;
      }

      .me-technology__grid {
        gap: 19px clamp(19px, 5vw, 86px);
      }

      .me-technology__inner {
        min-height: 195px;
        padding: 32px 16px;
        border-radius: 8px;
      }

      .me-technology__icon {
        width: 64px;
        height: 64px;
        margin-bottom: 13px;
      }

      .me-technology__name {
        font-size: 21px;
      }

      .me-technology__desc {
        margin-top: 13px;
        font-size: 14px;
      }

      .me-technology__note {
        margin-top: 14px;
        font-size: 10px;
      }
    }

    @media (max-width: 767px) {
      .me-technology {
        padding: 60px 0;
      }

      .me-technology__navagation {
        display: flex;
      }

      .me-technology .container {
        padding: 0 20px;
      }

      .me-technology__tle {
        max-width: 340px;
        margin: 0 auto;
        font-size: 28px;
      }

      .me-technology__txt {
        max-width: 310px;
        margin: 16px auto 0;
        font-size: 12px;
      }

      .me-technology__scroll {
        margin: 40px -20px 0;
        padding: 0 20px 8px;
      }

      .me-technology__grid {
        /* width: max-content;
        grid-template-columns: repeat(3, 192px); */
        gap: 18px 15px;
        display: flex;
      }

      .me-technology__card {
        scroll-snap-align: start;
      }

      .me-technology__inner {
        min-height: 194px;
        padding: 25px 12px;
        border-radius: 6px;
      }

      .me-technology__icon {
        width: 50px;
        height: 50px;
        margin-bottom: 8px;
      }

      .me-technology__name {
        font-size: 12px;
      }

      .me-technology__desc {
        margin-top: 8px;
        font-size: 9px;
      }

      .me-technology__note {
        margin-top: 18px;
        font-size: 9px;
      }

      .me-technology__scroll.swiper-container {
        position: relative;
        width: calc(100% + 0px);
        height: 356px;
        margin: 40px 0px 0 0;
        padding: 0;
        overflow: hidden;
        touch-action: pan-y;
        scroll-snap-type: none;
      }

      .me-technology__grid.swiper-wrapper {
        display: flex;
        flex-wrap: wrap;
        align-content: flex-start;
        width: 100%;
        height: 100%;
        gap: 0;
        grid-template-columns: none;
      }

      .me-technology__card.swiper-slide {
        flex-shrink: 0;
        min-width: 0;
        height: calc((100% - 16px) / 2);
        scroll-snap-align: none;
      }

      .me-technology__inner {
        box-sizing: border-box;
        height: 100%;
        min-height: 0;
      }

      .me-technology__navagation {
        display: flex;
      }

      .me-technology__navagation .me-technology__navagation__arrows.swiper-button-disabled {
        opacity: .25;
        pointer-events: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      .me-technology__head.to-top.appear,
      .me-technology__card.to-top.appear,
      .me-technology__card.to-top.appear .me-technology__inner::after {
        animation: none;
      }

      .me-technology__inner,
      .me-technology__icon {
        transition: none;
      }

      .me-technology__card:hover .me-technology__inner,
      .me-technology__card:hover .me-technology__icon {
        transform: none;
      }
    }
{% endstyle %}

