<script>
    class CustomSwiper extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initSwiper();
      }

      initSwiper() {
        const swiperContainer = this.querySelector('.swiper-container');
        if (!swiperContainer) {
          console.error('Swiper container not found');
          return;
        }

        // **设备判断：是否禁用 Swiper**
        const disableOn = this.getAttribute('disable-on'); // 'mobile' 或 'desktop'
        const isMobile = /Mobi|Android/i.test(navigator.userAgent);
        if ((disableOn === 'mobile' && isMobile) || (disableOn === 'desktop' && !isMobile)) {
          console.log(`Swiper disabled on ${disableOn}`);
          return;
        }

        // **Swiper 组件参数**
        const slidesPerView = this.getAttribute('slides-per-view') === 'auto'
          ? 'auto'
          : parseFloat(this.getAttribute('slides-per-view')) || 1.3;
        const spaceBetween = parseFloat(this.getAttribute('space-between')) || 10;
        const loop = this.getAttribute('loop') !== 'false'; // 默认为 true
        const centeredSlides = this.getAttribute('centered-slides') !== 'false'; // 默认为 true
        const paginationEnabled = this.getAttribute('pagination') === 'true'; // 是否启用分页
        const navigationEnabled = this.getAttribute('navigation') === 'true'; // 是否启用导航按钮
        let breakpoints = {};
        try {
          breakpoints = JSON.parse(this.getAttribute('breakpoints') || '{}');
        } catch (error) {
          console.error('Invalid breakpoints format. Expected JSON.');
        }

        // **动态控制 navigation 和 pagination**
        const prevButton = navigationEnabled ? this.querySelector('.swiper-prev') : null;
        const nextButton = navigationEnabled ? this.querySelector('.swiper-next') : null;
        const paginationEl = paginationEnabled ? { el: this.querySelector('.swiper-pagination'), clickable: true } : false;

        this.swiper = new Swiper(swiperContainer, {
          slidesPerView,
          spaceBetween,
          loop,
          centeredSlides,
          watchOverflow: this.getAttribute('watch-overflow') === 'true',
          navigation: navigationEnabled ? { prevEl: prevButton, nextEl: nextButton } : false,
          pagination: paginationEl,
          breakpoints
        });
      }
    }
    window.customElements.define('custom-swiper', CustomSwiper);



    class CustomSwiperMe extends HTMLElement {
      static get observedAttributes() {
        return [
          'options',
          'breakpoints',
          'disable-on',
          'mobile-breakpoint',
          'slides-per-view',
          'slides-per-group',
          'space-between',
          'speed',
          'initial-slide',
          'direction',
          'effect',
          'loop',
          'rewind',
          'centered-slides',
          'auto-height',
          'watch-overflow',
          'grab-cursor',
          'allow-touch-move',
          'navigation',
          'pagination',
          'pagination-type',
          'pagination-clickable',
          'scrollbar',
          'scrollbar-draggable',
          'autoplay',
          'autoplay-delay',
          'autoplay-disable-on-interaction',
          'autoplay-pause-on-hover',
          'grid-rows',
          'grid-fill',
          'keyboard',
          'mousewheel',
          'free-mode',
          'respect-reduced-motion'
        ];
      }

      constructor() {
        super();

        this.swiper = null;

        this._connected = false;
        this._queued = false;
        this._needsRebuild = false;
        this._savedIndex = null;

        this._mobileMedia = null;
        this._motionMedia = null;
        this._pendingObserver = null;
        this._resizeObserver = null;

        this._handleMediaChange = () => this._schedule();
        this._handleMotionChange = () => this._schedule(true);

        this._handleReady = () => {
          if (this._connected) this._schedule();
        };

        // 自定义元素连接时，子节点可能还没解析完。
        this._handleChildren = () => {
          if (this._hasMarkup()) {
            this._stopWaiting();
            this._schedule();
          }
        };
      }

      connectedCallback() {
        if (this._connected) return;

        this._connected = true;
        this._bindMedia();

        if (document.readyState === 'loading') {
          document.addEventListener(
            'DOMContentLoaded',
            this._handleReady,
            { once: true }
          );
        }

        this._schedule();
      }

      disconnectedCallback() {
        this._connected = false;

        document.removeEventListener(
          'DOMContentLoaded',
          this._handleReady
        );

        this._unbindMedia();
        this._stopWaiting();
        this.destroySwiper();
      }

      attributeChangedCallback(name, oldValue, newValue) {
        if (oldValue === newValue || !this._connected) return;

        if (name === 'mobile-breakpoint') {
          this._bindMedia();
        }

        if (name === 'initial-slide') {
          this._savedIndex = Math.max(
            0,
            Math.floor(this._number('initial-slide', 0))
          );
        }

        this._schedule(true);
      }

      // ---------- 属性读取 ----------

      _boolean(name, fallback = false) {
        if (!this.hasAttribute(name)) return fallback;

        const value = this.getAttribute(name).trim().toLowerCase();

        // 同时支持 navigation 和 navigation="true"
        return !['false', '0', 'off', 'no'].includes(value);
      }

      _number(name, fallback, min = -Infinity) {
        const value = this.getAttribute(name);

        if (value === null || value.trim() === '') return fallback;

        const number = Number(value);

        return Number.isFinite(number)
          ? Math.max(min, number)
          : fallback;
      }

      _json(name, fallback = {}) {
        const value = this.getAttribute(name);

        if (!value) return fallback;

        const parsed = JSON.parse(value);

        if (
          !parsed ||
          typeof parsed !== 'object' ||
          Array.isArray(parsed)
        ) {
          throw new Error(`${name} 必须是 JSON 对象`);
        }

        return parsed;
      }

      // 只查找当前组件的元素，避免嵌套轮播串用箭头。
      _find(selector) {
        return [...this.querySelectorAll(selector)].find(
          element => element.closest('custom-swiper-me') === this
        ) || null;
      }

      _getContainer() {
        return this._find(
          '[data-swiper-container], .swiper-container, .swiper'
        );
      }

      _hasMarkup() {
        const container = this._getContainer();

        if (!container) return false;

        const wrapper = [...container.children].find(
          element => element.classList.contains('swiper-wrapper')
        );

        return Boolean(
          wrapper &&
          [...wrapper.children].some(
            element => element.classList.contains('swiper-slide')
          )
        );
      }

      // ---------- 监听与清理 ----------

      _bindMedia() {
        this._unbindMedia();

        const breakpoint = this._number(
          'mobile-breakpoint',
          767,
          0
        );

        this._mobileMedia = window.matchMedia(
          `(max-width: ${breakpoint}px)`
        );

        this._motionMedia = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );

        this._mobileMedia.addEventListener(
          'change',
          this._handleMediaChange
        );

        this._motionMedia.addEventListener(
          'change',
          this._handleMotionChange
        );
      }

      _unbindMedia() {
        this._mobileMedia?.removeEventListener(
          'change',
          this._handleMediaChange
        );

        this._motionMedia?.removeEventListener(
          'change',
          this._handleMotionChange
        );
      }

      _waitForMarkup() {
        if (this._pendingObserver) return;

        this._pendingObserver = new MutationObserver(
          this._handleChildren
        );

        this._pendingObserver.observe(this, {
          childList: true,
          subtree: true
        });
      }

      _stopWaiting() {
        this._pendingObserver?.disconnect();
        this._pendingObserver = null;
      }

      _schedule(rebuild = false) {
        this._needsRebuild ||= rebuild;

        if (this._queued) return;

        this._queued = true;

        queueMicrotask(() => {
          this._queued = false;

          if (!this._connected) return;

          const shouldRebuild = this._needsRebuild;
          this._needsRebuild = false;

          if (shouldRebuild) {
            this.destroySwiper();
          }

          this.updateSwiper();
        });
      }

      _isDisabled() {
        const disableOn = this.getAttribute('disable-on');
        const mobile = this._mobileMedia?.matches;

        return (
          disableOn === 'all' ||
