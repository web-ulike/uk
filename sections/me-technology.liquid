
{% style %}
.me-technology {
      padding: 100px 0;
      background: #fff;
      color: #413939;
      overflow: hidden;
    }

    .me-technology__head {
      text-align: center;
    }

    .me-technology__tle {
      margin: 0;
      font-size: 44px;
      font-weight: 400;
      line-height: 1.25;
    }

    .me-technology__txt {
      margin: 16px 0 0;
      font-size: 18px;
      line-height: 1.2;
    }

    .me-technology__scroll {
      margin-top: 44px;
    }

    .me-technology__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px 108px;
    }

    .me-technology__card {
      min-width: 0;
    }

    .me-technology__inner {
      position: relative;
      height: 100%;
      min-height: 242px;
      padding: 40px 20px;
      overflow: hidden;
      isolation: isolate;
      border-radius: 10px;
      background: #FFF8FA;
      text-align: center;
      transition: transform .4s ease, box-shadow .4s ease, background .4s ease;
    }

    .me-technology__inner::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background: linear-gradient(110deg, transparent 20%, #fff9 48%, transparent 75%);
      transform: translateX(-150%);
    }

    .me-technology__icon {
      display: block;
      width: 80px;
      height: 80px;
      margin: 0 auto 13px;
      color: #E0004D;
      transition: transform .45s ease;
    }

    .me-technology__icon img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .me-technology__name {
      margin: 0;
      font-size: 26px;
      font-weight: 400;
      line-height: 1.25;
    }

    .me-technology__desc {
      margin: 13px 0 0;
      color: #a29a9e;
      font-size: 18px;
      line-height: 1.25;
    }

    .me-technology__note {
      margin: 18px 0 0;
      color: #928b8e;
      font-size: 12px;
      line-height: 1.4;
    }

    .me-technology__scroll:focus-visible {
      outline: 2px solid #e0004d;
      outline-offset: 5px;
    }

    .me-technology__head.js-me-top.appear {
      animation: me-tech-title .85s cubic-bezier(.16, 1, .3, 1) both;
    }

    .me-technology__card.js-me-top.appear {
      animation: me-tech-card .9s cubic-bezier(.16, 1, .3, 1) var(--me-delay, 0ms) both;
    }

    .me-technology__card.js-me-top.appear .me-technology__inner::after {
      animation: me-tech-shine 1.2s ease var(--me-delay, 0ms) both;
    }

    @keyframes me-tech-title {
      from {
        opacity: 0;
        transform: translateY(26px);
        filter: blur(7px);
      }

      to {
        opacity: 1;
        transform: none;
        filter: blur(0);
      }
    }

    @keyframes me-tech-card {
      from {
        opacity: 0;
        transform: perspective(900px) translateY(55px) rotateX(9deg) scale(.95);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes me-tech-shine {
      to {
        transform: translateX(150%);
      }
    }

    @media (hover: hover) and (pointer: fine) {
      .me-technology__card:hover .me-technology__inner {
        transform: translateY(-8px);
        background: #fff2f7;
        box-shadow: 0 18px 40px #e0004d12;
      }

      .me-technology__card:hover .me-technology__icon {
        transform: translateY(-4px) rotate(-5deg) scale(1.08);
      }
    }

    .me-technology__navagation {
      display: flex;
      align-items: center;
      gap: 27px;
      margin-top: 27px;
      justify-content: flex-end;
      padding-right: 28px;
      display: none;
    }

    .me-technology__navagation svg {
      width: 23px;
      cursor: pointer;
    }

    .me-technology__navagation .me-technology__navagation__arrows.swiper-button-disabled {
      opacity: 0.6;
    }

    @media (min-width: 768px) and (max-width: 1450px) {
      .me-technology {
        padding: 77px 0;
      }

      .me-technology .container {}

      .me-technology__tle {
        font-size: 35px;
      }

      .me-technology__txt {
        margin-top: 13px;
        font-size: 14px;
      }

      .me-technology__scroll {
        margin-top: 35px;
      }

      .me-technology__grid {
        gap: 19px clamp(19px, 5vw, 86px);
      }

      .me-technology__inner {
        min-height: 195px;
        padding: 32px 16px;
        border-radius: 8px;
      }

      .me-technology__icon {
        width: 64px;
        height: 64px;
        margin-bottom: 13px;
      }

      .me-technology__name {
        font-size: 21px;
      }

      .me-technology__desc {
        margin-top: 13px;
        font-size: 14px;
      }

      .me-technology__note {
        margin-top: 14px;
        font-size: 10px;
      }
    }

    @media (max-width: 767px) {
      .me-technology {
        padding: 60px 0;
      }

      .me-technology__navagation {
        display: flex;
      }

      .me-technology .container {
        padding: 0 20px;
      }

      .me-technology__tle {
        max-width: 340px;
        margin: 0 auto;
        font-size: 28px;
      }

      .me-technology__txt {
        max-width: 310px;
        margin: 16px auto 0;
        font-size: 12px;
      }

      .me-technology__scroll {
        margin: 40px -20px 0;
        padding: 0 20px 8px;
      }

      .me-technology__grid {
        /* width: max-content;
        grid-template-columns: repeat(3, 192px); */
        gap: 18px 15px;
        display: flex;
      }

      .me-technology__card {
        scroll-snap-align: start;
      }

      .me-technology__inner {
        min-height: 194px;
        padding: 25px 12px;
        border-radius: 6px;
      }

      .me-technology__icon {
        width: 50px;
        height: 50px;
        margin-bottom: 8px;
      }

      .me-technology__name {
        font-size: 12px;
      }

      .me-technology__desc {
        margin-top: 8px;
        font-size: 9px;
      }

      .me-technology__note {
        margin-top: 18px;
        font-size: 9px;
      }

      .me-technology__scroll.swiper-container {
        position: relative;
        width: calc(100% + 0px);
        height: 356px;
        margin: 40px 0px 0 0;
        padding: 0;
        overflow: hidden;
        touch-action: pan-y;
        scroll-snap-type: none;
      }

      .me-technology__grid.swiper-wrapper {
        display: flex;
        flex-wrap: wrap;
        align-content: flex-start;
        width: 100%;
        height: 100%;
        gap: 0;
        grid-template-columns: none;
      }

      .me-technology__card.swiper-slide {
        flex-shrink: 0;
        min-width: 0;
        height: calc((100% - 16px) / 2);
        scroll-snap-align: none;
      }

      .me-technology__inner {
        box-sizing: border-box;
        height: 100%;
        min-height: 0;
      }

      .me-technology__navagation {
        display: flex;
      }

      .me-technology__navagation .me-technology__navagation__arrows.swiper-button-disabled {
        opacity: .25;
        pointer-events: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      .me-technology__head.to-top.appear,
      .me-technology__card.to-top.appear,
      .me-technology__card.to-top.appear .me-technology__inner::after {
        animation: none;
      }

      .me-technology__inner,
      .me-technology__icon {
        transition: none;
      }

      .me-technology__card:hover .me-technology__inner,
      .me-technology__card:hover .me-technology__icon {
        transform: none;
      }
    }
{% endstyle %}

<section class="me-technology" aria-label="Advanced technology">
      <div class="container">
        <div class="me-technology__head">
          <h2 class="me-technology__tle">{{ section.settings.text_1 | escape }}</h2>
          <p class="me-technology__txt">{{ section.settings.text_2 | escape }}</p>
        </div>
        <custom-swiper-me disable-on="desktop" mobile-breakpoint="767" slides-per-view="2" slides-per-group="1"
          space-between="16" grid-rows="2" grid-fill="row" speed="500" loop="false" centered-slides="false"
          watch-overflow="true" navigation="true" pagination="false">
          <div class="me-technology__scroll swiper-container">
            <div class="me-technology__grid swiper-wrapper">
              {% for block in section.blocks %}
                <article class="me-technology__card swiper-slide js-me-top" style="--me-delay: {{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
                  <div class="me-technology__inner">
                    <div class="me-technology__icon" aria-hidden="true">
                      {% if block.settings.icon != blank %}
                        <img
                          src="{{ block.settings.icon | image_url: width: 240 }}"
                          alt="{{ block.settings.icon.alt | escape }}"
                          width="80"
                          height="80"
                          loading="lazy"
                        >
                      {% endif %}
                    </div>
                    {% if block.settings.title != blank %}
                      <h3 class="me-technology__name">{{ block.settings.title | escape }}</h3>
                    {% endif %}
                    {% if block.settings.description != blank %}
                      <p class="me-technology__desc">{{ block.settings.description | escape }}</p>
                    {% endif %}
                    {% if block.settings.note != blank %}
                      <p class="me-technology__note">{{ block.settings.note | escape }}</p>
                    {% endif %}
                  </div>
                </article>
              {% endfor %}

            </div>
          </div>
<div class="me-technology__navagation">
            <div class="me-technology__navagation__arrows swiper-prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="23" viewBox="0 0 30 23" fill="none">
                <g clip-path="url(#clip0_7980_1345)">
                  <path
                    d="M1.90735e-06 11.4922C1.90735e-06 11.6737 0.067318 11.8537 0.196098 11.9912L10.44 22.9668L11.5098 21.9688L2.41463 12.2239H30C30 11.4161 29.3444 10.7605 28.5366 10.7605H0.765366C0.488781 10.7605 0.219515 10.8995 0.0878067 11.1439C0.0278072 11.2537 1.90735e-06 11.3737 1.90735e-06 11.4922Z"
                    fill="currentColor"></path>
                  <path
                    d="M1.52926 8.92683C2.10146 9.49756 3.0278 9.49756 3.59853 8.92683L11.4922 1.03463L10.4576 0L1.53072 8.92683H1.52926Z"
                    fill="currentColor"></path>
                </g>
                <defs>
                  <clipPath id="clip0_7980_1345">
                    <rect width="30" height="22.9683" fill="white" transform="matrix(-1 0 0 1 30 0)"></rect>
                  </clipPath>
                </defs>
              </svg>
            </div>
            <div class="me-technology__navagation__arrows  swiper-next">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="23" viewBox="0 0 30 23" fill="none" class="">
                <g clip-path="url(#clip0_7980_1341)">
                  <path
                    d="M30 11.4922C30 11.6737 29.9327 11.8537 29.8039 11.9912L19.56 22.9668L18.4902 21.9688L27.5854 12.2239H0C0 11.4161 0.65561 10.7605 1.46341 10.7605H29.2346C29.5112 10.7605 29.7805 10.8995 29.9122 11.1439C29.9722 11.2537 30 11.3737 30 11.4922Z"
                    fill="currentColor"></path>
                  <path
                    d="M28.4707 8.92683C27.8985 9.49756 26.9722 9.49756 26.4015 8.92683L18.5078 1.03463L19.5424 0L28.4693 8.92683H28.4707Z"
                    fill="currentColor"></path>
                </g>
                <defs>
                  <clipPath id="clip0_7980_1341">
                    <rect width="30" height="22.9683" fill="white"></rect>
                  </clipPath>
                </defs>
              </svg>
            </div>
          </div>
        </custom-swiper-me>
      </div>
    </section>
{% schema %}
{
  "name": "Me Product Technology",
  "settings": [
    {
      "type": "text",
      "id": "text_1",
      "label": "Heading",
      "default": "Advanced Technology. Visible Results."
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Subheading",
      "default": "Engineered for fast, comfortable and efficient IPL hair removal at home."
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "technology_card",
      "name": "Technology card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Technology"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Note (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Me Product Technology",
      "blocks": [
        {
          "type": "technology_card",
          "settings": {
            "title": "Sapphire Ice-Cooling Technology",
            "description": "Cooling below 15.6°C for skin comfort*"
          }
        },
        {
          "type": "technology_card",
          "settings": {
            "title": "Up to 21J Energy Output",
            "description": "Ideal for coarse and stubborn hair"
          }
        },
        {
          "type": "technology_card",
          "settings": {
            "title": "AutoGlide Flash Mode",
            "description": "Continuous flashes for faster treatments"
          }
        },
        {
          "type": "technology_card",
          "settings": {
            "title": "287g Lightweight Design",
            "description": "Tailored settings for different body areas and hair types"
          }
        },
        {
          "type": "technology_card",
          "settings": {
            "title": "17 Min Full-Body Session*",
            "description": "Complete a full-body session at home"
          }
        },
        {
          "type": "technology_card",
          "settings": {
            "title": "94.8% Hair Density Reduction*",
            "description": "Visible results in 4 weeks*"
          }
        }
      ]
    }
  ]
}
{% endschema %}
