<style>
.ulike-market {
  padding: 100px 0;
}

.ulike-market .ulike-market-cont {
  display: flex;
}

.ulike-market .ulike-market-img {
  width: 536px;
  position: relative;
  flex-shrink: 0;
}

.ulike-market .ulike-market-img::before {
  width: 100%;
  padding-top: 75%;
  content: '';
  display: block;
  position: relative;
}

.ulike-market .ulike-market-img .market-img {
  position: absolute;
  z-index: 2;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  object-fit: cover;
}

.ulike-market .ulike-market-info {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 32px;
  background: #f6f6f6;
}

.ulike-market .ulike-market-h3 {
  color: #190a0a;
  font-size: 40px;
  line-height: 1.2;
  font-family: var(--heading-font-family);
  font-weight: normal;
  margin: 0;
  margin-bottom: 16px;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ulike-market .ulike-market-p {
  color: #190a0a;
  font-size: 24px;
  line-height: 1.33;
  margin: 0;
  margin-bottom: 24px;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ulike-market .ulike-market-link {
  display: flex;
  width: 218px;
  height: 48px;
  justify-content: center;
  align-items: center;
  border-radius: 4px;
  background: #190a0a;
  color: #fbfaf4;
  font-family: var(--heading-font-family);
  font-size: 14px;
  line-height: 1.57;
}

@media (max-width: 991px) {
  .ulike-market {
    padding: 30px 0;
  }
  .ulike-market .ulike-market-cont {
    flex-direction: column;
  }
  .ulike-market .ulike-market-img {
    width: 100%;
  }

  .ulike-market .ulike-market-info {
    padding: 16px 8px 24px 8px;
  }

  .ulike-market .ulike-market-h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }

  .ulike-market .ulike-market-p {
    font-size: 12px;
    margin-bottom: 24px;
  }

  .ulike-market .ulike-market-link {
    margin: 0 auto;
  }
}
</style>

<div class="ulike-market">
    <div class="container">
        <div class="ulike-market-cont">
            {%- if section.settings.image != blank -%}
                <div class="ulike-market-img">
                    <img
                        loading="lazy"
                        class="market-img"
                        width=""
                        height=""
                        {% render 'image-attributes', image: section.settings.image %}
                        alt="{{ section.settings.image.alt | escape }}"
                    >
                </div>
            {%- endif -%}
        <div class="ulike-market-info">
            <div>
                {% if section.settings.text != blank %}
                    <h3 class="ulike-market-h3">{{ section.settings.text }}</h3>
                {% endif %}
                {% if section.settings.text1 != blank %}
                    <p class="ulike-market-p">
                        {{ section.settings.text1 }}
                    </p>
            {% endif %}
            {% if section.settings.text2 != blank %}
                <a href="{{ section.settings.link }}" class="ulike-market-link">{{ section.settings.text2 }}</a>
            {% endif %}
            </div>
        </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "ulike-market",
  "settings": [
    {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
    },
    {
        "type": "text",
        "id": "text",
        "label": "Text"
    },
    {
        "type": "text",
        "id": "text1",
        "label": "Text"
    },
    {
        "type": "text",
        "id": "text2",
        "label": "Text"
    },
    {
        "type": "url",
        "id": "link",
        "label": "链接"
    },
  ],
  "presets": [
    {
      "name": "ulike-market",
      "blocks": []
    }
  ]
}
{% endschema %}