<style>
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --section-background: {{ section.settings.background }};
    --accent-color: {{ section.settings.accent_color }};
    --title-color: {{ section.settings.title_color }};
    --text-color: {{ section.settings.text_color }};
  }

  .feature-showcase {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background: var(--section-background);
  }

  .feature-showcase__container {
    position: relative;
  }

  .feature-showcase__stage {
    position: relative;
    transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .feature-showcase__slide {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    grid-template-columns: 557px minmax(0, 1fr);
    gap: 78px;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .feature-showcase__slide.is-active {
    position: relative;
    z-index: 1;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .feature-showcase__slide.is-entering,
  .feature-showcase__slide.is-leaving {
    position: absolute;
    inset: 0;
    opacity: 1;
    visibility: visible;
    pointer-events: none;
  }

  .feature-showcase__slide.is-entering {
    z-index: 2;
  }

  .feature-showcase__slide.is-leaving {
    z-index: 1;
  }

  .feature-showcase__content {
    min-width: 0;
    will-change: opacity, transform;
  }

  .feature-showcase__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    color: var(--accent-color);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
  }

  .feature-showcase__eyebrow-icon {
    display: block;
    flex: 0 0 auto;
  }

  .feature-showcase__title {
    margin: 0;
    color: var(--title-color);
    font-size: 48px;
    font-weight: 400;
    line-height: 1.25;
  }

  .feature-showcase__divider {
    display: block;
    width: 124px;
    height: 2px;
    margin: 24px 0;
    background: #7c7abc;
  }

  .feature-showcase__description {
    max-width: 557px;
    color: var(--text-color);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.6;
  }

  .feature-showcase__description p {
    margin: 0;
  }

  .feature-showcase__description p + p {
    margin-top: 12px;
  }

  .feature-showcase__stat {
    margin-top: 36px;
    color: var(--accent-color);
  }

  .feature-showcase__stat-label {
    margin-bottom: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
  }

  .feature-showcase__stat-value {
    font-size: 48px;
    font-weight: 400;
    line-height: 1;
    background: linear-gradient(180deg, #BCBBFF 0%, #5B5A92 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .feature-showcase__info {
    max-width: 526px;
    margin-top: 8px;
  }

  .feature-showcase__info.feature-showcase__info__img-large {
    margin-top: 16px;
  }

  .feature-showcase__info-label {
    margin-bottom: 16px;
    color: var(--accent-color);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }

  .feature-showcase__info-image {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .feature-showcase__footnote {
    max-width: 636px;
    margin-top: 18px;
    color: #8b8b8b;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
  }

  .feature-showcase__footnote p {
    margin: 0;
  }

  .feature-showcase__media {
    position: relative;
    width: 100%;
    aspect-ratio: 17 / 10;
    overflow: hidden;
    background: #f3f3f1;
    border-radius: 8px;
    will-change: opacity, transform;
  }

  .feature-showcase__image,
  .feature-showcase__video,
  .feature-showcase__media > svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-showcase__navigation {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 28px;
    width: 100%;
    margin-top: 40px;
  }

  .feature-showcase__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    padding: 0;
    color: #171717;
    background: transparent;
    border: 0;
    outline: 0;
    opacity: 1;
    cursor: pointer;
    transform: translate3d(0, 0, 0);
    transition:
      opacity 0.3s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .feature-showcase__arrow svg {
    display: block;
    width: 32px;
    height: auto;
    pointer-events: none;
  }

  .feature-showcase__arrow--prev:not(:disabled):hover {
    transform: translate3d(-5px, 0, 0);
  }

  .feature-showcase__arrow--next:not(:disabled):hover {
    transform: translate3d(5px, 0, 0);
  }

  .feature-showcase__arrow:not(:disabled):active {
    transform: translate3d(0, 0, 0) scale(0.94);
    transition-duration: 0.12s;
  }

  .feature-showcase__arrow:disabled {
    opacity: 0.25;
    cursor: default;
    pointer-events: none;
  }

  @media screen and (max-width: 1450px) {
    .feature-showcase__slide {
      grid-template-columns: 490px minmax(0, 1fr);
      gap: 64px;
    }
  }

  @media screen and (max-width: 1023px) {
    .feature-showcase {
      padding-top: var(--mobile-padding-top);
      padding-bottom: var(--mobile-padding-bottom);
    }

    .feature-showcase__slide {
      grid-template-columns: 1fr;
      gap: 41px;
    }

    .feature-showcase__content {
      max-width: 680px;
    }

    .feature-showcase__media {
      aspect-ratio: 16 / 10;
    }

    .feature-showcase__navigation {
      margin-top: 34px;
    }
  }

  @media screen and (max-width: 767px) {
    .feature-showcase__stage {
      touch-action: pan-y;
    }
    .feature-showcase__slide {
      gap: 41px;
      min-height: 620px;
    }

    .feature-showcase__eyebrow {
      gap: 8px;
      margin-bottom: 14px;
      font-size: 12px;
    }

    .feature-showcase__eyebrow-icon {
      width: 19px;
    }

    .feature-showcase__title {
      font-size: 24px;
      line-height: 1.2;
    }

    .feature-showcase__divider {
      width: 124px;
      margin: 14px 0;
    }

    .feature-showcase__description {
      font-size: 14px;
      line-height: 1.5;
    }

    .feature-showcase__stat {
      margin-top: 28px;
    }

    .feature-showcase__stat-value {
      font-size: 32px;
    }

    .feature-showcase__info {
      margin-top: 4px;
    }

    .feature-showcase__footnote {
      margin-top: 22px;
      font-size: 8px;
    }

    .feature-showcase__media {
      aspect-ratio: 336 / 200;
      border-radius: 4px;
    }

    .feature-showcase__navigation {
      gap: 20px;
      margin-top: 32px;
              justify-content: center;
    }

    .feature-showcase__arrow {
      width: 22px;
      height: 22px;
    }

    .feature-showcase__arrow svg {
      width: 20px;
    }
    .feature-showcase__info-label {
    margin-bottom: 8px;
    font-size: 10px;
}
    .feature-showcase__info-image {
        max-width: 550px;
        width:100%;
    }
  }

  @media (hover: none) {
    .feature-showcase__arrow--prev:not(:disabled):hover,
    .feature-showcase__arrow--next:not(:disabled):hover {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-showcase__stage,
    .feature-showcase__arrow {
      transition: none;
    }
  }
</style>

<section class="feature-showcase" data-feature-showcase="{{ section.id }}">
  <div class="feature-showcase__container container to-top">

    <div class="feature-showcase__stage" data-feature-stage>
      {% for block in section.blocks %}
        <article
          class="feature-showcase__slide{% if forloop.first %} is-active{% endif %}"
          data-feature-slide
          data-index="{{ forloop.index0 }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="feature-showcase__content" data-feature-copy>

            {% if block.settings.eyebrow != blank %}
              <div class="feature-showcase__eyebrow">
                {% if block.settings.eyebrow_icon != blank %}
                  <img
                    class="feature-showcase__eyebrow-icon"
                    src="{{ block.settings.eyebrow_icon | image_url: width: 80 }}"
                    alt=""
                    width="{{ block.settings.eyebrow_icon.width }}"
                    height="{{ block.settings.eyebrow_icon.height }}"
                    loading="lazy"
                  >
                {% endif %}
                <span>{{ block.settings.eyebrow }}</span>
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h2 class="feature-showcase__title">
                {{ block.settings.title | newline_to_br }}
              </h2>
            {% endif %}

            {% if block.settings.description != blank %}
              <span class="feature-showcase__divider"></span>
              <div class="feature-showcase__description">
                {{ block.settings.description }}
              </div>
            {% endif %}

            {% if block.settings.stat_label != blank or block.settings.stat_value != blank %}
              <div class="feature-showcase__stat">
                {% if block.settings.stat_label != blank %}
                  <div class="feature-showcase__stat-label">
                    {{ block.settings.stat_label }}
                  </div>
                {% endif %}

                {% if block.settings.stat_value != blank %}
                  <div class="feature-showcase__stat-value">
                    {{ block.settings.stat_value }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.info_label != blank or block.settings.info_image != blank %}
              <div class="feature-showcase__info{% if block.settings.info_image != blank %} feature-showcase__info__img-large{% endif %}">
                {% if block.settings.info_label != blank %}
                  <div class="feature-showcase__info-label">
                    {{ block.settings.info_label }}
                  </div>
                {% endif %}

                {% if block.settings.info_image != blank %}
                  <img
                    class="feature-showcase__info-image"
                    src="{{ block.settings.info_image | image_url: width: 1000 }}"
                    srcset="
                      {{ block.settings.info_image | image_url: width: 400 }} 400w,
                      {{ block.settings.info_image | image_url: width: 700 }} 700w,
                      {{ block.settings.info_image | image_url: width: 1000 }} 1000w
                    "
                    sizes="(max-width: 767px) 100vw, 520px"
                    alt="{{ block.settings.info_label | escape }}"
                    width="{{ block.settings.info_image.width }}"
                    height="{{ block.settings.info_image.height }}"
                    loading="lazy"
                  >
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.footnote != blank %}
              <div class="feature-showcase__footnote">
                {{ block.settings.footnote }}
              </div>
            {% endif %}

          </div>

          <div class="feature-showcase__media" data-feature-media>
            {% if block.settings.video != blank %}
              {{
                block.settings.video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  preload: 'metadata',
                  class: 'feature-showcase__video'
              }}
            {% elsif block.settings.image != blank %}
              <img
                class="feature-showcase__image"
                src="{{ block.settings.image | image_url: width: 1800 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 700 }} 700w,
                  {{ block.settings.image | image_url: width: 1100 }} 1100w,
                  {{ block.settings.image | image_url: width: 1400 }} 1400w,
                  {{ block.settings.image | image_url: width: 1800 }} 1800w
                "
                sizes="(max-width: 1023px) 100vw, 60vw"
                alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'feature-showcase__image' }}
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="feature-showcase__navigation">
        <button
          class="feature-showcase__arrow feature-showcase__arrow--prev"
          type="button"
          data-feature-prev
          aria-label="Previous feature"
        >
          <svg viewBox="0 0 34 20" fill="none" aria-hidden="true">
            <path
              d="M10 1L1 10M1 10L10 19M1 10H33"
              stroke="currentColor"
              stroke-width="1.3"
            />
          </svg>
        </button>

        <button
          class="feature-showcase__arrow feature-showcase__arrow--next"
          type="button"
          data-feature-next
          aria-label="Next feature"
        >
          <svg viewBox="0 0 34 20" fill="none" aria-hidden="true">
            <path
              d="M24 1L33 10M33 10L24 19M33 10H1"
              stroke="currentColor"
              stroke-width="1.3"
            />
          </svg>
        </button>
      </div>
    {% endif %}

  </div>
</section>

<script>
(() => {
  const section = document.querySelector(
    '[data-feature-showcase="{{ section.id }}"]'
  );

  if (!section || section.dataset.featureInitialized) return;

  section.dataset.featureInitialized = 'true';

  const stage = section.querySelector('[data-feature-stage]');
  const slides = [...section.querySelectorAll('[data-feature-slide]')];
  const prev = section.querySelector('[data-feature-prev]');
  const next = section.querySelector('[data-feature-next]');
  const loop = {{ section.settings.loop | json }};
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!stage || !slides.length) return;

  let activeIndex = Math.max(
    0,
    slides.findIndex(slide => slide.classList.contains('is-active'))
  );

  let animating = false;
  let resizeTimer;
  let touchStartX = 0;
  let touchStartY = 0;
  let touchStartTime = 0;

  const clearStyles = el => {
    if (!el) return;
    el.style.transition = '';
    el.style.opacity = '';
    el.style.transform = '';
  };

  const updateNav = () => {
    if (prev) prev.disabled = !loop && activeIndex === 0;
    if (next) next.disabled = !loop && activeIndex === slides.length - 1;
  };

  const setActive = index => {
    slides.forEach((slide, i) => {
      slide.classList.remove('is-active', 'is-entering', 'is-leaving');

      clearStyles(slide.querySelector('[data-feature-copy]'));
      clearStyles(slide.querySelector('[data-feature-media]'));

      const active = i === index;

      if (active) slide.classList.add('is-active');

      slide.setAttribute(
        'aria-hidden',
        active ? 'false' : 'true'
      );
    });

    activeIndex = index;
    stage.style.height = '';

    updateNav();
  };

  const getIndex = index => {
    if (loop) {
      if (index < 0) return slides.length - 1;
      if (index >= slides.length) return 0;
      return index;
    }

    return Math.max(
      0,
      Math.min(index, slides.length - 1)
    );
  };

  const goTo = (index, direction) => {
    if (animating) return;

    const targetIndex = getIndex(index);

    if (targetIndex === activeIndex) return;

    if (reduceMotion) {
      setActive(targetIndex);
      return;
    }

    const current = slides[activeIndex];
    const target = slides[targetIndex];

    const currentCopy = current.querySelector('[data-feature-copy]');
    const currentMedia = current.querySelector('[data-feature-media]');
    const targetCopy = target.querySelector('[data-feature-copy]');
    const targetMedia = target.querySelector('[data-feature-media]');

    const sign = direction === 'prev' ? -1 : 1;

    animating = true;

    stage.style.height = `${current.offsetHeight}px`;

    target.classList.add('is-entering');
    target.setAttribute('aria-hidden', 'false');

    if (targetCopy) {
      targetCopy.style.transition = 'none';
      targetCopy.style.opacity = '0';
      targetCopy.style.transform =
        `translate3d(${48 * sign}px,0,0)`;
    }

    if (targetMedia) {
      targetMedia.style.transition = 'none';
      targetMedia.style.opacity = '0';
      targetMedia.style.transform =
        `translate3d(${24 * sign}px,0,0) scale(.985)`;
    }

    const targetHeight = target.offsetHeight;

    current.classList.add('is-leaving');

    void stage.offsetHeight;

    stage.style.height = `${targetHeight}px`;

    if (currentCopy) {
      currentCopy.style.transition =
        'opacity .3s ease,transform .4s cubic-bezier(.4,0,.2,1)';
      currentCopy.style.opacity = '0';
      currentCopy.style.transform =
        `translate3d(${-32 * sign}px,0,0)`;
    }

    if (currentMedia) {
      currentMedia.style.transition =
        'opacity .36s ease,transform .46s cubic-bezier(.4,0,.2,1)';
      currentMedia.style.opacity = '0';
      currentMedia.style.transform =
        `translate3d(${-16 * sign}px,0,0) scale(.99)`;
    }

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (targetCopy) {
          targetCopy.style.transition =
            'opacity .44s ease .08s,transform .56s cubic-bezier(.22,1,.36,1) .08s';
          targetCopy.style.opacity = '1';
          targetCopy.style.transform = 'translate3d(0,0,0)';
        }

        if (targetMedia) {
          targetMedia.style.transition =
            'opacity .5s ease .04s,transform .62s cubic-bezier(.22,1,.36,1) .04s';
          targetMedia.style.opacity = '1';
          targetMedia.style.transform =
            'translate3d(0,0,0) scale(1)';
        }
      });
    });

    setTimeout(() => {
      setActive(targetIndex);
      animating = false;
    }, 720);
  };

  prev?.addEventListener('click', () => {
    goTo(activeIndex - 1, 'prev');
  });

  next?.addEventListener('click', () => {
    goTo(activeIndex + 1, 'next');
  });

  stage.addEventListener(
    'touchstart',
    e => {
      if (window.innerWidth > 767 || e.touches.length !== 1) return;

      const touch = e.touches[0];

      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchStartTime = Date.now();
    },
    { passive: true }
  );

  stage.addEventListener(
    'touchend',
    e => {
      if (
        window.innerWidth > 767 ||
        animating ||
        !e.changedTouches.length
      ) {
        return;
      }

      const touch = e.changedTouches[0];
      const diffX = touch.clientX - touchStartX;
      const diffY = touch.clientY - touchStartY;
      const duration = Date.now() - touchStartTime;
      const absX = Math.abs(diffX);
      const absY = Math.abs(diffY);

      if (
        absX < 45 ||
        absX < absY * 1.2 ||
        duration > 800
      ) {
        return;
      }

      if (diffX < 0) {
        goTo(activeIndex + 1, 'next');
      } else {
        goTo(activeIndex - 1, 'prev');
      }
    },
    { passive: true }
  );

  document.addEventListener(
    'shopify:block:select',
    e => {
      const slide = e.target.closest?.('[data-feature-slide]');

      if (!slide || !section.contains(slide)) return;

      const index = Number(slide.dataset.index);

      if (!Number.isNaN(index)) {
        setActive(index);
      }
    }
  );

  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);

    resizeTimer = setTimeout(() => {
      if (!animating) stage.style.height = '';
    }, 150);
  });

  updateNav();
})();
</script>
{% schema %}
{
  "name": "Feature Showcase Home",
  "settings": [
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto Switch",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto Switch Interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#fafaf7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#7373d7"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1d1717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2e2929"
    },
    {
      "type": "header",
      "content": "Desktop Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "eyebrow_icon",
          "label": "Feature Icon"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Feature Label",
          "default": "SkinSensor"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title",
          "default": "Smart skin protection."
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Skin tones vary across your body. That's why Ulike's built-in SkinSensor automatically detects your tone and adjusts power levels in real time.</p>"
        },
        {
          "type": "header",
          "content": "Stat"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Stat Label"
        },
