<style>
  #shopify-section-{{ section.id }} .ulike-moments {
    overflow: hidden;
    background: #fffffc;
    padding: 80px 0 73px;
    font-family: Saans, sans-serif;
  }

  #shopify-section-{{ section.id }} .ulike-moments__title {
    margin: 0 20px 70px;
    color: #1a1a1a;
    font-size: 48px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .ulike-moments__slider {
    position: relative;
  }

  #shopify-section-{{ section.id }} .ulike-moments__viewport {
    position: relative;
    height: 460px;
    overflow: hidden;
    touch-action: pan-y;
  }

  #shopify-section-{{ section.id }} .ulike-moments__track {
    position: relative;
    display: flex;
    box-sizing: content-box;
    width: 100%;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card {
    position: relative;
    flex: 0 0 auto;
    width: min(880px, calc(100% - 40px));
    min-width: 0;
    height: 460px;
    overflow: hidden;
    border-radius: 8px;
    background: #faf6f1;
  }

  #shopify-section-{{ section.id }} .ulike-moments__image {
    position: absolute;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card--intimate .ulike-moments__image {
    top: -21.1%;
    left: -3.75%;
    width: 114.55%;
    height: 122.4%;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card--beach .ulike-moments__image {
    right: -10%;
    bottom: 0;
    width: 156.9%;
    height: 136.1%;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card--occasion .ulike-moments__image {
    top: 0;
    left: -5.23%;
    width: 119.3%;
    height: 125.2%;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card--business .ulike-moments__image {
    top: -15.4%;
    left: -2.84%;
    width: 115.6%;
    height: 123.3%;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card--custom .ulike-moments__image {
    inset: 0;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card::after {
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    height: 49.35%;
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, .3));
    content: '';
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .ulike-moments__content {
    position: absolute;
    z-index: 2;
    bottom: 26px;
    left: 53px;
    width: min(505px, calc(100% - 106px));
    color: #fff;
  }

  #shopify-section-{{ section.id }} .ulike-moments__card-title {
    margin: 0 0 11px;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .ulike-moments__description {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .ulike-moments__navigation {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 60px;
    right: 60px;
    display: flex;
    justify-content: space-between;
    transform: translateY(-50%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .ulike-moments__arrow {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    padding: 0;
    border: .571px solid #190a0a;
    border-radius: 4.571px;
    background: #fff;
    color: #190a0a;
    cursor: pointer;
    pointer-events: auto;
    transition: background-color .4s ease, color .4s ease, border-color .4s ease;
  }

  @media (hover: hover) and (min-width: 768px) {
    #shopify-section-{{ section.id }} .ulike-moments__arrow:not(:disabled):hover {
      background: #190a0a;
      color: #fff;
    }
  }

  #shopify-section-{{ section.id }} .ulike-moments__arrow img {
    display: block;
    transition: filter .4s ease;
  }

  #shopify-section-{{ section.id }} [data-moments-prev] img {
    transform: rotate(180deg);
  }

  @media (hover: hover) and (min-width: 768px) {
    #shopify-section-{{ section.id }} .ulike-moments__arrow:hover img {
      filter: brightness(0) invert(1);
    }
  }

  #shopify-section-{{ section.id }} .ulike-moments__arrow:disabled {
    opacity: .45;
    cursor: default;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .ulike-moments__arrow:focus-visible {
    outline: 2px solid #190a0a;
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .ulike-moments {
      padding: 40px 0 39px;
    }

    #shopify-section-{{ section.id }} .ulike-moments__title {
      margin: 0 19px 31px;
      font-size: 24px;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .ulike-moments__viewport {
      height: 314px;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card {
      width: 257px;
      max-width: calc(100vw - 38px);
      height: 314px;
      border-radius: 4px;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--intimate .ulike-moments__image {
      top: 0;
      left: -53.3%;
      width: 218.7%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--beach .ulike-moments__image {
      right: -98%;
      bottom: 0;
      width: 359.5%;
      height: 137.3%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--occasion .ulike-moments__image {
      top: 0;
      left: -45.9%;
      width: 197.3%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--business .ulike-moments__image {
      top: 0;
      left: -72.4%;
      width: 219.1%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--custom .ulike-moments__image {
      inset: 0;
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card--mobile-custom .ulike-moments__image {
      inset: 0;
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card::after {
      height: 100%;
      background: linear-gradient(to bottom, rgba(0, 0, 0, .01) 64%, rgba(25, 10, 10, .5));
    }

    #shopify-section-{{ section.id }} .ulike-moments__content {
      bottom: 16px;
      left: 16px;
      width: 224px;
    }

    #shopify-section-{{ section.id }} .ulike-moments__card-title {
      margin-bottom: 3px;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .ulike-moments__description {
      font-size: 12px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .ulike-moments__navigation {
      position: relative;
      top: auto;
      left: calc(78.13% - 38.97px);
      right: auto;
      width: 62.699px;
      margin: 31.5px 0 0;
      transform: none;
    }

    #shopify-section-{{ section.id }} .ulike-moments__arrow:disabled {
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .ulike-moments__arrow img {
      width: 21px;
      height: 16px;
    }

    #shopify-section-{{ section.id }} [data-moments-prev] img {
      transform: none;
    }

    #shopify-section-{{ section.id }} .ulike-moments__arrow {
      width: 21px;
      height: 16px;
      border: 0;
      border-radius: 0;
      background: transparent;
    }
  }

</style>

<section class="ulike-moments" data-ulike-moments="{{ section.id }}" aria-label="{{ section.settings.title | escape }}">
  {% if section.settings.title != blank %}
    <h2 class="ulike-moments__title">{{ section.settings.title | escape }}</h2>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="ulike-moments__slider">
      <div class="ulike-moments__viewport swiper-container" data-moments-viewport tabindex="0" aria-label="{{ section.settings.title | escape }}">
      <div class="ulike-moments__track swiper-wrapper" data-moments-track>
        {% for block in section.blocks %}
          {% liquid
            assign default_image_filename = blank
            assign default_image_height = 982
            case block.settings.default_image
              when 'intimate'
                assign default_image_filename = 'ulike-moments-intimate.jpg'
              when 'beach'
                assign default_image_filename = 'ulike-moments-beach.jpg'
                assign default_image_height = 1119
              when 'occasion'
                assign default_image_filename = 'ulike-moments-occasion.jpg'
                assign default_image_height = 734
              when 'business'
                assign default_image_filename = 'ulike-moments-business.jpg'
            endcase
            assign desktop_image = block.settings.desktop_image
            assign mobile_image = block.settings.mobile_image
          %}
          <article class="ulike-moments__card swiper-slide ulike-moments__card--{% if desktop_image != blank %}custom{% else %}{{ block.settings.default_image }}{% endif %}{% if mobile_image != blank %} ulike-moments__card--mobile-custom{% endif %}" {{ block.shopify_attributes }}>
            {% if desktop_image != blank %}
              <picture>
                {% if mobile_image != blank %}
                  <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 750 }}">
                {% endif %}
                <img class="ulike-moments__image" src="{{ desktop_image | image_url: width: 1800 }}" alt="" width="{{ desktop_image.width }}" height="{{ desktop_image.height }}" loading="lazy">
              </picture>
            {% elsif default_image_filename != blank %}
              <picture>
                {% if mobile_image != blank %}
                  <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 750 }}">
                {% endif %}
                <img class="ulike-moments__image" src="{{ default_image_filename | asset_url }}" alt="" width="1760" height="{{ default_image_height }}" loading="lazy">
              </picture>
            {% endif %}
            <div class="ulike-moments__content">
              {% if block.settings.title != blank %}<h3 class="ulike-moments__card-title">{{ block.settings.title | escape }}</h3>{% endif %}
              {% if block.settings.description != blank %}<p class="ulike-moments__description">{{ block.settings.description | escape }}</p>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
      </div>
      {% if section.blocks.size > 1 %}
        <div class="ulike-moments__navigation">
          <button class="ulike-moments__arrow" type="button" data-moments-prev aria-label="Previous card">
            <picture>
              <source media="(max-width: 767px)" srcset="{{ 'ulike-moments-mobile-prev.svg' | asset_url }}" data-enabled-src="{{ 'ulike-moments-mobile-prev.svg' | asset_url }}" data-disabled-src="{{ 'ulike-moments-mobile-prev-disabled.svg' | asset_url }}">
              <img src="{{ 'ulike-moments-arrow.svg' | asset_url }}" alt="" width="19.8717" height="15.2139">
            </picture>
          </button>
          <button class="ulike-moments__arrow" type="button" data-moments-next aria-label="Next card">
            <picture>
              <source media="(max-width: 767px)" srcset="{{ 'ulike-moments-mobile-next.svg' | asset_url }}" data-enabled-src="{{ 'ulike-moments-mobile-next.svg' | asset_url }}" data-disabled-src="{{ 'ulike-moments-mobile-next-disabled.svg' | asset_url }}">
              <img src="{{ 'ulike-moments-arrow.svg' | asset_url }}" alt="" width="19.8717" height="15.2139">
            </picture>
          </button>
        </div>
      {% endif %}
    </div>
  {% endif %}
</section>

<script>
  (() => {
    const id = {{ section.id | json }};
    const selector = `[data-ulike-moments="${id}"]`;
    let retry;
    const init = () => {
      const section = document.querySelector(selector);
      if (!section || section.momentsSwiper) return;
      const viewport = section.querySelector('[data-moments-viewport]');
      if (!viewport) return;
      if (typeof window.Swiper === 'undefined') {
        retry = window.setTimeout(init, 100);
        return;
      }
      const count = {{ section.blocks.size | json }};
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const updateNavigation = (disabled) => {
        section.querySelectorAll('.ulike-moments__arrow').forEach(button => {
          button.disabled = disabled;
          const source = button.querySelector('source');
          if (source) source.srcset = disabled ? source.dataset.disabledSrc : source.dataset.enabledSrc;
        });
      };
      const swiper = new window.Swiper(viewport, {
        slidesPerView: 'auto',
        spaceBetween: 16,
        loop: count > 1,
        loopedSlides: count,
        initialSlide: window.matchMedia('(min-width: 768px)').matches && count > 1 ? 1 : 0,
        speed: reducedMotion ? 0 : 600,
        grabCursor: count > 1,
        mousewheel: { forceToAxis: true },
        centeredSlides: false,
        slidesOffsetBefore: 19,
        slidesOffsetAfter: 19,
        autoplay: {{ section.settings.autoplay | default: true, allow_false: true | json }} && !reducedMotion && count > 1 ? {
          delay: {{ section.settings.autoplay_interval | default: 5 | times: 1000 | json }},
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        } : false,
        navigation: {
          prevEl: section.querySelector('[data-moments-prev]'),
          nextEl: section.querySelector('[data-moments-next]')
        },
        breakpoints: {
          768: { centeredSlides: true, slidesOffsetBefore: 14, slidesOffsetAfter: 14 }
        },
        on: {
          init: () => updateNavigation(count < 2),
          transitionStart: (instance) => updateNavigation(count < 2 || instance.params.speed > 0),
          transitionEnd: () => updateNavigation(count < 2)
        }
      });
      section.momentsSwiper = swiper;
      viewport.addEventListener('keydown', event => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        event.key === 'ArrowRight' ? swiper.slideNext() : swiper.slidePrev();
      });
      section.addEventListener('shopify:block:select', event => {
        const card = event.target.closest('.ulike-moments__card');
        if (!card) return;
        swiper.autoplay?.stop();
        const index = Number(card.dataset.swiperSlideIndex ?? Array.from(card.parentNode.children).indexOf(card));
        swiper.params.loop ? swiper.slideToLoop(index) : swiper.slideTo(index);
      });
      section.addEventListener('shopify:block:deselect', () => {
        if (swiper.params.autoplay) swiper.autoplay?.start();
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
    else init();
    document.addEventListener('shopify:section:load', event => {
      if (event.target.querySelector?.(selector)) init();
    });
    document.addEventListener('shopify:section:unload', event => {
      const section = event.target.querySelector?.(selector);
      if (!section) return;
      window.clearTimeout(retry);
      section.momentsSwiper?.destroy(true, true);
    });
  })();
</script>

{% schema %}
{
  "name": "Ulike Moments",
  "tag": "section",
  "class": "section-ulike-moments",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Built for Every Moment" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto rotate cards", "default": true },
    { "type": "range", "id": "autoplay_interval", "label": "Change cards every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment card",
      "settings": [
        { "type": "select", "id": "default_image", "label": "Default image", "options": [
          { "value": "intimate", "label": "Intimate Moments" },
          { "value": "beach", "label": "Beach Getaway" },
          { "value": "occasion", "label": "Special Occasion Ready" },
          { "value": "business", "label": "Business Ready" }
        ], "default": "intimate" },
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Uses the desktop or default image when empty." },
        { "type": "text", "id": "title", "label": "Title", "default": "Intimate Moments" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A gentle mode designed for delicate areas, leaving skin feeling soft and smooth." }
      ]
    }
  ],
  "presets": [
    { "name": "Ulike Moments", "blocks": [
      { "type": "moment", "settings": { "default_image": "intimate", "title": "Intimate Moments", "description": "A gentle mode designed for delicate areas, leaving skin feeling soft and smooth." } },
      { "type": "moment", "settings": { "default_image": "beach", "title": "Beach Getaway", "description": "A bikini-sensitive-area mode designed for comfort, helping reduce the look of redness and irritation." } },
      { "type": "moment", "settings": { "default_image": "occasion", "title": "Special Occasion Ready", "description": "A smoothing mode for the shoulders, neck, and back, so you’re ready for every special occasion." } },
      { "type": "moment", "settings": { "default_image": "business", "title": "Business Ready", "description": "A quick touch-up mode for small areas, perfect for busy mornings and last-minute grooming." } }
    ] }
  ]
}
{% endschema %}
