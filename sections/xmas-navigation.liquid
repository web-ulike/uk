{% if section.settings.sticky_navigation %}<xmas-sticky-navigation>{% endif %}
<nav class="xmas-navigation" aria-label="Christmas event">
  <div class="container">
    <div class="xmas-navigation__layout">
      <ul class="xmas-navigation__links" role="list">
        {% for block in section.blocks %}
          {% assign anchor = block.settings.anchor | handleize %}
          {% if anchor != blank and block.settings.label != blank %}
            <li {{ block.shopify_attributes }}>
              <a href="#{{ anchor }}">{{ block.settings.label | escape }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      {% assign button_anchor = section.settings.button_anchor | handleize %}
      {% if button_anchor != blank and section.settings.button_label != blank %}
        <a class="xmas-navigation__button" href="#{{ button_anchor }}">
          {{ section.settings.button_label | escape }}
          <span class="xmas-navigation__arrow" aria-hidden="true">↓</span>
        </a>
      {% endif %}
    </div>
  </div>
</nav>
{% if section.settings.sticky_navigation %}</xmas-sticky-navigation>{% endif %}

{% stylesheet %}
  xmas-sticky-navigation { display: block; }

  .shopify-section:has(> xmas-sticky-navigation) {
    position: sticky;
    top: calc(
      var(--header-height, 0px) * var(--enable-sticky-header, 0) +
      var(--announcement-bar-height, 0px) * var(--enable-sticky-announcement-bar, 0)
    );
    z-index: 3;
  }

  .xmas-navigation {
    background: #fbf6ed;
    border-block: 1px solid #e3d3be;
    color: #49332e;
    font: 500 16px/1.3 Saans, sans-serif;
  }

  .xmas-navigation__layout {
    display: flex;
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    padding-block: 12px;
  }

  .xmas-navigation__links {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    column-gap: clamp(20px, 3.2vw, 52px);
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xmas-navigation__links li {
    display: flex;
    min-width: 0;
    max-width: 100%;
  }

  .xmas-navigation__links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 2px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }

  .xmas-navigation__links a:hover,
  .xmas-navigation__links a:focus-visible {
    color: #811425;
    text-decoration-color: currentColor;
  }

  .xmas-navigation .xmas-navigation__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex: 0 0 auto;
    max-width: 42%;
    min-height: 46px;
    padding: 7px 8px 7px 18px;
    border-radius: 999px;
    background: #741a2c;
    color: #fff9ee;
    overflow-wrap: anywhere;
  }

  .xmas-navigation .xmas-navigation__button:hover {
    background: #571020;
  }

  .xmas-navigation__arrow {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff9ee;
    color: #741a2c;
    font-size: 16px;
  }

  .xmas-navigation a:focus-visible {
    outline: 2px solid #811425;
    outline-offset: 2px;
  }

  @media (max-width: 700px) {
    .xmas-navigation { font-size: 15px; }

    .xmas-navigation__layout {
      display: grid;
      gap: 12px;
      padding-block: 8px 14px;
    }

    .xmas-navigation__links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 16px;
    }

    .xmas-navigation__links li { border-bottom: 1px solid #e3d3be; }
    .xmas-navigation__links a { width: 100%; }

    .xmas-navigation .xmas-navigation__button {
      justify-self: stretch;
      max-width: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('xmas-sticky-navigation')) {
    customElements.define('xmas-sticky-navigation', class extends HTMLElement {
      connectedCallback() {
        this.main = this.closest('#main');
        if (!this.main) return;

        this.observer = new ResizeObserver(() => this.updateOffset());
        this.observer.observe(this);
        this.updateOffset();
      }

      disconnectedCallback() {
        this.observer?.disconnect();
        this.updateOffset();
      }

      updateOffset() {
        if (!this.main) return;

        const menus = this.main.querySelectorAll('xmas-sticky-navigation');
        const height = Math.max(0, ...Array.from(menus, (menu) => menu.offsetHeight));
        this.main.style.setProperty('--xmas-navigation-height', height + 'px');
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Christmas event tabs",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_navigation",
      "label": "Stick to top when scrolling",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Plan your visit"
    },
    {
      "type": "text",
      "id": "button_anchor",
      "label": "Button target anchor",
      "default": "visit"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "anchor", "label": "Target anchor" }
      ]
    }
  ],
  "presets": [
    { "name": "Christmas event tabs" }
  ]
}
{% endschema %}
