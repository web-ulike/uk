<nav class="xmas-navigation" aria-label="Christmas event">
  <div class="container">
    <div class="xmas-navigation__layout">
      <ul class="xmas-navigation__links" role="list">
        {% for block in section.blocks %}
          {% assign anchor = block.settings.anchor | handleize %}
          {% if anchor != blank and block.settings.label != blank %}
            <li {{ block.shopify_attributes }}>
              <a href="#{{ anchor }}">{{ block.settings.label | escape }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      {% assign button_anchor = section.settings.button_anchor | handleize %}
      {% if button_anchor != blank and section.settings.button_label != blank %}
        <a class="xmas-navigation__button" href="#{{ button_anchor }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↓</span></a>
      {% endif %}
    </div>
  </div>
</nav>

{% stylesheet %}
  .xmas-navigation {
    background: #fff9ee;
    border-bottom: 1px solid #e4d3bb;
    color: #651625;
    font: 500 16px/1.3 Saans, sans-serif;
  }

  .xmas-navigation__layout {
    display: flex;
    align-items: stretch;
    gap: clamp(12px, 2.2vw, 32px);
    padding-block: 14px;
  }

  .xmas-navigation__links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    flex: 1 1 auto;
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xmas-navigation__links a,
  .xmas-navigation__button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 10px 14px;
    border-radius: 4px;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .xmas-navigation__links a {
    height: 100%;
    border: 1px solid #e4d3bb;
    background: #fbf3e6;
  }

  .xmas-navigation__links a:hover {
    background: #f0e1c9;
  }

  .xmas-navigation__button {
    gap: 12px;
    max-width: 34%;
    padding-inline: clamp(16px, 2vw, 30px);
    background: #741a2c;
    color: #fff9ee;
  }

  .xmas-navigation__button:hover {
    background: #571020;
  }

  .xmas-navigation a:focus-visible {
    outline: 2px solid #741a2c;
    outline-offset: 2px;
  }

  @media (max-width: 700px) {
    .xmas-navigation { font-size: 14px; }
    .xmas-navigation__layout { display: grid; gap: 8px; padding-block: 10px; }
    .xmas-navigation__links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .xmas-navigation__button { max-width: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Christmas navigation",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Plan your visit"
    },
    {
      "type": "text",
      "id": "button_anchor",
      "label": "Button target anchor",
      "default": "visit"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "anchor", "label": "Target anchor" }
      ]
    }
  ],
  "presets": [
    { "name": "Christmas navigation" }
  ]
}
{% endschema %}
