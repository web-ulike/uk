<xmas-sticky-navigation>
<nav class="xmas-navigation" aria-label="Christmas event">
  <div class="container">
    <div class="xmas-navigation__layout">
      <ul class="xmas-navigation__links" role="list">
        {% for block in section.blocks %}
          {% assign anchor = block.settings.anchor | handleize %}
          {% if anchor != blank and block.settings.label != blank %}
            <li {{ block.shopify_attributes }}>
              <a href="#{{ anchor }}">{{ block.settings.label | escape }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      {% assign button_anchor = section.settings.button_anchor | handleize %}
      {% if button_anchor != blank and section.settings.button_label != blank %}
        <a class="xmas-navigation__button" href="#{{ button_anchor }}">
          {{ section.settings.button_label | escape }}
          <span class="xmas-navigation__arrow" aria-hidden="true">↓</span>
        </a>
      {% endif %}
    </div>
  </div>
</nav>
</xmas-sticky-navigation>

{% stylesheet %}
  xmas-sticky-navigation { display: block; }

  .shopify-section:has(> xmas-sticky-navigation) {
    position: sticky;
    top: calc(
      var(--header-height, 0px) * var(--enable-sticky-header, 0) +
      var(--announcement-bar-height, 0px) * var(--enable-sticky-announcement-bar, 0)
    );
    z-index: 3;
  }

  #main:has(xmas-sticky-navigation) .xmas[id] {
    scroll-margin-top: calc(
      var(--header-height, 0px) * var(--enable-sticky-header, 0) +
      var(--announcement-bar-height, 0px) * var(--enable-sticky-announcement-bar, 0) +
      var(--xmas-navigation-height, 0px)
    );
  }

  .xmas-navigation {
    --xmas-nav-accent: #e0004d;
    background: #fbf6ed;
    border-block: 1px solid #e3d3be;
    color: #514841;
    font: 500 16px/1.3 Saans, sans-serif;
  }

  .xmas-navigation__layout {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2.4vw, 36px);
    padding-block: 8px;
  }

  .xmas-navigation__links {
    display: flex;
    flex: 1;
    align-items: stretch;
    gap: clamp(16px, 3vw, 48px);
    min-width: 0;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
  }

  .xmas-navigation__links li {
    display: flex;
    flex: 0 0 auto;
  }

  .xmas-navigation__links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 2px;
    text-decoration: none;
    white-space: nowrap;
  }

  .xmas-navigation__links a:hover,
  .xmas-navigation__links a:focus-visible,
  .xmas-navigation__links a[aria-current="location"] {
    color: var(--xmas-nav-accent);
  }

  .xmas-navigation .xmas-navigation__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex: 0 0 auto;
    max-width: 42%;
    min-height: 46px;
    padding: 7px 8px 7px 18px;
    border-radius: 999px;
    background: var(--xmas-nav-accent);
    color: #fff;
    overflow-wrap: anywhere;
  }

  .xmas-navigation .xmas-navigation__button:hover {
    background: #bc003f;
  }

  .xmas-navigation__arrow {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    color: var(--xmas-nav-accent);
    font-size: 16px;
  }

  .xmas-navigation a:focus-visible {
    outline: 2px solid var(--xmas-nav-accent);
    outline-offset: 2px;
  }

  @media (max-width: 700px) {
    .xmas-navigation { font-size: 16px; }
    .xmas-navigation__layout { gap: 8px; padding-block: 6px; }
    .xmas-navigation__links { gap: 14px; }

    .xmas-navigation .xmas-navigation__button {
      gap: 8px;
      max-width: 52%;
      min-height: 44px;
      padding: 5px 6px 5px 12px;
      font-size: 15px;
      white-space: nowrap;
    }

    .xmas-navigation__arrow { width: 24px; height: 24px; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('xmas-sticky-navigation')) {
    customElements.define('xmas-sticky-navigation', class extends HTMLElement {
      connectedCallback() {
        this.main = this.closest('#main');
        if (!this.main) return;

        this.links = this.querySelector('.xmas-navigation__links');
        window.addEventListener('scroll', this.scheduleHighlight, { passive: true });
        window.addEventListener('resize', this.scheduleHighlight);
        this.observer = new ResizeObserver(() => this.updateOffset());
        this.observer.observe(this);
        this.updateOffset();
      }

      disconnectedCallback() {
        this.observer?.disconnect();
        window.removeEventListener('scroll', this.scheduleHighlight);
        window.removeEventListener('resize', this.scheduleHighlight);
        cancelAnimationFrame(this.highlightFrame);
        this.highlightFrame = null;
        this.updateOffset();
      }

      updateOffset() {
        if (!this.main) return;

        const menus = this.main.querySelectorAll('xmas-sticky-navigation');
        const height = Math.max(0, ...Array.from(menus, (menu) => menu.offsetHeight));
        this.main.style.setProperty('--xmas-navigation-height', height + 'px');
        if (this.isConnected) this.scheduleHighlight();
      }

      scheduleHighlight = () => {
        if (this.highlightFrame) return;

        this.highlightFrame = requestAnimationFrame(() => {
          this.highlightFrame = null;
          this.updateHighlight();
        });
      };

      updateHighlight() {
        const boundary = this.getBoundingClientRect().bottom + 16;
        let first;
        let firstTop = Infinity;
        let current;
        let currentTop = -Infinity;

        for (const link of this.links.querySelectorAll('a')) {
          const target = document.getElementById(link.hash.slice(1));
          if (!target) continue;

          const top = target.getBoundingClientRect().top;
          if (top < firstTop) {
            first = link;
            firstTop = top;
          }
          if (top <= boundary && top > currentTop) {
            current = link;
            currentTop = top;
          }
        }

        const active = current || first;
        if (active === this.active) return;

        this.active?.removeAttribute('aria-current');
        this.active = active;
        if (!active) return;

        active.setAttribute('aria-current', 'location');
        const tab = active.getBoundingClientRect();
        const strip = this.links.getBoundingClientRect();
        if (tab.left < strip.left || tab.right > strip.right) {
          this.links.scrollLeft += tab.left - strip.left - (strip.width - tab.width) / 2;
        }
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Christmas event tabs",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Plan your visit"
    },
    {
      "type": "text",
      "id": "button_anchor",
      "label": "Button target anchor",
      "default": "visit"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "anchor", "label": "Target anchor" }
      ]
    }
  ],
  "presets": [
    { "name": "Christmas event tabs" }
  ]
}
{% endschema %}
