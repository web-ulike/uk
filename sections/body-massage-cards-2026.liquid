{% comment %}UK 2026. Add manually; images and copy are configured in the theme editor.{% endcomment %}
{% assign massage_arrow_svg = 'data:image/svg+xml;base64,' %}
{% style %}
  #shopify-section-{{ section.id }} .body-massage-2026 {
    display: block;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    font-family: 'Saans', var(--text-font-family);
  }
  #shopify-section-{{ section.id }} .body-massage-2026__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 60px;
  }
  #shopify-section-{{ section.id }} .body-massage-2026__heading {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: 48px;
    font-weight: 400;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .body-massage-2026__arrows { display: flex; flex-shrink: 0; gap: 22px; }
  #shopify-section-{{ section.id }} .body-massage-2026__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    line-height: 1;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .body-massage-2026__arrow img { display: block; }
  #shopify-section-{{ section.id }} .body-massage-2026__arrow[data-direction="-1"] img { transform: scaleX(-1); }
  #shopify-section-{{ section.id }} .body-massage-2026__arrow:disabled { opacity: .25; cursor: default; }
  #shopify-section-{{ section.id }} .body-massage-2026__arrow:not(:disabled):hover { opacity: .65; }
  #shopify-section-{{ section.id }} .body-massage-2026__arrow:active { transform: translateY(1px); }
  #shopify-section-{{ section.id }} .body-massage-2026__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 34px) / 3);
    align-items: stretch;
    gap: 17px;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .body-massage-2026__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .body-massage-2026__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-radius: 16px;
    background: {{ section.settings.card_background }};
    scroll-snap-align: start;
  }
  #shopify-section-{{ section.id }} .body-massage-2026__media { display: block; background: #f4f3f2; }
  #shopify-section-{{ section.id }} .body-massage-2026__image { display: block; width: 100%; height: auto; }
  #shopify-section-{{ section.id }} .body-massage-2026__placeholder { aspect-ratio: 495 / 400; }
  #shopify-section-{{ section.id }} .body-massage-2026__copy { flex: 1; padding: 34px clamp(24px, 3.28125vw, 63px); }
  #shopify-section-{{ section.id }} .body-massage-2026__title {
    margin: 0;
    color: {{ section.settings.accent_color }};
    font: 400 24px / 1.2 'Saans', var(--text-font-family);
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .body-massage-2026__description { margin-top: 16px; font-size: 16px; line-height: 1.2; overflow-wrap: anywhere; }
  #shopify-section-{{ section.id }} .body-massage-2026__description p { margin: 0; }
  #shopify-section-{{ section.id }} .body-massage-2026__description p + p { margin-top: .5em; }
  #shopify-section-{{ section.id }} .body-massage-2026__dots { display: none; }
  #shopify-section-{{ section.id }} .body-massage-2026__track:focus-visible,
  #shopify-section-{{ section.id }} .body-massage-2026__arrow:focus-visible,
  #shopify-section-{{ section.id }} .body-massage-2026__dot:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .body-massage-2026 { padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px; }
    #shopify-section-{{ section.id }} .body-massage-2026__header { margin-bottom: 40px; }
    #shopify-section-{{ section.id }} .body-massage-2026__heading { font-size: 26px; }
    #shopify-section-{{ section.id }} .body-massage-2026__arrows { display: none; }
    #shopify-section-{{ section.id }} .body-massage-2026__track { grid-auto-columns: calc((100% - 16px) / {{ section.settings.mobile_visible_cards }}); gap: 16px; }
    #shopify-section-{{ section.id }} .body-massage-2026__card { border-radius: 8px; }
    #shopify-section-{{ section.id }} .body-massage-2026__placeholder { aspect-ratio: 286 / 291; }
    #shopify-section-{{ section.id }} .body-massage-2026__copy { padding: 23px 24px; }
    #shopify-section-{{ section.id }} .body-massage-2026__title { font-size: 18px; }
    #shopify-section-{{ section.id }} .body-massage-2026__description { margin-top: 10px; font-size: 12px; }
    #shopify-section-{{ section.id }} .body-massage-2026__dots { display: flex; flex-shrink: 0; gap: 6px; align-items: center; }
    #shopify-section-{{ section.id }} .body-massage-2026__dot { display: grid; place-items: center; width: 10px; height: 32px; padding: 0; border: 0; background: transparent; cursor: pointer; }
    #shopify-section-{{ section.id }} .body-massage-2026__dot::before { content: ''; width: 100%; height: 6px; border-radius: 23px; background: #cacaca; }
    #shopify-section-{{ section.id }} .body-massage-2026__dot[aria-current='true'] { width: 24px; }
    #shopify-section-{{ section.id }} .body-massage-2026__dot[aria-current='true']::before { background: #190a0a; }
  }
{% endstyle %}

<body-massage-2026 class="body-massage-2026">
  <div class="container">
    <div class="body-massage-2026__header">
      {% if section.settings.heading != blank %}<h2 id="MassageHeading-{{ section.id }}" class="body-massage-2026__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.blocks.size > 1 %}
        <div class="body-massage-2026__arrows">
          <button type="button" class="body-massage-2026__arrow" data-direction="-1" aria-label="Previous card" aria-controls="MassageTrack-{{ section.id }}" disabled><img src="{{ massage_arrow_svg }}" width="30" height="23" alt="" aria-hidden="true"></button>
          <button type="button" class="body-massage-2026__arrow" data-direction="1" aria-label="Next card" aria-controls="MassageTrack-{{ section.id }}"><img src="{{ massage_arrow_svg }}" width="30" height="23" alt="" aria-hidden="true"></button>
        </div>
        <div class="body-massage-2026__dots" aria-label="Choose card">
          {% for block in section.blocks %}<button type="button" class="body-massage-2026__dot" data-slide="{{ forloop.index0 }}" aria-label="Card {{ forloop.index }}: {{ block.settings.title | escape }}" aria-controls="MassageTrack-{{ section.id }}"{% if forloop.first %} aria-current="true"{% endif %}></button>{% endfor %}
        </div>
      {% endif %}
    </div>
    <ul id="MassageTrack-{{ section.id }}" class="body-massage-2026__track" role="list" tabindex="0"{% if section.settings.heading != blank %} aria-labelledby="MassageHeading-{{ section.id }}"{% else %} aria-label="Body massage cards"{% endif %}>
      {% for block in section.blocks %}
        {% liquid
          assign desktop_image = block.settings.image_desktop | default: block.settings.image_mobile
          assign mobile_image = block.settings.image_mobile | default: desktop_image
          assign image_alt = desktop_image.alt | default: block.settings.title
        %}
        <li class="body-massage-2026__card" {{ block.shopify_attributes }}>
          {% if desktop_image != blank %}
            <picture class="body-massage-2026__media">
              <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 360 }} 360w, {{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 900 }} 900w, {{ mobile_image | image_url: width: 1400 }} 1400w" sizes="80vw" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}">
              {{ desktop_image | image_url: width: 1500 | image_tag: class: 'body-massage-2026__image', widths: '360, 600, 900, 1200, 1500', sizes: '(max-width: 767px) 80vw, (min-width: 1600px) 495px, 33vw', loading: 'lazy', alt: image_alt }}
            </picture>
          {% else %}<div class="body-massage-2026__media body-massage-2026__placeholder" aria-hidden="true"></div>{% endif %}
          <div class="body-massage-2026__copy">
            {% if block.settings.title != blank %}<h3 class="body-massage-2026__title">{{ block.settings.title | escape }}</h3>{% endif %}
            {% if block.settings.description != blank %}<div class="body-massage-2026__description">{{ block.settings.description }}</div>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</body-massage-2026>

<script>
  if (!customElements.get('body-massage-2026')) {
    customElements.define('body-massage-2026', class extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.body-massage-2026__track');
        this.cards = Array.from(this.track.children);
        this.dots = Array.from(this.querySelectorAll('[data-slide]'));
        this.arrows = Array.from(this.querySelectorAll('[data-direction]'));
        this.controller = new AbortController();
        const options = { signal: this.controller.signal };
        this.addEventListener('click', event => {
          const button = event.target.closest('button');
          if (!button || !this.contains(button)) return;
          if (button.hasAttribute('data-slide')) this.goTo(Number(button.dataset.slide));
          if (button.hasAttribute('data-direction')) this.goTo(this.current + Number(button.dataset.direction));
        }, options);
        this.track.addEventListener('scroll', () => {
          if (this.frame) return;
          this.frame = requestAnimationFrame(() => { this.frame = null; this.update(); });
        }, { ...options, passive: true });
        this.track.addEventListener('keydown', event => {
          if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
            event.preventDefault();
            this.goTo(this.current + (event.key === 'ArrowRight' ? 1 : -1));
          }
        }, options);
        this.addEventListener('shopify:block:select', event => {
          const card = event.target.closest('.body-massage-2026__card');
          if (card) this.goTo(this.cards.indexOf(card), true);
        }, options);
        this.observer = new ResizeObserver(() => this.update());
        this.observer.observe(this.track);
        this.update();
      }
      positions() {
        const max = Math.max(0, this.track.scrollWidth - this.track.clientWidth);
        const first = this.cards[0];
        return this.cards.map(card => Math.min(max, card.offsetLeft - first.offsetLeft));
      }
      goTo(index, instant = false) {
        const positions = this.positions();
        if (!positions.length) return;
        const target = Math.max(0, Math.min(index, positions.length - 1));
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.track.scrollTo({ left: positions[target], behavior: instant || reduced ? 'auto' : 'smooth' });
      }
      update() {
        const positions = this.positions();
        const left = this.track.scrollLeft;
        this.current = positions.reduce((best, value, index) => Math.abs(value - left) < Math.abs(positions[best] - left) ? index : best, 0);
        this.dots.forEach((dot, index) => {
          if (index === this.current) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        this.arrows.forEach(button => {
          button.disabled = Number(button.dataset.direction) < 0 ? left <= 1 : left >= this.track.scrollWidth - this.track.clientWidth - 1;
        });
      }
      disconnectedCallback() {
        this.controller.abort();
        this.observer.disconnect();
        if (this.frame) cancelAnimationFrame(this.frame);
      }
    });
  }
</script>

{% schema %}
{
  "name": "UK Body Massage 2026",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Massage Your Body" },
    { "type": "range", "id": "mobile_visible_cards", "label": "手机端可见卡片数", "min": 1.1, "max": 1.5, "step": 0.1, "default": 1.2, "info": "默认显示一张完整卡片，并露出下一张约 20%。" },
    { "type": "color", "id": "background", "label": "组件背景", "default": "#fbfaf9" },
    { "type": "color", "id": "card_background", "label": "卡片背景", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "卡片标题颜色", "default": "#e0004d" },
    { "type": "range", "id": "padding_top", "label": "PC 上边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 78 },
    { "type": "range", "id": "padding_bottom", "label": "PC 下边距", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 74 },
    { "type": "range", "id": "mobile_padding_top", "label": "手机上边距", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "手机下边距", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 }
  ],
  "blocks": [{
    "type": "massage_card", "name": "护理卡片", "settings": [
      { "type": "image_picker", "id": "image_desktop", "label": "PC 图片", "info": "建议 495 × 400，不含文案；图片按上传比例完整显示。" },
      { "type": "image_picker", "id": "image_mobile", "label": "手机图片", "info": "建议 286 × 291；留空则使用 PC 图片。" },
      { "type": "text", "id": "title", "label": "标题" },
      { "type": "richtext", "id": "description", "label": "说明" }
    ]
  }],
  "presets": [{ "name": "Body Massage 2026", "blocks": [
    { "type": "massage_card", "settings": { "title": "Shoulders & Back", "description": "<p>Glide along the shoulders and back to ease tension and relax tired muscles.</p>" } },
    { "type": "massage_card", "settings": { "title": "Neck", "description": "<p>Use gentle upward strokes along the neck for a refreshed, soothed feeling.</p>" } },
    { "type": "massage_card", "settings": { "title": "Legs", "description": "<p>Glide smoothly over the legs to soothe tired muscles and leave skin feeling refreshed.</p>" } }
  ] }]
}
{% endschema %}
