{%- if paginate.pages > 1 -%}
  <page-pagination {% if use_ajax %}ajax{% endif %} class="pagination">
    <div class="ulike-pagination">
      {%- if paginate.previous -%}
        <a rel="prev" aria-label="{{ 'general.pagination.previous_page' | t }}" data-page="{{ paginate.current_page | minus: 1 }}" href="{% if paginate.current_page == 2 %}{{ paginate.previous.url | remove: 'page=1' | remove: '?' }}{% else %}{{ paginate.previous.url }}{% endif %}{{ hash }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="8" height="13" viewBox="0 0 8 13" fill="none"><path d="M7 12.53L1 6.53003L7 0.530029" stroke="currentColor" stroke-width="1.3"/></svg>
        </a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{% if part.title == 1 %}{{ part.url | remove: 'page=1' | remove: '?' }}{% else %}{{ part.url }}{% endif %}{{ hash }}" data-page="{{ part.title }}" aria-label="{{ 'general.pagination.go_to_page' | t: page: part.title }}">{{ part.title }}</a>
        {%- else -%}
          <span {% if part.title == paginate.current_page %}aria-current="page" class="active" {% endif %}>{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.next -%}
        <a rel="next" aria-label="{{ 'general.pagination.next_page' | t }}" data-page="{{ paginate.current_page | plus: 1 }}" href="{{ paginate.next.url }}{{ hash }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="8" height="13" viewBox="0 0 8 13" fill="none"><path d="M0.5 0.530029L6.5 6.53003L0.5 12.53" stroke="currentColor" stroke-width="1.3"/></svg>
        </a>
      {%- endif -%}
    </div>
  </page-pagination>
{%- endif -%}
