{% stylesheet %}
  .xmas {
    background: #fbf6ed;
    color: #342b27;
    font-family: Saans, sans-serif;
  }
  .xmas .container { width: 100%; max-width: 1150px; padding-inline: 35px; margin-inline: auto; }
  .xmas img { display: block; }
  @media (max-width: 700px) {
    .xmas .container { padding-inline: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .xmas .to-top { opacity: 1; transform: none; transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('shopify:section:load', (event) => {
    if (event.target.querySelector('.xmas') && typeof window.initialCheck === 'function') {
      window.initialCheck();
    }
  });
{% endjavascript %}
