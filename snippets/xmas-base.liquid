{% stylesheet %}
  .xmas {
    --xmas-section-space: clamp(64px, 7.5vw, 120px);
    --xmas-body-size: clamp(16px, 1.4vw, 20px);
    --xmas-small-size: clamp(13px, 1.05vw, 15px);
    font-size: var(--xmas-body-size);
    line-height: 1.55;
    background: #fbf6ed;
    color: #342b27;
    font-family: Saans, sans-serif;
  }
  .xmas img { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .xmas .to-top { opacity: 1; transform: none; transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('shopify:section:load', (event) => {
    if (event.target.querySelector('.xmas') && typeof window.initialCheck === 'function') {
      window.initialCheck();
    }
  });
{% endjavascript %}
