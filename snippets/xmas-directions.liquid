{% if settings_group.map_url != blank and settings_group.button != blank %}
  <a class="xmas-directions to-top" style="transition-delay: {{ delay | default: 0 }}s" href="{{ settings_group.map_url | escape }}" target="_blank" rel="noopener">
    {{ settings_group.button | escape }} <span aria-hidden="true">↗</span>
  </a>
{% endif %}
{% stylesheet %}
  .xmas-directions { display: inline-flex; align-items: center; gap: 24px; border-radius: 3px; background: #861629; color: white; padding: 14px 24px; font: 500 16px/1.45 Saans, sans-serif; text-decoration: none; }
  .xmas-directions:hover { background: #a5283b; }
{% endstylesheet %}
