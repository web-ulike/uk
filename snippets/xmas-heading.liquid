{% render 'xmas-base' %}
<p class="xmas-kicker to-top">{{ settings_group.kicker | escape }}</p>
<h2 class="xmas-heading to-top" style="transition-delay: 0.1s">{{ settings_group.heading | escape | newline_to_br }}</h2>
{% if settings_group.description != blank %}
  <p class="xmas-intro to-top" style="transition-delay: 0.2s">{{ settings_group.description | escape | newline_to_br }}</p>
{% endif %}

{% stylesheet %}
  .xmas .xmas-kicker { margin: 0 0 16px; color: #8b1b2b; font: 500 var(--xmas-small-size)/1.45 Saans, sans-serif; letter-spacing: 0.14em; }
  .xmas .xmas-heading { margin: 0; font: 400 clamp(38px, 4.5vw, 64px)/1.05 Bodoni-Book, serif; letter-spacing: -0.035em; color: inherit; }
  .xmas .xmas-intro { font-size: var(--xmas-body-size); line-height: 1.6; margin: 24px 0 0; color: #6d665e; }
  .xmas-head-row { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); align-items: end; gap: 0 clamp(24px, 4vw, 64px); margin-bottom: clamp(28px, 3.3vw, 48px); }
  .xmas-head-row .xmas-kicker { grid-column: 1 / -1; }
  .xmas .xmas-head-row .xmas-intro { margin: 0; }
  @media (max-width: 700px) {
    .xmas-head-row { display: block; }
    .xmas .xmas-head-row .xmas-intro { margin-top: 20px; }
  }
{% endstylesheet %}
