    "358fb48a-131e-4cef-9349-137a75f9e02d": {
      "type": "slide-diy",
      "blocks": {
        "c92e0cbe-754b-4852-98e9-7d5f95f66761": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/a4.png",
            "image1": "shopify://shop_images/a41.png",
            "image2": "shopify://shop_images/a42.png",
            "text": "Struggling with public speaking always, spurred by intriguing surveys, I decided to make a change in the new year by incorporating more substantial movements. Surprisingly, these small adjustments made a big difference."
          }
        },
        "923971f8-8ada-4d17-a9b3-3972724db731": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/a1_e0aa26a5-1f6a-4ea9-8718-2903410ed77a.png",
            "image1": "shopify://shop_images/a11.png",
            "image2": "shopify://shop_images/a12.png",
            "text": "I can't pinpoint when the hurtful body-shaming drove me away from the poolside I once cherished. It hit me that embracing and loving myself is the most powerful response."
          }
        },
        "15611138-6104-4a63-9374-1eadfcc8a925": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/a2_05069682-98a6-469b-9796-485a69740a06.png",
            "image1": "shopify://shop_images/a21.png",
            "image2": "shopify://shop_images/a22.png",
            "text": "Is every 30-something woman's life a constant stream of \"believe it or not\" advice, or is it just me? Time to swing my arms and smash through this noise like a tennis ball."
          }
        },
        "04d33859-9b3e-4de5-a9a1-c8ed7026cdb5": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/a3_65d4f635-93e2-4320-8d10-4a8fbd5b53ca.png",
            "image1": "shopify://shop_images/a31.png",
            "image2": "shopify://shop_images/a32.png",
            "text": "No more stressing over standing out at parties or fitting in. It turns out, embracing my inner twerp who enjoys sitting in the audience and cheering is quite enjoyable. Raise your glass!"
          }
        }
      },
      "block_order": [
        "c92e0cbe-754b-4852-98e9-7d5f95f66761",
        "923971f8-8ada-4d17-a9b3-3972724db731",
        "15611138-6104-4a63-9374-1eadfcc8a925",
        "04d33859-9b3e-4de5-a9a1-c8ed7026cdb5"
      ],
