    "faq_detail_diy_3TeAqC": {
      "type": "faq-detail-diy",
      "blocks": {
        "item_PhiUnk": {
          "type": "item",
          "settings": {
            "title": "Can I use the device in the bathroom?",
            "content": "<p>No. This device is not waterproof and should not be used in the bathroom.</p>"
          }
        },
        "item_pjMWeP": {
          "type": "item",
          "settings": {
            "title": "Why does my skin feel warm after use?",
            "content": "<p>A mild warming sensation is normal and is caused by the device's heat-based technology.</p>"
          }
        },
        "item_EQBKEk": {
          "type": "item",
          "settings": {
            "title": "Is it safe for sensitive skin?",
            "content": "<p>The M12 Max (RD) is safe for most skin types. However, if you have extremely sensitive skin or an active skin condition (eczema, rosacea, severe acne), please consult your dermatologist before use.We recommend doing a patch test on a small area and waiting 24 hours for a reaction before beginning treatment.</p>"
          }
        },
        "item_Xdecxm": {
          "type": "item",
          "settings": {
            "title": "What changes when I increase the intensity level?",
            "content": "<p>Higher intensity levels provide a stronger treatment sensation and increased warmth. If you're a first-time user or are still adjusting to the device, we recommend starting at Level 1.</p>"
          }
        },
        "item_aGKzJC": {
          "type": "item",
          "settings": {
            "title": "Who should NOT use M12 Max (RD) ?",
            "content": "<p>Do not use if you:Are pregnant or breastfeedingHave cancer or history of cancer or tumors</p><p>Have an active skin condition (i.e. open wounds, blisters, severe acne, eczema, rosacea)Are epileptic or have a seizure disorder</p><p>Are currently taking photosensitizing medications (i.e. retinoids, benzoyl peroxide, certain antibiotics)</p><p>Have had a recent cosmetic procedure (within 2 weeks)Have a pacemaker or implanted medical device</p><p>⚠️ If you have any other medical conditions or concerns, consult your doctor before use.</p>"
          }
        },
        "item_yykaxA": {
          "type": "item",
          "settings": {
            "title": "Can I rinse the device with water?",
            "content": "<p>No. The device is not waterproof and should never be rinsed with water, as this may damage the device.</p>"
          }
        },
        "item_jeTPjt": {
          "type": "item",
          "settings": {
            "title": "How often should I use the device?",
            "content": "<p>We recommend using the device six times per week. You can use it before applying makeup in the morning or after cleansing your face in the evening.</p><ul><li>FACE Mode: 6 minutes per session</li><li>MAX Mode: 10 minutes per session</li></ul><p>For the best results, alternate between the two modes on different days.</p>"
          }
        },
        "item_8EfREn": {
          "type": "item",
          "settings": {
            "title": "Can I use the device while wearing makeup?",
            "content": "<p>No. Before each treatment, remove all makeup and cleanse your face thoroughly to ensure your skin is free of oil and impurities.</p>"
          }
        },
        "item_HQVMeC": {
          "type": "item",
          "settings": {
            "title": "Can I use another gel instead of the official conductive gel?",
            "content": "<p>We recommend using the official conductive gel, which was specifically developed for this device to optimize performance.</p><p>You may choose to use a similar gel product; however, we cannot guarantee the treatment results or be responsible for any issues caused by using non-official products.</p>"
          }
        }
      },
