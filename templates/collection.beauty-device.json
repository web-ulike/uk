    "css_module_RL9n3i": {
      "type": "css-module",
      "settings": {
        "html_cont": "<style>\n.comparison-container {\n  padding: 80px 0;\n  background: linear-gradient(180deg, rgba(195, 203, 211, 1) 4.5%, #fff 95.5%);\n}\n\n.comparison-container .comparison-cont {\n  padding: 0 50px;\n  max-width: 1400px;\n  margin: 0 auto;\n  border-radius: 10px;\n  background: #fff;\n}\n\n.comparison-container .comparison-table {\n  width: 100%;\n  border-collapse: collapse;\n  table-layout: fixed;\n  border-spacing: 0;\n}\n\n.comparison-container .comparison-table th,\n.comparison-table td {\n  border: none;\n  border-bottom: 1px solid #e3e3e3;\n  padding: 10px 0;\n  text-align: center;\n  vertical-align: middle;\n  font-size: 14px;\n  color: #000;\n  line-height: 1.5;\n  font-weight: normal;\n}\n.comparison-container .comparison-table tbody tr:last-child td {\n  border-bottom: none;\n}\n\n.comparison-container .comparison-table thead th {\n  border: none;\n  padding: 10px;\n  padding-top: 38px;\n  font-size: 18px;\n  color: #000;\n  font-family: var(--heading-font-family);\n}\n.comparison-container .comparison-table thead th:first-child {\n  vertical-align: top;\n  font-size: 25px;\n  font-family: var(--heading-font-family);\n  color: #222;\n  text-align: left;\n}\n\n.comparison-container .comparison-table thead th img {\n  display: block;\n  margin: 0 auto;\n  margin-bottom: 8px;\n  width: auto;\n  height: 98px;\n}\n\n.comparison-container .comparison-table thead th .small {\n  font-size: 16px;\n  font-family: var(--text-font-family);\n}\n\n.comparison-container .comparison-table th:nth-child(2) .small {\n  font-family: var(--heading-font-family);\n  color: #e3185d;\n}\n\n.comparison-container .comparison-table tbody td:first-child {\n  font-size: 16px;\n  text-align: left;\n  color: #000;\n  font-family: var(--heading-font-family);\n}\n\n.comparison-container .comparison-table tbody td:first-child .small {\n  display: block;\n  font-size: 14px;\n  font-family: var(--text-font-family);\n}\n\n.comparison-container .comparison-table th:nth-child(2),\n.comparison-container .comparison-table td:nth-child(2) {\n  background-color: #fff0f5;\n  font-family: var(--heading-font-family);\n}\n.comparison-container .comparison-table td:nth-child(2) {\n  border-right: none;\n}\n\n.comparison-container .comparison-table tbody tr:last-child td {\n  padding-bottom: 35px;\n}\n\n.comparison-container .feature-color {\n  display: inline-block;\n  width: 39px;\n  height: 10px;\n  border-radius: 20px;\n  margin-left: 6px;\n  vertical-align: middle;\n}\n.comparison-container .feature-color.infrared {\n  background-color: #DF3ECE;\n}\n.comparison-container .feature-color.red {\n  background-color: #DF3E3E;\n}\n.comparison-container .feature-color.yellow {\n  background-color: #F7E62A;\n}\n.comparison-container .feature-color.blue {\n  background-color: #326FFE;\n}\n\n.comparison-container .icon {\n  display: inline-flex;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  position: relative;\n}\n\n.comparison-container .icon.check.ulike {\n  background-color: #e0004d;\n}\n.comparison-container .icon.check.ulike::before {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 7px;\n  height: 14px;\n  border-bottom: 1px solid #fff;\n  border-right: 1px solid #fff;\n  transform: translate(-50%, -70%) rotate(45deg);\n  margin-top: 1px;\n}\n.comparison-container .icon.check.competitor {\n  background-color: #000;\n}\n.comparison-container .icon.check.competitor::before {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 7px;\n  height: 14px;\n  border-bottom: 1px solid #fff;\n  border-right: 1px solid #fff;\n  transform: translate(-50%, -70%) rotate(45deg);\n  margin-top: 1px;\n}\n\n.comparison-container .icon.cross {\n  background-color: #b5b5b5;\n}\n\n.comparison-container .icon.cross::before,\n.comparison-container .icon.cross::after {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 15px;\n  height: 1px;\n  background-color: #fff;\n}\n.compari