    "preheat_specialist_7cHBGB": {
      "type": "preheat-specialist",
      "blocks": {
        "item_nHYbwd": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/Dr._Carolin_Copeland.png",
            "text": "„Der Ulike Air 10 Pro kombiniert wissenschaftlich fundierte IPL-Technologie mit intelligenter Energieanpassung und integrierter Saphir-Eiskühlung für eine komfortable Anwendung zu Hause.“",
            "text1": "Dr. Carolin Copeland <br> Board-Certified Dermatologist (MD, PhD)",
            "text2": "Studium an der Technischen Universität München und der Ludwig-Maximilians-Universität München. Klinische Ausbildung am Klinikum rechts der Isar der Universität München."
          }
        },
        "item_dH3UE8": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/h4.png",
            "text": "“Ich werde Ulikes starke F&E-Kapazitäten mit Spitzenforschung in der Photomedizin verbinden, um bahnbrechende Schönheitsprodukte zu entwickeln.”",
            "text1": "Professor M.R. Hamblin <br>Wissenschaftlicher Hauptberater von Ulike",
            "text2": "Er war leitender Forscher am Wellman Center for Photomedicine am Massachusetts General Hospital und ein renommierter Professor für Dermatologie an der Harvard Medical School. Aktuell ist er als Gastprofessor an der Universität von Johannesburg tätig."
          }
        },
        "item_N8WDpj": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/Dr._Sina_Ghadiri.png",
            "text": "„Der Ulike Air 10 überzeugt mich besonders durch seine Saphir-Eiskühlungstechnologie, die den Anwendungskomfort spürbar verbessert. Der SHR-Modus liefert hohe Leistung auf kontrollierte Weise und sorgt so für effiziente und gleichmäßige Anwendungen. Zusammen mit dem ergonomischen Design wirkt das Gerät intuitiv und durchdacht für die alltägliche Anwendung zu Hause.“",
            "text1": "Dr. Sina Ghadiri <br> Zertifizierter Dermatologe, MB BChir (Cantab), MA (Cantab)",
            "text2": "Dr. Sina Ghadiri ist ein in Großbritannien tätiger Dermatologe und Gründer der Sinaesthetics Clinic in London. Er ist board-certified und Mitglied des Royal College of Physicians (MRCP). Seine Schwerpunkte liegen sowohl in der medizinischen als auch in der ästhetischen Dermatologie."
          }
        },
        "item_TLjh6X": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/Dr._Sermed_Mezher.png",
            "text": "„Dieses Gerät für die Anwendung zu Hause ist praktisch, angenehm in der Anwendung und kann bei regelmäßiger Anwendung dazu beitragen, das Nachwachsen der Haare sichtbar zu reduzieren. Es eignet sich besonders für feines bis mittelstarkes Haar.“",
            "text1": "Dr. Sermed Mezher   In London zugelassener Allgemeinmediziner. MBChB, MRes, MRCGP.",
            "text2": "Dr. Sermed Mezher ist ein in Manchester ausgebildeter Allgemeinmediziner und klinischer Forscher. Als Fellow von Kidney Research UK verfügt er über einen Master of Medical Research; seine Arbeit zum Management des britischen National Health Service wurde im BMJ Leader veröffentlicht."
          }
        },
        "item_LBEQrm": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/h1_ef518485-c7e5-47af-a2bb-405deaef6458.png",
            "text": "“Mit Ulike können die Nutzer ihr eigenes sicheres und privates Schönheitserlebnis schaffen, um unerwünschte Haare diskret loszuwerden.”",
            "text1": "Dr. Davin Lim <br> Zertifizierter Hautarzt",
            "text2": "Ein australischer, zertifizierter Laser-, Verfahrens- und ästhetischer Dermatologe. Er ist außerdem ein angesehenes Mitglied der American Academy of Aesthetic Medicine und sitzt in verschiedenen Beiräten, unter anderem bei Galderma, Fraxel und Syneron Candella."
          }
        }
      },
