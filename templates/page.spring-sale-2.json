        },
        "4af10bde-493a-40d0-946a-d5befa9a8a60": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/b2.png",
            "text": "02",
            "text1": "The light is then converted to heat energy, disabling the hair follicle, resulting in thinner hair regrowth."
          }
        },
        "9928a165-5a3d-4b8e-803c-65b45b94f509": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/b3.png",
            "text": "03",
            "text1": "After regular and consistent treatment, Ulike IPL eventually stops any new hairs from regrowing."
          }
        },
        "2b7935c3-0e98-4760-a575-9bd20ae64e79": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/b4.png",
            "text": "04",
            "text1": "After 4 weeks of proper IPL use, you can expect the treatment area to see significant hair reduction."
          }
        },
        "f159c981-b48c-4cb0-a855-ee61f96270ec": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/b5.png",
            "text": "05",
            "text1": "Continuing with the full 12-week cycle, touch-ups may be needed depending on the individual and to ensure every hair is treated during the anagen (growth) phase."
          }
        }
      },
      "block_order": [
