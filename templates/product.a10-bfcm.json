    "ipl_works_8fEE3B": {
      "type": "ipl-works",
      "blocks": {
        "item_LiryPa": {
          "type": "item",
          "settings": {
            "video": "shopify://files/videos/01-video.mp4",
            "image": "shopify://shop_images/IPL02.jpg",
            "text": "01",
            "text1": "The light penetrates the skin's surface and is absorbed by the melanin in the hair follicles.",
            "autoplay": true,
            "show_video_controls": false
          }
        },
        "item_nKEtB9": {
          "type": "item",
          "settings": {
            "video": "shopify://files/videos/02-video.mp4",
            "image": "shopify://shop_images/IPL03.jpg",
            "text": "02",
            "text1": "It is then converted to heat energy, disabling the hair follicles, and resulting in thinner hair regrowth.",
            "autoplay": true,
            "show_video_controls": false
          }
        },
        "item_etNC9d": {
          "type": "item",
          "settings": {
            "video": "shopify://files/videos/03-video.mp4",
            "image": "shopify://shop_images/IPL02.jpg",
            "text": "03",
            "text1": "With consistent treatments, the Ulike IPL ultimately prevents hair growth altogether.",
            "autoplay": true,
            "show_video_controls": false
          }
        }
      },
      "block_order": [
        "item_LiryPa",
        "item_nKEtB9",
        "item_etNC9d"
      ],
      "settings": {
        "text": "How does IPL works?",
        "text1": "The light pulses target melanin and heat the hair follicles to inhibit regrowth, resulting in hair that grows back thinner, more slowly, and eventually ceases altogether."
      }
    },
    "preheat_specialist_adqgBA": {
      "type": "preheat-specialist",
      "blocks": {
        "item_CDTqqm": {
          "type": "item",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/h4.png",
            "text": "\"I am to merge the most important findings in photomedicine research with Ulike’s robust research and development capabilities to attain industry breakthroughs with advanced beauty products.\"",
            "text1": "Professor M.R. Hamblin",
            "text2": "Chief Scientific Advisor of Ulike Group",
            "btn_text": ""
          }
        },
        "item_i9cPGK": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/Gemini_Generated.png",
            "text": "\"This at home device is convenient, comfortable and effective at significantly reducing hair growth and counts. Perfect for light to moderate hair thickness.\"",
            "text1": "Dr. Sermed Mezher",
            "text2": "Qualified GP in London. MBChB, MRes, MRCGP.",
            "btn_text": ""
          }
        },
        "item_C6HqK9": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/h1_ef518485-c7e5-47af-a2bb-405deaef6458.png",
            "text": "\"What was only possible in a clinic a few years ago has become an effective and safe option for patients to undertake from the convenience and privacy of their own home.\"",
            "text1": "Dr. Davin Lim",
            "text2": "Board-Certified Dermatologist",
            "btn_text": ""
          }
        },
        "item_DrTeJy": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/US-New-experts-Dr._Adam_Rubinstein-0314_1.webp",
